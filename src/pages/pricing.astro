---
import PublicFooter from '../components/marketing/PublicFooter.astro';
import PublicNav from '../components/marketing/PublicNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const isNew = Astro.url.searchParams.get('new') === '1';

const faq = [
  { q: 'Y a-t-il un engagement minimum ?', a: "Les plans mensuels sont sans engagement, résiliables à tout moment. L'option annuelle est un abonnement renouvelé automatiquement chaque année." },
  { q: "Comment fonctionne l'essai gratuit ?", a: "L’essai gratuit nécessite une carte bancaire afin d’activer le plan choisi. Vous pouvez résilier à tout moment pendant les 14 jours d’essai. Sans résiliation, l’abonnement démarre automatiquement sur le forfait sélectionné." },
  { q: "Quelle est la différence entre mensuel et annuel ?", a: "Le mensuel est facturé chaque mois. L'annuel est facturé une fois par an et se renouvelle automatiquement: 295€ pour Starter, 699€ pour Pro et 1990€ pour Business." },
  { q: 'Puis-je changer de plan ?', a: 'Oui, vous pouvez évoluer ou rétrograder à tout moment depuis votre espace commerçant.' },
  { q: "Mes clients doivent-ils télécharger une app ?", a: "Non. Vos clients utilisent Apple Wallet ou Google Wallet, déjà installés sur leur téléphone. Aucun téléchargement supplémentaire." },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const plans = [
  {
    id: 'starter',
    name: 'Starter',
    eyebrow: 'Première carte',
    monthly: '29€',
    annual: '295€',
    periodMonthly: '/mois',
    periodAnnual: '/an',
    saving: 'Économisez 15% avec l’abonnement annuel',
    desc: 'Pour lancer votre première carte et commencer à fidéliser.',
    highlight: false,
    cta: "Démarrer l'essai gratuit",
    setupCta: 'Starter + Setup (+90€ une fois)',
    features: [
      "Jusqu'à 500 cartes actives",
      '1 point de vente',
      'Scanners illimités',
      'Apple Wallet + Google Wallet',
      'Scanner mobile + affiche QR',
      'Notifications push illimitées',
      'Carte tampons, points, paliers',
      'Analytics de base',
      'Support email',
    ],
  },
  {
    id: 'pro',
    name: 'Pro',
    eyebrow: 'Croissance',
    monthly: '69€',
    annual: '699€',
    periodMonthly: '/mois',
    periodAnnual: '/an',
    saving: 'Économisez 15% avec l’abonnement annuel',
    desc: 'Pour fidéliser plus fort et communiquer avec vos clients.',
    highlight: true,
    badge: 'Le plus populaire',
    cta: "Démarrer l'essai gratuit",
    setupCta: 'Pro + Setup (+90€ une fois)',
    features: [
      "Jusqu'à 2000 cartes actives",
      '3 points de vente',
      'Scanners illimités',
      'Apple Wallet + Google Wallet',
      'Push ciblées & campagnes',
      'Push avis Google auto (+1h)',
      'Analytics avancés',
      'Anniversaire automatique',
      'Support prioritaire',
    ],
  },
  {
    id: 'business',
    name: 'Business',
    eyebrow: 'Volume',
    monthly: '199€',
    annual: '1990€',
    periodMonthly: '/mois',
    periodAnnual: '/an',
    saving: 'Économisez 16% avec l’abonnement annuel',
    desc: 'Pour les commerces qui veulent un déploiement complet avec setup inclus.',
    highlight: false,
    cta: "Démarrer l'essai gratuit",
    setupIncluded: true,
    features: [
      'Cartes actives illimitées',
      'Points de vente avancés',
      'Scanners illimités',
      'Apple Wallet + Google Wallet',
      'Push ciblées & campagnes',
      'Automatisations incluses',
      'Analytics avancés',
      'Accompagnement setup compris',
      'Support prioritaire',
    ],
  },
];
---

<BaseLayout
  theme="light"
  title="Tarifs Fidelopass — Essai gratuit 14 jours"
  description="Plans Starter, Pro et Business pour commerces. Essai gratuit 14 jours, résiliable à tout moment pendant l’essai."
  jsonLd={faqJsonLd}
>
  <PublicNav currentPath="/pricing" />

  {isNew && (
    <div class="bg-indigo-600 text-white text-center py-3 px-4">
      <p class="text-sm font-medium">
        Compte créé avec succès. Choisissez votre plan pour commencer votre essai gratuit.
      </p>
    </div>
  )}

  <section class="relative overflow-hidden bg-[linear-gradient(180deg,#ffffff_0%,#f5f9ff_65%,#ffffff_100%)] pt-6 pb-5 sm:pt-8 sm:pb-6">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-24 right-0 h-56 w-56 rounded-full bg-sky-200/30 blur-3xl"></div>
      <div class="absolute -top-10 left-0 h-52 w-52 rounded-full bg-indigo-200/20 blur-3xl"></div>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="mb-3 inline-flex items-center rounded-full border border-sky-200 bg-white px-3.5 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-sky-700 shadow-sm">Tarifs Fidelopass</span>
      <h1 class="font-display text-3xl font-bold text-slate-900 leading-[1.05] sm:text-5xl lg:text-[3.65rem]">
        Des tarifs simples, <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">sans mauvaise surprise.</span>
      </h1>
      <p class="text-slate-500 text-base mt-3 max-w-2xl mx-auto sm:text-lg">
        Essai gratuit 14 jours sur tous les plans. Carte bancaire requise, résiliable à tout moment pendant l’essai.
      </p>
    </div>
  </section>

  <section class="bg-slate-50/70 py-5 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-5 flex justify-center">
        <div class="billing-toggle inline-flex items-center gap-1 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm" aria-label="Choisir la facturation">
          <button type="button" data-billing-mode="monthly" aria-pressed="true">Mensuel</button>
          <button type="button" data-billing-mode="annual" aria-pressed="false">
            Annuel
            <span class="ml-1.5 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-700">-15%</span>
          </button>
        </div>
      </div>

      <div class="grid gap-6 items-start lg:grid-cols-4">
        {plans.map((plan) => (
          <article class:list={[
            'relative flex h-full flex-col rounded-[1.75rem] border p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)]',
            plan.highlight
              ? 'border-indigo-400 bg-[linear-gradient(155deg,#1e1b4b_0%,#312e81_62%,#0284c7_100%)] text-white shadow-[0_30px_80px_rgba(49,46,129,0.24)]'
              : 'border-slate-200 bg-white text-slate-900',
          ]}>
            {plan.badge && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                <span class="rounded-full bg-amber-400 px-4 py-1.5 text-xs font-bold text-amber-900 shadow whitespace-nowrap">
                  {plan.badge}
                </span>
              </div>
            )}
            <div class="mb-3">
              <span class:list={[
                'text-xs font-bold uppercase tracking-widest',
                plan.highlight ? 'text-indigo-200' : 'text-slate-400',
              ]}>{plan.eyebrow}</span>
            </div>
            <h2 class:list={['font-display text-2xl font-bold', plan.highlight ? 'text-white' : 'text-slate-950']}>{plan.name}</h2>
            <p class:list={['mt-2 min-h-[2.7rem] text-sm leading-relaxed', plan.highlight ? 'text-indigo-100' : 'text-slate-500']}>{plan.desc}</p>

            <div class="mt-4">
              <div class="flex items-end gap-1">
                <span
                  class:list={['font-display text-5xl font-bold leading-none tracking-[-0.05em] price-display', plan.highlight ? 'text-white' : 'text-slate-950']}
                  data-monthly={plan.monthly}
                  data-annual={plan.annual}
                >{plan.monthly}</span>
                <span
                  class:list={['mb-1 text-sm price-period', plan.highlight ? 'text-indigo-200' : 'text-slate-400']}
                  data-monthly={plan.periodMonthly}
                  data-annual={plan.periodAnnual}
                >{plan.periodMonthly}</span>
              </div>
              <p class:list={['mt-3 hidden text-xs font-semibold annual-saving', plan.highlight ? 'text-emerald-100' : 'text-emerald-700']}>{plan.saving}</p>
              <p class:list={['mt-1 text-xs billing-note', plan.highlight ? 'text-indigo-200' : 'text-slate-400']}>Facturation mensuelle</p>
            </div>

            <div class="mt-6 space-y-2.5">
              <a
                href={`/register?next=%2Fabonnement%2Fchoix%3Fplan%3D${plan.id}`}
                data-plan-cta={plan.id}
                data-setup="0"
                class:list={[
                  'inline-flex w-full items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold transition-all',
                  plan.highlight
                    ? 'border-2 border-white bg-white text-indigo-700 shadow hover:bg-indigo-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-indigo-600'
                    : 'btn-primary',
                ]}
              >
                {plan.cta}
              </a>
              {plan.setupCta && (
                <a
                  href={`/register?next=%2Fabonnement%2Fchoix%3Fplan%3D${plan.id}%26setup%3D1`}
                  data-plan-cta={plan.id}
                  data-setup="1"
                  class:list={[
                    'inline-flex w-full items-center justify-center rounded-xl border px-4 py-3 text-sm font-semibold transition-all',
                    plan.highlight
                      ? 'border-white/30 bg-white/10 text-white hover:bg-white/20'
                      : 'border-slate-200 text-slate-700 hover:bg-slate-50',
                  ]}
                >
                  {plan.setupCta}
                </a>
              )}
              {plan.setupIncluded && (
                <p class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-center text-xs font-bold uppercase tracking-[0.14em] text-emerald-700">
                  Setup compris
                </p>
              )}
              <p class:list={['trial-note text-center text-xs', plan.highlight ? 'text-indigo-200' : 'text-slate-400']}>14 jours gratuits · Annuler à tout moment</p>
            </div>

            <ul class="mt-7 flex-1 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-center gap-3 text-sm">
                  <span class:list={[
                    'flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-xs font-bold',
                    plan.highlight ? 'bg-white/20 text-white' : 'bg-emerald-100 text-emerald-600',
                  ]}>✓</span>
                  <span class:list={plan.highlight ? 'text-indigo-50' : 'text-slate-700'}>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}

        <article class="flex h-full flex-col rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_20px_50px_rgba(15,23,42,0.08)]">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Réseau & Franchise</p>
          <h2 class="mt-3 font-display text-2xl font-bold text-slate-950">Sur devis</h2>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-display text-4xl font-bold leading-none text-slate-950">Sur devis</span>
          </div>
          <p class="mt-3 text-xs font-semibold text-slate-400">Tarif personnalisé selon votre réseau</p>
          <p class="mt-4 min-h-[2.7rem] text-sm leading-relaxed text-slate-500">Pour les réseaux, franchises et groupes avec plusieurs enseignes.</p>
          <a href="/contact" class="mt-6 inline-flex w-full items-center justify-center rounded-xl border-2 border-slate-900 px-4 py-3 text-sm font-semibold text-slate-900 transition-all hover:bg-slate-900 hover:text-white">
            Nous contacter
          </a>
          <ul class="mt-7 flex-1 space-y-3">
            {[
              'Points de vente illimités',
              'Cartes actives illimitées',
              'Scanners illimités',
              'API + intégrations caisse',
              'Accompagnement personnalisé',
              'Support prioritaire dédié',
            ].map((feature) => (
              <li class="flex items-center gap-3 text-sm">
                <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-violet-100 text-xs font-bold text-violet-600">✓</span>
                <span class="text-slate-700">{feature}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <p class="text-center text-slate-400 text-xs mt-8">Prix HT. TVA applicable selon votre situation.</p>

      <div class="mt-14 max-w-md mx-auto">
        <h2 class="font-display text-2xl font-bold text-slate-900 mb-6 text-center">Option complémentaire</h2>
        <div class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm flex flex-col gap-3">
          <div>
            <p class="font-semibold text-slate-900">Accompagnement Setup</p>
            <p class="text-slate-500 text-sm mt-1 leading-relaxed">Aide à la configuration, paramétrage initial et mise en ligne de votre première carte par notre équipe.</p>
          </div>
          <div class="flex items-end justify-between gap-3 mt-auto pt-2">
            <div>
              <span class="font-display text-2xl font-bold text-slate-900">90€</span>
              <span class="text-slate-400 text-sm ml-1">une fois</span>
            </div>
            <span class="rounded-full bg-indigo-50 border border-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-700">
              Inclus avec Business
            </span>
          </div>
          <p class="text-xs text-slate-500">Cette option peut être ajoutée au checkout Starter ou Pro. Elle est comprise dans le plan Business.</p>
        </div>
      </div>

      <div class="mt-14 rounded-[2rem] border border-sky-100 bg-white p-5 shadow-[0_24px_70px_-52px_rgba(37,99,235,0.45)] sm:p-7">
        <div class="grid gap-8 lg:grid-cols-[1fr_0.95fr] lg:items-center">
          <div>
            <p class="text-[0.7rem] font-bold uppercase tracking-[0.24em] text-sky-700">Simulateur de revenus</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl">Combien Fidelopass peut vous rapporter ?</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">
              Indiquez votre nombre de clients fidélisés, votre panier moyen et le pourcentage de clients susceptibles de revenir grâce à Fidelopass.
            </p>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              {plans.map((plan) => (
                <button
                  type="button"
                  class:list={[
                    'roi-plan rounded-2xl border px-4 py-3 text-left transition',
                    plan.highlight ? 'border-indigo-200 bg-indigo-50 text-indigo-950' : 'border-slate-200 bg-white text-slate-800',
                  ]}
                  data-roi-plan={plan.id}
                  data-roi-cost={parseInt(plan.monthly, 10)}
                >
                  <span class="block text-sm font-bold">{plan.name}</span>
                  <span class="mt-1 block text-xs text-slate-500">{plan.monthly} / mois</span>
                </button>
              ))}
            </div>

            <div class="mt-6 grid gap-5">
              <label class="roi-range">
                <span><strong>Clients fidélisés</strong><em id="roi-cards-label">500 clients</em></span>
                <small>Nombre de clients ayant une carte Fidelopass active.</small>
                <input id="roi-cards" type="range" min="50" max="5000" step="50" value="500" />
              </label>
              <label class="roi-range">
                <span><strong>Panier moyen client</strong><em id="roi-basket-label">25€</em></span>
                <small>Montant moyen dépensé à chaque visite.</small>
                <input id="roi-basket" type="range" min="5" max="150" step="1" value="25" />
              </label>
              <label class="roi-range">
                <span><strong>Taux de retour estimé</strong><em id="roi-return-label">27%</em></span>
                <small>Part des clients qui reviennent une fois de plus dans le mois.</small>
                <input id="roi-return" type="range" min="5" max="50" step="1" value="27" />
              </label>
            </div>
          </div>

          <div class="rounded-[1.8rem] border border-slate-200 bg-[linear-gradient(155deg,#0f172a_0%,#1e3a8a_62%,#0891b2_100%)] p-6 text-white shadow-[0_28px_70px_-42px_rgba(15,23,42,0.75)]">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-cyan-100/80">Votre gain estimé</p>
            <div class="mt-4 rounded-3xl bg-white p-5 text-slate-950 shadow-[0_24px_55px_-34px_rgba(15,23,42,0.75)]">
              <p id="roi-profit" class="font-display text-5xl font-extrabold tracking-[-0.06em] text-emerald-600">3 306€ / mois</p>
              <p id="roi-yearly" class="mt-2 text-sm font-bold text-slate-500">≈ 39 672€ / an</p>
            </div>
            <div class="mt-4 rounded-2xl bg-white/12 p-4 ring-1 ring-white/15">
              <p class="text-sm font-bold text-white">Détail du calcul</p>
              <ul class="mt-3 space-y-2 text-sm leading-6 text-blue-50">
                <li id="roi-detail-clients">500 clients fidélisés</li>
                <li id="roi-detail-return">27% reviennent 1 fois dans le mois</li>
                <li id="roi-detail-visits">135 visites supplémentaires</li>
                <li id="roi-detail-basket">Panier moyen : 25€</li>
                <li id="roi-detail-revenue">CA généré : +3 375€</li>
                <li id="roi-plan-cost">Abonnement Pro : -69€</li>
              </ul>
            </div>
            <div class="mt-4 rounded-2xl bg-cyan-50/95 p-4 text-slate-950">
              <p id="roi-roi" class="text-lg font-extrabold text-blue-700">ROI : x49</p>
              <p id="roi-roi-text" class="mt-1 text-xs leading-5 text-slate-600">Pour 1€ investi dans Fidelopass, vous pourriez générer environ 49€ de chiffre d’affaires supplémentaire.</p>
            </div>
            <p class="mt-4 text-xs leading-5 text-blue-100/80">Estimation indicative basée sur une visite supplémentaire par client revenu. Les résultats peuvent varier selon votre activité, votre fréquence de passage et vos campagnes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-slate-900">Questions fréquentes</h2>
      </div>
      <div class="space-y-3" id="pricing-faq">
        {faq.map((item, i) => (
          <div class="bg-white rounded-[1.5rem] border border-slate-200 overflow-hidden shadow-sm" data-faq={i}>
            <button class="w-full px-6 py-5 text-left flex items-center justify-between gap-4" aria-expanded="false">
              <span class="font-semibold text-slate-900 text-sm sm:text-base">{item.q}</span>
              <span class="faq-icon text-slate-400 text-xl flex-shrink-0 font-light">+</span>
            </button>
            <div class="faq-answer hidden px-6 pb-5">
              <p class="text-slate-500 text-sm leading-relaxed">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[linear-gradient(135deg,#0f172a_0%,#312e81_55%,#0284c7_100%)] py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-4xl font-bold text-white">Commencez votre essai gratuit</h2>
      <p class="text-indigo-200 text-lg mt-4">14 jours offerts. Carte bancaire requise, résiliable pendant l’essai.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a href="/register?next=%2Fabonnement%2Fchoix" class="inline-flex items-center justify-center bg-white text-indigo-700 font-bold px-8 py-4 rounded-xl hover:bg-indigo-50 transition-colors text-base shadow-lg">
          Démarrer l'essai gratuit
        </a>
        <a href="/contact" class="inline-flex items-center justify-center bg-white/10 text-white font-medium px-8 py-4 rounded-xl hover:bg-white/20 border border-white/20 transition-colors text-base">
          Contacter l'équipe
        </a>
      </div>
    </div>
  </section>

  <PublicFooter />
</BaseLayout>

<style>
  .roi-range {
    display: grid;
    gap: 0.45rem;
  }

  .roi-range span {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    color: #0f172a;
    font-size: 0.92rem;
  }

  .roi-range em {
    color: #64748b;
    font-style: normal;
    font-weight: 600;
  }

  .roi-range small {
    color: #64748b;
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .roi-range input {
    accent-color: #2563eb;
  }
</style>

<script>
  const billingButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-billing-mode]'));

  function buttonClass(mode: string | undefined, activeMode: string) {
    const base = 'rounded-xl px-5 py-2 text-sm font-semibold transition-all';
    return mode === activeMode
      ? `${base} bg-slate-950 text-white shadow-sm`
      : `${base} text-slate-500 hover:bg-slate-100`;
  }

  function setMode(mode: string) {
    const isAnnual = mode === 'annual';

    billingButtons.forEach((button) => {
      const buttonMode = button.dataset.billingMode;
      button.className = buttonClass(buttonMode, mode);
      button.setAttribute('aria-pressed', String(buttonMode === mode));
    });

    document.querySelectorAll<HTMLElement>('.price-display').forEach((el) => {
      el.textContent = isAnnual ? (el.dataset.annual ?? '') : (el.dataset.monthly ?? '');
    });

    document.querySelectorAll<HTMLElement>('.price-period').forEach((el) => {
      el.textContent = isAnnual ? (el.dataset.annual ?? '') : (el.dataset.monthly ?? '');
    });

    document.querySelectorAll('.annual-saving').forEach((el) => {
      el.classList.toggle('hidden', !isAnnual);
    });

    document.querySelectorAll('.billing-note').forEach((note) => {
      note.textContent = isAnnual ? 'Renouvellement annuel automatique' : 'Facturation mensuelle';
    });

    document.querySelectorAll('.trial-note').forEach((note) => {
      note.textContent = isAnnual ? '14 jours gratuits · Abonnement annuel' : '14 jours gratuits · Annuler à tout moment';
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-plan-cta]').forEach((link) => {
      const plan = link.dataset.planCta ?? 'starter';
      const setup = link.dataset.setup === '1';
      const next = `/abonnement/choix?plan=${encodeURIComponent(plan)}&billing=${mode}${setup ? '&setup=1' : ''}`;
      link.href = `/register?next=${encodeURIComponent(next)}`;
    });
  }

  billingButtons.forEach((button) => {
    button.addEventListener('click', () => {
      setMode(button.dataset.billingMode === 'monthly' ? 'monthly' : 'annual');
    });
  });
  setMode('monthly');

  const roiButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-roi-plan]'));
  const roiCards = document.getElementById('roi-cards') as HTMLInputElement | null;
  const roiBasket = document.getElementById('roi-basket') as HTMLInputElement | null;
  const roiReturn = document.getElementById('roi-return') as HTMLInputElement | null;
  const roiCardsLabel = document.getElementById('roi-cards-label');
  const roiBasketLabel = document.getElementById('roi-basket-label');
  const roiReturnLabel = document.getElementById('roi-return-label');
  const roiPlanCost = document.getElementById('roi-plan-cost');
  const roiProfit = document.getElementById('roi-profit');
  const roiYearly = document.getElementById('roi-yearly');
  const roiDetailClients = document.getElementById('roi-detail-clients');
  const roiDetailReturn = document.getElementById('roi-detail-return');
  const roiDetailVisits = document.getElementById('roi-detail-visits');
  const roiDetailBasket = document.getElementById('roi-detail-basket');
  const roiDetailRevenue = document.getElementById('roi-detail-revenue');
  const roiRoi = document.getElementById('roi-roi');
  const roiRoiText = document.getElementById('roi-roi-text');
  let selectedRoiPlan = 'pro';

  function euro(value: number) {
    return `${Math.round(value).toLocaleString('fr-FR')}€`;
  }

  function updateRoi() {
    const cards = Number(roiCards?.value ?? 500);
    const basket = Number(roiBasket?.value ?? 25);
    const returnRate = Number(roiReturn?.value ?? 27);
    const activeButton = roiButtons.find((button) => button.dataset.roiPlan === selectedRoiPlan) ?? roiButtons[0];
    const cost = Number(activeButton?.dataset.roiCost ?? 69);
    const planName = activeButton?.querySelector('span')?.textContent?.trim() ?? 'Pro';
    const returnClients = Math.round(cards * returnRate / 100);
    const revenue = returnClients * basket;
    const profit = revenue - cost;
    const roi = cost > 0 ? Math.max(1, Math.round(revenue / cost)) : 0;

    roiButtons.forEach((button) => {
      const active = button.dataset.roiPlan === selectedRoiPlan;
      button.classList.toggle('border-indigo-500', active);
      button.classList.toggle('bg-indigo-50', active);
      button.classList.toggle('shadow-[0_16px_36px_-28px_rgba(79,70,229,0.65)]', active);
    });

    if (roiCardsLabel) roiCardsLabel.textContent = `${cards.toLocaleString('fr-FR')} clients`;
    if (roiBasketLabel) roiBasketLabel.textContent = `${basket.toLocaleString('fr-FR')}€`;
    if (roiReturnLabel) roiReturnLabel.textContent = `${returnRate}%`;
    if (roiProfit) roiProfit.textContent = `${euro(profit)} / mois`;
    if (roiYearly) roiYearly.textContent = `≈ ${euro(profit * 12)} / an`;
    if (roiDetailClients) roiDetailClients.textContent = `${cards.toLocaleString('fr-FR')} clients fidélisés`;
    if (roiDetailReturn) roiDetailReturn.textContent = `${returnRate}% reviennent 1 fois dans le mois`;
    if (roiDetailVisits) roiDetailVisits.textContent = `${returnClients.toLocaleString('fr-FR')} visites supplémentaires`;
    if (roiDetailBasket) roiDetailBasket.textContent = `Panier moyen : ${basket.toLocaleString('fr-FR')}€`;
    if (roiDetailRevenue) roiDetailRevenue.textContent = `CA généré : +${euro(revenue)}`;
    if (roiPlanCost) roiPlanCost.textContent = `Abonnement ${planName} : -${cost}€`;
    if (roiRoi) roiRoi.textContent = `ROI : x${roi}`;
    if (roiRoiText) roiRoiText.textContent = `Pour 1€ investi dans Fidelopass, vous pourriez générer environ ${roi}€ de chiffre d’affaires supplémentaire.`;
  }

  roiButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectedRoiPlan = button.dataset.roiPlan ?? 'pro';
      updateRoi();
    });
  });
  roiCards?.addEventListener('input', updateRoi);
  roiBasket?.addEventListener('input', updateRoi);
  roiReturn?.addEventListener('input', updateRoi);
  updateRoi();

  document.querySelectorAll('#pricing-faq [data-faq]').forEach((item) => {
    const btn = item.querySelector('button');
    const answer = item.querySelector('.faq-answer');
    const icon = item.querySelector('.faq-icon');
    if (!btn || !answer || !icon) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      answer.classList.toggle('hidden', open);
      icon.textContent = open ? '+' : '×';
    });
  });
</script>
