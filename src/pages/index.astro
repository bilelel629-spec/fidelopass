---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicFooter from '../components/marketing/PublicFooter.astro';
import PublicNav from '../components/marketing/PublicNav.astro';
---

<BaseLayout
  theme="light"
  title="Fidelopass — N°1 de la carte de fidélité dématérialisée en France"
  description="N°1 de la carte de fidélité dématérialisée en France, déjà plus de 2 000 commerces. Créez votre carte dans Apple Wallet et Google Wallet en 5 minutes, sans application pour vos clients. Essai gratuit 14 jours."
>
  <PublicNav currentPath="/" />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-[linear-gradient(180deg,#ffffff_0%,#f6f9ff_58%,#ffffff_100%)] pt-4 pb-12 sm:pt-14 sm:pb-20 dark:bg-[linear-gradient(180deg,#020617_0%,#0b1120_58%,#020617_100%)]">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-16 right-0 h-72 w-72 rounded-full bg-sky-200/35 blur-3xl"></div>
      <div class="absolute top-24 left-0 h-64 w-64 rounded-full bg-indigo-200/25 blur-3xl"></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-white dark:to-slate-950"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[1.02fr_0.98fr] gap-7 lg:gap-12 items-center">
      <div class="relative">
        <span class="mb-5 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-indigo-600 to-violet-500 px-4 py-2 text-sm font-extrabold text-white shadow-[0_14px_30px_-12px_rgba(79,70,229,0.7)] ring-1 ring-white/20 sm:px-5 sm:py-2.5 sm:text-base">
          <span class="text-lg sm:text-xl" aria-hidden="true">🇫🇷</span>
          <span>N°1 de la carte de fidélité dématérialisée en France</span>
        </span>
        <h1 class="font-display text-[2.35rem] sm:text-[4.15rem] font-bold text-slate-900 leading-[0.98] tracking-[-0.04em] dark:text-slate-100">
          Transformez vos
          <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">
            clients en habitués.
          </span>
        </h1>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-slate-500 sm:mt-6 sm:text-lg dark:text-slate-300">
          Créez une carte de fidélité directement dans Apple Wallet et Google Wallet.
          Vos clients l'ajoutent en 20 secondes — sans compte, sans téléchargement.
        </p>
        <p class="mt-3 flex items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
          <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-300">
            <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" aria-hidden="true"><path d="M5 10.2 8.1 13.3 15 6.4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
          Déjà plus de <span class="text-indigo-600 dark:text-indigo-300">2 000 commerces</span> nous font confiance.
        </p>

        <!-- Visuel mobile (placé avant le CTA principal) -->
        <div class="relative mt-5 mb-1 flex justify-center lg:hidden">
          <div class="hero-phone-wrap hero-phone-wrap--compact">
            <div class="hero-phone">
              <div class="hero-phone__screen">
                <div class="hero-phone__status"><span>9:41</span><span>Wallet</span></div>
                <div class="hero-wallet-card hero-wallet-card--real" aria-label="Aperçu d'une carte fidélité Fidelopass dans Wallet">
                  <img src="/images/hero/somstar-wallet-card.png" alt="Carte fidélité Somstar dans Apple Wallet" />
                </div>
                <div class="hero-phone__timeline">
                  <span></span>
                  <div>
                    <strong>Ajoutée au Wallet</strong>
                    <small>Prête à scanner en caisse</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="hero-float hero-float--one"><strong>20 sec</strong><span>pour ajouter la carte</span></div>
            <div class="hero-float hero-float--two"><strong>+27%</strong><span>de rétention</span></div>
            <div class="hero-float hero-float--three"><strong>0 app</strong><span>à télécharger</span></div>
          </div>
        </div>

        <div class="mt-5 flex flex-col gap-3 sm:mt-8 sm:flex-row">
          <a href="/register" class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-7 py-3.5 text-base font-semibold text-white shadow-[0_18px_40px_rgba(15,23,42,0.18)] transition-all hover:-translate-y-0.5 hover:bg-slate-900">
            Essai gratuit — 14 jours
          </a>
          <a href="/comment-ca-fonctionne" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-7 py-3.5 text-base font-medium text-slate-700 shadow-sm transition-all hover:border-slate-300 hover:text-slate-900 hover:shadow-md dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-500 dark:hover:text-white">
            Comment ça marche →
          </a>
        </div>

        <p class="mt-3 text-sm text-slate-400 sm:mt-4 dark:text-slate-400">
          Carte bancaire requise pour l’essai · Aucune application pour vos clients · Prêt en 5 minutes
        </p>

        <div class="mt-5 flex flex-wrap gap-x-4 gap-y-3 sm:mt-8 sm:gap-5">
          <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-300">
            <span class="w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 text-xs font-bold">✓</span>
            Apple Wallet natif
          </div>
          <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-300">
            <span class="w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 text-xs font-bold">✓</span>
            Google Wallet natif
          </div>
          <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-300">
            <span class="w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 text-xs font-bold">✓</span>
            +27% de rétention clients
          </div>
        </div>
      </div>

      <!-- Visuel principal (desktop only) -->
      <div class="relative hidden justify-center lg:flex">
        <div class="hero-phone-wrap">
          <div class="hero-phone">
            <div class="hero-phone__screen">
              <div class="hero-phone__status"><span>9:41</span><span>Wallet</span></div>
              <div class="hero-wallet-card hero-wallet-card--real" aria-label="Aperçu d'une carte fidélité Fidelopass dans Wallet">
                <img src="/images/hero/somstar-wallet-card.png" alt="Carte fidélité Somstar dans Apple Wallet" />
              </div>
              <div class="hero-phone__timeline">
                <span></span>
                <div>
                  <strong>Ajoutée au Wallet</strong>
                  <small>Prête à scanner en caisse</small>
                </div>
              </div>
            </div>
          </div>
          <div class="hero-float hero-float--one"><strong>20 sec</strong><span>pour ajouter la carte</span></div>
          <div class="hero-float hero-float--two"><strong>+27%</strong><span>de rétention</span></div>
          <div class="hero-float hero-float--three"><strong>0 app</strong><span>à télécharger</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- BARRE RÉASSURANCE -->
  <div class="bg-white py-3 sm:py-6 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex gap-3 overflow-x-auto pb-2 sm:grid sm:grid-cols-2 sm:overflow-visible sm:pb-0 xl:grid-cols-5">
        {[
          { eyebrow: 'Compatibilité', value: 'Apple Wallet', detail: 'Ajout natif sur iPhone', icon: '/apple-wallet-logo.png' },
          { eyebrow: 'Compatibilité', value: 'Google Wallet', detail: 'Ajout natif sur Android', icon: '/google-wallet-logo.png' },
          { eyebrow: 'Expérience client', value: 'Aucune application', detail: 'Scan, ajout et fidélisation fluide', icon: '/client-experience-icon.svg' },
          { eyebrow: 'Mise en place', value: 'Prêt en 5 minutes', detail: 'QR, carte et scanner inclus', icon: '/setup-watch-icon.svg' },
          { eyebrow: 'Performance', value: '+27% de rétention', detail: 'Moyenne observée sur les cartes Wallet', icon: '/growth-arrow-icon.svg' },
        ].map((item) => (
          <div class="min-w-[15.2rem] rounded-[1.2rem] border border-slate-200 bg-white px-4 py-3.5 shadow-sm sm:min-w-0 sm:rounded-[1.35rem] sm:px-5 sm:py-4 dark:border-slate-700 dark:bg-slate-900">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
              <img src={item.icon} alt={item.value} class="h-10 w-10 object-contain" />
            </div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-400 dark:text-slate-400">{item.eyebrow}</p>
            <p class="mt-2 text-base font-semibold text-slate-900 dark:text-slate-100">{item.value}</p>
            <p class="mt-1 text-sm text-slate-500 leading-relaxed dark:text-slate-300">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- TYPES DE CARTES -->
  <section class="bg-white py-12 sm:py-20 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-9 max-w-3xl sm:mb-12">
        <span class="mb-4 inline-flex items-center rounded-full border border-sky-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-sky-700 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-sky-300">Deux mécaniques simples</span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-slate-900 mt-2 dark:text-slate-100">Choisissez le programme qui colle à votre commerce</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-500 dark:text-slate-300">
          Tampons pour créer un réflexe de retour rapide, points pour récompenser les dépenses et faire monter la valeur client.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <article class="group overflow-hidden rounded-[2rem] border border-slate-200 bg-[linear-gradient(135deg,#ffffff_0%,#ecfeff_100%)] p-5 shadow-[0_22px_55px_rgba(15,23,42,0.08)] transition-all hover:-translate-y-1 hover:shadow-[0_30px_70px_rgba(15,23,42,0.12)] sm:p-7 dark:border-slate-700 dark:bg-slate-900">
          <div class="grid gap-6 md:grid-cols-[0.92fr_1.08fr] md:items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-sky-700">Carte à tampons</p>
              <h3 class="mt-3 font-display text-3xl font-bold tracking-[-0.03em] text-slate-900 dark:text-slate-100">Idéale pour les visites régulières</h3>
              <p class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-300">
                Le client cumule un tampon à chaque passage et débloque une récompense claire, visible directement dans son Wallet.
              </p>
              <div class="mt-5 rounded-2xl border border-slate-200 bg-white/80 p-4 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                Exemple : 10 passages = 1 café, 1 coupe ou 1 plat offert.
              </div>
            </div>
            <div class="rounded-[1.75rem] bg-[#064e3b] p-5 text-white shadow-[0_20px_50px_rgba(6,78,59,0.24)]">
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-lg font-bold">Restaurant</p>
                  <p class="text-xs uppercase tracking-[0.18em] text-emerald-200">Tampons</p>
                </div>
                <p class="text-2xl font-bold">6/10</p>
              </div>
              <div class="mt-6 grid grid-cols-5 gap-3">
                {Array.from({ length: 10 }).map((_, index) => (
                  <span class={`flex aspect-square items-center justify-center rounded-full border ${index < 6 ? 'border-emerald-300 bg-emerald-400 text-amber-300' : 'border-white/35 bg-white/10 text-white/45'}`}>
                    ★
                  </span>
                ))}
              </div>
              <div class="mt-7 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-2xl bg-white/10 p-3">
                  <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-200">Récompense</p>
                  <p class="mt-1 font-semibold">1 plat offert</p>
                </div>
                <div class="rounded-2xl bg-white/10 p-3">
                  <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-200">Statut</p>
                  <p class="mt-1 font-semibold">4 tampons restants</p>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="group overflow-hidden rounded-[2rem] border border-slate-200 bg-[linear-gradient(135deg,#ffffff_0%,#eef2ff_100%)] p-5 shadow-[0_22px_55px_rgba(15,23,42,0.08)] transition-all hover:-translate-y-1 hover:shadow-[0_30px_70px_rgba(15,23,42,0.12)] sm:p-7 dark:border-slate-700 dark:bg-slate-900">
          <div class="grid gap-6 md:grid-cols-[0.92fr_1.08fr] md:items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.22em] text-indigo-700">Carte à points</p>
              <h3 class="mt-3 font-display text-3xl font-bold tracking-[-0.03em] text-slate-900 dark:text-slate-100">Parfaite pour augmenter le panier moyen</h3>
              <p class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-300">
                Le client gagne des points selon ses achats, suit son solde et revient pour atteindre le prochain avantage.
              </p>
              <div class="mt-5 rounded-2xl border border-slate-200 bg-white/80 p-4 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                Exemple : 1€ dépensé = 1 point, puis 150 points = 10€ offerts.
              </div>
            </div>
            <div class="rounded-[1.75rem] bg-[#111827] p-5 text-white shadow-[0_20px_50px_rgba(17,24,39,0.24)]">
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-lg font-bold">Boutique</p>
                  <p class="text-xs uppercase tracking-[0.18em] text-indigo-200">Points</p>
                </div>
                <p class="text-2xl font-bold">128</p>
              </div>
              <div class="mt-6 grid grid-cols-2 gap-3 text-xs text-slate-300">
                <div class="rounded-2xl border border-white/10 bg-white/10 p-3">
                  <span class="block uppercase tracking-[0.18em] text-indigo-200">Solde</span>
                  <span class="mt-1 block text-lg font-bold text-white">128 pts</span>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/10 p-3">
                  <span class="block uppercase tracking-[0.18em] text-indigo-200">Objectif</span>
                  <span class="mt-1 block text-lg font-bold text-white">150 pts</span>
                </div>
              </div>
              <div class="mt-7 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-2xl bg-white/10 p-3">
                  <p class="text-[10px] uppercase tracking-[0.2em] text-indigo-200">Prochain gain</p>
                  <p class="mt-1 font-semibold">10€ offerts</p>
                </div>
                <div class="rounded-2xl bg-white/10 p-3">
                  <p class="text-[10px] uppercase tracking-[0.2em] text-indigo-200">À gagner</p>
                  <p class="mt-1 font-semibold">22 points</p>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SHOWCASE CARTES WALLET -->
  <section class="bg-[linear-gradient(180deg,#f6f9ff_0%,#ffffff_100%)] py-12 sm:py-20 dark:bg-[linear-gradient(180deg,#020617_0%,#0b1120_100%)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center rounded-full border border-sky-200 bg-white px-3.5 py-1.5 text-[0.67rem] font-semibold uppercase tracking-[0.22em] text-sky-700 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-sky-300">Des cartes à votre image</span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-slate-900 mt-3 dark:text-slate-100">Une carte unique pour chaque commerce</h2>
        <p class="text-slate-500 text-base sm:text-lg mt-4 leading-relaxed dark:text-slate-300">
          Couleurs, logo, visuel, récompenses : chaque carte reflète votre identité.
          Restaurant, boucherie, coiffeur, fleuriste, pizzeria, café, sport… elle s'adapte à tous les métiers, dans Apple Wallet et Google Wallet.
        </p>
      </div>
      <div class="mt-8 sm:mt-12 overflow-hidden rounded-[1.75rem] border border-slate-200/70 bg-white shadow-[0_30px_80px_-40px_rgba(15,23,42,0.4)] dark:border-slate-800 dark:bg-slate-900">
        <img
          src="/images/showcase-cartes-wallet.jpeg"
          alt="Exemples de cartes de fidélité Fidelopass personnalisées dans Apple Wallet et Google Wallet : restaurant, boucherie, coiffeur, fleuriste, nail salon, pizzeria, sport, café"
          loading="lazy"
          class="w-full h-auto"
        />
      </div>
    </div>
  </section>

  <!-- EXPÉRIENCE CLIENT -->
  <section class="bg-white py-12 sm:py-20 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center sm:mb-16">
        <span class="mb-4 inline-flex items-center rounded-full border border-sky-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-sky-700 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-sky-300">Expérience fluide</span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-slate-900 mt-2 dark:text-slate-100">Vos clients adorent. Vous ne levez pas le petit doigt.</h2>
        <p class="text-slate-500 text-lg mt-4 max-w-2xl mx-auto dark:text-slate-300">
          Le parcours est pensé pour le comptoir: rapide à comprendre, simple à ajouter, facile à suivre dans le Wallet.
        </p>
      </div>
      <div class="grid gap-5 lg:grid-cols-3 lg:gap-8">
        {[
          {
            num: '01',
            tag: 'Vous configurez',
            title: 'Votre carte est prête en quelques minutes',
            desc: 'Choisissez tampons ou points, ajoutez votre logo, vos couleurs et la récompense. Fidelopass prépare le QR code et la carte Wallet.',
            accent: 'from-sky-500 to-blue-600',
            image: '/images/how-it-works/etape-dashboard-premium.png',
            alt: 'Configuration de carte dans Fidelopass',
          },
          {
            num: '02',
            tag: 'Ils ajoutent',
            title: 'Le client scanne et ajoute sans application',
            desc: 'Un QR code au comptoir suffit. Le client ajoute sa carte dans Apple Wallet ou Google Wallet sans créer de compte compliqué.',
            accent: 'from-violet-500 to-fuchsia-500',
            image: '/images/how-it-works/etape-diffusion-premium.png',
            alt: 'Ajout Wallet depuis un QR code Fidelopass',
          },
          {
            num: '03',
            tag: 'Vous fidélisez',
            title: 'Chaque passage devient mesurable',
            desc: 'Votre équipe scanne, les points se mettent à jour, les récompenses se déclenchent et le dashboard suit l’activité.',
            accent: 'from-emerald-500 to-teal-500',
            image: '/images/how-it-works/etape-activation-premium.png',
            alt: 'Scan Fidelopass en caisse avec carte Wallet',
          },
        ].map((s) => (
          <div class="group overflow-hidden rounded-[1.55rem] border border-slate-200 bg-white shadow-[0_22px_55px_rgba(15,23,42,0.08)] transition-all hover:-translate-y-1 hover:shadow-[0_28px_70px_rgba(15,23,42,0.12)] sm:rounded-[1.75rem] dark:border-slate-700 dark:bg-slate-900">
            <div class={`relative min-h-[13.5rem] overflow-hidden bg-gradient-to-br ${s.accent} p-3`}>
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(255,255,255,0.42),transparent_32%),radial-gradient(circle_at_80%_75%,rgba(255,255,255,0.28),transparent_28%)]"></div>
              <figure class="relative h-[13.5rem] overflow-hidden rounded-[1.25rem] border border-white/60 bg-white/92 shadow-[0_24px_52px_rgba(15,23,42,0.22)]">
                <img src={s.image} alt={s.alt} class="h-full w-full object-cover" loading="lazy" />
              </figure>
            </div>
            <div class="p-6 sm:p-8">
              <div class="flex items-center justify-between gap-4 mb-6">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950 text-sm font-bold text-white shadow-[0_14px_30px_rgba(15,23,42,0.16)]">{s.num}</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">{s.tag}</span>
              </div>
              <h3 class="font-display text-xl font-bold text-slate-900 dark:text-slate-100">{s.title}</h3>
              <p class="text-slate-500 text-sm leading-relaxed mt-3 dark:text-slate-300">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center sm:mt-10">
        <a href="/comment-ca-fonctionne" class="btn-secondary px-6 py-2.5 text-sm">Voir le détail complet →</a>
      </div>
    </div>
  </section>

  <!-- SIMULATEUR -->
  <section class="bg-[linear-gradient(180deg,#ffffff_0%,#f5f9ff_100%)] py-12 sm:py-18 dark:bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="rounded-[2rem] border border-sky-100 bg-white p-5 shadow-[0_24px_70px_-52px_rgba(37,99,235,0.45)] sm:p-7 dark:border-slate-700 dark:bg-slate-900">
        <div class="grid gap-8 lg:grid-cols-[1fr_0.95fr] lg:items-center">
          <div>
            <p class="text-[0.7rem] font-bold uppercase tracking-[0.24em] text-sky-700 dark:text-sky-300">Simulateur de revenus</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl dark:text-white">Combien Fidelopass peut vous rapporter ?</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
              Indiquez votre nombre de clients fidélisés, votre panier moyen et le pourcentage de clients susceptibles de revenir grâce à Fidelopass.
            </p>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              {[
