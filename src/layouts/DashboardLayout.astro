---
import '../styles/global.css';
import DashboardNav from '../components/dashboard/DashboardNav.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Dashboard — Fidelopass', activeNav = '' } = Astro.props;
---

<!doctype html>
<html lang="fr" class="dashboard">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f9ff" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#f5f9ff] text-slate-900 antialiased">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -top-28 right-[-8rem] h-[28rem] w-[28rem] rounded-full bg-cyan-200/45 blur-3xl"></div>
      <div class="absolute top-1/3 left-[-9rem] h-[24rem] w-[24rem] rounded-full bg-blue-100/80 blur-3xl"></div>
      <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white/80 to-transparent"></div>
    </div>
    <div class="flex min-h-screen lg:h-screen overflow-hidden">
      <DashboardNav activeNav={activeNav} />
      <main class="relative z-10 flex-1 min-w-0 overflow-y-auto pb-24 lg:pb-0">
        <div class="p-4 sm:p-6 md:p-8 pt-24 lg:pt-8 max-w-7xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { requireFreshSession, showSessionOverlay } from '../lib/session-guard';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );
  const API = (import.meta.env.PUBLIC_API_URL ?? 'https://api.fidelopass.com').replace(/\/$/, '');

  type SessionLike = { access_token: string };
  type TourStep = {
    path: string;
    selector: string;
    navSelector?: string;
    title: string;
    body: string;
    action: string;
  };

  const TOUR_QUERY_KEY = 'fidelopass_tour_active';
  const TOUR_STEP_KEY = 'fidelopass_tour_step';
  const TOUR_POSTPONED_KEY = 'fidelopass_tour_postponed';

  const TOUR_STEPS: TourStep[] = [
    {
      path: '/dashboard',
      selector: '[data-tour="dashboard-actions"]',
      navSelector: '[data-tour-nav="dashboard"]',
      title: 'Votre poste de pilotage',
      body: 'Cette zone rassemble les actions les plus fréquentes: scanner en caisse, afficher le QR client et relancer vos clients.',
      action: 'Commencez ici quand vous voulez aller vite pendant la journée.',
    },
    {
      path: '/dashboard',
      selector: '[data-tour="dashboard-stats"]',
      title: 'Les chiffres qui comptent',
      body: 'Clients, scans, récompenses et clients joignables vous donnent une lecture rapide de la santé du programme.',
      action: 'Surveillez surtout les scans du jour et les clients joignables Wallet.',
    },
    {
      path: '/dashboard/carte',
      selector: '[data-tour="card-editor-intro"]',
      navSelector: '[data-tour-nav="carte"]',
      title: 'Construire la carte Wallet',
      body: 'La page Ma carte est le centre de création: identité, programme, design, messages et partage.',
      action: 'Avancez étape par étape, puis enregistrez pour garder une carte cohérente.',
    },
    {
      path: '/dashboard/carte',
      selector: '[data-tour="card-program"]',
      title: 'Choisir la mécanique fidélité',
      body: 'Tampons pour une expérience simple en caisse, points pour plus de souplesse et des paliers avancés.',
      action: 'Choisissez le modèle le plus simple pour votre équipe avant de personnaliser le visuel.',
    },
    {
      path: '/dashboard/clients',
      selector: '[data-tour="clients-list"]',
      navSelector: '[data-tour-nav="clients"]',
      title: 'Suivre vos clients fidèles',
      body: 'La base client vous permet de retrouver un membre, consulter son solde et corriger manuellement ses points ou tampons.',
      action: 'Cliquez sur un client pour ouvrir sa fiche et ajuster son solde si besoin.',
    },
    {
      path: '/dashboard/notifications',
      selector: '[data-tour="notifications-compose"]',
      navSelector: '[data-tour-nav="notifications"]',
      title: 'Faire revenir les clients',
      body: 'Les notifications Wallet servent à annoncer une offre, rappeler une récompense ou automatiser des relances.',
      action: 'Gardez vos messages courts, utiles et liés à une vraie raison de revenir.',
    },
    {
      path: '/dashboard/parametres?tab=abonnement',
      selector: '[data-tour="account-billing"]',
      navSelector: '[data-tour-nav="parametres"]',
      title: 'Gérer le compte commerçant',
      body: 'L’espace compte regroupe profil, abonnement, moyens de paiement, scanners et organisation des points de vente.',
      action: 'Revenez ici pour changer de plan, annuler, réactiver ou installer un scanner.',
    },
  ];

  function getVisibleTarget(selector: string): HTMLElement | null {
    if (!selector) return null;
    const nodes = Array.from(document.querySelectorAll<HTMLElement>(selector));
    return nodes.find((node) => node.offsetParent !== null) ?? nodes[0] ?? null;
  }

  async function setTourSeen(accessToken: string, seen: boolean) {
    try {
      await fetch(`${API}/api/dashboard/tour-status`, {
        method: 'PATCH',
        headers: {
          Authorization: `Bearer ${accessToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ seen }),
      });
    } catch {
      // best effort
    }
  }

  function getCurrentPath() {
    return window.location.pathname;
  }

  function getStepFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const raw = params.get('step') ?? window.sessionStorage.getItem(TOUR_STEP_KEY) ?? '0';
    const parsed = Number(raw);
    if (!Number.isFinite(parsed)) return 0;
    return Math.min(Math.max(parsed, 0), TOUR_STEPS.length - 1);
  }

  function isTourForced() {
    const params = new URLSearchParams(window.location.search);
    return params.get('tour') === '1' || window.sessionStorage.getItem(TOUR_QUERY_KEY) === '1';
  }

  function makeTourUrl(stepIndex: number) {
    const step = TOUR_STEPS[stepIndex];
    const url = new URL(step.path, window.location.origin);
    url.searchParams.set('tour', '1');
    url.searchParams.set('step', String(stepIndex));
    return `${url.pathname}${url.search}`;
  }

  function goToTourStep(stepIndex: number) {
    window.sessionStorage.setItem(TOUR_QUERY_KEY, '1');
    window.sessionStorage.removeItem(TOUR_POSTPONED_KEY);
    window.sessionStorage.setItem(TOUR_STEP_KEY, String(stepIndex));
    const stepUrl = makeTourUrl(stepIndex);
    const destination = new URL(stepUrl, window.location.origin);
    if (destination.pathname !== getCurrentPath()) {
      window.location.href = stepUrl;
      return;
    }
    window.history.replaceState({}, '', stepUrl);
  }

  function clearTourUrl() {
    const url = new URL(window.location.href);
    url.searchParams.delete('tour');
    url.searchParams.delete('step');
    window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
  }

  function startDashboardTour(accessToken: string, startIndex = 0) {
    const style = document.createElement('style');
    style.textContent = `
      .dashboard-tour-highlight {
        position: relative;
        z-index: 86 !important;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.75), 0 0 0 9999px rgba(15, 23, 42, 0.42), 0 20px 55px -30px rgba(8, 47, 73, 0.6);
        border-radius: 1rem;
      }
      .dashboard-tour-card {
        max-height: min(72vh, 560px);
        overflow: auto;
      }
      @media (max-width: 640px) {
        .dashboard-tour-card {
          left: 1rem !important;
          right: 1rem !important;
          top: auto !important;
          bottom: calc(env(safe-area-inset-bottom) + 1rem) !important;
          width: auto !important;
          transform: none !important;
        }
      }
    `;
    document.head.appendChild(style);

    const overlay = document.createElement('div');
    overlay.className = 'fixed inset-0 z-[75] pointer-events-none';

    const card = document.createElement('div');
    card.className = 'dashboard-tour-card pointer-events-auto fixed z-[90] w-[min(92vw,430px)] rounded-2xl border border-sky-100 bg-white p-5 shadow-2xl shadow-slate-950/20';
    overlay.appendChild(card);
    document.body.appendChild(overlay);

    let index = startIndex;
    let activeTarget: HTMLElement | null = null;

    const cleanupTarget = () => {
      if (!activeTarget) return;
      activeTarget.classList.remove('dashboard-tour-highlight');
      activeTarget = null;
    };

    const finish = async () => {
      cleanupTarget();
      overlay.remove();
      style.remove();
      window.sessionStorage.removeItem(TOUR_QUERY_KEY);
      window.sessionStorage.removeItem(TOUR_STEP_KEY);
      window.sessionStorage.removeItem(TOUR_POSTPONED_KEY);
      clearTourUrl();
      await setTourSeen(accessToken, true);
    };

    const postpone = async () => {
      cleanupTarget();
      overlay.remove();
      style.remove();
      window.sessionStorage.removeItem(TOUR_QUERY_KEY);
      window.sessionStorage.removeItem(TOUR_STEP_KEY);
      window.sessionStorage.setItem(TOUR_POSTPONED_KEY, '1');
      clearTourUrl();
      await setTourSeen(accessToken, false);
    };

    const positionCard = (target: HTMLElement | null) => {
      const margin = 18;
      const viewportW = window.innerWidth;
      const viewportH = window.innerHeight;
      const cardW = Math.min(430, viewportW - 32);

      if (!target || viewportW < 640) {
        card.style.left = '';
        card.style.right = '';
        card.style.top = '';
        card.style.bottom = '';
        card.style.width = '';
        card.style.transform = '';
        return;
      }

      const rect = target.getBoundingClientRect();
      const preferRight = rect.left + rect.width + cardW + margin < viewportW;
      const preferLeft = rect.left - cardW - margin > 0;
      const top = Math.min(Math.max(rect.top, margin), viewportH - 260);

      card.style.width = `${cardW}px`;
      card.style.top = `${top}px`;
      card.style.bottom = 'auto';
      card.style.transform = 'none';

      if (preferRight) {
        card.style.left = `${rect.right + margin}px`;
        card.style.right = 'auto';
      } else if (preferLeft) {
        card.style.left = `${rect.left - cardW - margin}px`;
        card.style.right = 'auto';
      } else {
        card.style.left = '50%';
        card.style.right = 'auto';
        card.style.transform = 'translateX(-50%)';
        card.style.top = `${Math.min(rect.bottom + margin, viewportH - 260)}px`;
      }
    };

    const render = () => {
      const step = TOUR_STEPS[index];
      if (getCurrentPath() !== new URL(step.path, window.location.origin).pathname) {
        goToTourStep(index);
        return;
      }

      cleanupTarget();
      activeTarget = getVisibleTarget(step.selector) ?? getVisibleTarget(step.navSelector ?? '');
      activeTarget?.classList.add('dashboard-tour-highlight');
      activeTarget?.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
      window.setTimeout(() => positionCard(activeTarget), 180);

      card.innerHTML = `
        <div class="mb-3 flex items-center justify-between gap-3">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-sky-700/75">Guide FideloPass (${index + 1}/${TOUR_STEPS.length})</p>
          <button type="button" id="tour-skip" class="rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
            Plus tard
          </button>
        </div>
        <h3 class="text-lg font-display font-bold text-slate-900">${step.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">${step.body}</p>
        <div class="mt-3 rounded-xl border border-sky-100 bg-sky-50 px-3 py-2 text-sm font-medium text-sky-900">
          ${step.action}
        </div>
        <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full bg-sky-600 transition-all" style="width:${((index + 1) / TOUR_STEPS.length) * 100}%"></div>
        </div>
        <div class="mt-4 grid grid-cols-[auto_1fr_auto] items-center gap-2">
          <button type="button" id="tour-prev" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 ${index === 0 ? 'opacity-40 cursor-not-allowed' : ''}" ${index === 0 ? 'disabled' : ''}>
            Précédent
          </button>
          <a id="tour-open-page" href="${step.path}" class="text-center text-xs font-semibold text-sky-700 hover:text-sky-800">
            Explorer cette page
          </a>
          <button type="button" id="tour-next" class="rounded-xl bg-sky-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-sky-700">
            ${index === TOUR_STEPS.length - 1 ? 'Terminer' : 'Suivant'}
          </button>
        </div>
      `;

      const nextBtn = card.querySelector<HTMLButtonElement>('#tour-next');
      const prevBtn = card.querySelector<HTMLButtonElement>('#tour-prev');
      const skipBtn = card.querySelector<HTMLButtonElement>('#tour-skip');
      nextBtn?.addEventListener('click', async () => {
        if (index >= TOUR_STEPS.length - 1) {
          await finish();
          return;
        }
        index += 1;
        goToTourStep(index);
        render();
      });
      prevBtn?.addEventListener('click', () => {
        if (index <= 0) return;
        index -= 1;
        goToTourStep(index);
        render();
      });
      skipBtn?.addEventListener('click', postpone);
    };

    goToTourStep(index);
    render();
  }

  async function maybeShowTour(session: SessionLike) {
    try {
      const res = await fetch(`${API}/api/dashboard/tour-status`, {
        headers: {
          Authorization: `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
        },
      });
      if (!res.ok) return;
      const payload = await res.json().catch(() => null);
      if (window.sessionStorage.getItem(TOUR_POSTPONED_KEY) === '1' && !isTourForced()) return;
      if (payload?.data?.seen && !isTourForced()) return;
      startDashboardTour(session.access_token, isTourForced() ? getStepFromUrl() : 0);
    } catch {
      // ignore
    }
  }

  async function initDashboardGuard() {
    const overlay = showSessionOverlay('Vérification de la session...', 'Un instant, nous gardons votre espace commerçant prêt.');
    const session = await requireFreshSession(supabase, { overlay });
    if (!session) {
      return;
    }

    const billing = await fetch(`${API}/api/billing/status`, {
      headers: {
        Authorization: `Bearer ${session.access_token}`,
        'Content-Type': 'application/json',
      },
    }).then(async (r) => ({ ok: r.ok, status: r.status, payload: await r.json().catch(() => ({})) })).catch(() => null);

    if (!billing) {
      overlay.setText('Connexion instable', 'Impossible de vérifier votre accès pour le moment.');
      window.setTimeout(() => window.location.reload(), 1200);
      return;
    }

    if (billing.status === 401) {
      const refreshed = await requireFreshSession(supabase, { overlay });
      if (!refreshed) return;
      window.location.reload();
      return;
    }

    if (!billing.payload?.data?.has_access) {
      window.location.replace('/abonnement/choix');
      return;
    }
    if (!billing.payload?.data?.onboarding_completed) {
      window.location.replace('/onboarding');
      return;
    }

    overlay.remove();
    maybeShowTour(session as SessionLike);
  }

  initDashboardGuard();
</script>
