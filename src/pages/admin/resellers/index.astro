---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Revendeurs — Admin Fidelopass" activeNav="resellers">
  <section class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-red-600/75">Administration</p>
        <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-slate-950">Revendeurs</h1>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
          Approbation manuelle, suivi financier, type de revendeur et configuration des parts Fidelopass.
        </p>
      </div>
      <button id="create-open-button" class="inline-flex w-fit items-center rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-500 px-5 py-3 text-sm font-semibold text-white shadow-[0_20px_36px_-24px_rgba(37,99,235,0.8)] transition hover:-translate-y-0.5">
        Ajouter un revendeur
      </button>
    </div>

    <form id="create-form" class="hidden rounded-[1.7rem] border border-sky-100 bg-white/90 p-6 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
      <div class="grid gap-4 md:grid-cols-3">
        <label class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Email utilisateur</span>
          <input name="email" type="email" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" />
        </label>
        <label class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Type</span>
          <select name="type" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
            <option value="stripe_connect">Stripe Connect</option>
            <option value="invoiced">Facturé</option>
          </select>
        </label>
        <label class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Pays</span>
          <input name="country" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" placeholder="FR, DZ..." />
        </label>
        <label class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Devise</span>
          <input name="currency" maxlength="3" value="eur" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" />
        </label>
        <label class="space-y-2 md:col-span-2">
          <span class="text-sm font-semibold text-slate-700">Nom commercial</span>
          <input name="brand_name" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" placeholder="Revendeur Fidelopass" />
        </label>
      </div>
      <button class="mt-5 rounded-2xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Créer</button>
      <p id="create-feedback" class="mt-3 text-sm text-slate-500"></p>
    </form>

    <section class="rounded-[1.7rem] border border-sky-100 bg-white/90 p-4 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="text-[0.68rem] uppercase tracking-[0.2em] text-slate-500">
            <tr>
              <th class="px-4 py-3">Nom</th>
              <th class="px-4 py-3">Pays</th>
              <th class="px-4 py-3">Type</th>
              <th class="px-4 py-3">Statut</th>
              <th class="px-4 py-3">Commerçants</th>
              <th class="px-4 py-3">CA total</th>
              <th class="px-4 py-3">Part Fidelopass</th>
              <th class="px-4 py-3">Revendeur</th>
              <th class="px-4 py-3">Action</th>
            </tr>
          </thead>
          <tbody id="reseller-rows" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </section>
  </section>
</AdminLayout>

<script>
  import { authFetch } from '../../../lib/api';

  const formatMoney = (cents: unknown, currency = 'eur') => new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: String(currency || 'eur').toUpperCase(),
    maximumFractionDigits: 0,
  }).format(Number(cents ?? 0) / 100);

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function statusBadge(status: string) {
    const normalized = String(status ?? 'pending').toLowerCase();
    const color = normalized === 'approved'
      ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
      : normalized === 'suspended'
        ? 'bg-red-50 text-red-700 border-red-200'
        : 'bg-amber-50 text-amber-700 border-amber-200';
    return `<span class="rounded-full border ${color} px-3 py-1 text-xs font-semibold">${escapeHtml(normalized)}</span>`;
  }

  async function action(id: string, endpoint: string, body: any = {}) {
    const res = await authFetch(`/api/admin/resellers/${id}/${endpoint}`, { method: 'POST', body: JSON.stringify(body) });
    if (!res.ok) alert((await res.json().catch(() => null))?.error ?? 'Action impossible.');
    await loadResellers();
  }

  async function loadResellers() {
    const res = await authFetch('/api/admin/resellers');
    const payload = await res.json().catch(() => null);
    const rows = document.getElementById('reseller-rows')!;
    const resellers = Array.isArray(payload?.data) ? payload.data : [];
    if (!res.ok || !resellers.length) {
      rows.innerHTML = `<tr><td colspan="9" class="px-4 py-8 text-center text-slate-500">${res.ok ? 'Aucun revendeur.' : escapeHtml(payload?.error ?? 'Chargement impossible.')}</td></tr>`;
      return;
    }
    rows.innerHTML = resellers.map((reseller: any) => `
      <tr class="align-top">
        <td class="px-4 py-4">
          <p class="font-semibold text-slate-950">${escapeHtml(reseller.brand_name)}</p>
          <p class="text-xs text-slate-500">${escapeHtml(reseller.support_email ?? '')}</p>
        </td>
        <td class="px-4 py-4">${escapeHtml(reseller.country ?? '-')}</td>
        <td class="px-4 py-4">${escapeHtml(reseller.type)}</td>
        <td class="px-4 py-4">${statusBadge(reseller.status)}</td>
        <td class="px-4 py-4">${reseller.metrics?.active_merchants_count ?? 0}/${reseller.metrics?.merchants_count ?? 0}</td>
        <td class="px-4 py-4">${formatMoney(reseller.metrics?.total_revenue_cents, reseller.currency)}</td>
        <td class="px-4 py-4">${formatMoney(reseller.metrics?.platform_revenue_cents, reseller.currency)}</td>
        <td class="px-4 py-4">${formatMoney(reseller.metrics?.reseller_revenue_cents, reseller.currency)}</td>
        <td class="px-4 py-4">
          <div class="flex flex-wrap gap-2">
            <a href="/admin/resellers/${reseller.id}" class="rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-800">Détails</a>
            <button data-action="approve" data-id="${reseller.id}" class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800">Approuver</button>
            <button data-action="suspend" data-id="${reseller.id}" class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">Suspendre</button>
          </div>
        </td>
      </tr>
    `).join('');
    rows.querySelectorAll('[data-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const btn = button as HTMLButtonElement;
        action(btn.dataset.id!, btn.dataset.action === 'approve' ? 'approve' : 'suspend', {});
      });
    });
  }

  document.getElementById('create-open-button')?.addEventListener('click', () => {
    document.getElementById('create-form')?.classList.toggle('hidden');
  });

  document.getElementById('create-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(event.currentTarget as HTMLFormElement);
    const payload = Object.fromEntries(formData.entries());
    for (const key of Object.keys(payload)) {
      if (typeof payload[key] === 'string' && payload[key].trim() === '') {
        delete payload[key];
      }
    }
    const res = await authFetch('/api/admin/resellers', { method: 'POST', body: JSON.stringify(payload) });
    const result = await res.json().catch(() => null);
    document.getElementById('create-feedback')!.textContent = res.ok ? 'Revendeur créé.' : result?.error ?? 'Création impossible.';
    if (res.ok) await loadResellers();
  });

  await loadResellers();
</script>
