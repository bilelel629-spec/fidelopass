    title: 'Salons de coiffure & Esthétique',
    description: 'Fidélisez votre clientèle et remplissez vos créneaux plus facilement.',
    reward: 'Ex. : 1 soin offert après 5 visites',
    image: 'https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=900&q=80',
    imageAlt: 'Salon de coiffure lumineux',
    tone: 'from-emerald-500 to-teal-400 text-emerald-700 bg-emerald-50 border-emerald-100',
    iconPaths: ['M4 7l16 10', 'M4 17L20 7', 'M7 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0', 'M7 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0'],
  },
  {
    title: 'Beauté & Nail Art',
    description: 'Récompensez vos clientes et augmentez la fréquence de leurs visites.',
    reward: 'Ex. : 1 nail art offert après 4 prestations',
    image: 'https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=900&q=80',
    imageAlt: 'Manucure et nail art',
    tone: 'from-pink-500 to-rose-400 text-pink-700 bg-pink-50 border-pink-100',
    iconPaths: ['M8 20h8', 'M9 20l1-12a2 2 0 0 1 4 0l1 12', 'M10 8h4', 'M12 3v3'],
  },
  {
    title: 'Salles de sport & Bien-être',
    description: 'Motivez vos membres et valorisez leur engagement dans la durée.',
    reward: 'Ex. : séance offerte après 10 visites',
    image: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=900&q=80',
    imageAlt: 'Salle de sport équipée',
    tone: 'from-amber-400 to-orange-500 text-orange-700 bg-orange-50 border-orange-100',
    iconPaths: ['M4 12h16', 'M6 9v6', 'M18 9v6', 'M8 10v4', 'M16 10v4'],
  },
  {
