---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicFooter from '../components/marketing/PublicFooter.astro';
import PublicNav from '../components/marketing/PublicNav.astro';

type UseCase = {
  title: string;
  description: string;
  reward: string;
  image: string;
  imageAlt: string;
  tone: string;
  iconPaths: string[];
};

const useCases: UseCase[] = [
  {
    title: 'Cafés & Restaurants',
    description: 'Récompensez vos clients fidèles, encouragez les visites régulières et augmentez votre fréquentation.',
    reward: 'Ex. : 1 café offert après 9 achats',
    image: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=80',
    imageAlt: 'Restaurant chaleureux avec tables dressées',
    tone: 'from-violet-500 to-blue-500 text-violet-700 bg-violet-50 border-violet-100',
    iconPaths: ['M6 8h11a4 4 0 0 1 0 8h-1', 'M6 8v7a5 5 0 0 0 10 0V8', 'M4 20h14'],
  },
  {
    title: 'Commerces & Boutiques',
    description: 'Fidélisez vos clients, boostez vos ventes et créez une relation durable après chaque passage.',
    reward: 'Ex. : remise spéciale après 5 achats',
    image: 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=900&q=80',
    imageAlt: 'Boutique moderne avec vêtements en rayon',
    tone: 'from-blue-500 to-sky-500 text-blue-700 bg-blue-50 border-blue-100',
