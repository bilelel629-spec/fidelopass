---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicNav from '../../components/marketing/PublicNav.astro';
import PublicFooter from '../../components/marketing/PublicFooter.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) => d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
const readingTime = Math.max(1, Math.round((post.body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));
const ogImage = post.data.image ?? '/images/og-fidelopass.jpg';

const categoryStyle = (cat: string): string => {
  const map: Record<string, string> = {
    Guide: 'border-indigo-200 bg-indigo-50 text-indigo-700',
    Produit: 'border-sky-200 bg-sky-50 text-sky-700',
    Comparatif: 'border-violet-200 bg-violet-50 text-violet-700',
    'Stratégie': 'border-emerald-200 bg-emerald-50 text-emerald-700',
  };
  return map[cat] ?? 'border-slate-200 bg-slate-50 text-slate-600';
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  image: new URL(ogImage, 'https://www.fidelopass.com').href,
  author: { '@type': 'Organization', name: 'Fidelopass' },
  publisher: {
    '@type': 'Organization',
    name: 'Fidelopass',
    logo: { '@type': 'ImageObject', url: 'https://www.fidelopass.com/logo-premium.png' },
  },
  mainEntityOfPage: `https://www.fidelopass.com/blog/${post.id}`,
};
---

<BaseLayout
  theme="light"
  title={`${post.data.title} — Fidelopass`}
  description={post.data.description}
  image={ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <PublicNav currentPath="/blog" />

  <article class="bg-white">
    <header class="relative overflow-hidden bg-[linear-gradient(180deg,#ffffff_0%,#f3f7ff_100%)] pt-8 pb-7 sm:pt-14 sm:pb-12">
      <div class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 h-60 w-[36rem] rounded-full bg-[radial-gradient(closest-side,rgba(79,70,229,0.09),transparent)]"></div>
      <div class="relative max-w-3xl mx-auto px-4 sm:px-6">
        <nav class="text-xs text-slate-400 mb-5">
          <a href="/" class="hover:text-slate-600">Accueil</a>
          <span class="mx-1">/</span>
          <a href="/blog" class="hover:text-slate-600">Blog</a>
        </nav>
        <span class={`inline-flex rounded-full border px-3 py-1 text-[0.66rem] font-bold uppercase tracking-[0.14em] ${categoryStyle(post.data.category)}`}>{post.data.category}</span>
        <h1 class="mt-4 font-display text-3xl sm:text-[2.7rem] font-bold text-slate-900 leading-[1.08] tracking-[-0.02em]">{post.data.title}</h1>
        <p class="mt-4 text-lg text-slate-500 leading-relaxed">{post.data.description}</p>
        <div class="mt-6 flex items-center gap-3 text-xs font-semibold text-slate-400">
          <span class="inline-flex items-center gap-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[linear-gradient(135deg,#4f46e5,#0ea5e9)] text-[0.6rem] font-bold text-white">F</span>
            Fidelopass
          </span>
          <span class="h-1 w-1 rounded-full bg-slate-300"></span>
          <span>{dateFmt(post.data.pubDate)}</span>
          <span class="h-1 w-1 rounded-full bg-slate-300"></span>
          <span>{readingTime} min de lecture</span>
        </div>
      </div>
    </header>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <div class="article-prose">
        <Content />
      </div>

      <!-- Encart CTA premium -->
      <div class="mt-14 overflow-hidden rounded-[1.9rem] bg-[linear-gradient(135deg,#0f172a_0%,#312e81_55%,#0284c7_100%)] p-8 sm:p-10 text-center text-white shadow-[0_30px_70px_-40px_rgba(49,46,129,0.8)]">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/12 px-3 py-1 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-white/90 backdrop-blur">
          ★ La fidélité des commerces exigeants
        </span>
        <h2 class="mt-4 font-display text-2xl sm:text-3xl font-bold leading-tight">Passez à une fidélité qui vous ressemble.</h2>
        <p class="mt-3 text-indigo-100 max-w-xl mx-auto leading-relaxed">
          Une carte premium dans Apple Wallet &amp; Google Wallet, prête en 5 minutes, sans application pour vos clients.
        </p>
        <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/register" class="inline-flex items-center justify-center rounded-xl bg-white px-7 py-3.5 text-sm font-bold text-indigo-700 shadow-lg hover:bg-indigo-50 hover:-translate-y-0.5 transition">Démarrer l'essai gratuit</a>
          <a href="/pricing" class="inline-flex items-center justify-center rounded-xl border border-white/25 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white hover:bg-white/20 transition">Voir les tarifs</a>
        </div>
        <p class="mt-5 text-xs text-indigo-200/80">14 jours offerts · Sans engagement · Sans carte bancaire pour essayer</p>
      </div>

      <div class="mt-10 text-center">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:gap-3 transition-all">
          <span aria-hidden="true">←</span> Tous les articles
        </a>
      </div>
    </div>
  </article>

  <PublicFooter />
</BaseLayout>

<style is:global>
  .article-prose { color: #334155; font-size: 1.07rem; line-height: 1.82; }
  .article-prose > * + * { margin-top: 1.15rem; }
  .article-prose h2 { font-family: var(--font-display), system-ui, sans-serif; font-size: 1.7rem; font-weight: 700; color: #0f172a; margin-top: 2.6rem; margin-bottom: 0.4rem; letter-spacing: -0.02em; scroll-margin-top: 5rem; }
  .article-prose h2::before { content: ""; display: block; width: 2.4rem; height: 3px; border-radius: 999px; background: linear-gradient(90deg,#4f46e5,#0ea5e9); margin-bottom: 0.85rem; }
  .article-prose h3 { font-size: 1.28rem; font-weight: 700; color: #1e293b; margin-top: 1.9rem; margin-bottom: 0.2rem; }
  .article-prose p { margin-top: 1.1rem; }
  .article-prose a { color: #4f46e5; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; text-decoration-color: #c7d2fe; transition: color .15s; }
  .article-prose a:hover { color: #4338ca; text-decoration-color: #4338ca; }
  .article-prose ul, .article-prose ol { margin-top: 1.1rem; padding-left: 1.35rem; }
  .article-prose ul { list-style: disc; }
  .article-prose ol { list-style: decimal; }
  .article-prose li { margin-top: 0.5rem; }
  .article-prose li::marker { color: #6366f1; }
  .article-prose strong { color: #0f172a; font-weight: 700; }
  .article-prose blockquote { border-left: 4px solid #818cf8; background: #f5f7ff; padding: 1rem 1.3rem; border-radius: 0.7rem; color: #475569; font-style: italic; }
  .article-prose table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; font-size: 0.95rem; border-radius: 0.8rem; overflow: hidden; box-shadow: 0 1px 0 #e2e8f0; }
  .article-prose th, .article-prose td { border: 1px solid #e8edf5; padding: 0.7rem 0.9rem; text-align: left; }
  .article-prose th { background: #f1f5ff; font-weight: 700; color: #0f172a; }
  .article-prose tbody tr:nth-child(even) { background: #fbfcfe; }
  .article-prose img { border-radius: 1rem; margin-top: 1.6rem; }
  .article-prose hr { border: none; border-top: 1px solid #e2e8f0; margin: 2.4rem 0; }
</style>
