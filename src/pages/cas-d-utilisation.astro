  },
  {
    title: 'Événements & Loisirs',
    description: 'Fidélisez votre public et boostez la participation à vos événements.',
    reward: 'Ex. : 1 place offerte après 5 événements',
    image: 'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=900&q=80',
    imageAlt: 'Concert et public en soirée',
    tone: 'from-rose-500 to-pink-500 text-rose-700 bg-rose-50 border-rose-100',
    iconPaths: ['M5 9h14v4a2 2 0 0 0 0 4v2H5v-2a2 2 0 0 0 0-4V9Z', 'M9 9v10', 'M15 9v10'],
  },
];
---

<BaseLayout
  theme="light"
  title="Cas d'utilisation — Fidelopass"
  description="Découvrez les secteurs où Fidelopass peut être utilisé pour fidéliser les clients avec des cartes Wallet, des points, des tampons et des récompenses simples."
>
  <PublicNav currentPath="/cas-d-utilisation" />

  <main class="overflow-hidden bg-[radial-gradient(circle_at_top,#eef6ff_0%,#ffffff_36%,#f8fbff_100%)]">
    <section class="px-4 pb-10 pt-14 sm:px-6 lg:pb-12">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="font-display text-5xl font-bold leading-tight text-slate-950 sm:text-6xl lg:text-7xl">
          Cas d’utilisation
        </h1>
        <p class="mt-4 text-xl font-bold text-blue-600 sm:text-2xl">
          Une solution polyvalente adaptée à tous les secteurs
        </p>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          Fidelopass s’adapte à votre activité et vous aide à fidéliser vos clients, quel que soit votre domaine.
        </p>
      </div>
    </section>

    <section class="px-4 pb-8 sm:px-6 lg:pb-10">
      <div class="mx-auto grid max-w-[92rem] grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {useCases.map((item) => (
          <article class="group overflow-hidden rounded-[1.35rem] border border-slate-200/80 bg-white shadow-[0_20px_50px_-34px_rgba(15,23,42,0.42)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-34px_rgba(37,99,235,0.48)]">
            <div class="relative h-36 overflow-hidden sm:h-40">
              <img
                src={item.image}
                alt={item.imageAlt}
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/15 to-transparent"></div>
            </div>

            <div class="relative px-5 pb-5 pt-8 text-center">
              <div class={`absolute left-1/2 top-0 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-gradient-to-br ${item.tone.split(' ').slice(0, 2).join(' ')} text-white shadow-lg ring-4 ring-white`}>
                <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {item.iconPaths.map((path) => <path d={path}></path>)}
                </svg>
              </div>
              <h2 class="text-base font-extrabold text-slate-950">
                {item.title}
              </h2>
              <p class="mt-3 min-h-[4.5rem] text-sm leading-6 text-slate-600">
                {item.description}
              </p>
              <p class={`mt-3 rounded-full border px-3 py-2 text-xs font-bold ${item.tone.split(' ').slice(2).join(' ')}`}>
                {item.reward}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="px-4 pb-16 pt-2 sm:px-6 lg:pb-20">
      <div class="mx-auto flex max-w-[92rem] flex-col gap-5 rounded-[1.5rem] border border-blue-100 bg-white/85 p-5 shadow-[0_24px_70px_-44px_rgba(37,99,235,0.55)] backdrop-blur sm:flex-row sm:items-center sm:justify-between sm:p-6 lg:px-8">
        <div class="flex items-start gap-4">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-sky-400 text-white shadow-[0_18px_36px_-22px_rgba(37,99,235,0.9)]">
            <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3Z"></path>
              <path d="M7 9h10"></path>
              <path d="M8 14h4"></path>
              <path d="M17 14l1 1 2-3"></path>
            </svg>
          </div>
          <div>
            <h2 class="font-display text-2xl font-bold text-slate-950 lg:text-3xl">
              Quel que soit votre domaine, Fidelopass vous accompagne.
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 sm:text-base">
              Une solution simple, efficace et adaptée à votre activité pour fidéliser vos clients au quotidien.
            </p>
          </div>
        </div>
        <a href="/contact" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-[0_18px_34px_-22px_rgba(37,99,235,0.9)] transition hover:bg-blue-700">
          Demander une démonstration
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <PublicFooter />
</BaseLayout>
