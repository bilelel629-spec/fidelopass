<script>
  document.querySelectorAll('#faq-list [data-faq]').forEach((item) => {
    const btn = item.querySelector('button');
    const answer = item.querySelector('.faq-answer');
    const icon = item.querySelector('.faq-icon');
    if (!btn || !answer || !icon) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      answer.classList.toggle('hidden', open);
      icon.textContent = open ? '+' : '×';
    });
  });

  const homeRoiButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-home-roi-plan]'));
  const homeRoiCards = document.getElementById('home-roi-cards') as HTMLInputElement | null;
  const homeRoiBasket = document.getElementById('home-roi-basket') as HTMLInputElement | null;
  const homeRoiReturn = document.getElementById('home-roi-return') as HTMLInputElement | null;
  const homeRoiCardsLabel = document.getElementById('home-roi-cards-label');
  const homeRoiBasketLabel = document.getElementById('home-roi-basket-label');
  const homeRoiReturnLabel = document.getElementById('home-roi-return-label');
  const homeRoiPlanCost = document.getElementById('home-roi-plan-cost');
  const homeRoiProfit = document.getElementById('home-roi-profit');
  const homeRoiYearly = document.getElementById('home-roi-yearly');
  const homeRoiDetailClients = document.getElementById('home-roi-detail-clients');
  const homeRoiDetailReturn = document.getElementById('home-roi-detail-return');
  const homeRoiDetailVisits = document.getElementById('home-roi-detail-visits');
  const homeRoiDetailBasket = document.getElementById('home-roi-detail-basket');
  const homeRoiDetailRevenue = document.getElementById('home-roi-detail-revenue');
  const homeRoiRoi = document.getElementById('home-roi-roi');
  const homeRoiRoiText = document.getElementById('home-roi-roi-text');
  let selectedHomeRoiPlan = 'pro';

  function homeEuro(value: number) {
    return `${Math.round(value).toLocaleString('fr-FR')}€`;
  }

  function updateHomeRoi() {
    if (!homeRoiButtons.length) return;
    const cards = Number(homeRoiCards?.value ?? 500);
    const basket = Number(homeRoiBasket?.value ?? 25);
    const returnRate = Number(homeRoiReturn?.value ?? 27);
    const activeButton = homeRoiButtons.find((button) => button.dataset.homeRoiPlan === selectedHomeRoiPlan) ?? homeRoiButtons[0];
    const cost = Number(activeButton?.dataset.homeRoiCost ?? 69);
    const planName = activeButton?.querySelector('span')?.textContent?.trim() ?? 'Pro';
    const returnClients = Math.round(cards * returnRate / 100);
    const revenue = returnClients * basket;
    const profit = revenue - cost;
    const roi = cost > 0 ? Math.max(1, Math.round(revenue / cost)) : 0;

    homeRoiButtons.forEach((button) => {
      const active = button.dataset.homeRoiPlan === selectedHomeRoiPlan;
      button.classList.toggle('border-indigo-500', active);
      button.classList.toggle('bg-indigo-50', active);
      button.classList.toggle('shadow-[0_16px_36px_-28px_rgba(79,70,229,0.65)]', active);
    });

    if (homeRoiCardsLabel) homeRoiCardsLabel.textContent = `${cards.toLocaleString('fr-FR')} clients`;
    if (homeRoiBasketLabel) homeRoiBasketLabel.textContent = `${basket.toLocaleString('fr-FR')}€`;
    if (homeRoiReturnLabel) homeRoiReturnLabel.textContent = `${returnRate}%`;
    if (homeRoiProfit) homeRoiProfit.textContent = `${homeEuro(profit)} / mois`;
    if (homeRoiYearly) homeRoiYearly.textContent = `≈ ${homeEuro(profit * 12)} / an`;
    if (homeRoiDetailClients) homeRoiDetailClients.textContent = `${cards.toLocaleString('fr-FR')} clients fidélisés`;
    if (homeRoiDetailReturn) homeRoiDetailReturn.textContent = `${returnRate}% reviennent 1 fois dans le mois`;
    if (homeRoiDetailVisits) homeRoiDetailVisits.textContent = `${returnClients.toLocaleString('fr-FR')} visites supplémentaires`;
    if (homeRoiDetailBasket) homeRoiDetailBasket.textContent = `Panier moyen : ${basket.toLocaleString('fr-FR')}€`;
    if (homeRoiDetailRevenue) homeRoiDetailRevenue.textContent = `CA généré : +${homeEuro(revenue)}`;
    if (homeRoiPlanCost) homeRoiPlanCost.textContent = `Abonnement ${planName} : -${cost}€`;
    if (homeRoiRoi) homeRoiRoi.textContent = `ROI : x${roi}`;
    if (homeRoiRoiText) homeRoiRoiText.textContent = `Pour 1€ investi dans Fidelopass, vous pourriez générer environ ${roi}€ de chiffre d’affaires supplémentaire.`;
  }

  homeRoiButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectedHomeRoiPlan = button.dataset.homeRoiPlan ?? 'pro';
      updateHomeRoi();
    });
  });
  homeRoiCards?.addEventListener('input', updateHomeRoi);
  homeRoiBasket?.addEventListener('input', updateHomeRoi);
  homeRoiReturn?.addEventListener('input', updateHomeRoi);
  updateHomeRoi();
</script>
