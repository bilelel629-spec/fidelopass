</style>

<script define:vars={{ apiBase, carteId: id }}>
  const API = apiBase;
  const qrBase = 'https://api.qrserver.com/v1/create-qr-code/';
  const templatePresets = {
    restaurant: { primary: '#082f25', secondary: '#c8a45d', image: '/banner-templates/restaurant.png', title: 'SCANNEZ & PROFITEZ' },
    moderne: { primary: '#0f172a', secondary: '#38bdf8', image: '/banner-templates/template-13.png', title: 'SCANNEZ & PROFITEZ' },
    elegant: { primary: '#111827', secondary: '#a78bfa', image: '/banner-templates/template-10.png', title: 'VOTRE CARTE FIDÉLITÉ' },
    cafe: { primary: '#3f2416', secondary: '#f8d7a1', image: '/banner-templates/template-18.png', title: 'SCANNEZ & SAVOUREZ' },
    beaute: { primary: '#831843', secondary: '#f9a8d4', image: '/banner-templates/nail-art.png', title: 'SCANNEZ & PROFITEZ' },
    minimal: { primary: '#f8fafc', secondary: '#2563eb', image: '/banner-templates/template-13.png', title: 'AJOUTEZ LA CARTE' },
  };

  const templateAliases = {
    essential: 'minimal',
    signature: 'restaurant',
    impact: 'moderne',
    premium: 'restaurant',
    modern: 'moderne',
    elegant: 'elegant',
    elegante: 'elegant',
    restaurant: 'restaurant',
    cafe: 'cafe',
    beaute: 'beaute',
    minimal: 'minimal',
    moderne: 'moderne',
  };

  function normalizeTemplate(value) {
    const key = String(value || '').trim().toLowerCase();
    return templateAliases[key] || 'restaurant';
  }

  const initialTemplate = normalizeTemplate(new URLSearchParams(window.location.search).get('template'));
  const initialPreset = templatePresets[initialTemplate] || templatePresets.restaurant;

  const state = {
    template: initialTemplate,
    logo: '',
    commerce: 'Votre commerce',
    title: initialPreset.title,
    subtitle: 'Ajoutez notre carte fidélité à votre téléphone',
    reward: '1 CAFÉ OFFERT',
    phone: '',
    instagram: '',
    address: '',
    primary: initialPreset.primary,
    secondary: initialPreset.secondary,
    image: initialPreset.image,
  };

  const $ = (id) => document.getElementById(id);

  function apiUrl(path) {
    return `${API}${path}`;
  }

  function qrUrl(cardId, size = 900) {
    return `${qrBase}?size=${size}x${size}&data=${encodeURIComponent(`${window.location.origin}/carte/${cardId}`)}&bgcolor=ffffff&color=111827&qzone=1`;
  }

  function rewardSummary(data) {
    const tiers = Array.isArray(data.carte.rewards_config) ? data.carte.rewards_config : [];
    if (tiers.length) {
      return tiers.map((item) => `${item.seuil} ${data.carte.type === 'points' ? 'pts' : 'tampons'} = ${item.recompense}`).join(' · ');
    }
    return data.carte.recompense_description || 'Récompense fidélité';
  }

  function setField(id, value) {
    const field = $(id);
    if (field) field.value = value ?? '';
  }

  function syncFieldsFromState() {
    setField('field-commerce', state.commerce);
    setField('field-title', state.title);
    setField('field-subtitle', state.subtitle);
    setField('field-reward', state.reward);
    setField('field-phone', state.phone);
    setField('field-instagram', state.instagram);
    setField('field-address', state.address);
    setField('field-primary', state.primary);
    setField('field-secondary', state.secondary);
  }

  function readFields() {
    state.commerce = $('field-commerce')?.value?.trim() || 'Votre commerce';
    state.title = $('field-title')?.value?.trim() || 'SCANNEZ & PROFITEZ';
    state.subtitle = $('field-subtitle')?.value?.trim() || 'Ajoutez notre carte fidélité à votre téléphone';
    state.reward = $('field-reward')?.value?.trim() || 'Récompense fidélité';
    state.phone = $('field-phone')?.value?.trim() || '';
    state.instagram = $('field-instagram')?.value?.trim() || '';
    state.address = $('field-address')?.value?.trim() || '';
    state.primary = $('field-primary')?.value || state.primary;
    state.secondary = $('field-secondary')?.value || state.secondary;
  }

  function setText(id, value) {
    const node = $(id);
    if (node) node.textContent = value;
  }

  function applyCreator() {
    readFields();
    const sheet = $('poster-sheet');
    sheet.style.setProperty('--poster-primary', state.primary);
    sheet.style.setProperty('--poster-secondary', state.secondary);
    sheet.style.setProperty('--poster-image', `url("${state.image}")`);
    const isLight = ['minimal'].includes(state.template) || state.primary.toLowerCase() === '#f8fafc' || state.primary.toLowerCase() === '#fff7ed';
    sheet.style.setProperty('--poster-ink', isLight ? '#0f172a' : '#ffffff');
    sheet.style.setProperty('--poster-muted', isLight ? 'rgba(15,23,42,0.62)' : 'rgba(255,255,255,0.72)');
    sheet.classList.toggle('is-light', isLight);

    setText('poster-commerce', state.commerce);
    setText('poster-title', state.title);
    setText('poster-subtitle', state.subtitle);
    setText('poster-reward-badge', state.reward.toUpperCase());
    setText('poster-phone', state.phone);
    setText('poster-instagram', state.instagram);
    setText('poster-address', state.address);

    const logo = $('poster-logo');
    const fallback = $('poster-logo-fallback');
    const uploadLogo = $('upload-logo-img');
    const uploadIcon = $('upload-logo-icon');
    if (state.logo) {
      logo.src = state.logo;
      logo.classList.remove('hidden');
      fallback.classList.add('hidden');
      uploadLogo.src = state.logo;
      uploadLogo.classList.remove('hidden');
      uploadIcon.classList.add('hidden');
    } else {
      logo.classList.add('hidden');
      fallback.classList.remove('hidden');
      uploadLogo.classList.add('hidden');
      uploadIcon.classList.remove('hidden');
    }
  }

  function updateTemplateSelection() {
    const selectedTemplate = document.querySelector(`.template-card[data-template="${state.template}"]`);
    if (selectedTemplate?.classList.contains('template-extra')) {
      selectedTemplate.classList.remove('hidden');
    }
    document.querySelectorAll('.template-card').forEach((button) => {
      button.classList.toggle('is-selected', button.dataset.template === state.template);
    });
    document.querySelectorAll('.palette-btn').forEach((button) => {
      button.classList.toggle('is-selected', button.dataset.primary === state.primary && button.dataset.secondary === state.secondary);
    });
  }

  function selectTemplate(name, keepText = true) {
    const normalizedName = normalizeTemplate(name);
    const preset = templatePresets[normalizedName] || templatePresets.restaurant;
    state.template = normalizedName;
    state.primary = preset.primary;
    state.secondary = preset.secondary;
    state.image = preset.image;
    if (!keepText) state.title = preset.title;
    setField('field-primary', state.primary);
    setField('field-secondary', state.secondary);
    if (!keepText) setField('field-title', state.title);
    updateTemplateSelection();
    applyCreator();
  }

  async function downloadPosterImage(filename, story = false) {
    const sheet = $('poster-sheet');
    const rect = sheet.getBoundingClientRect();
    const width = story ? 1080 : 1600;
    const height = story ? 1920 : Math.round(width * (rect.height / rect.width));
    const clone = sheet.cloneNode(true);
    clone.style.width = `${width}px`;
    clone.style.height = `${height}px`;
    clone.style.borderRadius = story ? '54px' : '0';
    clone.style.transform = 'none';
    clone.querySelectorAll('img').forEach((img) => img.setAttribute('crossorigin', 'anonymous'));

    const css = Array.from(document.styleSheets)
      .map((sheetItem) => {
        try {
          return Array.from(sheetItem.cssRules).map((rule) => rule.cssText).join('\n');
        } catch {
          return '';
        }
      })
      .join('\n');
    const html = `<style>${css}</style>${clone.outerHTML}`;
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}"><foreignObject width="100%" height="100%">${html}</foreignObject></svg>`;
    const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml;charset=utf-8' }));
    const image = new Image();
    image.crossOrigin = 'anonymous';
    await new Promise((resolve, reject) => {
      image.onload = resolve;
      image.onerror = reject;
      image.src = url;
    });
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(image, 0, 0);
    URL.revokeObjectURL(url);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(link.href);
    }, 'image/png', 0.96);
  }

  async function loadPoster() {
    try {
      const response = await fetch(apiUrl(`/api/cartes/${carteId}/public`));
      if (!response.ok) throw new Error();
      const { data } = await response.json();
      const commerceName = data.commerce.nom || 'Votre commerce';
      const message = data.carte.welcome_message || 'Ajoutez notre carte fidélité à votre téléphone';
      const reward = rewardSummary(data);

      state.logo = data.carte.logo_url || data.commerce.logo_url || '';
      state.commerce = commerceName;
      state.subtitle = message;
      state.reward = reward;
      state.primary = data.carte.couleur_fond || state.primary;
      state.secondary = data.carte.couleur_accent || state.secondary;
      state.phone = data.commerce.telephone || '';
      state.instagram = data.commerce.instagram || '';
      state.address = data.commerce.adresse || '';
      state.title = templatePresets[state.template]?.title || state.title;

      syncFieldsFromState();
      $('poster-qr').src = qrUrl(carteId);

      $('poster-loading').classList.add('hidden');
      $('poster-stage').classList.remove('hidden');
      updateTemplateSelection();
      applyCreator();
    } catch {
      syncFieldsFromState();
      $('poster-qr').src = qrUrl(carteId);
      $('poster-loading').classList.add('hidden');
      $('poster-stage').classList.remove('hidden');
      updateTemplateSelection();
      applyCreator();
    }
  }

  document.querySelectorAll('.template-card').forEach((button) => {
    button.addEventListener('click', () => selectTemplate(button.dataset.template || 'restaurant', false));
  });

  document.querySelectorAll('.palette-btn').forEach((button) => {
    button.addEventListener('click', () => {
      setField('field-primary', button.dataset.primary);
      setField('field-secondary', button.dataset.secondary);
      document.querySelectorAll('.palette-btn').forEach((item) => item.classList.remove('is-selected'));
      button.classList.add('is-selected');
      applyCreator();
    });
  });

  ['field-commerce', 'field-title', 'field-subtitle', 'field-reward', 'field-phone', 'field-instagram', 'field-address', 'field-primary', 'field-secondary']
    .forEach((id) => $(id)?.addEventListener('input', applyCreator));

  $('poster-logo-upload')?.addEventListener('change', (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      state.logo = String(reader.result || '');
      applyCreator();
    };
    reader.readAsDataURL(file);
  });

  $('show-more-templates')?.addEventListener('click', () => {
    document.querySelectorAll('.template-extra').forEach((node) => node.classList.toggle('hidden'));
  });

  $('download-pdf')?.addEventListener('click', () => window.print());
  $('download-png')?.addEventListener('click', () => downloadPosterImage(`fidelopass-affiche-${carteId}.png`));
  $('download-story')?.addEventListener('click', () => downloadPosterImage(`fidelopass-story-${carteId}.png`, true));
  $('download-all')?.addEventListener('click', async () => {
    await downloadPosterImage(`fidelopass-affiche-${carteId}.png`);
    await downloadPosterImage(`fidelopass-story-${carteId}.png`, true);
    window.print();
  });
  $('download-all-top')?.addEventListener('click', () => $('download-all')?.click());

  loadPoster();
</script>
