---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const apiBase = (
  import.meta.env.PUBLIC_API_URL
  ?? (import.meta.env.PROD ? 'https://api.fidelopass.com' : 'http://localhost:3001')
).replace(/\/$/, '');
---

<BaseLayout title="Création d'affiche — Fidelopass" description="Créez une affiche Fidelopass premium prête à imprimer avec le QR code de votre carte.">
  <div class="poster-creator min-h-screen bg-[#f6f8fb] text-slate-950">
    <header class="poster-ui creator-header sticky top-0 z-40 border-b border-slate-200/80 bg-white/86 px-4 py-3 backdrop-blur-2xl">
      <div class="mx-auto flex max-w-[1720px] items-center justify-between gap-4">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/dashboard" class="icon-btn" aria-label="Retour au dashboard">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          </a>
          <img src="/logo-premium.png" alt="Fidelopass" class="h-9 w-36 object-cover object-center" />
          <span class="hidden rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700 sm:inline-flex">Affiches</span>
        </div>
        <nav class="hidden items-center gap-1 text-sm font-semibold text-slate-500 lg:flex">
          <a href="/dashboard" class="rounded-full px-3 py-2 transition hover:bg-slate-100 hover:text-slate-950">Dashboard</a>
          <a href="/dashboard/carte" class="rounded-full px-3 py-2 transition hover:bg-slate-100 hover:text-slate-950">Ma carte</a>
          <a href="/dashboard/notifications" class="rounded-full px-3 py-2 transition hover:bg-slate-100 hover:text-slate-950">Notifications</a>
        </nav>
        <button id="download-all-top" type="button" class="primary-export-btn">
          Télécharger tous les formats
        </button>
      </div>
    </header>

    <div class="creator-workspace mx-auto grid max-w-[1720px] gap-6 px-4 py-6 lg:grid-cols-[420px_minmax(0,1fr)]">
      <aside class="poster-ui editor-panel lg:sticky lg:top-[76px]">
        <div class="editor-scroll">
          <div class="mb-6">
            <p class="text-[0.68rem] font-extrabold uppercase tracking-[0.28em] text-blue-600">Création d'affiche</p>
            <h1 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.04em] text-slate-950">Studio affiche</h1>
            <p class="mt-2 text-sm leading-6 text-slate-500">Choisissez un modèle, personnalisez les textes et exportez une affiche prête à imprimer.</p>
          </div>

          <section class="editor-card">
            <div class="stepper">
              <div class="step is-active"><span>1</span><div><strong>Choisir un modèle</strong><small>Base visuelle de l'affiche</small></div></div>
              <div class="step is-active"><span>2</span><div><strong>Personnaliser</strong><small>Textes, couleurs et logo</small></div></div>
              <div class="step"><span>3</span><div><strong>Aperçu & export</strong><small>PDF, PNG et story</small></div></div>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Modèles</p>
                <h2>Choisir un style</h2>
              </div>
              <button id="show-more-templates" type="button" class="mini-link">Voir plus</button>
            </div>
            <div class="template-grid">
              <button type="button" class="template-card is-selected" data-template="restaurant">
                <span class="mini-poster restaurant"></span>
                <strong>Restaurant</strong>
              </button>
              <button type="button" class="template-card" data-template="moderne">
                <span class="mini-poster moderne"></span>
                <strong>Moderne</strong>
              </button>
              <button type="button" class="template-card" data-template="elegant">
                <span class="mini-poster elegant"></span>
                <strong>Élégant</strong>
              </button>
              <button type="button" class="template-card" data-template="cafe">
                <span class="mini-poster cafe"></span>
                <strong>Café</strong>
              </button>
              <button type="button" class="template-card template-extra hidden" data-template="beaute">
                <span class="mini-poster beaute"></span>
                <strong>Beauté</strong>
              </button>
              <button type="button" class="template-card template-extra hidden" data-template="minimal">
                <span class="mini-poster minimal"></span>
                <strong>Minimal</strong>
              </button>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Logo</p>
                <h2>Identité visuelle</h2>
              </div>
            </div>
            <label class="upload-zone" for="poster-logo-upload">
              <input id="poster-logo-upload" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
              <span id="upload-logo-preview" class="upload-preview">
                <img id="upload-logo-img" src="" alt="" class="hidden" />
                <svg id="upload-logo-icon" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7-7-7 7"></path></svg>
              </span>
              <span>
                <strong>Changer le logo</strong>
                <small>PNG, JPG, WebP ou SVG. Glissez-déposez ou cliquez.</small>
              </span>
            </label>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Personnalisation</p>
                <h2>Contenu de l'affiche</h2>
              </div>
            </div>
            <div class="form-grid">
              <label class="field full"><span>Nom commerce</span><input id="field-commerce" type="text" placeholder="Votre commerce" /></label>
              <label class="field full"><span>Slogan</span><input id="field-title" type="text" placeholder="SCANNEZ & PROFITEZ" /></label>
              <label class="field full"><span>Texte court</span><textarea id="field-subtitle" rows="3" placeholder="Ajoutez notre carte fidélité à votre téléphone"></textarea></label>
              <label class="field full"><span>Récompense</span><input id="field-reward" type="text" placeholder="1 café offert" /></label>
              <label class="field"><span>Téléphone</span><input id="field-phone" type="text" placeholder="04 00 00 00 00" /></label>
              <label class="field"><span>Instagram</span><input id="field-instagram" type="text" placeholder="@votrecommerce" /></label>
              <label class="field full"><span>Adresse</span><input id="field-address" type="text" placeholder="Adresse du commerce" /></label>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Couleurs</p>
                <h2>Palette</h2>
              </div>
            </div>
            <div class="palette-row">
              <button type="button" class="palette-btn is-selected" data-primary="#082f25" data-secondary="#c8a45d"><span style="background:#082f25"></span><span style="background:#c8a45d"></span></button>
              <button type="button" class="palette-btn" data-primary="#111827" data-secondary="#38bdf8"><span style="background:#111827"></span><span style="background:#38bdf8"></span></button>
              <button type="button" class="palette-btn" data-primary="#312e81" data-secondary="#a78bfa"><span style="background:#312e81"></span><span style="background:#a78bfa"></span></button>
              <button type="button" class="palette-btn" data-primary="#fff7ed" data-secondary="#f97316"><span style="background:#fff7ed"></span><span style="background:#f97316"></span></button>
              <button type="button" class="palette-btn" data-primary="#fdf2f8" data-secondary="#ec4899"><span style="background:#fdf2f8"></span><span style="background:#ec4899"></span></button>
            </div>
            <div class="color-grid">
              <label class="color-field"><span>Principale</span><input id="field-primary" type="color" value="#082f25" /></label>
              <label class="color-field"><span>Secondaire</span><input id="field-secondary" type="color" value="#c8a45d" /></label>
            </div>
          </section>
        </div>
      </aside>

      <main class="preview-area">
        <div id="poster-loading" class="preview-state">
          <div class="spinner"></div>
          <p>Préparation de l'affiche...</p>
        </div>
        <div id="poster-error" class="preview-state hidden">
          <p class="font-bold text-red-600">Impossible de charger cette affiche.</p>
          <p class="mt-2 text-sm text-slate-500">Vérifiez que votre carte est bien publiée puis réessayez.</p>
        </div>

        <div id="poster-stage" class="hidden w-full">
          <div class="preview-toolbar poster-ui">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-slate-400">Aperçu temps réel</p>
              <h2 class="font-display text-xl font-extrabold text-slate-950">Affiche A4</h2>
            </div>
            <div class="inline-flex rounded-full border border-slate-200 bg-white p-1 text-xs font-bold text-slate-500">
              <span class="rounded-full bg-slate-950 px-3 py-1.5 text-white">A4</span>
              <span class="px-3 py-1.5">1080px</span>
            </div>
          </div>

          <div class="poster-preview-shell">
            <div id="poster-sheet" class="poster-sheet" style="--poster-primary:#082f25;--poster-secondary:#c8a45d;--poster-ink:#ffffff;--poster-muted:rgba(255,255,255,0.72);">
              <div class="poster-bg-image" id="poster-bg-image"></div>
              <div class="poster-noise"></div>
              <div class="poster-orb poster-orb-one"></div>
              <div class="poster-orb poster-orb-two"></div>

              <div class="poster-content">
                <header class="poster-top">
                  <div class="poster-brand">
                    <span class="poster-logo-wrap">
                      <img id="poster-logo" src="" alt="" class="hidden" />
                      <span id="poster-logo-fallback">F</span>
                    </span>
                    <div>
                      <p class="poster-kicker">Carte fidélité Wallet</p>
                      <h3 id="poster-commerce">Votre commerce</h3>
                    </div>
                  </div>
                  <span class="poster-top-badge">Sans application</span>
                </header>

                <section class="poster-hero">
                  <div class="reward-badge">
                    <span>Récompense</span>
                    <strong id="poster-reward-badge">1 CAFÉ OFFERT</strong>
                  </div>
                  <h1 id="poster-title">SCANNEZ & PROFITEZ</h1>
                  <p id="poster-subtitle">Ajoutez notre carte fidélité à votre téléphone</p>
                </section>

                <section class="poster-qr-zone">
                  <div class="qr-card">
                    <p>Scannez ici</p>
                    <img id="poster-qr" src="" alt="QR code Fidelopass" crossorigin="anonymous" />
                    <strong>Ouvrez l'appareil photo</strong>
                  </div>
                  <div class="poster-instructions">
                    <div><span>1</span><p>Scannez le QR code</p></div>
                    <div><span>2</span><p>Ajoutez la carte à votre Wallet</p></div>
                    <div><span>3</span><p>Cumulez vos avantages</p></div>
                  </div>
                </section>

                <footer class="poster-footer">
                  <div class="wallet-badges">
                    <span>Apple Wallet</span>
                    <span>Google Wallet</span>
                  </div>
                  <div class="poster-contact">
                    <span id="poster-phone"></span>
                    <span id="poster-instagram"></span>
                    <span id="poster-address"></span>
                  </div>
                  <p>Powered by Fidelopass</p>
                </footer>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <div class="poster-ui export-bar">
      <button id="download-pdf" type="button" class="export-action">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
        <span><strong>Télécharger PDF</strong><small>Impression A4</small></span>
      </button>
      <button id="download-png" type="button" class="export-action">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>
        <span><strong>Télécharger PNG</strong><small>Haute qualité</small></span>
      </button>
      <button id="download-story" type="button" class="export-action">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"></rect><path d="M11 18h2"></path></svg>
        <span><strong>Story Instagram</strong><small>Format mobile</small></span>
      </button>
      <button id="download-all" type="button" class="export-all-btn">Télécharger tous les formats</button>
    </div>
  </div>
</BaseLayout>

<style>
  .poster-creator {
    background:
      radial-gradient(circle at 85% 8%, rgba(56, 189, 248, 0.18), transparent 28rem),
      radial-gradient(circle at 24% 4%, rgba(124, 58, 237, 0.12), transparent 24rem),
      #f6f8fb;
    padding-bottom: 6.5rem;
  }

  .icon-btn {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #475569;
    box-shadow: 0 16px 34px -28px rgba(15, 23, 42, 0.4);
    transition: transform 180ms ease, box-shadow 180ms ease, color 180ms ease;
  }

  .icon-btn:hover,
  .primary-export-btn:hover,
  .export-all-btn:hover,
  .export-action:hover,
  .template-card:hover {
    transform: translateY(-2px);
  }

  .primary-export-btn,
  .export-all-btn {
    border-radius: 1rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    padding: 0.8rem 1.05rem;
    color: white;
    font-size: 0.86rem;
    font-weight: 800;
    box-shadow: 0 22px 46px -26px rgba(37, 99, 235, 0.88);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .creator-workspace {
    align-items: start;
  }

  .editor-panel {
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.75rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 30px 80px -58px rgba(15, 23, 42, 0.44);
    backdrop-filter: blur(20px);
  }

  .editor-scroll {
    max-height: calc(100dvh - 96px);
    overflow: auto;
    padding: 1.35rem 1.35rem 7.5rem;
  }

  .editor-card {
    margin-top: 1rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.35rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.92));
    padding: 1rem;
    box-shadow: 0 18px 48px -42px rgba(15, 23, 42, 0.36);
  }

  .section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .section-kicker {
    color: #2563eb;
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-head h2 {
    margin-top: 0.18rem;
    font-size: 1rem;
    font-weight: 850;
    color: #0f172a;
  }

  .mini-link {
    border-radius: 999px;
    border: 1px solid #dbeafe;
    background: #eff6ff;
    padding: 0.42rem 0.72rem;
    color: #2563eb;
    font-size: 0.72rem;
    font-weight: 850;
  }

  .stepper {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .stepper::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 1.2rem;
    bottom: 1.2rem;
    width: 1px;
    background: linear-gradient(#bfdbfe, #e2e8f0);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .step span {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    z-index: 1;
  }

  .step.is-active span {
    border-color: rgba(96, 165, 250, 0.9);
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.11), 0 18px 34px -24px rgba(37, 99, 235, 0.75);
  }

  .step strong {
    display: block;
    font-size: 0.86rem;
    color: #0f172a;
  }

  .step small {
    display: block;
    margin-top: 0.15rem;
    color: #64748b;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .template-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .template-card {
    border-radius: 1.1rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    padding: 0.55rem;
    text-align: left;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .template-card.is-selected {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12), 0 20px 44px -34px rgba(79, 70, 229, 0.68);
  }

  .template-card strong {
    display: block;
    margin-top: 0.45rem;
    padding-inline: 0.2rem;
    font-size: 0.78rem;
    color: #0f172a;
  }

  .mini-poster {
    display: block;
    height: 7.6rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255,255,255,0.68);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
  }

  .mini-poster.restaurant { background: linear-gradient(145deg, #082f25, #14532d 58%, #c8a45d); }
  .mini-poster.moderne { background: linear-gradient(145deg, #0f172a, #2563eb 58%, #38bdf8); }
  .mini-poster.elegant { background: linear-gradient(145deg, #111827, #2e1065 58%, #d8b4fe); }
  .mini-poster.cafe { background: linear-gradient(145deg, #3f2416, #8b5e34 60%, #f8d7a1); }
  .mini-poster.beaute { background: linear-gradient(145deg, #fff1f2, #f9a8d4 56%, #be185d); }
  .mini-poster.minimal { background: linear-gradient(145deg, #ffffff, #e2e8f0 68%, #0f172a); }

  .upload-zone {
    display: flex;
    cursor: pointer;
    align-items: center;
    gap: 0.9rem;
    border-radius: 1.1rem;
    border: 1px dashed #bfdbfe;
    background: #f8fbff;
    padding: 0.9rem;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .upload-zone:hover {
    transform: translateY(-1px);
    border-color: #60a5fa;
    background: #eff6ff;
  }

  .upload-zone input {
    display: none;
  }

  .upload-zone strong {
    display: block;
    font-size: 0.86rem;
  }

  .upload-zone small {
    display: block;
    margin-top: 0.18rem;
    color: #64748b;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .upload-preview {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid #dbeafe;
    background: #fff;
    color: #2563eb;
  }

  .upload-preview img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .field.full {
    grid-column: 1 / -1;
  }

  .field span,
  .color-field span {
    display: block;
    margin-bottom: 0.35rem;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .field input,
  .field textarea {
    width: 100%;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.78rem 0.85rem;
    color: #0f172a;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: #60a5fa;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
  }

  .palette-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .palette-btn {
    display: inline-flex;
    gap: 0.2rem;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    padding: 0.24rem;
    transition: box-shadow 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .palette-btn:hover {
    transform: translateY(-1px);
  }

  .palette-btn.is-selected {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
  }

  .palette-btn span {
    height: 1.25rem;
    width: 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .color-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .color-field input {
    height: 3rem;
    width: 100%;
    cursor: pointer;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.2rem;
  }

  .preview-area {
    min-height: calc(100dvh - 8rem);
    border-radius: 2rem;
    border: 1px solid rgba(226, 232, 240, 0.75);
    background:
      linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px),
      radial-gradient(circle at 50% 12%, rgba(59, 130, 246, 0.12), transparent 34rem),
      #eef2f7;
