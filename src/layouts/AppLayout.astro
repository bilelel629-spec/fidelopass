---
import '../styles/global.css';

interface Props {
  title?: string;
  deferSessionCheck?: boolean;
}

const { title = 'Fidelopass Scanner', deferSessionCheck = false } = Astro.props;
---

<!doctype html>
<html lang="fr" class="dashboard">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#edf6ff" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-[100dvh] bg-[#f5f9ff] text-slate-900 antialiased overflow-x-hidden" data-defer-session-check={deferSessionCheck ? 'true' : 'false'}>
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -top-24 right-[-6rem] h-[18rem] w-[18rem] rounded-full bg-cyan-200/40 blur-3xl"></div>
      <div class="absolute bottom-[-6rem] left-[-4rem] h-[14rem] w-[14rem] rounded-full bg-blue-100/70 blur-3xl"></div>
    </div>
    <slot />
  </body>
</html>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    bindSessionActivityTracking,
    requireFreshSession,
    shouldShowSessionRefreshOverlay,
    showSessionOverlay,
  } from '../lib/session-guard';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  bindSessionActivityTracking();

  const deferSessionCheck = document.body.dataset.deferSessionCheck === 'true';
  let idleRefreshPromise: Promise<void> | null = null;

  function refreshSessionAfterInactivity() {
    if (!shouldShowSessionRefreshOverlay() || idleRefreshPromise) return;

    idleRefreshPromise = (async () => {
      if (deferSessionCheck) {
        await requireFreshSession(supabase, { redirectToLogin: false });
        return;
      }
      const overlay = showSessionOverlay('Ouverture du scanner...', 'Votre session est rafraîchie avant d’activer la caméra.');
      const session = await requireFreshSession(supabase, { overlay });
      if (session) overlay.remove();
    })().finally(() => {
      idleRefreshPromise = null;
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refreshSessionAfterInactivity();
  });
  window.addEventListener('focus', refreshSessionAfterInactivity);

  if (deferSessionCheck) {
    requireFreshSession(supabase, { redirectToLogin: false }).catch(() => {});
  } else {
    const overlay = shouldShowSessionRefreshOverlay()
      ? showSessionOverlay('Ouverture du scanner...', 'Votre session est rafraîchie avant d’activer la caméra.')
      : undefined;
    const session = await requireFreshSession(supabase, { overlay });
    if (session) overlay?.remove();
  }

  // Enregistrement du Service Worker
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  }
</script>
