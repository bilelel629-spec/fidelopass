---
import ResellerLayout from '../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Stripe Connect — Fidelopass" activeNav="stripe">
  <section class="space-y-8">
    <div>
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-sky-700/75">Paiement en ligne</p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-slate-950">Stripe Connect</h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
        Connectez votre compte Stripe pour recevoir automatiquement votre part sur les abonnements commerçants.
      </p>
    </div>

    <section class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="rounded-[1.7rem] border border-sky-100 bg-white/90 p-6 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-slate-500">État du compte</p>
        <h2 id="connect-title" class="mt-3 font-display text-2xl font-bold text-slate-950">Chargement...</h2>
        <p id="connect-description" class="mt-3 text-sm leading-6 text-slate-600"></p>
        <div id="connect-badges" class="mt-5 flex flex-wrap gap-2"></div>
        <button id="connect-button" class="mt-6 w-full rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-500 px-5 py-4 text-sm font-bold text-white shadow-[0_20px_36px_-24px_rgba(37,99,235,0.8)] transition hover:-translate-y-0.5">
          Connecter Stripe
        </button>
      </article>

      <article class="rounded-[1.7rem] border border-indigo-100 bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-900 p-7 text-white shadow-[0_24px_60px_-38px_rgba(15,23,42,0.75)]">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-white/60">Fonctionnement</p>
        <h2 class="mt-3 font-display text-3xl font-bold">Split automatique</h2>
        <div class="mt-6 grid gap-3 text-sm">
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="font-semibold">1. Le commerçant paie son abonnement</p>
            <p class="mt-1 text-white/65">Il ne voit que son prix final.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="font-semibold">2. Fidelopass prélève sa part</p>
            <p class="mt-1 text-white/65">La part plateforme est calculée côté serveur.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="font-semibold">3. Le reste va au revendeur</p>
            <p class="mt-1 text-white/65">Stripe verse votre marge sur votre compte connecté.</p>
          </div>
        </div>
      </article>
    </section>
  </section>
</ResellerLayout>

<script>
  import { authFetch } from '../../lib/api';

  function badge(label: string, ok: boolean) {
    return `<span class="rounded-full border ${ok ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-amber-200 bg-amber-50 text-amber-700'} px-3 py-1 text-xs font-semibold">${label}</span>`;
  }

  async function loadStripeStatus() {
    const res = await authFetch('/api/reseller/stripe/status');
    const payload = await res.json().catch(() => null);
    const title = document.getElementById('connect-title')!;
    const description = document.getElementById('connect-description')!;
    const badges = document.getElementById('connect-badges')!;
    const button = document.getElementById('connect-button') as HTMLButtonElement;

    if (!res.ok) {
      title.textContent = 'Impossible de vérifier Stripe';
      description.textContent = payload?.error ?? 'Réessayez dans quelques instants.';
      return;
    }
    const data = payload.data ?? {};
    const reseller = data.reseller ?? {};
    if (data.enabled === false) {
      title.textContent = 'Mode facturé';
      description.textContent = data.message ?? 'Ce compte revendeur n’utilise pas Stripe Connect.';
      button.disabled = true;
      button.textContent = 'Stripe non requis';
      badges.innerHTML = badge('Facturation manuelle', true);
      return;
    }
    const connected = Boolean(reseller.stripe_connect_account_id);
    const charges = Boolean(reseller.stripe_charges_enabled);
    const payouts = Boolean(reseller.stripe_payouts_enabled);
    title.textContent = charges && payouts ? 'Stripe Connect prêt' : connected ? 'Onboarding à finaliser' : 'Compte non connecté';
    description.textContent = charges && payouts
      ? 'Vous pouvez créer des paiements en ligne avec split automatique.'
      : 'Finalisez l’onboarding Stripe pour activer les paiements et versements.';
    badges.innerHTML = [
      badge('Compte connecté', connected),
      badge('Paiements actifs', charges),
      badge('Versements actifs', payouts),
    ].join('');
    button.textContent = connected ? 'Finaliser onboarding Stripe' : 'Connecter Stripe';
  }

  document.getElementById('connect-button')?.addEventListener('click', async () => {
    const button = document.getElementById('connect-button') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Redirection...';
    const res = await authFetch('/api/reseller/stripe/connect', { method: 'POST', body: JSON.stringify({}) });
    const payload = await res.json().catch(() => null);
    if (res.ok && payload?.url) window.location.href = payload.url;
    else {
      button.disabled = false;
      button.textContent = 'Réessayer';
      alert(payload?.error ?? 'Impossible de créer le lien Stripe Connect.');
    }
  });

  await loadStripeStatus();
</script>
