---
import ResellerLayout from '../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Reversements revendeur — Fidelopass" activeNav="stripe">
  <section class="space-y-8">
    <div>
      <p id="billing-eyebrow" class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-sky-700/75">Reversements</p>
      <h1 id="billing-title" class="mt-2 font-display text-4xl font-bold tracking-tight text-slate-950">Reversements revendeur</h1>
      <p id="billing-description" class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
        Fidelopass encaisse les abonnements Stripe et suit votre marge. Les reversements sont validés manuellement en V1.
      </p>
    </div>

    <section class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="rounded-[1.7rem] border border-sky-100 bg-white/90 p-6 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-slate-500">État du compte</p>
        <h2 id="connect-title" class="mt-3 font-display text-2xl font-bold text-slate-950">Chargement...</h2>
        <p id="connect-description" class="mt-3 text-sm leading-6 text-slate-600"></p>
        <div id="connect-badges" class="mt-5 flex flex-wrap gap-2"></div>
        <button id="connect-button" class="mt-6 w-full rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-500 px-5 py-4 text-sm font-bold text-white shadow-[0_20px_36px_-24px_rgba(37,99,235,0.8)] transition hover:-translate-y-0.5">
          Configurer mon lien revendeur
        </button>
      </article>

      <article class="rounded-[1.7rem] border border-indigo-100 bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-900 p-7 text-white shadow-[0_24px_60px_-38px_rgba(15,23,42,0.75)]">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-white/60">Fonctionnement V1</p>
        <h2 id="billing-mode-title" class="mt-3 font-display text-3xl font-bold">Commission interne</h2>
        <div id="billing-steps" class="mt-6 grid gap-3 text-sm">
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="font-semibold">1. Le commerçant paie Fidelopass</p>
            <p class="mt-1 text-white/65">Le paiement Stripe se fait sur le compte Fidelopass.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="font-semibold">2. Votre marge est enregistrée</p>
            <p class="mt-1 text-white/65">Chaque facture payée crée une commission à reverser.</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-4">
            <p class="font-semibold">3. Fidelopass vous règle</p>
            <p class="mt-1 text-white/65">Le règlement se fait manuellement selon votre accord commercial.</p>
          </div>
        </div>
      </article>
    </section>
  </section>
</ResellerLayout>

<script>
  import { authFetch } from '../../lib/api';

  const formatMoney = (cents: unknown, currency = 'eur') => new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: String(currency || 'eur').toUpperCase(),
    maximumFractionDigits: 0,
  }).format(Number(cents ?? 0) / 100);

  function badge(label: string, ok: boolean) {
    return `<span class="rounded-full border ${ok ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-sky-200 bg-sky-50 text-sky-700'} px-3 py-1 text-xs font-semibold">${label}</span>`;
  }

  async function loadStripeStatus() {
    const res = await authFetch('/api/reseller/stripe/status');
    const payload = await res.json().catch(() => null);
    const title = document.getElementById('connect-title')!;
    const description = document.getElementById('connect-description')!;
    const badges = document.getElementById('connect-badges')!;
    const button = document.getElementById('connect-button') as HTMLButtonElement;

    if (!res.ok) {
      title.textContent = 'Impossible de vérifier Stripe';
      description.textContent = payload?.error ?? 'Réessayez dans quelques instants.';
      return;
    }
    const data = payload.data ?? {};
    const pending = formatMoney(data.pending_commission_cents, data.currency);
    const paid = formatMoney(data.paid_commission_cents, data.currency);
    button.dataset.action = 'link';
    document.title = 'Reversements revendeur — Fidelopass';
    title.textContent = 'Commissions suivies';
    description.textContent = `${data.message ?? 'V1 active.'} À reverser: ${pending}. Déjà réglé: ${paid}.`;
    badges.innerHTML = [
      badge('Paiement Stripe Fidelopass', true),
      badge('Commission interne', true),
      badge('V1 active', true),
    ].join('');
    button.disabled = false;
    button.textContent = 'Configurer mon lien revendeur';
  }

  document.getElementById('connect-button')?.addEventListener('click', async () => {
    window.location.href = '/reseller/link';
  });

  await loadStripeStatus();
</script>
