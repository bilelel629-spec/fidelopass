---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Scan caisse — Fidelopass" activeNav="scan">
  <section class="mx-auto max-w-5xl space-y-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.26em] text-sky-700/75">Mode caisse</p>
        <h1 class="font-display text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Scanner client</h1>
        <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">
          Page dédiée à la scannette USB/Bluetooth branchée à la caisse. Scannez le code-barres Wallet, ajoutez le passage, puis passez au client suivant.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/app/install" class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-2.5 text-sm font-semibold text-sky-800 shadow-[0_12px_28px_-24px_rgba(37,99,235,0.5)] transition hover:border-sky-300 hover:bg-sky-100">
          Scanner mobile
        </a>
        <button id="fullscreen-btn" type="button" class="rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-[0_12px_28px_-24px_rgba(15,23,42,0.35)] transition hover:border-slate-300 hover:bg-slate-50">
          Plein écran
        </button>
        <button id="new-scan-top" type="button" class="hidden rounded-2xl border border-sky-200 bg-white px-4 py-2.5 text-sm font-semibold text-sky-800 shadow-[0_12px_28px_-24px_rgba(37,99,235,0.5)] transition hover:border-sky-300 hover:bg-sky-50">
          Nouveau scan
        </button>
      </div>
    </div>

    <div class="rounded-[2rem] border border-slate-200/70 bg-white/95 p-5 shadow-[0_30px_80px_-58px_rgba(15,23,42,0.35)] sm:p-7">
      <div class="mb-5 grid gap-3 rounded-[1.4rem] border border-sky-100 bg-sky-50/70 p-4 text-sm leading-6 text-slate-600 sm:grid-cols-[1fr_auto] sm:items-center">
        <div>
          <p class="font-bold text-slate-900">Mode scannette</p>
          <p>
            Utilisez cette page quand une scannette physique saisit automatiquement le code dans le champ ci-dessous.
            Pour scanner avec l’appareil photo d’un téléphone, ouvrez plutôt le mode scanner mobile.
          </p>
        </div>
        <a href="/app/install" class="inline-flex justify-center rounded-2xl bg-slate-950 px-4 py-2.5 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-slate-800">
          Ouvrir le scanner mobile
        </a>
      </div>

      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <label for="scan-input" class="block text-sm font-semibold text-slate-700">Champ de scan</label>
        <div class="flex flex-wrap items-center gap-2">
          <span id="scan-status-pill" class="inline-flex w-fit items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-sky-700">
            Prêt à scanner
          </span>
        </div>
      </div>

      <div class="relative">
        <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-sky-600">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7V5a1 1 0 0 1 1-1h2"></path>
            <path d="M17 4h2a1 1 0 0 1 1 1v2"></path>
            <path d="M20 17v2a1 1 0 0 1-1 1h-2"></path>
            <path d="M7 20H5a1 1 0 0 1-1-1v-2"></path>
            <path d="M7 12h10"></path>
          </svg>
        </span>
        <input
          id="scan-input"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          autofocus
          placeholder="Scannez le pass client"
          class="w-full rounded-[1.6rem] border-2 border-sky-100 bg-sky-50/55 py-7 pl-14 pr-5 font-mono text-3xl font-bold uppercase tracking-[0.08em] text-slate-950 outline-none transition focus:border-sky-400 focus:bg-white focus:shadow-[0_0_0_6px_rgba(14,165,233,0.12)] sm:text-4xl"
        />
      </div>
      <p id="scan-feedback" class="mt-5 hidden rounded-2xl border px-4 py-3 text-sm font-semibold"></p>

      <div id="scan-placeholder" class="mt-10 flex flex-col items-center gap-3 text-slate-400">
        <div class="flex h-20 w-20 items-center justify-center rounded-full bg-slate-100 text-4xl">📷</div>
        <p class="text-sm font-medium">Scannez le QR client ou entrez un code FID-XXXXX</p>
      </div>

      <div id="client-card" class="mt-6 hidden rounded-[1.7rem] border border-slate-200 bg-gradient-to-br from-white to-sky-50/50 p-5 shadow-[0_20px_55px_-42px_rgba(37,99,235,0.45)]">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-sky-700/75">Client trouvé</p>
            <h2 id="client-name" class="mt-1 font-display text-3xl font-bold text-slate-950">—</h2>
            <p id="client-contact" class="mt-1 text-sm text-slate-500">—</p>
          </div>
          <span id="wallet-code-badge" class="inline-flex w-fit rounded-full border border-slate-200 bg-white px-3 py-1.5 font-mono text-xs font-bold text-slate-600">—</span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-white bg-white/86 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Progression</p>
            <p id="client-progress" class="mt-2 text-2xl font-bold text-slate-950">—</p>
          </div>
          <div class="rounded-2xl border border-white bg-white/86 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Récompense</p>
            <p id="client-reward" class="mt-2 text-base font-bold text-slate-950">—</p>
          </div>
          <div class="rounded-2xl border border-white bg-white/86 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Disponible</p>
            <p id="client-reward-count" class="mt-2 text-2xl font-bold text-emerald-600">0</p>
          </div>
        </div>

          <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <button id="add-point-btn" type="button" class="rounded-[1.2rem] bg-gradient-to-r from-blue-600 to-indigo-500 px-5 py-5 text-lg font-bold text-white shadow-[0_18px_34px_-22px_rgba(37,99,235,0.9)] transition hover:-translate-y-0.5 hover:shadow-[0_24px_42px_-24px_rgba(37,99,235,0.95)]">
            +1 point
          </button>
          <button id="use-reward-btn" type="button" class="rounded-[1.2rem] border border-emerald-200 bg-white px-5 py-5 text-lg font-bold text-emerald-700 shadow-[0_16px_30px_-26px_rgba(16,185,129,0.65)] transition hover:-translate-y-0.5 hover:bg-emerald-50 disabled:cursor-not-allowed disabled:border-slate-200 disabled:text-slate-400 disabled:hover:translate-y-0 disabled:hover:bg-white">
            Utiliser récompense
            </button>
          </div>
          <div id="point-reward-actions" class="mt-3 hidden space-y-2"></div>

        <div class="mt-4 flex justify-end">
          <button id="new-scan-card" type="button" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
            Scanner un autre client
          </button>
        </div>

        <details class="mt-5 rounded-2xl border border-slate-200 bg-white/75">
          <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-700">Derniers passages</summary>
          <div id="history-list" class="space-y-2 px-4 pb-4 text-sm text-slate-500">
            <p class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5 text-center">
              Scannez un client pour afficher son historique.
            </p>
          </div>
        </details>
      </div>
    </div>

    <details class="rounded-[1.5rem] border border-slate-200 bg-white/80 p-4 shadow-[0_18px_50px_-42px_rgba(15,23,42,0.3)]">
      <summary class="cursor-pointer text-sm font-bold text-slate-800">Aide scanner</summary>
      <div class="mt-4 grid gap-3 text-sm leading-6 text-slate-600 md:grid-cols-[1.2fr_1fr]">
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-amber-800">
          Pour utiliser une scannette, les cartes doivent être en <strong>code-barres linéaire Code 128</strong>.
          Modification dans
          <a href="/dashboard/carte?step=4&panel=barcode" class="font-bold underline underline-offset-4 hover:text-amber-900">Ma carte → Code-barres</a>.
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <p class="font-semibold text-slate-900">Mémo rapide</p>
          <ol class="mt-2 space-y-1 text-xs text-slate-500">
            <li>1. Branchez la scannette USB/Bluetooth.</li>
            <li>2. Scannez le code Wallet du client.</li>
            <li>3. Ajoutez le passage ou utilisez la récompense.</li>
          </ol>
          <button id="demo-scan" type="button" class="mt-3 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-50">
            Tester FID-DEMO123
          </button>
        </div>
      </div>
    </details>
  </section>
</DashboardLayout>

<script>
  import { authFetch } from '../../lib/api';

  type ScanPayload = {
    demo?: boolean;
    client: {
      id: string;
      wallet_code: string;
      nom: string;
      telephone: string | null;
      email: string | null;
      points_actuels: number;
      tampons_actuels: number;
      recompenses_obtenues: number;
    };
    carte: {
      id: string;
      nom: string;
      type: 'points' | 'tampons';
      reward_description: string;
      rewards_multi_enabled?: boolean;
    };
    progress: {
      current: number;
      goal: number;
      label: string;
      addType: 'ajout_points' | 'ajout_tampon';
    };
    can_use_reward: boolean;
    reward_state?: {
      reward_catalog: Array<{ seuil: number; recompense: string; disponible: boolean; points_manquants: number }>;
      available_rewards: Array<{ seuil: number; recompense: string; disponible: boolean; points_manquants: number }>;
      next_reward: { seuil: number; recompense: string; disponible: boolean; points_manquants: number } | null;
      can_use_reward: boolean;
    } | null;
    history: Array<{ id: string; type: string; valeur: number; created_at: string; note?: string | null }>;
  };

  const input = document.getElementById('scan-input') as HTMLInputElement;
  const feedback = document.getElementById('scan-feedback')!;
  const statusPill = document.getElementById('scan-status-pill')!;
  const clientCard = document.getElementById('client-card')!;
  const scanPlaceholder = document.getElementById('scan-placeholder');
  const historyList = document.getElementById('history-list')!;
  const addPointBtn = document.getElementById('add-point-btn') as HTMLButtonElement;
  const useRewardBtn = document.getElementById('use-reward-btn') as HTMLButtonElement;
  const pointRewardActions = document.getElementById('point-reward-actions')!;
  const fullscreenBtn = document.getElementById('fullscreen-btn') as HTMLButtonElement | null;
  const newScanTop = document.getElementById('new-scan-top') as HTMLButtonElement | null;
  const newScanCard = document.getElementById('new-scan-card') as HTMLButtonElement | null;

  let currentPayload: ScanPayload | null = null;
  let busy = false;
  let audioContext: AudioContext | null = null;

  function normalizeScanCode(value: string): string {
    return value.replace(/\s+/g, '').trim().toUpperCase();
  }

  function focusInput() {
    window.setTimeout(() => input.focus(), 40);
  }

  function setScanState(message: string, tone: 'success' | 'error' | 'info' = 'info') {
    statusPill.textContent = message;
    statusPill.className = 'inline-flex w-fit items-center rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-[0.14em]';
    if (tone === 'success') statusPill.classList.add('border-emerald-200', 'bg-emerald-50', 'text-emerald-700');
    else if (tone === 'error') statusPill.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
    else statusPill.classList.add('border-sky-200', 'bg-sky-50', 'text-sky-700');
  }

  function playBeep(tone: 'success' | 'error' | 'info' = 'info') {
    try {
      audioContext ??= new AudioContext();
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.value = tone === 'success' ? 880 : tone === 'error' ? 220 : 520;
      gain.gain.setValueAtTime(0.0001, audioContext.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.08, audioContext.currentTime + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioContext.currentTime + (tone === 'error' ? 0.24 : 0.13));
      oscillator.connect(gain);
      gain.connect(audioContext.destination);
      oscillator.start();
      oscillator.stop(audioContext.currentTime + (tone === 'error' ? 0.25 : 0.14));
    } catch {
      // Les navigateurs peuvent bloquer l'audio tant qu'il n'y a pas eu d'interaction utilisateur.
    }
  }

  function signal(tone: 'success' | 'error' | 'info') {
    playBeep(tone);
    if (!navigator.vibrate) return;
    if (tone === 'success') navigator.vibrate([45, 30, 80]);
    else if (tone === 'error') navigator.vibrate([120, 45, 120]);
  }

  function showFeedback(message: string, tone: 'success' | 'error' | 'info' = 'info') {
    feedback.textContent = message;
    feedback.className = 'mt-5 rounded-2xl border px-4 py-3 text-sm font-semibold';
    if (tone === 'success') feedback.classList.add('border-emerald-200', 'bg-emerald-50', 'text-emerald-700');
    else if (tone === 'error') feedback.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
    else feedback.classList.add('border-sky-200', 'bg-sky-50', 'text-sky-700');
    feedback.classList.remove('hidden');
    setScanState(tone === 'success' ? 'Client prêt' : tone === 'error' ? 'À vérifier' : 'Recherche...', tone);
  }

  function clearFeedback() {
    feedback.classList.add('hidden');
    setScanState('Prêt à scanner', 'info');
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function formatDateTime(value: unknown): string {
    if (!value) return '—';
    const date = new Date(String(value));
    return Number.isFinite(date.getTime())
      ? date.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })
      : '—';
  }

  function renderHistory(history: ScanPayload['history'] | unknown) {
    const items = Array.isArray(history) ? history : [];
    if (!items.length) {
      historyList.innerHTML = '<p class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5 text-center">Aucun passage récent.</p>';
      return;
    }

    historyList.innerHTML = items.slice(0, 3).map((item) => {
      const label = item.type === 'ajout_tampon'
        ? '+ tampon'
        : item.type === 'ajout_points'
          ? '+ points'
          : item.type === 'recompense'
            ? 'Récompense utilisée'
            : item.type;
      const date = formatDateTime(item.created_at);
      return `
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3">
          <div class="flex items-center justify-between gap-3">
            <span class="font-semibold text-slate-800">${escapeHtml(label)}</span>
            <span class="text-xs text-slate-400">${escapeHtml(date)}</span>
          </div>
          <p class="mt-1 text-xs text-slate-500">${escapeHtml(item.note ?? `Valeur: ${item.valeur}`)}</p>
        </div>
      `;
    }).join('');
  }

  function renderClient(payload: ScanPayload) {
    currentPayload = payload;
    const contact = payload.client.telephone || payload.client.email || 'Contact non renseigné';
    const isMultiplePoints = payload.carte.type === 'points' && payload.carte.rewards_multi_enabled === true;
    const availablePointRewards = payload.reward_state?.available_rewards ?? [];
    const rewardCount = isMultiplePoints ? availablePointRewards.length : payload.client.recompenses_obtenues ?? 0;
    const actionLabel = payload.carte.type === 'points' ? '+1 point' : '+1 tampon';

    document.getElementById('client-name')!.textContent = payload.client.nom || 'Client anonyme';
    document.getElementById('client-contact')!.textContent = contact;
    document.getElementById('wallet-code-badge')!.textContent = payload.client.wallet_code;
    document.getElementById('client-progress')!.textContent = `${payload.progress.current}/${payload.progress.goal} ${payload.progress.label}`;
    document.getElementById('client-reward')!.textContent = isMultiplePoints
      ? availablePointRewards.map((reward) => reward.recompense).join(', ')
        || (payload.reward_state?.next_reward
          ? `${payload.reward_state.next_reward.recompense} dans ${payload.reward_state.next_reward.points_manquants} pts`
          : 'Tous les paliers sont atteints')
      : payload.carte.reward_description || 'Récompense';
    document.getElementById('client-reward-count')!.textContent = String(rewardCount);
    addPointBtn.textContent = actionLabel;
    addPointBtn.disabled = Boolean(payload.demo);
    useRewardBtn.disabled = Boolean(payload.demo) || !payload.can_use_reward;
    useRewardBtn.classList.toggle('hidden', isMultiplePoints);
    pointRewardActions.innerHTML = '';
    pointRewardActions.classList.toggle('hidden', !isMultiplePoints);
    if (isMultiplePoints) {
      if (availablePointRewards.length) {
        availablePointRewards.forEach((reward) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'w-full rounded-[1.2rem] border border-emerald-200 bg-white px-5 py-4 text-base font-bold text-emerald-700 transition hover:bg-emerald-50 disabled:text-slate-400';
          button.textContent = `Utiliser « ${reward.recompense} » · ${reward.seuil} pts`;
          button.disabled = Boolean(payload.demo);
          button.addEventListener('click', () => runAction('use-reward', reward.seuil));
          pointRewardActions.appendChild(button);
        });
      } else if (payload.reward_state?.next_reward) {
        const message = document.createElement('p');
        message.className = 'rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center text-sm text-slate-500';
        message.textContent = `Prochaine récompense : ${payload.reward_state.next_reward.recompense}, encore ${payload.reward_state.next_reward.points_manquants} point(s).`;
        pointRewardActions.appendChild(message);
      }
    }
    clientCard.classList.remove('hidden');
    scanPlaceholder?.classList.add('hidden');
    newScanTop?.classList.remove('hidden');
    renderHistory(payload.history);
  }

  async function readJson(res: Response) {
    return res.json().catch(() => null);
  }

  async function runScan(codeRaw: string) {
    const code = normalizeScanCode(codeRaw);
    if (!code) {
      showFeedback('Scan vide, veuillez réessayer.', 'error');
      signal('error');
      focusInput();
      return;
    }

    busy = true;
    showFeedback('Recherche du client...', 'info');
    input.value = '';

    try {
      const res = await authFetch(`/api/merchant/scan?code=${encodeURIComponent(code)}`);
      const payload = await readJson(res);
      if (!res.ok || !payload?.success) throw new Error(payload?.error ?? 'Erreur serveur, veuillez réessayer.');
      renderClient(payload.data);
      showFeedback('Client trouvé. Choisissez l’action à appliquer.', 'success');
      signal('success');
    } catch (error) {
      currentPayload = null;
      clientCard.classList.add('hidden');
      newScanTop?.classList.add('hidden');
      historyList.innerHTML = '<p class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5 text-center">Scannez un client pour afficher son historique.</p>';
      showFeedback(error instanceof Error ? error.message : 'Erreur serveur, veuillez réessayer.', 'error');
      signal('error');
    } finally {
      busy = false;
      focusInput();
    }
  }

  async function runAction(action: 'add-point' | 'use-reward', rewardThreshold?: number) {
    if (!currentPayload || busy || currentPayload.demo) return;
    busy = true;
    showFeedback(action === 'add-point' ? 'Ajout du passage...' : 'Utilisation de la récompense...', 'info');

    try {
      const path = action === 'add-point'
        ? `/api/merchant/customers/${currentPayload.client.id}/add-point`
        : `/api/merchant/customers/${currentPayload.client.id}/use-reward`;
      const res = await authFetch(path, {
        method: 'POST',
        body: JSON.stringify(rewardThreshold ? { reward_threshold: rewardThreshold } : {}),
      });
      const payload = await readJson(res);
      if (!res.ok || !payload?.success) throw new Error(payload?.error ?? 'Erreur serveur, veuillez réessayer.');
      renderClient(payload.data);
      showFeedback(payload.message ?? 'Action enregistrée.', 'success');
      signal('success');
    } catch (error) {
      showFeedback(error instanceof Error ? error.message : 'Erreur serveur, veuillez réessayer.', 'error');
      signal('error');
    } finally {
      busy = false;
      focusInput();
    }
  }

  function resetScan() {
    currentPayload = null;
    input.value = '';
    clientCard.classList.add('hidden');
    newScanTop?.classList.add('hidden');
    clearFeedback();
    historyList.innerHTML = '<p class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5 text-center">Scannez un client pour afficher son historique.</p>';
    focusInput();
  }

  function updateFullscreenButton() {
    if (!fullscreenBtn) return;
    fullscreenBtn.textContent = document.fullscreenElement ? 'Quitter le plein écran' : 'Plein écran caisse';
  }

  input.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || busy) return;
    event.preventDefault();
    runScan(input.value);
  });
  document.getElementById('demo-scan')?.addEventListener('click', () => runScan('FID-DEMO123'));
  newScanTop?.addEventListener('click', resetScan);
  newScanCard?.addEventListener('click', resetScan);
  fullscreenBtn?.addEventListener('click', async () => {
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await document.documentElement.requestFullscreen();
      updateFullscreenButton();
    } catch {
      showFeedback('Le plein écran n’est pas disponible sur ce navigateur.', 'error');
    } finally {
      focusInput();
    }
  });
  document.addEventListener('fullscreenchange', updateFullscreenButton);
  addPointBtn.addEventListener('click', () => runAction('add-point'));
  useRewardBtn.addEventListener('click', () => runAction('use-reward'));

  document.addEventListener('click', () => {
    if (!busy) focusInput();
  });
  window.addEventListener('focus', focusInput);
  focusInput();
</script>
