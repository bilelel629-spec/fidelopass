---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Historique — Fidelopass" activeNav="transactions">
  <div class="mb-8">
    <p class="dashboard-kicker">Historique</p>
    <h1 class="dashboard-title">Historique</h1>
    <p class="dashboard-subtitle">Historique de tous les scans et ajouts de points.</p>
  </div>

  <div class="card dashboard-panel overflow-x-auto">
    <div id="transactions-list">
      <p class="text-slate-500 text-sm p-6">Chargement...</p>
    </div>
  </div>
</DashboardLayout>

<script>
  import { authFetch } from '../../lib/api';

  function escapeHtml(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char] ?? char));
  }

  function toFiniteNumber(value: unknown) {
    const numberValue = Number(value ?? 0);
    return Number.isFinite(numberValue) ? numberValue : 0;
  }

  function formatDate(value: unknown) {
    const date = new Date(String(value ?? ''));
    return Number.isNaN(date.getTime()) ? '—' : date.toLocaleString('fr-FR');
  }

  async function loadTransactions() {
    const container = document.getElementById('transactions-list')!;
    try {
      const res = await authFetch('/api/transactions?limit=50');
      if (!res.ok) throw new Error();
      const { data } = await res.json();
      const rows = Array.isArray(data) ? data : [];

      if (!rows.length) {
        container.innerHTML = '<p class="text-slate-500 text-sm p-6">Aucune transaction pour le moment.</p>';
        return;
      }

      const typeLabel: Record<string, string> = {
        ajout_points: 'Points ajoutés',
        ajout_tampon: 'Tampon ajouté',
        recompense: 'Récompense',
        reset: 'Reset',
      };
      const typeBadge: Record<string, string> = {
        ajout_points: 'badge-info',
        ajout_tampon: 'badge-info',
        recompense: 'badge-success',
        reset: 'badge-warning',
      };

      container.innerHTML = `
        <div class="hidden md:block">
        <table class="w-full">
          <thead class="border-b border-slate-200">
            <tr class="text-left">
              <th class="px-6 py-3 text-slate-500 text-xs uppercase tracking-wide font-medium">Type</th>
              <th class="px-6 py-3 text-slate-500 text-xs uppercase tracking-wide font-medium">Valeur</th>
              <th class="px-6 py-3 text-slate-500 text-xs uppercase tracking-wide font-medium">Avant / Après</th>
              <th class="px-6 py-3 text-slate-500 text-xs uppercase tracking-wide font-medium">Note</th>
              <th class="px-6 py-3 text-slate-500 text-xs uppercase tracking-wide font-medium">Date</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map((t: { type?: string; valeur?: number; points_avant?: number | null; points_apres?: number | null; note?: string | null; created_at?: string }) => {
              const type = String(t.type ?? '');
              const valeur = toFiniteNumber(t.valeur);
              const pointsAvant = t.points_avant === null || t.points_avant === undefined ? '—' : String(toFiniteNumber(t.points_avant));
              const pointsApres = t.points_apres === null || t.points_apres === undefined ? '—' : String(toFiniteNumber(t.points_apres));
              return `
                <tr class="border-b border-slate-200 last:border-0 hover:bg-sky-50 transition-colors">
                  <td class="px-6 py-4">
                    <span class="badge ${typeBadge[type] ?? 'badge-info'}">${escapeHtml(typeLabel[type] ?? type)}</span>
                  </td>
                  <td class="px-6 py-4 font-mono text-slate-900 text-sm">${valeur >= 0 ? '+' : ''}${escapeHtml(valeur)}</td>
                  <td class="px-6 py-4 font-mono text-slate-600 text-sm">
                    ${escapeHtml(pointsAvant)} → ${escapeHtml(pointsApres)}
                  </td>
                  <td class="px-6 py-4 text-slate-600 text-sm">${escapeHtml(t.note ?? '—')}</td>
                  <td class="px-6 py-4 text-slate-600 text-sm">
                    ${escapeHtml(formatDate(t.created_at))}
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
        </div>
        <div class="grid gap-3 p-3 md:hidden">
          ${rows.map((t: { type?: string; valeur?: number; points_avant?: number | null; points_apres?: number | null; note?: string | null; created_at?: string }) => {
            const type = String(t.type ?? '');
            const valeur = toFiniteNumber(t.valeur);
            const pointsAvant = t.points_avant === null || t.points_avant === undefined ? '—' : String(toFiniteNumber(t.points_avant));
            const pointsApres = t.points_apres === null || t.points_apres === undefined ? '—' : String(toFiniteNumber(t.points_apres));
            const positive = valeur >= 0;
            return `
              <article class="rounded-[1.25rem] border border-slate-200 bg-white p-4 shadow-[0_16px_40px_-34px_rgba(15,23,42,0.35)]">
                <div class="flex items-start justify-between gap-3">
                  <span class="badge ${typeBadge[type] ?? 'badge-info'}">${escapeHtml(typeLabel[type] ?? type)}</span>
                  <span class="font-mono text-lg font-bold ${positive ? 'text-sky-700' : 'text-rose-600'}">${positive ? '+' : ''}${escapeHtml(valeur)}</span>
                </div>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  <div class="rounded-2xl border border-slate-100 bg-slate-50 px-3 py-2">
                    <p class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Avant / après</p>
                    <p class="mt-1 font-mono text-sm text-slate-800">${escapeHtml(pointsAvant)} → ${escapeHtml(pointsApres)}</p>
                  </div>
                  <div class="rounded-2xl border border-slate-100 bg-slate-50 px-3 py-2">
                    <p class="text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Date</p>
                    <p class="mt-1 text-xs font-semibold text-slate-700">${escapeHtml(formatDate(t.created_at))}</p>
                  </div>
                </div>
                <p class="mt-3 rounded-2xl border border-slate-100 bg-slate-50 px-3 py-2 text-sm text-slate-600">${escapeHtml(t.note ?? '—')}</p>
              </article>
            `;
          }).join('')}
        </div>
      `;
    } catch {
      container.innerHTML = '<p class="text-red-400 text-sm p-6">Erreur lors du chargement.</p>';
    }
  }

  loadTransactions();
</script>
