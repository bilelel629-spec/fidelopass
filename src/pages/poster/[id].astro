---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const apiBase = (
  import.meta.env.PUBLIC_API_URL
  ?? (import.meta.env.PROD ? 'https://api.fidelopass.com' : 'http://localhost:3001')
).replace(/\/$/, '');
---

<BaseLayout title="Affiche A4 — Fidelopass" description="Téléchargez une affiche A4 Fidelopass prête à imprimer avec le QR code de votre carte.">
  <div class="min-h-screen px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <div class="poster-ui flex flex-col lg:flex-row gap-6 items-start justify-between mb-6">
        <div>
          <p class="text-slate-400 text-sm uppercase tracking-[0.28em]">Affiches Fidelopass</p>
          <h1 class="font-display text-3xl sm:text-4xl font-bold text-white mt-3">Préparez une affiche A4 prête à imprimer</h1>
          <p class="text-slate-400 text-sm sm:text-base mt-3 max-w-2xl">
            Choisissez un modèle, imprimez-le en A4 ou téléchargez uniquement le QR code pour vos supports en boutique.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <button id="download-qr" type="button" class="btn-secondary px-5 py-3 text-sm">Télécharger le QR</button>
          <button id="print-poster" type="button" class="btn-primary px-5 py-3 text-sm">Imprimer l'affiche</button>
        </div>
      </div>

      <div class="poster-ui flex flex-wrap gap-3 mb-6">
        <button type="button" class="poster-template-btn btn-secondary text-sm px-4 py-2.5" data-template="essential">Essentiel</button>
        <button type="button" class="poster-template-btn btn-secondary text-sm px-4 py-2.5" data-template="signature">Signature</button>
        <button type="button" class="poster-template-btn btn-secondary text-sm px-4 py-2.5" data-template="impact">Impact</button>
      </div>

      <div class="poster-ui card mb-6 border border-white/10 bg-slate-900/55 p-5">
        <p class="text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-sky-300/80">Personnalisation rapide</p>
        <div class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
          <div class="xl:col-span-2">
            <label for="poster-custom-title" class="text-xs font-medium text-slate-300">Titre principal</label>
            <input id="poster-custom-title" type="text" class="mt-1 w-full rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-2.5 text-sm text-slate-100 focus:border-sky-400 focus:outline-none" />
          </div>
          <div class="xl:col-span-2">
            <label for="poster-custom-subtitle" class="text-xs font-medium text-slate-300">Sous-titre</label>
            <input id="poster-custom-subtitle" type="text" class="mt-1 w-full rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-2.5 text-sm text-slate-100 focus:border-sky-400 focus:outline-none" />
          </div>
          <div class="xl:col-span-2">
            <label for="poster-custom-reward" class="text-xs font-medium text-slate-300">Texte récompense</label>
            <input id="poster-custom-reward" type="text" class="mt-1 w-full rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-2.5 text-sm text-slate-100 focus:border-sky-400 focus:outline-none" />
          </div>
          <div>
            <label for="poster-custom-accent" class="text-xs font-medium text-slate-300">Couleur accent</label>
            <input id="poster-custom-accent" type="color" value="#6366f1" class="mt-1 h-11 w-full cursor-pointer rounded-xl border border-slate-700 bg-slate-950/70 p-1" />
          </div>
          <div>
            <label for="poster-custom-bg" class="text-xs font-medium text-slate-300">Couleur fond</label>
            <input id="poster-custom-bg" type="color" value="#0f172a" class="mt-1 h-11 w-full cursor-pointer rounded-xl border border-slate-700 bg-slate-950/70 p-1" />
          </div>
        </div>
      </div>

      <div id="poster-loading" class="text-center py-16">
        <div class="w-8 h-8 border-2 border-indigo-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
        <p class="text-slate-400 text-sm">Préparation de l'affiche...</p>
      </div>

      <div id="poster-error" class="hidden text-center py-12">
        <div class="card p-8 max-w-xl mx-auto">
          <p class="text-red-400 font-semibold">Impossible de charger cette affiche.</p>
          <p class="text-slate-400 text-sm mt-2">Vérifiez que votre carte est bien publiée puis réessayez.</p>
        </div>
      </div>

      <div id="poster-stage" class="hidden">
        <div id="poster-sheet" class="poster-sheet mx-auto overflow-hidden shadow-2xl border border-white/10">

          <!-- ===================== TEMPLATE ESSENTIEL ===================== -->
          <div id="poster-essential" class="poster-variant hidden h-full bg-white text-slate-900">
            <!-- Top accent bar -->
            <div id="poster-essential-topbar" class="h-[7px] w-full"></div>
            <div class="poster-safe-zone h-full flex flex-col" style="padding-top:0.9cm">

              <!-- Header: logo + commerce + badge -->
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <img id="poster-essential-logo" src="" alt="" class="hidden w-[58px] h-[58px] rounded-2xl object-cover shadow" />
                  <div>
                    <p class="text-[9px] uppercase tracking-[0.38em] text-slate-400 font-semibold">Carte fidélité digitale</p>
                    <h2 id="poster-essential-commerce" class="font-display text-[1.85rem] leading-tight font-bold mt-1">Votre commerce</h2>
                  </div>
                </div>
                <div id="poster-essential-badge" class="shrink-0 px-4 py-1.5 rounded-full text-xs font-bold border tracking-wide">Carte fidélité</div>
              </div>

              <!-- Divider -->
              <div id="poster-essential-divider" class="mt-5 h-[2px] w-16 rounded-full"></div>

              <!-- Title block -->
              <div class="mt-5">
                <h3 id="poster-essential-title" class="font-display text-[2.5rem] leading-[1.06] font-bold max-w-[12cm]">
                  Scannez et rejoignez notre programme fidélité
                </h3>
                <p id="poster-essential-subtitle" class="text-[0.95rem] text-slate-500 mt-4 max-w-[13cm] leading-relaxed">
                  Bienvenue, créez votre carte fidélité en 10 secondes.
                </p>

                <!-- Feature pills -->
                <div class="flex flex-wrap gap-2 mt-5">
                  <span class="poster-pill">⚡ 10 secondes</span>
                  <span class="poster-pill">📱 Sans application</span>
                  <span class="poster-pill">✓ Apple & Google Wallet</span>
                </div>
              </div>

              <!-- Bottom: program card + QR block -->
              <div class="mt-auto grid grid-cols-[1fr_86mm] gap-5 items-end">
                <!-- Program card -->
                <div id="poster-essential-program" class="rounded-[1.1rem] p-6 text-white h-full flex flex-col justify-between">
                  <div>
                    <p class="text-[10px] uppercase tracking-[0.3em] opacity-75 font-semibold">Programme fidélité</p>
                    <p id="poster-essential-reward" class="font-display text-[1.75rem] leading-tight font-bold mt-3">10 achats = 1 récompense</p>
                  </div>
                  <!-- 3-step guide -->
                  <div class="mt-5 space-y-2.5">
                    <div class="flex items-center gap-3">
                      <span class="poster-step-num">1</span>
                      <span class="text-sm opacity-90">Scannez le QR code ci-contre</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="poster-step-num">2</span>
                      <span class="text-sm opacity-90">Ajoutez la carte à votre Wallet</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="poster-step-num">3</span>
                      <span class="text-sm opacity-90">Cumulez vos avantages à chaque achat</span>
                    </div>
                  </div>
                  <p class="text-[10px] opacity-50 mt-5">Propulsé par Fidelopass</p>
                </div>

                <!-- QR block -->
                <div class="rounded-[1.1rem] border border-slate-200 bg-slate-50 p-4 text-center flex flex-col items-center">
                  <p class="text-[9px] uppercase tracking-[0.3em] text-slate-400 font-semibold mb-3">Scannez ici</p>
                  <img id="poster-essential-qr" src="" alt="QR code Fidelopass" class="w-[72mm] h-[72mm] rounded-xl" />
                  <p class="text-xs font-bold text-slate-700 mt-3">↑ Pointez votre caméra</p>
                  <!-- Wallet badges -->
                  <div class="flex gap-2 mt-3 justify-center">
                    <span class="poster-wallet-badge">🍎 Apple</span>
                    <span class="poster-wallet-badge">📱 Google</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ===================== TEMPLATE SIGNATURE ===================== -->
          <div id="poster-signature" class="poster-variant hidden h-full text-slate-900 bg-white">
            <div class="h-full relative overflow-hidden">
              <!-- Dark banner top -->
              <div id="poster-signature-banner" class="absolute inset-x-0 top-0 h-[34%]"></div>
              <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(180deg,rgba(0,0,0,0.18) 0%,transparent 40%,rgba(0,0,0,0.08) 100%)"></div>

              <div class="poster-safe-zone relative z-10 h-full flex flex-col">
                <!-- Header -->
                <div class="flex items-start justify-between gap-5">
                  <div class="max-w-[12.5cm] text-white">
                    <p class="text-[9px] uppercase tracking-[0.38em] text-white/60 font-semibold">Carte fidélité digitale</p>
                    <h2 id="poster-signature-commerce" class="font-display text-[2.2rem] leading-tight font-bold mt-2">Votre commerce</h2>
                    <p id="poster-signature-copy" class="text-[0.95rem] text-white/85 mt-3.5 leading-relaxed">
                      Scannez, ajoutez votre carte et profitez de vos avantages à chaque passage.
                    </p>
                    <!-- Feature row -->
                    <div class="flex flex-wrap gap-2 mt-4">
                      <span class="poster-pill-light">⚡ 10 sec</span>
                      <span class="poster-pill-light">📱 Sans app</span>
                      <span class="poster-pill-light">✓ Apple & Google</span>
                    </div>
                  </div>
                  <img id="poster-signature-logo" src="" alt="" class="hidden w-[60px] h-[60px] rounded-2xl object-cover border-2 border-white/30 shadow-xl" />
                </div>

                <!-- Bottom: QR left + info right -->
                <div class="mt-auto grid grid-cols-[90mm_1fr] gap-5 items-end">
                  <!-- QR card -->
                  <div class="rounded-[1.2rem] bg-white p-4 text-center shadow-2xl border border-slate-100">
                    <p class="text-[9px] uppercase tracking-[0.3em] text-slate-400 font-semibold mb-3">Scannez ici</p>
                    <img id="poster-signature-qr" src="" alt="QR code Fidelopass" class="w-[76mm] h-[76mm] mx-auto rounded-xl" />
                    <p class="text-xs font-bold text-slate-700 mt-3">↑ Pointez votre caméra</p>
                    <div class="flex gap-2 mt-2.5 justify-center">
                      <span class="poster-wallet-badge">🍎 Apple</span>
                      <span class="poster-wallet-badge">📱 Google</span>
                    </div>
                  </div>

                  <!-- Info card -->
                  <div id="poster-signature-infocard" class="rounded-[1.2rem] border border-white/15 p-5 text-white h-full flex flex-col justify-between" style="background:rgba(255,255,255,0.10);backdrop-filter:blur(12px)">
                    <div>
                      <p class="text-[10px] uppercase tracking-[0.26em] text-white/60 font-semibold">Votre récompense</p>
                      <p id="poster-signature-reward" class="font-display text-[1.75rem] leading-tight font-bold mt-2">Récompense fidélité</p>
                    </div>
                    <div class="mt-4 space-y-2.5">
                      <div class="flex items-center gap-3">
                        <span class="poster-step-num-light">1</span>
                        <span class="text-sm text-white/85">Scannez le QR code</span>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="poster-step-num-light">2</span>
                        <span class="text-sm text-white/85">Ajoutez à votre Wallet</span>
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="poster-step-num-light">3</span>
                        <span class="text-sm text-white/85">Cumulez à chaque achat</span>
                      </div>
                    </div>
                    <p class="text-[9px] text-white/40 mt-5">Propulsé par Fidelopass</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ===================== TEMPLATE IMPACT ===================== -->
          <div id="poster-impact" class="poster-variant hidden h-full">
            <div id="poster-impact-bg" class="h-full w-full flex flex-col relative overflow-hidden">
              <!-- Decorative circles -->
              <div id="poster-impact-circle1" class="absolute -top-[80px] -right-[80px] w-[320px] h-[320px] rounded-full opacity-20"></div>
              <div id="poster-impact-circle2" class="absolute -bottom-[60px] -left-[60px] w-[240px] h-[240px] rounded-full opacity-15"></div>

              <div class="poster-safe-zone relative z-10 h-full flex flex-col items-center text-center text-white">
                <!-- Logo + commerce -->
                <div class="flex flex-col items-center gap-3">
                  <img id="poster-impact-logo" src="" alt="" class="hidden w-[80px] h-[80px] rounded-[1.4rem] object-cover shadow-2xl border-2 border-white/30" />
                  <div>
                    <p class="text-[9px] uppercase tracking-[0.42em] text-white/55 font-semibold">Carte fidélité digitale</p>
                    <h2 id="poster-impact-commerce" class="font-display text-[2.1rem] leading-tight font-bold mt-2">Votre commerce</h2>
                  </div>
                </div>

                <!-- Big headline -->
                <div class="mt-6 max-w-[14cm]">
                  <h3 id="poster-impact-title" class="font-display text-[3.1rem] leading-[1.02] font-bold">
                    Rejoignez notre programme fidélité
                  </h3>
                  <p id="poster-impact-subtitle" class="text-[1rem] text-white/75 mt-4 leading-relaxed">
                    Créez votre carte en 10 secondes, sans téléchargement.
                  </p>
                </div>

                <!-- Reward pill -->
                <div id="poster-impact-reward-pill" class="mt-6 px-6 py-3 rounded-full border border-white/30 bg-white/15 backdrop-blur-sm">
                  <p id="poster-impact-reward" class="font-display text-[1.35rem] font-bold">10 achats = 1 récompense</p>
                </div>

                <!-- 3 steps horizontal -->
                <div class="mt-6 flex items-center gap-0 w-full max-w-[13cm]">
                  <div class="flex-1 flex flex-col items-center gap-2">
                    <div id="poster-impact-stepbg" class="w-10 h-10 rounded-full flex items-center justify-center text-[1rem] font-bold border border-white/25 bg-white/20">1</div>
                    <p class="text-xs text-white/80 font-medium">Scannez</p>
                  </div>
                  <div class="flex-shrink-0 text-white/30 text-lg px-2">→</div>
                  <div class="flex-1 flex flex-col items-center gap-2">
                    <div id="poster-impact-stepbg2" class="w-10 h-10 rounded-full flex items-center justify-center text-[1rem] font-bold border border-white/25 bg-white/20">2</div>
                    <p class="text-xs text-white/80 font-medium">Ajoutez</p>
                  </div>
                  <div class="flex-shrink-0 text-white/30 text-lg px-2">→</div>
                  <div class="flex-1 flex flex-col items-center gap-2">
                    <div id="poster-impact-stepbg3" class="w-10 h-10 rounded-full flex items-center justify-center text-[1rem] font-bold border border-white/25 bg-white/20">3</div>
                    <p class="text-xs text-white/80 font-medium">Profitez</p>
                  </div>
                </div>

                <!-- QR code -->
                <div class="mt-auto bg-white rounded-[1.4rem] p-4 shadow-2xl">
                  <img id="poster-impact-qr" src="" alt="QR code Fidelopass" class="w-[80mm] h-[80mm] rounded-xl mx-auto" />
                  <p class="text-slate-800 text-xs font-bold mt-3">↑ Scannez avec votre caméra</p>
                  <div class="flex gap-2 mt-2 justify-center">
                    <span class="poster-wallet-badge">🍎 Apple Wallet</span>
                    <span class="poster-wallet-badge">📱 Google Wallet</span>
                  </div>
                </div>

                <p class="text-[9px] text-white/30 mt-4">Propulsé par Fidelopass</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .poster-sheet {
    width: min(100%, 860px);
    aspect-ratio: 210 / 297;
    border-radius: 1.5rem;
  }

  .poster-safe-zone {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 1.2cm;
  }

  .poster-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    letter-spacing: 0.01em;
  }

  .poster-pill-light {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    background: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.9);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(6px);
    letter-spacing: 0.01em;
  }

  .poster-step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(255,255,255,0.22);
    border: 1px solid rgba(255,255,255,0.3);
    flex-shrink: 0;
  }

  .poster-step-num-light {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.25);
    flex-shrink: 0;
  }

  .poster-wallet-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 600;
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #e2e8f0;
  }

  @page {
    size: A4 portrait;
    margin: 0;
  }

  @media print {
    html, body {
      width: 210mm;
      height: 297mm;
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    nav,
    header,
    footer,
    .poster-ui,
    #poster-loading,
    #poster-error {
      display: none !important;
    }

    main,
    .min-h-screen,
    #poster-stage {
      margin: 0 !important;
      padding: 0 !important;
      min-height: auto !important;
      width: 210mm !important;
      height: 297mm !important;
      background: #fff !important;
    }

    #poster-sheet {
      width: 210mm !important;
      height: 297mm !important;
      aspect-ratio: auto !important;
      border: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      margin: 0 !important;
      overflow: hidden !important;
      page-break-inside: avoid;
    }

    .poster-safe-zone {
      padding: 12mm !important;
    }
  }
</style>

<script define:vars={{ apiBase, carteId: id }}>
  const API = apiBase;
  const qrBase = 'https://api.qrserver.com/v1/create-qr-code/';
  const params = new URLSearchParams(window.location.search);
  const TEMPLATE_ALIASES = {
    minimal: 'essential',
    premium: 'signature',
    promo: 'impact',
    essential: 'essential',
    signature: 'signature',
    impact: 'impact',
  };
  let currentTemplate = normalizeTemplate(params.get('template'));
  const customTitleInput = document.getElementById('poster-custom-title');
  const customSubtitleInput = document.getElementById('poster-custom-subtitle');
  const customRewardInput = document.getElementById('poster-custom-reward');
  const customAccentInput = document.getElementById('poster-custom-accent');
  const customBgInput = document.getElementById('poster-custom-bg');
  let posterBase = null;

  function normalizeTemplate(value) {
    const key = String(value || '').trim().toLowerCase();
    return TEMPLATE_ALIASES[key] || 'essential';
  }

  function apiUrl(path) {
    return `${API}${path}`;
  }

  function qrUrl(cardId, size = 720) {
    return `${qrBase}?size=${size}x${size}&data=${encodeURIComponent(`${window.location.origin}/carte/${cardId}`)}&bgcolor=ffffff&color=111827&qzone=1`;
  }

  function rewardSummary(data) {
    const tiers = Array.isArray(data.carte.rewards_config) ? data.carte.rewards_config : [];
    if (tiers.length) {
      return tiers.map((item) => `${item.seuil} ${data.carte.type === 'points' ? 'pts' : 'tampons'} = ${item.recompense}`).join(' • ');
    }
    return data.carte.recompense_description || 'Récompense fidélité';
  }

  function setImage(id, src) {
    const img = document.getElementById(id);
    if (!img || !src) return;
    img.src = src;
    img.classList.remove('hidden');
  }

  function hexToRgb(hex) {
    const h = hex.replace('#', '');
    const r = parseInt(h.substring(0, 2), 16);
    const g = parseInt(h.substring(2, 4), 16);
    const b = parseInt(h.substring(4, 6), 16);
    return { r, g, b };
  }

  function lightenHex(hex, amount = 40) {
    const { r, g, b } = hexToRgb(hex);
    return `rgb(${Math.min(255, r + amount)},${Math.min(255, g + amount)},${Math.min(255, b + amount)})`;
  }

  function applyCustomizations() {
    if (!posterBase) return;

    const title = (customTitleInput?.value || '').trim() || posterBase.defaultTitle;
    const subtitle = (customSubtitleInput?.value || '').trim() || posterBase.defaultSubtitle;
    const reward = (customRewardInput?.value || '').trim() || posterBase.defaultReward;
    const accent = (customAccentInput?.value || posterBase.defaultAccent || '#6366f1').trim();
    const background = (customBgInput?.value || posterBase.defaultBackground || '#0f172a').trim();
    const lighter = lightenHex(accent, 30);

    // Essential
    document.getElementById('poster-essential-title').textContent = title;
    document.getElementById('poster-essential-subtitle').textContent = subtitle;
    document.getElementById('poster-essential-reward').textContent = reward;
    document.getElementById('poster-essential-topbar').style.background = `linear-gradient(90deg, ${background}, ${accent})`;
    document.getElementById('poster-essential-divider').style.background = `linear-gradient(90deg, ${accent}, ${background})`;
    document.getElementById('poster-essential-badge').style.background = `${accent}22`;
    document.getElementById('poster-essential-badge').style.color = accent;
    document.getElementById('poster-essential-badge').style.borderColor = `${accent}44`;
    document.getElementById('poster-essential-program').style.background = `linear-gradient(135deg, ${background} 0%, ${accent} 100%)`;

    // Signature
    document.getElementById('poster-signature-copy').textContent = subtitle;
    document.getElementById('poster-signature-reward').textContent = reward;
    document.getElementById('poster-signature-banner').style.background = posterBase.stripUrl
      ? `linear-gradient(rgba(15,23,42,0.34), rgba(15,23,42,0.55)), url("${posterBase.stripUrl}") center/cover`
      : `linear-gradient(135deg, ${background} 0%, ${accent} 100%)`;
    document.getElementById('poster-signature-infocard').style.background = `linear-gradient(135deg, ${background}cc 0%, ${accent}99 100%)`;

    // Impact
    document.getElementById('poster-impact-title').textContent = title;
    document.getElementById('poster-impact-subtitle').textContent = subtitle;
    document.getElementById('poster-impact-reward').textContent = reward;
    document.getElementById('poster-impact-bg').style.background = `linear-gradient(160deg, ${background} 0%, ${accent} 100%)`;
    document.getElementById('poster-impact-circle1').style.background = lighter;
    document.getElementById('poster-impact-circle2').style.background = accent;
  }

  function renderTemplate(name) {
    currentTemplate = normalizeTemplate(name);
    document.querySelectorAll('.poster-variant').forEach((node) => node.classList.add('hidden'));
    document.getElementById(`poster-${currentTemplate}`)?.classList.remove('hidden');
    document.querySelectorAll('.poster-template-btn').forEach((button) => {
      const active = button.dataset.template === currentTemplate;
      button.className = active
        ? 'poster-template-btn btn-primary text-sm px-4 py-2.5'
        : 'poster-template-btn btn-secondary text-sm px-4 py-2.5';
    });
    const nextUrl = new URL(window.location.href);
    nextUrl.searchParams.set('template', currentTemplate);
    window.history.replaceState({}, '', nextUrl);
  }

  async function downloadQr() {
    const response = await fetch(qrUrl(carteId, 1200));
    const blob = await response.blob();
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `fidelopass-qr-${carteId}.png`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  }

  async function loadPoster() {
    try {
      const response = await fetch(apiUrl(`/api/cartes/${carteId}/public`));
      if (!response.ok) throw new Error();
      const { data } = await response.json();

      const commerceName = data.commerce.nom;
      const message = data.carte.welcome_message || `Bienvenue chez ${commerceName}, créez votre carte fidélité en 10 secondes.`;
      const reward = rewardSummary(data);
      const qr = qrUrl(carteId);
      const logo = data.carte.logo_url ?? data.commerce.logo_url ?? '';
      const typeLabel = data.carte.type === 'points' ? 'Carte à points' : 'Carte à tampons';
      const accent = data.carte.couleur_accent ?? '#6366f1';
      const fond = data.carte.couleur_fond ?? '#0f172a';
      const defaultTitle = `Scannez pour rejoindre ${commerceName}`;

      // Essential
      document.getElementById('poster-essential-commerce').textContent = commerceName;
      document.getElementById('poster-essential-title').textContent = defaultTitle;
      document.getElementById('poster-essential-subtitle').textContent = message;
      document.getElementById('poster-essential-reward').textContent = reward;
      document.getElementById('poster-essential-badge').textContent = typeLabel;

      // Signature
      document.getElementById('poster-signature-commerce').textContent = commerceName;
      document.getElementById('poster-signature-copy').textContent = message;
      document.getElementById('poster-signature-reward').textContent = reward;

      // Impact
      document.getElementById('poster-impact-commerce').textContent = commerceName;
      document.getElementById('poster-impact-title').textContent = defaultTitle;
      document.getElementById('poster-impact-subtitle').textContent = message;
      document.getElementById('poster-impact-reward').textContent = reward;

      // QR codes
      ['poster-essential-qr', 'poster-signature-qr', 'poster-impact-qr'].forEach((elementId) => {
        document.getElementById(elementId).src = qr;
      });

      // Logos
      setImage('poster-essential-logo', logo);
      setImage('poster-signature-logo', logo);
      setImage('poster-impact-logo', logo);

      posterBase = {
        defaultTitle,
        defaultSubtitle: message,
        defaultReward: reward,
        defaultAccent: accent,
        defaultBackground: fond,
        stripUrl: data.carte.strip_url ?? null,
      };

      if (customTitleInput) customTitleInput.value = defaultTitle;
      if (customSubtitleInput) customSubtitleInput.value = message;
      if (customRewardInput) customRewardInput.value = reward;
      if (customAccentInput) customAccentInput.value = accent;
      if (customBgInput) customBgInput.value = fond;

      document.getElementById('poster-loading').classList.add('hidden');
      document.getElementById('poster-stage').classList.remove('hidden');
      renderTemplate(currentTemplate);
      applyCustomizations();
    } catch {
      document.getElementById('poster-loading').classList.add('hidden');
      document.getElementById('poster-error').classList.remove('hidden');
    }
  }

  document.getElementById('print-poster').addEventListener('click', () => window.print());
  document.getElementById('download-qr').addEventListener('click', downloadQr);
  document.querySelectorAll('.poster-template-btn').forEach((button) => {
    button.addEventListener('click', () => renderTemplate(button.dataset.template || 'essential'));
  });
  [customTitleInput, customSubtitleInput, customRewardInput, customAccentInput, customBgInput]
    .filter(Boolean)
    .forEach((field) => field.addEventListener('input', applyCustomizations));

  loadPoster();
</script>
