---
import ResellerLayout from '../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Commerçants revendeur — Fidelopass" activeNav="merchants">
  <section class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-sky-700/75">Portefeuille clients</p>
        <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-slate-950">Commerçants</h1>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
          Suivez les commerçants rattachés à votre lien revendeur: prospects, paiements, clients actifs et marges.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/reseller/link" class="inline-flex w-fit items-center rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-500 px-5 py-3 text-sm font-semibold text-white shadow-[0_20px_36px_-24px_rgba(37,99,235,0.8)] transition hover:-translate-y-0.5">
          Configurer mon lien
        </a>
        <a href="/reseller/merchants/new" class="inline-flex w-fit items-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-sky-200 hover:text-sky-800">
          Ajout manuel
        </a>
      </div>
    </div>

    <section class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
      <article class="rounded-[1.7rem] border border-sky-100 bg-white/90 p-6 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-blue-700">Parcours recommandé</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-950">Partagez votre lien, Fidelopass rattache automatiquement les clients.</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Configurez vos prix une seule fois, copiez votre lien public, puis chaque commerçant inscrit via ce lien arrive ici avec son statut et son résumé financier.
        </p>
      </article>
      <article class="rounded-[1.7rem] border border-violet-100 bg-gradient-to-br from-violet-50 to-sky-50 p-6">
        <p class="text-sm font-semibold text-slate-700">Étapes</p>
        <div class="mt-4 grid gap-2 text-sm font-semibold text-slate-700">
          <span class="rounded-2xl bg-white/80 px-4 py-3">1. Configurer les prix et marges</span>
          <span class="rounded-2xl bg-white/80 px-4 py-3">2. Prévisualiser la page publique</span>
          <span class="rounded-2xl bg-white/80 px-4 py-3">3. Partager le lien au commerçant</span>
        </div>
      </article>
    </section>

    <section class="rounded-[1.7rem] border border-sky-100 bg-white/90 p-4 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="text-[0.68rem] uppercase tracking-[0.2em] text-slate-500">
            <tr>
              <th class="px-4 py-3">Commerce</th>
              <th class="px-4 py-3">Plan</th>
              <th class="px-4 py-3">Prix payé</th>
              <th class="px-4 py-3">Marge</th>
              <th class="px-4 py-3">Paiement</th>
              <th class="px-4 py-3">Statut</th>
              <th class="px-4 py-3">Action</th>
            </tr>
          </thead>
          <tbody id="merchant-rows" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </section>
  </section>
</ResellerLayout>

<script>
  import { authFetch } from '../../lib/api';

  const formatMoney = (cents: unknown, currency = 'eur') => new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: String(currency || 'eur').toUpperCase(),
    maximumFractionDigits: 0,
  }).format(Number(cents ?? 0) / 100);

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function statusBadge(status: string) {
    const normalized = String(status ?? 'pending').toLowerCase();
    const color = ['active', 'trialing'].includes(normalized)
      ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
      : ['past_due', 'suspended', 'cancelled', 'canceled'].includes(normalized)
        ? 'bg-red-50 text-red-700 border-red-200'
        : 'bg-amber-50 text-amber-700 border-amber-200';
    return `<span class="rounded-full border ${color} px-3 py-1 text-xs font-semibold">${escapeHtml(normalized)}</span>`;
  }

  async function loadMerchants() {
    const res = await authFetch('/api/reseller/merchants');
    const payload = await res.json().catch(() => null);
    const rows = document.getElementById('merchant-rows')!;
    const merchants = Array.isArray(payload?.data) ? payload.data : [];
    if (!res.ok || !merchants.length) {
      rows.innerHTML = `<tr><td colspan="7" class="px-4 py-8 text-center text-slate-500">${res.ok ? 'Aucun commerçant pour le moment.' : escapeHtml(payload?.error ?? 'Chargement impossible.')}</td></tr>`;
      return;
    }
    rows.innerHTML = merchants.map((merchant: any) => `
      <tr class="align-top">
        <td class="px-4 py-4">
          <p class="font-semibold text-slate-950">${escapeHtml(merchant.merchant_name ?? merchant.commerce?.nom ?? 'Commerce')}</p>
          <p class="text-xs text-slate-500">${escapeHtml(merchant.merchant_email ?? '')}</p>
        </td>
        <td class="px-4 py-4 font-semibold text-slate-800">${escapeHtml(merchant.plan)}</td>
        <td class="px-4 py-4">${formatMoney(merchant.reseller_price_cents, merchant.currency)}</td>
        <td class="px-4 py-4">${formatMoney(merchant.reseller_margin_cents, merchant.currency)}</td>
        <td class="px-4 py-4">${escapeHtml(merchant.payment_mode)}</td>
        <td class="px-4 py-4">${statusBadge(merchant.subscription_status)}</td>
        <td class="px-4 py-4">
          <div class="flex flex-wrap gap-2">
            <a href="/reseller/merchants/${merchant.id}" class="rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-800">Voir</a>
            <button type="button" data-delete-merchant="${escapeHtml(merchant.id)}" class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">Supprimer</button>
          </div>
        </td>
      </tr>
    `).join('');
    document.querySelectorAll('[data-delete-merchant]').forEach((button) => {
      button.addEventListener('click', async () => {
        const merchantId = (button as HTMLButtonElement).dataset.deleteMerchant;
        if (!merchantId || !confirm('Supprimer ce commerçant revendeur ? Cette action est réservée aux commerçants sans abonnement actif.')) return;
        const res = await authFetch(`/api/reseller/merchants/${merchantId}`, { method: 'DELETE' });
        const payload = await res.json().catch(() => null);
        if (!res.ok) {
          alert(payload?.error ?? 'Suppression impossible.');
          return;
        }
        await loadMerchants();
      });
    });
  }

  await loadMerchants();
</script>
