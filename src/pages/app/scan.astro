---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Scanner — Fidelopass" deferSessionCheck>
  <div class="min-h-[100dvh] flex flex-col">
    <!-- Header -->
    <div class="scanner-header flex items-center justify-between gap-3 px-4 pb-3">
      <a href="/dashboard" class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-sky-100 bg-white/90 text-slate-500 shadow-sm transition-colors hover:text-slate-900">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div class="min-w-0 flex-1 text-center">
        <h1 class="font-display text-base font-bold text-slate-900">Scanner caisse</h1>
        <p id="scanner-status" class="truncate text-xs text-slate-500">Chargement du scanner...</p>
      </div>
      <img src="/favicon.png" alt="Fidelopass" class="h-10 w-10 rounded-xl border border-sky-100 bg-white shadow-sm" />
    </div>

    <!-- Zone scanner -->
    <div class="flex-1 flex flex-col items-center justify-center px-4 pb-5">
      <div class="relative w-full max-w-sm">
        <div class="scanner-reader-shell rounded-[2rem] border border-sky-100 bg-white p-3 shadow-[0_32px_70px_-42px_rgba(59,130,246,0.45)]">
          <div class="scanner-reader-frame relative overflow-hidden rounded-[1.4rem] border border-sky-100 bg-slate-950">
            <video id="camera-video" class="camera-video absolute inset-0 h-full w-full object-cover" playsinline muted autoplay></video>
            <canvas id="scan-canvas" class="hidden"></canvas>
            <div id="scanner-launch" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-slate-950 px-6 text-center text-white">
              <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-white/10 text-sky-200 shadow-[0_20px_60px_-30px_rgba(56,189,248,0.8)]">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 7h2M15 7h2M7 17h2M15 17h2M5 10V8a3 3 0 0 1 3-3h2M19 10V8a3 3 0 0 0-3-3h-2M5 14v2a3 3 0 0 0 3 3h2M19 14v2a3 3 0 0 1-3 3h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </div>
              <p id="scanner-launch-title" class="font-display text-xl font-bold">Scanner caméra</p>
              <p id="scanner-launch-text" class="mt-2 max-w-[15rem] text-sm leading-6 text-slate-300">
                Touchez le bouton pour autoriser la caméra et scanner une carte client.
              </p>
              <button id="btn-start-camera" type="button" class="mt-5 inline-flex min-h-12 w-full max-w-[15rem] items-center justify-center rounded-2xl bg-white px-5 py-3 text-sm font-bold text-slate-950 shadow-[0_18px_45px_-25px_rgba(255,255,255,0.75)] transition hover:-translate-y-0.5 hover:bg-sky-50 active:translate-y-0">
                Démarrer le scanner
              </button>
            </div>
            <div id="scanner-loading" class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-slate-950/92 px-6 text-center text-white">
              <div class="h-10 w-10 animate-spin rounded-full border-2 border-white/20 border-t-sky-300"></div>
              <p class="mt-4 text-sm font-semibold">Ouverture de la caméra...</p>
              <p class="mt-1 text-xs text-slate-300">Acceptez la demande du navigateur si elle apparaît.</p>
            </div>
            <div class="pointer-events-none absolute inset-4 z-10 rounded-[1.15rem] border border-white/70 shadow-[0_0_30px_rgba(59,130,246,0.28)]"></div>
          </div>
        </div>
      </div>
      <div class="mt-4 w-full max-w-sm text-center">
        <p class="text-sm font-semibold text-slate-900">Placez le code dans le cadre</p>
        <a href="/app/install" class="mt-2 inline-flex text-xs font-semibold text-sky-700 transition hover:text-sky-900">
          Installer l’icône scanner
        </a>
        <div id="camera-help" class="hidden mt-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-4 text-left">
          <p class="text-amber-900 text-sm font-semibold">Autorisation caméra nécessaire</p>
          <p id="camera-help-text" class="text-amber-800/80 text-xs mt-1 leading-relaxed">
            Autorisez la caméra pour scanner directement la carte du client.
          </p>
          <button id="btn-camera-permission" type="button" class="btn-primary w-full py-3 mt-3">
            Autoriser la caméra
          </button>
        </div>
      </div>
    </div>

    <!-- Résultat scan -->
    <div id="scan-result" class="hidden fixed inset-0 bg-navy-900/95 backdrop-blur-sm flex flex-col items-center justify-center px-6 z-50">
      <div class="card w-full max-w-sm p-5 text-center">
        <h2 id="result-nom" class="mb-1 font-display text-xl font-bold text-slate-900">—</h2>
        <p id="result-solde" class="text-sm text-slate-600">—</p>
        <p id="result-rewards" class="mb-5 mt-2 text-xs font-semibold text-emerald-700">Récompenses disponibles: 0</p>

        <div class="flex gap-3 mb-4">
          <button id="btn-tampon" class="btn-primary flex-1 py-4 flex flex-col items-center">
            <span class="mb-1 inline-flex h-8 w-8 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M8 5h8a2 2 0 0 1 2 2v10l-6-3-6 3V7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-sm">+1 tampon</span>
          </button>
          <button id="btn-points" class="btn-secondary flex-1 py-4 flex flex-col items-center">
            <span class="mb-1 inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-50 text-amber-500">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="m12 3.5 2.59 5.25 5.8.84-4.2 4.09.99 5.77L12 16.73 6.82 19.45l.99-5.77-4.2-4.09 5.8-.84L12 3.5Z" />
              </svg>
            </span>
            <span class="text-sm">+points</span>
          </button>
        </div>

        <button id="btn-reward" class="hidden btn-secondary mb-4 w-full border-emerald-200 py-3 text-emerald-700 hover:bg-emerald-50">
          Utiliser 1 récompense
        </button>

        <button id="btn-close" class="btn-secondary w-full py-3">Scanner un autre client</button>
      </div>
    </div>

    <div id="points-modal" class="hidden fixed inset-0 bg-navy-950/90 backdrop-blur-sm z-[60] flex items-center justify-center px-6">
      <div class="card w-full max-w-xs p-5">
        <h2 class="font-display text-lg font-bold text-slate-900">Ajouter des points</h2>
        <p class="mb-4 mt-1 text-sm text-slate-500">Entrez le nombre de points à créditer.</p>
        <input id="points-value" type="number" min="1" step="1" inputmode="numeric" class="input text-center text-xl font-mono" placeholder="10" />
        <div class="grid grid-cols-2 gap-3 mt-4">
          <button id="btn-cancel-points" type="button" class="btn-secondary py-3">Annuler</button>
          <button id="btn-confirm-points" type="button" class="btn-primary py-3">Ajouter</button>
        </div>
      </div>
    </div>

    <div id="scan-toast" class="hidden fixed left-4 right-4 bottom-6 z-[70] rounded-2xl border border-emerald-400/30 bg-emerald-500/15 px-4 py-3 text-center text-sm font-semibold text-emerald-100 shadow-2xl backdrop-blur-md"></div>
  </div>
</AppLayout>

<style is:global>
  .scanner-header {
    padding-top: max(1rem, calc(env(safe-area-inset-top) + 0.6rem));
  }

  .scanner-reader-shell {
    position: relative;
  }

  .scanner-reader-frame {
    aspect-ratio: 4 / 5;
  }

  .camera-video {
    background: #020617;
    border-radius: 1rem;
  }
</style>

<script>
  import { authFetch } from '../../lib/api';
  import jsQR from 'jsqr';
  import {
    BarcodeFormat,
    BinaryBitmap,
    DecodeHintType,
    HybridBinarizer,
    MultiFormatReader,
    RGBLuminanceSource,
  } from '@zxing/library';

  let currentClientId: string | null = null;
  let currentClientRecompenses = 0;
  let currentProgramType: 'tampons' | 'points' = 'tampons';
  let scannerPaused = false;
  let audioContext: AudioContext | null = null;
  let confettiPromise: Promise<any> | null = null;
  let toastTimeout: ReturnType<typeof setTimeout> | null = null;
  let mediaStream: MediaStream | null = null;
  let scanFrameId: number | null = null;
  let lastDecodeAttemptAt = 0;
  const barcodeReader = new MultiFormatReader();
  const barcodeHints = new Map<DecodeHintType, unknown>();
  barcodeHints.set(DecodeHintType.POSSIBLE_FORMATS, [
    BarcodeFormat.QR_CODE,
    BarcodeFormat.CODE_128,
    BarcodeFormat.PDF_417,
    BarcodeFormat.AZTEC,
    BarcodeFormat.EAN_13,
    BarcodeFormat.EAN_8,
    BarcodeFormat.UPC_A,
    BarcodeFormat.UPC_E,
    BarcodeFormat.CODE_39,
    BarcodeFormat.CODE_93,
    BarcodeFormat.ITF,
    BarcodeFormat.CODABAR,
  ]);
  barcodeHints.set(DecodeHintType.TRY_HARDER, true);
  barcodeReader.setHints(barcodeHints);

  const scannerStatus = document.getElementById('scanner-status')!;
  const cameraHelp = document.getElementById('camera-help')!;
  const cameraHelpText = document.getElementById('camera-help-text')!;
  const cameraPermissionBtn = document.getElementById('btn-camera-permission') as HTMLButtonElement;
  const startCameraBtn = document.getElementById('btn-start-camera') as HTMLButtonElement;
  const scannerLaunch = document.getElementById('scanner-launch')!;
  const scannerLaunchTitle = document.getElementById('scanner-launch-title')!;
  const scannerLaunchText = document.getElementById('scanner-launch-text')!;
  const scannerLoading = document.getElementById('scanner-loading')!;
  const scanToast = document.getElementById('scan-toast')!;
  const cameraVideo = document.getElementById('camera-video') as HTMLVideoElement;
  const scanCanvas = document.getElementById('scan-canvas') as HTMLCanvasElement;
  const scanContext = scanCanvas.getContext('2d', { willReadFrequently: true });
  let scannerStarting = false;
  const CAMERA_CACHE_KEY = 'fidelopass_scanner_camera_id';
  const API_TIMEOUT_MS = Number(import.meta.env.PUBLIC_API_FETCH_TIMEOUT_MS ?? 8000);
  const DECODE_INTERVAL_MS = 120;
  const MAX_DECODE_WIDTH = 900;

  function decodeMultiFormatBarcode(imageData: ImageData, width: number, height: number) {
    try {
      const luminanceSource = new RGBLuminanceSource(imageData.data, width, height);
      const binaryBitmap = new BinaryBitmap(new HybridBinarizer(luminanceSource));
      const result = barcodeReader.decodeWithState(binaryBitmap);
      return result.getText()?.trim() || null;
    } catch {
      return null;
    }
  }

  function withTimeout<T>(promise: Promise<T>, timeoutMs: number): Promise<T> {
    return Promise.race([
      promise,
      new Promise<T>((_, reject) => window.setTimeout(() => reject(new Error('timeout')), timeoutMs)),
    ]);
  }

  async function authFetchWithTimeout(path: string, init?: RequestInit): Promise<Response> {
    return withTimeout(authFetch(path, init), API_TIMEOUT_MS);
  }

  async function readApiError(res: Response, fallback: string) {
    const payload = await res.json().catch(() => null);
    if (res.status === 401) return 'Session expirée. Reconnectez-vous au compte commerçant pour utiliser le scanner.';
    if (res.status === 402) return 'Abonnement requis pour utiliser le scanner.';
    return String(payload?.error ?? fallback);
  }

  function setScannerStatus(message: string) {
    scannerStatus.textContent = message;
  }

  function showLaunchOverlay(title: string, text: string, buttonText = 'Démarrer le scanner') {
    scannerLaunchTitle.textContent = title;
    scannerLaunchText.textContent = text;
    startCameraBtn.textContent = buttonText;
    startCameraBtn.disabled = false;
    scannerLoading.classList.add('hidden');
    scannerLaunch.classList.remove('hidden');
  }

  function showScannerLoading() {
    startCameraBtn.disabled = true;
    scannerLaunch.classList.add('hidden');
    scannerLoading.classList.remove('hidden');
  }

  function hideScannerOverlays() {
    scannerLaunch.classList.add('hidden');
    scannerLoading.classList.add('hidden');
    startCameraBtn.disabled = false;
  }

  function getAudioContext() {
    const AudioContextClass =
      window.AudioContext ?? (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!AudioContextClass) return null;
    audioContext ??= new AudioContextClass();
    return audioContext;
  }

  function unlockAudio() {
    const context = getAudioContext();
    if (context?.state === 'suspended') {
      context.resume().catch(() => {});
    }
  }

  function playBeep(type: 'scan' | 'success' = 'scan') {
    const context = getAudioContext();
    if (!context) return;

    const now = context.currentTime;
    const oscillator = context.createOscillator();
    const gain = context.createGain();
    oscillator.type = type === 'success' ? 'triangle' : 'sine';
    oscillator.frequency.setValueAtTime(type === 'success' ? 880 : 660, now);
    if (type === 'success') {
      oscillator.frequency.exponentialRampToValueAtTime(1320, now + 0.08);
    }

    gain.gain.setValueAtTime(0.001, now);
    gain.gain.exponentialRampToValueAtTime(type === 'success' ? 0.18 : 0.13, now + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.001, now + (type === 'success' ? 0.16 : 0.09));

    oscillator.connect(gain);
    gain.connect(context.destination);
    oscillator.start(now);
    oscillator.stop(now + (type === 'success' ? 0.18 : 0.11));
  }

  function showToast(message: string, tone: 'success' | 'error' = 'success') {
    if (toastTimeout) clearTimeout(toastTimeout);
    scanToast.textContent = message;
    scanToast.classList.remove('border-emerald-400/30', 'bg-emerald-500/15', 'text-emerald-100');
    scanToast.classList.remove('border-red-300/40', 'bg-red-500/15', 'text-red-100');
    if (tone === 'error') {
      scanToast.classList.add('border-red-300/40', 'bg-red-500/15', 'text-red-100');
    } else {
      scanToast.classList.add('border-emerald-400/30', 'bg-emerald-500/15', 'text-emerald-100');
    }
    scanToast.classList.remove('hidden');
    toastTimeout = setTimeout(() => scanToast.classList.add('hidden'), 2200);
  }

  function showCameraHelp(message: string) {
    cameraHelpText.textContent = message;
    cameraHelp.classList.remove('hidden');
  }

  function hideCameraHelp() {
    cameraHelp.classList.add('hidden');
  }

  function rememberCameraId(deviceId: string | null) {
    if (!deviceId) return;
    try {
      localStorage.setItem(CAMERA_CACHE_KEY, deviceId);
    } catch {
      // Stockage best-effort.
    }
  }

  function readRememberedCameraId(): string | null {
    try {
      return localStorage.getItem(CAMERA_CACHE_KEY);
    } catch {
      return null;
    }
  }

  function forgetRememberedCameraId() {
    try {
      localStorage.removeItem(CAMERA_CACHE_KEY);
    } catch {
      // Stockage best-effort.
    }
  }

  function defaultCameraConstraints(): MediaTrackConstraints {
    return {
      facingMode: { ideal: 'environment' },
      width: { ideal: 1280, max: 1920 },
      height: { ideal: 720, max: 1080 },
    };
  }

  function cameraAttempts(): MediaStreamConstraints[] {
    const rememberedCameraId = readRememberedCameraId();
    const attempts: MediaStreamConstraints[] = [];
    if (rememberedCameraId) {
      attempts.push({ video: { deviceId: { exact: rememberedCameraId } }, audio: false });
    }
    attempts.push({ video: defaultCameraConstraints(), audio: false });
    attempts.push({ video: { facingMode: 'environment' }, audio: false });
    attempts.push({ video: true, audio: false });
    return attempts;
  }

  async function getRearCameraId() {
    if (!navigator.mediaDevices?.enumerateDevices) return null;
    const devices = await navigator.mediaDevices.enumerateDevices();
    const cameras = devices.filter((device) => device.kind === 'videoinput');
    if (!cameras.length) return null;

    const rearCamera = cameras.find((camera) => {
      const label = camera.label.toLowerCase();
      return label.includes('back')
        || label.includes('rear')
        || label.includes('environment')
        || label.includes('arrière')
        || label.includes('arriere');
    });

    return rearCamera?.deviceId ?? cameras[cameras.length - 1]?.deviceId ?? null;
  }

  function stopCameraStream() {
    if (scanFrameId !== null) {
      cancelAnimationFrame(scanFrameId);
      scanFrameId = null;
    }
    if (mediaStream) {
      for (const track of mediaStream.getTracks()) track.stop();
      mediaStream = null;
    }
    cameraVideo.pause();
    cameraVideo.srcObject = null;
  }

  function rememberStreamCamera(stream: MediaStream) {
    const track = stream.getVideoTracks()[0];
    const settings = track?.getSettings?.();
    if (settings?.deviceId) {
      rememberCameraId(settings.deviceId);
      return;
    }
    getRearCameraId().then((rearCameraId) => rememberCameraId(rearCameraId)).catch(() => {});
  }

  async function waitForVideoReady(video: HTMLVideoElement) {
    if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA && video.videoWidth > 0) return;
    await new Promise<void>((resolve) => {
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        video.removeEventListener('loadedmetadata', finish);
        video.removeEventListener('canplay', finish);
        resolve();
      };
      video.addEventListener('loadedmetadata', finish, { once: true });
      video.addEventListener('canplay', finish, { once: true });
      window.setTimeout(finish, 1800);
    });
  }

  function decodeCurrentFrame() {
    if (!scanContext || !mediaStream || cameraVideo.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) return null;
    const sourceWidth = cameraVideo.videoWidth;
    const sourceHeight = cameraVideo.videoHeight;
    if (!sourceWidth || !sourceHeight) return null;

    const targetWidth = Math.min(MAX_DECODE_WIDTH, sourceWidth);
    const targetHeight = Math.round((targetWidth / sourceWidth) * sourceHeight);
    if (scanCanvas.width !== targetWidth || scanCanvas.height !== targetHeight) {
      scanCanvas.width = targetWidth;
      scanCanvas.height = targetHeight;
    }

    scanContext.drawImage(cameraVideo, 0, 0, targetWidth, targetHeight);
    const imageData = scanContext.getImageData(0, 0, targetWidth, targetHeight);
    const code = jsQR(imageData.data, targetWidth, targetHeight, {
      inversionAttempts: 'attemptBoth',
    });

    return code?.data?.trim() || decodeMultiFormatBarcode(imageData, targetWidth, targetHeight);
  }

  function scanFrame(timestamp: number) {
    if (!mediaStream) return;

    if (!scannerPaused && timestamp - lastDecodeAttemptAt >= DECODE_INTERVAL_MS) {
      lastDecodeAttemptAt = timestamp;
      const decodedText = decodeCurrentFrame();
      if (decodedText) {
        void handleScan(decodedText);
      }
    }

    scanFrameId = requestAnimationFrame(scanFrame);
  }

  function startDecodeLoop() {
    if (scanFrameId !== null) cancelAnimationFrame(scanFrameId);
    lastDecodeAttemptAt = 0;
    scanFrameId = requestAnimationFrame(scanFrame);
  }

  function formatCameraError(error: unknown) {
    if (!(error instanceof Error)) return 'Caméra indisponible.';
    const name = error.name ? `${error.name}: ` : '';
    return `${name}${error.message || 'Caméra indisponible.'}`;
  }

  async function startScanner({ fromUserAction = false } = {}) {
    if (scannerStarting) return;
    scannerStarting = true;
    scannerPaused = false;
    hideCameraHelp();
    showScannerLoading();
    setScannerStatus('Chargement du scanner...');

    try {
      if (!navigator.mediaDevices?.getUserMedia) {
        throw new Error('La caméra n’est pas disponible dans ce navigateur. Ouvrez cette page en HTTPS dans Safari ou Chrome.');
      }

      stopCameraStream();
      setScannerStatus('Ouverture de la caméra...');
      let lastError: unknown = null;

      for (const [index, constraints] of cameraAttempts().entries()) {
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
          cameraVideo.srcObject = mediaStream;
          cameraVideo.muted = true;
          cameraVideo.setAttribute('playsinline', 'true');
          await cameraVideo.play();
          await waitForVideoReady(cameraVideo);
          rememberStreamCamera(mediaStream);
          startDecodeLoop();
          hideScannerOverlays();
          setScannerStatus('Scanner prêt. Placez le code dans l’image.');
          return;
        } catch (error) {
          lastError = error;
          stopCameraStream();
          if (index === 0) forgetRememberedCameraId();
        }
      }

      throw lastError ?? new Error('Caméra indisponible.');
    } catch (error) {
      const message = formatCameraError(error);
      setScannerStatus('Caméra à autoriser.');
      showLaunchOverlay(
        'Caméra non ouverte',
        fromUserAction
          ? 'La caméra n’a pas pu démarrer. Vérifiez que Safari/Chrome autorise bien la caméra, puis réessayez.'
          : 'Touchez le bouton pour ouvrir la caméra.',
        'Réessayer'
      );
      showCameraHelp(
        fromUserAction
          ? `${message} Si vous avez refusé, activez la caméra dans les réglages du navigateur puis rechargez la page.`
          : 'Touchez “Autoriser la caméra”, puis acceptez la demande du navigateur.'
      );
    } finally {
      scannerStarting = false;
    }
  }

  function resumeScanner() {
    if (!scannerPaused) return;
    scannerPaused = false;
    setScannerStatus('Scanner prêt. Placez le code dans l’image.');
  }

  async function handleScan(decodedText: string) {
    if (scannerPaused) return;
    scannerPaused = true;
    setScannerStatus('Code détecté...');
    playBeep('scan');

    try {
      const res = await authFetchWithTimeout(`/api/merchant/scan?code=${encodeURIComponent(decodedText.trim())}`);
      if (!res.ok) throw new Error(await readApiError(res, 'Carte client introuvable.'));

      const payload = await res.json();
      const scanPayload = payload?.data ?? payload;
      const data = scanPayload?.client ?? scanPayload;
      const carte = scanPayload?.carte ?? data?.carte ?? null;
      if (!data?.id) throw new Error('Client introuvable');

      currentClientId = data.id;
      currentClientRecompenses = data.recompenses_obtenues ?? 0;
      const rawCardType = String(carte?.type ?? data?.type ?? '').toLowerCase();
      currentProgramType = rawCardType.includes('point') || (data.points_actuels !== undefined && data.tampons_actuels === undefined)
        ? 'points'
        : 'tampons';

      document.getElementById('result-nom')!.textContent = data.nom ?? 'Client anonyme';
      document.getElementById('result-solde')!.textContent =
        currentProgramType === 'points'
          ? `${data.points_actuels ?? 0} point(s)`
          : `${data.tampons_actuels ?? 0} tampon(s) — ${data.recompenses_obtenues ?? 0} récompense(s)`;
      document.getElementById('result-rewards')!.textContent = `Récompenses disponibles: ${data.recompenses_obtenues ?? 0}`;
      document.getElementById('btn-tampon')!.classList.toggle('hidden', currentProgramType !== 'tampons');
      document.getElementById('btn-points')!.classList.toggle('hidden', currentProgramType !== 'points');
      const rewardBtn = document.getElementById('btn-reward')!;
      rewardBtn.classList.toggle('hidden', currentClientRecompenses <= 0);

      document.getElementById('scan-result')!.classList.remove('hidden');

      // Feedback haptique
      if (navigator.vibrate) navigator.vibrate(100);
    } catch (error) {
      showToast(error instanceof Error ? error.message : 'Code non reconnu. Réessayez.', 'error');
      resumeScanner();
    }
  }

  // Bouton +1 tampon
  document.getElementById('btn-tampon')!.addEventListener('click', async () => {
    if (!currentClientId) return;
    await addTransaction('ajout_tampon', 1);
  });

  // Bouton +points
  document.getElementById('btn-points')!.addEventListener('click', async () => {
    if (!currentClientId) return;
    document.getElementById('points-modal')!.classList.remove('hidden');
    (document.getElementById('points-value') as HTMLInputElement).focus();
  });

  document.getElementById('btn-reward')!.addEventListener('click', async () => {
    if (!currentClientId || currentClientRecompenses <= 0) return;
    await addTransaction('recompense', 1);
  });

  document.getElementById('btn-cancel-points')!.addEventListener('click', () => {
    document.getElementById('points-modal')!.classList.add('hidden');
  });

  document.getElementById('btn-confirm-points')!.addEventListener('click', async () => {
    const input = document.getElementById('points-value') as HTMLInputElement;
    const valeur = parseInt(input.value);
    if (!Number.isFinite(valeur) || valeur < 1) {
      input.focus();
      return;
    }
    document.getElementById('points-modal')!.classList.add('hidden');
    input.value = '';
    await addTransaction('ajout_points', valeur);
  });

  async function addTransaction(type: string, valeur: number) {
    try {
      const res = await authFetchWithTimeout('/api/transactions', {
        method: 'POST',
        body: JSON.stringify({ client_id: currentClientId, type, valeur }),
      });

      if (!res.ok) throw new Error(await readApiError(res, "Erreur lors de l'ajout. Réessayez."));

      const data = await res.json();

      // Feedback positif
      if (navigator.vibrate) navigator.vibrate([50, 50, 100]);
      playBeep('success');
      const confirmation = type === 'ajout_tampon'
        ? 'Tampon ajouté avec succès.'
        : type === 'ajout_points'
          ? `${valeur} point${valeur > 1 ? 's' : ''} ajouté${valeur > 1 ? 's' : ''} avec succès.`
          : type === 'recompense'
            ? 'Récompense utilisée avec succès.'
            : 'Action enregistrée avec succès.';
      showToast(confirmation);

      // Confetti si récompense obtenue (dernier tampon ou points atteints)
      const newRecompenses: number = data.client?.recompenses_obtenues ?? currentClientRecompenses;
      if (newRecompenses > currentClientRecompenses) {
        fireRewardConfetti();
      }

      closeResult();
    } catch (error) {
      showToast(error instanceof Error ? error.message : "Erreur lors de l'ajout. Réessayez.", 'error');
    }
  }

  function fireRewardConfetti() {
    if (!confettiPromise) confettiPromise = import('canvas-confetti');
    const duration = 2500;
    const end = Date.now() + duration;

    const frame = () => {
      confettiPromise?.then((module) => {
        const confetti = module?.default ?? module;
        confetti({
          particleCount: 4,
          angle: 60,
          spread: 55,
          origin: { x: 0, y: 0.7 },
          colors: ['#6366f1', '#a78bfa', '#f59e0b', '#10b981', '#ef4444'],
          zIndex: 9999,
        });
        confetti({
          particleCount: 4,
          angle: 120,
          spread: 55,
          origin: { x: 1, y: 0.7 },
          colors: ['#6366f1', '#a78bfa', '#f59e0b', '#10b981', '#ef4444'],
          zIndex: 9999,
        });
      }).catch(() => {});
      if (Date.now() < end) requestAnimationFrame(frame);
    };
    frame();
  }

  function closeResult() {
    document.getElementById('scan-result')!.classList.add('hidden');
    currentClientId = null;
    currentClientRecompenses = 0;
    currentProgramType = 'tampons';
    resumeScanner();
  }

  document.getElementById('btn-close')!.addEventListener('click', closeResult);
  document.addEventListener('pointerdown', unlockAudio, { once: true });
  document.addEventListener('touchstart', unlockAudio, { once: true });
  cameraPermissionBtn.addEventListener('click', async () => {
    await startScanner({ fromUserAction: true });
  });
  startCameraBtn.addEventListener('click', async () => {
    await startScanner({ fromUserAction: true });
  });

  setScannerStatus('Prêt à démarrer.');
  if (!navigator.mediaDevices?.getUserMedia) {
    setScannerStatus('Caméra indisponible.');
    showLaunchOverlay(
      'Caméra indisponible',
      'Ouvrez cette page en HTTPS dans Safari ou Chrome, puis autorisez la caméra.',
      'Réessayer'
    );
  }

  window.addEventListener('pagehide', stopCameraStream);
</script>
