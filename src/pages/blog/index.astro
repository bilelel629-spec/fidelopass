---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicNav from '../../components/marketing/PublicNav.astro';
import PublicFooter from '../../components/marketing/PublicFooter.astro';

export const prerender = true;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFmt = (d: Date) => d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  theme="light"
  title="Blog Fidelopass — Fidélité client & cartes dématérialisées"
  description="Conseils, guides et stratégies pour fidéliser vos clients avec une carte de fidélité dématérialisée dans Apple Wallet et Google Wallet."
>
  <PublicNav currentPath="/blog" />

  <section class="relative overflow-hidden bg-[linear-gradient(180deg,#ffffff_0%,#f5f9ff_62%,#ffffff_100%)] pt-10 pb-6 sm:pt-16 sm:pb-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="mb-3 inline-flex items-center rounded-full border border-sky-200 bg-white px-3.5 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-sky-700 shadow-sm">Le blog Fidelopass</span>
      <h1 class="font-display text-3xl sm:text-5xl font-bold text-slate-900 leading-tight">
        Fidélisez vos clients, <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">simplement.</span>
      </h1>
      <p class="text-slate-500 text-base sm:text-lg mt-4 max-w-2xl mx-auto leading-relaxed">
        Guides, comparatifs et stratégies concrètes pour transformer vos clients en habitués avec une carte de fidélité dématérialisée.
      </p>
    </div>
  </section>

  <section class="bg-slate-50/70 py-10 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      {posts.length === 0 ? (
        <p class="text-center text-slate-500">Les premiers articles arrivent très bientôt.</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group flex flex-col rounded-[1.6rem] border border-slate-200 bg-white p-6 shadow-[0_18px_46px_-36px_rgba(15,23,42,0.4)] transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
              <span class="inline-flex w-fit rounded-full bg-indigo-50 px-3 py-1 text-[0.66rem] font-bold uppercase tracking-[0.14em] text-indigo-700">{post.data.category}</span>
              <h2 class="mt-4 font-display text-2xl font-bold text-slate-950 leading-tight group-hover:text-indigo-700">{post.data.title}</h2>
              <p class="mt-3 flex-1 text-sm leading-6 text-slate-500">{post.data.description}</p>
              <span class="mt-5 text-xs font-semibold text-slate-400">{dateFmt(post.data.pubDate)}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <PublicFooter />
</BaseLayout>
