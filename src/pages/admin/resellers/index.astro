---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Revendeurs — Admin Fidelopass" activeNav="resellers">
  <section class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-red-600/75">Administration</p>
        <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-slate-950">Revendeurs</h1>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
          Approbation manuelle, lien revendeur, prix publics et commissions à reverser.
        </p>
      </div>
      <button id="create-open-button" class="inline-flex w-fit items-center rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-500 px-5 py-3 text-sm font-semibold text-white shadow-[0_20px_36px_-24px_rgba(37,99,235,0.8)] transition hover:-translate-y-0.5">
        Ajouter un revendeur
      </button>
    </div>

    <form id="create-form" class="hidden rounded-[1.7rem] border border-sky-100 bg-white/90 p-6 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
      <div class="grid gap-4 md:grid-cols-3">
        <label class="space-y-2 md:col-span-2">
          <span class="text-sm font-semibold text-slate-700">Email du revendeur</span>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input id="reseller-email-input" name="email" type="email" required class="min-w-0 flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" />
            <button id="search-user-button" type="button" class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-bold text-sky-800 transition hover:border-sky-300">
              Rechercher
            </button>
          </div>
          <span id="user-search-feedback" class="block text-xs font-medium text-slate-500">Recherchez le compte avant de créer le revendeur. S’il n’existe pas, une invitation sera envoyée.</span>
        </label>
        <div class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Mode V1</span>
          <input type="hidden" name="type" value="invoiced" />
          <div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3">
            <p class="text-sm font-bold text-emerald-800">Stripe Fidelopass + commissions</p>
            <p class="mt-1 text-xs leading-5 text-emerald-700">
              Fidelopass encaisse le commerçant, puis la marge revendeur est suivie pour reversement manuel.
            </p>
          </div>
        </div>
        <label class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Pays</span>
          <input name="country" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" placeholder="FR, DZ..." />
        </label>
        <label class="space-y-2">
          <span class="text-sm font-semibold text-slate-700">Devise</span>
          <input name="currency" maxlength="3" value="eur" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" />
        </label>
        <label class="space-y-2 md:col-span-2">
          <span class="text-sm font-semibold text-slate-700">Nom commercial</span>
          <input name="brand_name" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" placeholder="Revendeur Fidelopass" />
        </label>
        <label class="space-y-2 md:col-span-3">
          <span class="text-sm font-semibold text-slate-700">Slug public <span class="font-normal text-slate-400">(optionnel)</span></span>
          <input name="public_slug" pattern="[a-z0-9\-]{3,60}" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" placeholder="nom-revendeur" />
          <span class="block text-xs text-slate-400">Lien d'inscription commerçants : fidelopass.com/r/[slug] — uniquement minuscules, chiffres et tirets.</span>
        </label>
      </div>
      <div class="mt-6 rounded-[1.35rem] border border-indigo-100 bg-indigo-50/40 p-4">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-indigo-700">Conditions commerciales</p>
            <h3 class="mt-1 text-lg font-bold text-slate-950">Prix minimums et part Fidelopass</h3>
          </div>
          <p class="text-xs text-slate-500">Ces valeurs sont privées et ne sont jamais visibles par le commerçant final.</p>
        </div>
        <div class="mt-4 grid gap-3 lg:grid-cols-3">
          {[
            { plan: 'starter', label: 'Starter', minPrice: 29, fee: 14 },
            { plan: 'pro', label: 'Pro', minPrice: 69, fee: 24 },
            { plan: 'premium', label: 'Business', minPrice: 199, fee: 49 },
          ].map(({ plan, label, minPrice, fee }) => (
            <article class="rounded-2xl border border-white bg-white/85 p-4">
              <p class="text-sm font-bold text-slate-950">{label}</p>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <label class="space-y-1">
                  <span class="text-xs font-semibold text-slate-500">Prix min. €</span>
                  <input data-setting-plan={plan} data-setting-field="min_price" type="number" min="0" value={minPrice} class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold" />
                </label>
                <label class="space-y-1">
                  <span class="text-xs font-semibold text-slate-500">Part F. €</span>
                  <input data-setting-plan={plan} data-setting-field="platform_fee" type="number" min="0" value={fee} class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold" />
                </label>
              </div>
            </article>
          ))}
        </div>
      </div>
      <button class="mt-5 rounded-2xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Créer</button>
      <p id="create-feedback" class="mt-3 text-sm font-medium text-slate-500"></p>
    </form>

    <section class="rounded-[1.7rem] border border-sky-100 bg-white/90 p-4 shadow-[0_22px_52px_-38px_rgba(37,99,235,0.45)]">
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="text-[0.68rem] uppercase tracking-[0.2em] text-slate-500">
            <tr>
              <th class="px-4 py-3">Nom</th>
              <th class="px-4 py-3">Pays</th>
              <th class="px-4 py-3">Type</th>
              <th class="px-4 py-3">Statut</th>
              <th class="px-4 py-3">Commerçants</th>
              <th class="px-4 py-3">CA total</th>
              <th class="px-4 py-3">Part Fidelopass</th>
              <th class="px-4 py-3">Revendeur</th>
              <th class="px-4 py-3">Action</th>
            </tr>
          </thead>
          <tbody id="reseller-rows" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </section>
  </section>
</AdminLayout>

<script>
  import { authFetch } from '../../../lib/api';

  const formatMoney = (cents: unknown, currency = 'eur') => new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: String(currency || 'eur').toUpperCase(),
    maximumFractionDigits: 0,
  }).format(Number(cents ?? 0) / 100);

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function statusBadge(status: string) {
    const normalized = String(status ?? 'pending').toLowerCase();
    const color = normalized === 'approved'
      ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
      : normalized === 'suspended'
        ? 'bg-red-50 text-red-700 border-red-200'
        : 'bg-amber-50 text-amber-700 border-amber-200';
    return `<span class="rounded-full border ${color} px-3 py-1 text-xs font-semibold">${escapeHtml(normalized)}</span>`;
  }

  function typeLabel(type: unknown) {
    return String(type ?? '') === 'stripe_connect'
      ? 'Ancien Connect'
      : 'V1 commissions';
  }

  async function action(id: string, endpoint: string, body: any = {}) {
    const res = await authFetch(`/api/admin/resellers/${id}/${endpoint}`, { method: 'POST', body: JSON.stringify(body) });
    if (!res.ok) alert((await res.json().catch(() => null))?.error ?? 'Action impossible.');
    await loadResellers();
  }

  async function loadResellers() {
    const res = await authFetch('/api/admin/resellers');
    const payload = await res.json().catch(() => null);
    const rows = document.getElementById('reseller-rows')!;
    const resellers = Array.isArray(payload?.data) ? payload.data : [];
    if (!res.ok || !resellers.length) {
      rows.innerHTML = `<tr><td colspan="9" class="px-4 py-8 text-center text-slate-500">${res.ok ? 'Aucun revendeur.' : escapeHtml(payload?.error ?? 'Chargement impossible.')}</td></tr>`;
      return;
    }
    rows.innerHTML = resellers.map((reseller: any) => `
      <tr class="align-top">
        <td class="px-4 py-4">
          <p class="font-semibold text-slate-950">${escapeHtml(reseller.brand_name)}</p>
          <p class="text-xs text-slate-500">${escapeHtml(reseller.support_email ?? '')}</p>
        </td>
        <td class="px-4 py-4">${escapeHtml(reseller.country ?? '-')}</td>
        <td class="px-4 py-4">${escapeHtml(typeLabel(reseller.type))}</td>
        <td class="px-4 py-4">${statusBadge(reseller.status)}</td>
        <td class="px-4 py-4">${reseller.metrics?.active_merchants_count ?? 0}/${reseller.metrics?.merchants_count ?? 0}</td>
        <td class="px-4 py-4">${formatMoney(reseller.metrics?.total_revenue_cents, reseller.currency)}</td>
        <td class="px-4 py-4">${formatMoney(reseller.metrics?.platform_revenue_cents, reseller.currency)}</td>
        <td class="px-4 py-4">${formatMoney(reseller.metrics?.reseller_revenue_cents, reseller.currency)}</td>
        <td class="px-4 py-4">
          <div class="flex flex-wrap gap-2">
            <a href="/admin/resellers/${reseller.id}" class="rounded-xl border border-sky-200 bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-800">Détails</a>
            <button data-action="approve" data-id="${reseller.id}" class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800">Approuver</button>
            <button data-action="suspend" data-id="${reseller.id}" class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">Suspendre</button>
          </div>
        </td>
      </tr>
    `).join('');
    rows.querySelectorAll('[data-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const btn = button as HTMLButtonElement;
        action(btn.dataset.id!, btn.dataset.action === 'approve' ? 'approve' : 'suspend', {});
      });
    });
  }

  document.getElementById('create-open-button')?.addEventListener('click', () => {
    document.getElementById('create-form')?.classList.toggle('hidden');
  });

  document.getElementById('search-user-button')?.addEventListener('click', async () => {
    const email = (document.getElementById('reseller-email-input') as HTMLInputElement | null)?.value?.trim();
    const feedback = document.getElementById('user-search-feedback');
    if (!feedback) return;
    if (!email) {
      feedback.className = 'block text-xs font-semibold text-red-700';
      feedback.textContent = 'Saisissez un email à rechercher.';
      return;
    }
    feedback.className = 'block text-xs font-medium text-slate-500';
    feedback.textContent = 'Recherche du compte...';
    const res = await authFetch(`/api/admin/resellers/users/search?email=${encodeURIComponent(email)}`);
    const payload = await res.json().catch(() => null);
    if (!res.ok) {
      feedback.className = 'block text-xs font-semibold text-red-700';
      feedback.textContent = payload?.error ?? 'Recherche impossible.';
      return;
    }
    if (payload?.data?.already_reseller) {
      feedback.className = 'block text-xs font-semibold text-amber-700';
      feedback.textContent = 'Ce compte est déjà revendeur. Vous pouvez ouvrir son dossier depuis la liste.';
      return;
    }
    if (payload?.data?.exists) {
      feedback.className = 'block text-xs font-semibold text-emerald-700';
      feedback.textContent = 'Compte trouvé. Vous pouvez le transformer en revendeur.';
      return;
    }
    feedback.className = 'block text-xs font-semibold text-sky-700';
    feedback.textContent = 'Compte absent. Fidelopass enverra une invitation au revendeur.';
  });

  document.getElementById('create-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submitButton = form.querySelector('button[type="submit"], button:not([type])') as HTMLButtonElement | null;
    const feedback = document.getElementById('create-feedback')!;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Création...';
    }
    feedback.className = 'mt-3 text-sm font-medium text-slate-500';
    feedback.textContent = 'Préparation du compte revendeur...';
    const formData = new FormData(event.currentTarget as HTMLFormElement);
    const payload: Record<string, any> = Object.fromEntries(formData.entries());
    for (const key of Object.keys(payload)) {
      if (typeof payload[key] === 'string' && payload[key].trim() === '') {
        delete payload[key];
      }
    }
    payload.status = 'approved';
    payload.settings = ['starter', 'pro', 'premium'].map((plan) => {
      const minPrice = Number((document.querySelector(`[data-setting-plan="${plan}"][data-setting-field="min_price"]`) as HTMLInputElement | null)?.value || 0);
      const platformFee = Number((document.querySelector(`[data-setting-plan="${plan}"][data-setting-field="platform_fee"]`) as HTMLInputElement | null)?.value || 0);
      return {
        plan,
        min_price_cents: Math.round(minPrice * 100),
        platform_fee_cents: Math.round(platformFee * 100),
        currency: payload.currency || 'eur',
      };
    });
    try {
      const res = await authFetch('/api/admin/resellers', { method: 'POST', body: JSON.stringify(payload) });
      const result = await res.json().catch(() => null);
      if (res.ok) {
        const message = result?.message
          ?? (result?.already_exists ? 'Ce revendeur existe déjà. Il a été chargé dans la liste.' : 'Revendeur créé.');
        const dashboardUrl = 'https://www.fidelopass.com/reseller';
        const publicUrl = result?.data?.public_url ?? null;
        const makeLink = (label: string, url: string) => `
          <div class="flex flex-wrap items-center gap-2 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2">
            <span class="text-xs font-semibold text-slate-600">${escapeHtml(label)}</span>
            <a href="${escapeHtml(url)}" target="_blank" class="min-w-0 flex-1 truncate text-xs text-blue-700 underline">${escapeHtml(url)}</a>
            <button type="button" data-copy="${escapeHtml(url)}" class="shrink-0 rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs font-semibold text-slate-700 hover:border-slate-300">Copier</button>
          </div>`;
        feedback.className = 'mt-3 text-sm';
        feedback.innerHTML = `
          <p class="font-semibold text-emerald-700">${escapeHtml(message)}</p>
          <div class="mt-3 space-y-2">
            ${makeLink('Dashboard revendeur :', dashboardUrl)}
            ${publicUrl ? makeLink('Lien d\'inscription commerçants :', publicUrl) : ''}
          </div>`;
        feedback.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
          btn.addEventListener('click', () => {
            navigator.clipboard.writeText(btn.dataset.copy ?? '').then(() => {
              const prev = btn.textContent;
              btn.textContent = 'Copié !';
              setTimeout(() => { btn.textContent = prev; }, 1500);
            });
          });
        });
        await loadResellers();
      } else {
        feedback.className = 'mt-3 text-sm font-semibold text-red-700';
        feedback.textContent = result?.error ?? 'Création impossible.';
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Créer';
      }
    }
  });

  await loadResellers();
</script>
