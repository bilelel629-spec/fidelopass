---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const apiBase = (
  import.meta.env.PUBLIC_API_URL
  ?? (import.meta.env.PROD ? 'https://api.fidelopass.com' : 'http://localhost:3001')
).replace(/\/$/, '');
---

<BaseLayout title="Création d'affiche — Fidelopass" description="Créez une affiche Fidelopass premium prête à imprimer avec le QR code de votre carte.">
  <div class="poster-creator min-h-screen bg-[#f6f8fb] text-slate-950" data-poster-creator data-api-base={apiBase} data-carte-id={id}>
    <header class="poster-ui creator-header sticky top-0 z-40 border-b border-slate-200/80 bg-white/86 px-4 py-3 backdrop-blur-2xl">
      <div class="mx-auto flex max-w-[1720px] items-center justify-between gap-4">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/dashboard" class="icon-btn" aria-label="Retour au dashboard">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          </a>
          <img src="/logo-premium.png" alt="Fidelopass" class="h-9 w-36 object-cover object-center" />
          <span class="hidden rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700 sm:inline-flex">Affiches</span>
        </div>
        <nav class="hidden items-center gap-1 text-sm font-semibold text-slate-500 lg:flex">
          <a href="/dashboard" class="rounded-full px-3 py-2 transition hover:bg-slate-100 hover:text-slate-950">Dashboard</a>
          <a href="/dashboard/carte" class="rounded-full px-3 py-2 transition hover:bg-slate-100 hover:text-slate-950">Ma carte</a>
          <a href="/dashboard/notifications" class="rounded-full px-3 py-2 transition hover:bg-slate-100 hover:text-slate-950">Notifications</a>
        </nav>
        <button id="download-pdf-top" type="button" class="primary-export-btn">
          Télécharger PDF
        </button>
      </div>
    </header>

    <div class="poster-ui mobile-poster-switch mx-auto mt-3 grid max-w-[1720px] grid-cols-2 gap-2 px-4 lg:hidden">
      <button id="mobile-editor-jump" type="button" class="rounded-2xl bg-slate-950 px-4 py-3 text-sm font-extrabold text-white">Modifier</button>
      <button id="mobile-preview-jump" type="button" class="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-extrabold text-slate-700">Aperçu</button>
    </div>

    <div class="creator-workspace mx-auto grid max-w-[1720px] gap-6 px-4 py-6 lg:grid-cols-[420px_minmax(0,1fr)]">
      <aside id="poster-editor-panel" class="poster-ui editor-panel lg:sticky lg:top-[76px]">
        <div class="editor-scroll">
          <div class="mb-6">
            <p class="text-[0.68rem] font-extrabold uppercase tracking-[0.28em] text-blue-600">Création d'affiche</p>
            <h1 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.04em] text-slate-950">Studio affiche</h1>
            <p class="mt-2 text-sm leading-6 text-slate-500">Choisissez un modèle, personnalisez les textes et exportez une affiche prête à imprimer.</p>
          </div>

          <section class="editor-card">
            <div class="stepper">
              <div class="step is-active"><span>1</span><div><strong>Choisir un modèle</strong><small>Base visuelle de l'affiche</small></div></div>
              <div class="step is-active"><span>2</span><div><strong>Personnaliser</strong><small>Textes, couleurs et logo</small></div></div>
              <div class="step"><span>3</span><div><strong>Aperçu & export</strong><small>PDF imprimable A4 ou A5</small></div></div>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Modèles</p>
                <h2>Choisir un style</h2>
              </div>
            </div>
            <div class="template-grid">
              <button type="button" class="template-card is-selected" data-template="affiche">
                <span class="mini-poster beaute"></span>
                <strong>Modèle affiche</strong>
              </button>
              <button type="button" class="template-card" data-template="qr">
                <span class="mini-poster qr"></span>
                <strong>QR code seul</strong>
              </button>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Logo</p>
                <h2>Identité visuelle</h2>
              </div>
            </div>
            <label class="upload-zone" for="poster-logo-upload">
              <input id="poster-logo-upload" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
              <span id="upload-logo-preview" class="upload-preview">
                <img id="upload-logo-img" src="" alt="" class="hidden" />
                <svg id="upload-logo-icon" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7-7-7 7"></path></svg>
              </span>
              <span>
                <strong>Changer le logo</strong>
                <small>PNG, JPG, WebP ou SVG. Glissez-déposez ou cliquez.</small>
              </span>
            </label>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Personnalisation</p>
                <h2>Contenu de l'affiche</h2>
              </div>
            </div>
            <div class="form-grid">
              <label class="field full"><span>Nom commerce</span><input id="field-commerce" type="text" placeholder="Votre commerce" /></label>
              <label class="field full"><span>Slogan</span><input id="field-title" type="text" placeholder="SCANNEZ & PROFITEZ" /></label>
              <label class="field full"><span>Texte court</span><textarea id="field-subtitle" rows="3" placeholder="Ajoutez notre carte fidélité à votre téléphone"></textarea></label>
              <label class="field full"><span>Récompense</span><input id="field-reward" type="text" placeholder="1 café offert" /></label>
              <label class="field"><span>Téléphone</span><input id="field-phone" type="text" placeholder="04 00 00 00 00" /></label>
              <label class="field"><span>Instagram</span><input id="field-instagram" type="text" placeholder="@votrecommerce" /></label>
              <label class="field full"><span>Adresse</span><input id="field-address" type="text" placeholder="Adresse du commerce" /></label>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Couleurs</p>
                <h2>Palette</h2>
                <p class="section-note">La palette de votre carte est appliquée automatiquement.</p>
              </div>
            </div>
            <div class="palette-row">
              <button id="card-palette-btn" type="button" class="palette-btn hidden" data-primary="#082f25" data-secondary="#c8a45d" data-text="#ffffff" data-title="#ffffff" title="Palette de la carte"><span style="background:#082f25"></span><span style="background:#c8a45d"></span><span style="background:#ffffff"></span></button>
              <button type="button" class="palette-btn is-selected" data-primary="#fff0e5" data-secondary="#df652a" data-text="#1f2937" data-title="#df652a"><span style="background:#fff0e5"></span><span style="background:#df652a"></span><span style="background:#1f2937"></span></button>
              <button type="button" class="palette-btn" data-primary="#111827" data-secondary="#38bdf8" data-text="#ffffff" data-title="#ffffff"><span style="background:#111827"></span><span style="background:#38bdf8"></span><span style="background:#ffffff"></span></button>
              <button type="button" class="palette-btn" data-primary="#312e81" data-secondary="#a78bfa" data-text="#ffffff" data-title="#ffffff"><span style="background:#312e81"></span><span style="background:#a78bfa"></span><span style="background:#ffffff"></span></button>
              <button type="button" class="palette-btn" data-primary="#fff7ed" data-secondary="#f97316" data-text="#0f172a" data-title="#c2410c"><span style="background:#fff7ed"></span><span style="background:#f97316"></span><span style="background:#0f172a"></span></button>
              <button type="button" class="palette-btn" data-primary="#fdf2f8" data-secondary="#ec4899" data-text="#831843" data-title="#be185d"><span style="background:#fdf2f8"></span><span style="background:#ec4899"></span><span style="background:#831843"></span></button>
            </div>
            <div class="color-grid">
              <label class="color-field"><span>Principale</span><input id="field-primary" type="color" value="#082f25" /></label>
              <label class="color-field"><span>Secondaire</span><input id="field-secondary" type="color" value="#c8a45d" /></label>
              <label class="color-field"><span>Texte</span><input id="field-text" type="color" value="#ffffff" /></label>
              <label class="color-field"><span>Titres</span><input id="field-title-color" type="color" value="#ffffff" /></label>
            </div>
          </section>

          <section class="editor-card">
            <div class="section-head">
              <div>
                <p class="section-kicker">Typographie</p>
                <h2>Police d'écriture</h2>
              </div>
            </div>
            <label class="field full">
              <span>Style de police</span>
              <select id="field-font">
                <option value="Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif">Moderne</option>
                <option value="'Arial Rounded MT Bold', Arial, ui-sans-serif, system-ui, sans-serif">Arrondie</option>
                <option value="Georgia, 'Times New Roman', serif">Élégante</option>
                <option value="'Trebuchet MS', Arial, sans-serif">Créative</option>
                <option value="'Courier New', monospace">Monospace</option>
              </select>
            </label>
            <label class="field full mt-4">
              <span>Police des titres</span>
              <select id="field-title-font">
                <option value="Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif">Moderne forte</option>
                <option value="'Arial Rounded MT Bold', Arial, ui-sans-serif, system-ui, sans-serif">Arrondie</option>
                <option value="Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif">Impact</option>
                <option value="Georgia, 'Times New Roman', serif">Élégante</option>
                <option value="'Trebuchet MS', Arial, sans-serif">Créative</option>
              </select>
            </label>
          </section>

        </div>
      </aside>

      <main id="poster-preview-area" class="preview-area">
        <div id="poster-loading" class="preview-state">
          <div class="spinner"></div>
          <p>Préparation de l'affiche...</p>
        </div>
        <div id="poster-error" class="preview-state hidden">
          <p class="font-bold text-red-600">Impossible de charger cette affiche.</p>
          <p class="mt-2 text-sm text-slate-500">Vérifiez que votre carte est bien publiée puis réessayez.</p>
        </div>

        <div id="poster-stage" class="hidden w-full">
          <div class="preview-toolbar poster-ui">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-slate-400">Aperçu temps réel</p>
              <h2 id="poster-preview-title" class="font-display text-xl font-extrabold text-slate-950">Affiche A4</h2>
            </div>
            <div class="format-switch" aria-label="Format d'affiche">
              <button type="button" class="format-btn is-active" data-format="a4">A4</button>
              <button type="button" class="format-btn" data-format="a5">A5</button>
            </div>
          </div>

          <div class="poster-preview-shell">
            <div id="poster-sheet" class="poster-sheet" style="--poster-primary:#082f25;--poster-secondary:#c8a45d;--poster-ink:#ffffff;--poster-title-color:#ffffff;--poster-font:Inter,ui-sans-serif,system-ui,sans-serif;--poster-title-font:Inter,ui-sans-serif,system-ui,sans-serif;--poster-muted:rgba(255,255,255,0.72);">
              <svg id="poster-svg" class="poster-svg" viewBox="0 0 1240 1754" role="img" aria-label="Aperçu affiche Fidelopass"></svg>
            </div>
          </div>
        </div>
      </main>
    </div>

    <div class="poster-ui export-bar">
      <button type="button" class="export-action" data-download-format="a4">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
        <span><strong>Télécharger PDF A4</strong><small>210 x 297 mm</small></span>
      </button>
      <button type="button" class="export-action" data-download-format="a5">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
        <span><strong>Télécharger PDF A5</strong><small>148 x 210 mm</small></span>
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .poster-creator {
    --poster-print-width: 210mm;
    --poster-print-height: 297mm;
    --poster-preview-width: min(100%, 460px, calc((100dvh - 16rem) * 0.707));
    --poster-preview-width-a5: min(100%, 380px, calc((100dvh - 16rem) * 0.707));
    background:
      radial-gradient(circle at 85% 8%, rgba(56, 189, 248, 0.18), transparent 28rem),
      radial-gradient(circle at 24% 4%, rgba(124, 58, 237, 0.12), transparent 24rem),
      #f6f8fb;
    padding-bottom: 2rem;
  }

  .icon-btn {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #475569;
    box-shadow: 0 16px 34px -28px rgba(15, 23, 42, 0.4);
    transition: transform 180ms ease, box-shadow 180ms ease, color 180ms ease;
  }

  .icon-btn:hover,
  .primary-export-btn:hover,
  .export-all-btn:hover,
  .export-action:hover,
  .template-card:hover {
    transform: translateY(-2px);
  }

  .primary-export-btn,
  .export-all-btn {
    border-radius: 1rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    padding: 0.8rem 1.05rem;
    color: white;
    font-size: 0.86rem;
    font-weight: 800;
    box-shadow: 0 22px 46px -26px rgba(37, 99, 235, 0.88);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .creator-workspace {
    align-items: start;
  }

  .editor-panel {
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.75rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 30px 80px -58px rgba(15, 23, 42, 0.44);
    backdrop-filter: blur(20px);
  }

  .editor-scroll {
    max-height: calc(100dvh - 96px);
    overflow: auto;
    padding: 1.35rem 1.35rem 7.5rem;
  }

  .editor-card {
    margin-top: 1rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 1.35rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.92));
    padding: 1rem;
    box-shadow: 0 18px 48px -42px rgba(15, 23, 42, 0.36);
  }

  .section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .section-kicker {
    color: #2563eb;
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-head h2 {
    margin-top: 0.18rem;
    font-size: 1rem;
    font-weight: 850;
    color: #0f172a;
  }

  .section-note {
    margin-top: 0.25rem;
    color: #64748b;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .mini-link {
    border-radius: 999px;
    border: 1px solid #dbeafe;
    background: #eff6ff;
    padding: 0.42rem 0.72rem;
    color: #2563eb;
    font-size: 0.72rem;
    font-weight: 850;
  }

  .stepper {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .stepper::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 1.2rem;
    bottom: 1.2rem;
    width: 1px;
    background: linear-gradient(#bfdbfe, #e2e8f0);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .step span {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
    z-index: 1;
  }

  .step.is-active span {
    border-color: rgba(96, 165, 250, 0.9);
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.11), 0 18px 34px -24px rgba(37, 99, 235, 0.75);
  }

  .step strong {
    display: block;
    font-size: 0.86rem;
    color: #0f172a;
  }

  .step small {
    display: block;
    margin-top: 0.15rem;
    color: #64748b;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .template-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .template-card {
    border-radius: 1.1rem;
    border: 1px solid #e2e8f0;
    background: #fff;
    padding: 0.55rem;
    text-align: left;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .template-card.is-selected {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12), 0 20px 44px -34px rgba(79, 70, 229, 0.68);
  }

  .template-card strong {
    display: block;
    margin-top: 0.45rem;
    padding-inline: 0.2rem;
    font-size: 0.78rem;
    color: #0f172a;
  }

  .mini-poster {
    display: block;
    height: 7.6rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255,255,255,0.68);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
  }

  .mini-poster.beaute { background: linear-gradient(145deg, #fff1f2, #f9a8d4 56%, #be185d); }
  .mini-poster.qr {
    background:
      linear-gradient(90deg, transparent 46%, #0f172a 46% 54%, transparent 54%),
      linear-gradient(transparent 46%, #0f172a 46% 54%, transparent 54%),
      #ffffff;
    background-size: 2.4rem 2.4rem;
  }

  .upload-zone {
    display: flex;
    cursor: pointer;
    align-items: center;
    gap: 0.9rem;
    border-radius: 1.1rem;
    border: 1px dashed #bfdbfe;
    background: #f8fbff;
    padding: 0.9rem;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .upload-zone:hover {
    transform: translateY(-1px);
    border-color: #60a5fa;
    background: #eff6ff;
  }

  .upload-zone input {
    display: none;
  }

  .upload-zone strong {
    display: block;
    font-size: 0.86rem;
  }

  .upload-zone small {
    display: block;
    margin-top: 0.18rem;
    color: #64748b;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .upload-zone.compact {
    padding: 0.75rem;
  }

  .upload-preview {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid #dbeafe;
    background: #fff;
    color: #2563eb;
  }

  .upload-preview img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .field.full {
    grid-column: 1 / -1;
  }

  .field span,
  .color-field span {
    display: block;
    margin-bottom: 0.35rem;
    color: #475569;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .field input,
  .field textarea,
  .field select {
    width: 100%;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.78rem 0.85rem;
    color: #0f172a;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    border-color: #60a5fa;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
  }

  .palette-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .palette-btn {
    display: inline-flex;
    gap: 0.2rem;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #fff;
    padding: 0.24rem;
    transition: box-shadow 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .palette-btn:hover {
    transform: translateY(-1px);
  }

  .palette-btn.is-selected {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
  }

  .palette-btn span {
    height: 1.25rem;
    width: 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .color-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .color-field input {
    height: 3rem;
    width: 100%;
    cursor: pointer;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.2rem;
  }

  .preview-area {
    min-height: calc(100dvh - 8rem);
    overflow: auto;
    border-radius: 2rem;
    border: 1px solid rgba(226, 232, 240, 0.75);
    background:
      linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
