---
import '../styles/global.css';
import DashboardNav from '../components/dashboard/DashboardNav.astro';
import GoogleTag from '../components/GoogleTag.astro';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Dashboard — Fidelopass', activeNav = '' } = Astro.props;
---

<!doctype html>
<html lang="fr" class="dashboard">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f9ff" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <GoogleTag />
  </head>
  <body class="min-h-screen bg-[#f7fbff] text-slate-900 antialiased">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_0%,rgba(56,189,248,0.18),transparent_30%),radial-gradient(circle_at_9%_42%,rgba(37,99,235,0.10),transparent_28%),linear-gradient(180deg,#ffffff_0%,#f7fbff_46%,#eef7ff_100%)]"></div>
      <div class="absolute -top-28 right-[-8rem] h-[30rem] w-[30rem] rounded-full bg-cyan-200/50 blur-3xl"></div>
      <div class="absolute top-1/3 left-[-9rem] h-[25rem] w-[25rem] rounded-full bg-blue-100/90 blur-3xl"></div>
      <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-white/88 to-transparent"></div>
      <div class="absolute inset-0 opacity-[0.045] [background-image:linear-gradient(rgba(15,23,42,0.45)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.45)_1px,transparent_1px)] [background-size:36px_36px]"></div>
    </div>
    <div class="flex min-h-screen lg:h-screen overflow-hidden">
      <DashboardNav activeNav={activeNav} />
      <main class="relative z-10 flex-1 min-w-0 overflow-y-auto pb-24 lg:pb-0">
        <div class="p-4 sm:p-6 md:p-8 pt-24 lg:pt-8 max-w-7xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
    <div id="toast-container" class="fixed bottom-6 right-4 z-[200] flex flex-col gap-2 sm:right-6 pointer-events-none"></div>
  </body>
</html>

<script>
  import { createClient } from '@supabase/supabase-js';
  import {
    bindSessionActivityTracking,
    requireFreshSession,
    shouldShowSessionRefreshOverlay,
    showSessionOverlay,
  } from '../lib/session-guard';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );
  const API = (import.meta.env.PUBLIC_API_URL ?? 'https://api.fidelopass.com').replace(/\/$/, '');

  bindSessionActivityTracking();

  let idleRefreshPromise: Promise<void> | null = null;

  function refreshSessionAfterInactivity() {
    if (!shouldShowSessionRefreshOverlay() || idleRefreshPromise) return;

    idleRefreshPromise = (async () => {
      const overlay = showSessionOverlay('Reconnexion en cours...', 'Votre session est rafraîchie après une période d’inactivité.');
      const session = await requireFreshSession(supabase, { overlay });
      if (session) overlay.remove();
    })().finally(() => {
      idleRefreshPromise = null;
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refreshSessionAfterInactivity();
  });
  window.addEventListener('focus', refreshSessionAfterInactivity);

  type SessionLike = { access_token: string };
  type TourStep = {
    path: string;
    selector: string;
    navSelector?: string;
    title: string;
    body: string;
    action: string;
    tone: 'blue' | 'amber' | 'emerald' | 'rose' | 'violet' | 'slate';
  };

  const TOUR_QUERY_KEY = 'fidelopass_tour_active';
  const TOUR_STEP_KEY = 'fidelopass_tour_step';
  const TOUR_POSTPONED_KEY = 'fidelopass_tour_postponed';

  const TOUR_STEPS: TourStep[] = [
    {
      path: '/dashboard',
      selector: '[data-tour="dashboard-actions"]',
      navSelector: '[data-tour-nav="dashboard"]',
      title: 'Votre poste de pilotage',
      body: 'Cette zone rassemble les actions les plus fréquentes: scanner en caisse, afficher le QR client et relancer vos clients.',
      action: 'Commencez ici quand vous voulez aller vite pendant la journée.',
      tone: 'blue',
    },
    {
      path: '/dashboard',
      selector: '[data-tour="dashboard-stats"]',
      title: 'Les chiffres qui comptent',
      body: 'Clients, scans, récompenses et notifications envoyées vous donnent une lecture rapide de la santé du programme.',
      action: 'Surveillez surtout les scans du jour et les campagnes push envoyées.',
      tone: 'violet',
    },
    {
      path: '/dashboard/carte',
      selector: '[data-tour="card-editor-intro"]',
      navSelector: '[data-tour-nav="carte"]',
      title: 'Construire la carte Wallet',
      body: 'La page Ma carte est le centre de création: identité, programme, design, messages et partage.',
      action: 'Avancez étape par étape, puis enregistrez pour garder une carte cohérente.',
      tone: 'amber',
    },
    {
      path: '/dashboard/carte',
      selector: '[data-tour="card-program"]',
      title: 'Choisir la mécanique fidélité',
      body: 'Tampons pour une expérience simple en caisse, points pour plus de souplesse et des paliers avancés.',
      action: 'Choisissez le modèle le plus simple pour votre équipe avant de personnaliser le visuel.',
      tone: 'emerald',
    },
    {
      path: '/dashboard/clients',
      selector: '[data-tour="clients-list"]',
      navSelector: '[data-tour-nav="clients"]',
      title: 'Suivre vos clients fidèles',
      body: 'La base client vous permet de retrouver un membre, consulter son solde et corriger manuellement ses points ou tampons.',
      action: 'Cliquez sur un client pour ouvrir sa fiche et ajuster son solde si besoin.',
      tone: 'violet',
    },
    {
      path: '/dashboard/notifications',
      selector: '[data-tour="notifications-compose"]',
      navSelector: '[data-tour-nav="notifications"]',
      title: 'Faire revenir les clients',
      body: 'Les notifications Wallet servent à annoncer une offre, rappeler une récompense ou automatiser des relances.',
      action: 'Gardez vos messages courts, utiles et liés à une vraie raison de revenir.',
      tone: 'rose',
    },
    {
      path: '/dashboard/parametres?tab=abonnement',
      selector: '[data-tour="account-billing"]',
      navSelector: '[data-tour-nav="parametres"]',
      title: 'Gérer le compte commerçant',
      body: 'L’espace compte regroupe profil, abonnement, moyens de paiement, scanners et organisation des points de vente.',
      action: 'Revenez ici pour changer de plan, annuler, réactiver ou installer un scanner.',
      tone: 'slate',
    },
  ];

  const TOUR_TONES = {
    blue: { label: 'text-blue-700/80', box: 'border-blue-100 bg-blue-50 text-blue-950', bar: 'bg-blue-600', button: 'bg-blue-600 hover:bg-blue-700', ring: 'rgba(37, 99, 235, 0.72)' },
    amber: { label: 'text-amber-700/85', box: 'border-amber-100 bg-amber-50 text-amber-950', bar: 'bg-amber-500', button: 'bg-amber-600 hover:bg-amber-700', ring: 'rgba(245, 158, 11, 0.72)' },
    emerald: { label: 'text-emerald-700/85', box: 'border-emerald-100 bg-emerald-50 text-emerald-950', bar: 'bg-emerald-600', button: 'bg-emerald-600 hover:bg-emerald-700', ring: 'rgba(5, 150, 105, 0.72)' },
    rose: { label: 'text-rose-700/85', box: 'border-rose-100 bg-rose-50 text-rose-950', bar: 'bg-rose-600', button: 'bg-rose-600 hover:bg-rose-700', ring: 'rgba(225, 29, 72, 0.72)' },
    violet: { label: 'text-violet-700/85', box: 'border-violet-100 bg-violet-50 text-violet-950', bar: 'bg-violet-600', button: 'bg-violet-600 hover:bg-violet-700', ring: 'rgba(124, 58, 237, 0.72)' },
    slate: { label: 'text-slate-700/85', box: 'border-slate-200 bg-slate-100 text-slate-950', bar: 'bg-slate-700', button: 'bg-slate-700 hover:bg-slate-800', ring: 'rgba(51, 65, 85, 0.72)' },
  };

  function getVisibleTarget(selector: string): HTMLElement | null {
    if (!selector) return null;
    const nodes = Array.from(document.querySelectorAll<HTMLElement>(selector));
    return nodes.find((node) => node.offsetParent !== null) ?? nodes[0] ?? null;
  }

  async function setTourSeen(accessToken: string, seen: boolean) {
    try {
      await fetch(`${API}/api/dashboard/tour-status`, {
        method: 'PATCH',
        headers: {
          Authorization: `Bearer ${accessToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ seen }),
      });
    } catch {
      // best effort
    }
  }

  async function markOnboardingCompleted(accessToken: string) {
    try {
      await fetch(`${API}/api/commerces/me`, {
        method: 'PATCH',
        headers: {
          Authorization: `Bearer ${accessToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ onboarding_completed: true }),
      });
    } catch {
      // best effort
    }
  }

  function getCurrentPath() {
    return window.location.pathname;
  }

  function getStepFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const raw = params.get('step') ?? window.sessionStorage.getItem(TOUR_STEP_KEY) ?? '0';
    const parsed = Number(raw);
    if (!Number.isFinite(parsed)) return 0;
    return Math.min(Math.max(parsed, 0), TOUR_STEPS.length - 1);
  }

  function isTourForced() {
    const params = new URLSearchParams(window.location.search);
    return params.get('tour') === '1' || window.sessionStorage.getItem(TOUR_QUERY_KEY) === '1';
  }

  function makeTourUrl(stepIndex: number) {
    const step = TOUR_STEPS[stepIndex];
    const url = new URL(step.path, window.location.origin);
    url.searchParams.set('tour', '1');
    url.searchParams.set('step', String(stepIndex));
    return `${url.pathname}${url.search}`;
  }

  function goToTourStep(stepIndex: number) {
    window.sessionStorage.setItem(TOUR_QUERY_KEY, '1');
    window.sessionStorage.removeItem(TOUR_POSTPONED_KEY);
    window.sessionStorage.setItem(TOUR_STEP_KEY, String(stepIndex));
    const stepUrl = makeTourUrl(stepIndex);
    const destination = new URL(stepUrl, window.location.origin);
    if (destination.pathname !== getCurrentPath()) {
      window.location.href = stepUrl;
      return;
    }
    window.history.replaceState({}, '', stepUrl);
  }

  function clearTourUrl() {
    const url = new URL(window.location.href);
    url.searchParams.delete('tour');
    url.searchParams.delete('step');
    window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
  }

  function startDashboardTour(accessToken: string, startIndex = 0, onboardingCompleted = true) {
    const style = document.createElement('style');
    style.textContent = `
      .dashboard-tour-highlight {
        position: relative;
        z-index: 86 !important;
        box-shadow: 0 0 0 3px var(--tour-ring, rgba(14, 165, 233, 0.75)), 0 0 0 9999px rgba(15, 23, 42, 0.42), 0 20px 55px -30px rgba(8, 47, 73, 0.6);
        border-radius: 1rem;
      }
      .dashboard-tour-card {
        max-height: min(72vh, 560px);
        overflow: auto;
        overscroll-behavior: contain;
      }
      @media (max-width: 640px) {
        .dashboard-tour-card {
          left: 1rem !important;
          right: 1rem !important;
          top: auto !important;
          bottom: calc(env(safe-area-inset-bottom) + 1rem) !important;
          width: auto !important;
          max-height: min(76dvh, calc(100dvh - env(safe-area-inset-bottom) - 2rem)) !important;
          transform: none !important;
        }
      }
    `;
    document.head.appendChild(style);

    const overlay = document.createElement('div');
    overlay.className = 'fixed inset-0 z-[75] pointer-events-none';

    const card = document.createElement('div');
    card.className = 'dashboard-tour-card pointer-events-auto fixed z-[90] w-[min(92vw,430px)] rounded-2xl border border-sky-100 bg-white p-5 shadow-2xl shadow-slate-950/20';
    overlay.appendChild(card);
    document.body.appendChild(overlay);

    let index = startIndex;
    let activeTarget: HTMLElement | null = null;
    let reposition = () => {};

    const cleanupTarget = () => {
      if (!activeTarget) return;
      activeTarget.classList.remove('dashboard-tour-highlight');
      activeTarget.style.removeProperty('--tour-ring');
      activeTarget = null;
    };

    const finish = async () => {
      cleanupTarget();
      window.removeEventListener('resize', reposition);
      window.removeEventListener('scroll', reposition);
      overlay.remove();
      style.remove();
      window.sessionStorage.removeItem(TOUR_QUERY_KEY);
      window.sessionStorage.removeItem(TOUR_STEP_KEY);
      window.sessionStorage.removeItem(TOUR_POSTPONED_KEY);
      clearTourUrl();
      await setTourSeen(accessToken, true);
      if (!onboardingCompleted) {
        await markOnboardingCompleted(accessToken);
        window.location.href = '/dashboard/carte?setup=1';
      }
    };

    const dismiss = async () => {
      cleanupTarget();
      window.removeEventListener('resize', reposition);
      window.removeEventListener('scroll', reposition);
      overlay.remove();
      style.remove();
      window.sessionStorage.removeItem(TOUR_QUERY_KEY);
      window.sessionStorage.removeItem(TOUR_STEP_KEY);
      window.sessionStorage.removeItem(TOUR_POSTPONED_KEY);
      clearTourUrl();
      await setTourSeen(accessToken, true);
    };

    const positionCard = (target: HTMLElement | null) => {
      const margin = 18;
      const viewportW = window.visualViewport?.width ?? window.innerWidth;
      const viewportH = window.visualViewport?.height ?? window.innerHeight;
      const cardW = Math.min(430, viewportW - 32);
      const availableHeight = Math.max(220, viewportH - margin * 2);
      card.style.maxHeight = `${availableHeight}px`;

      if (viewportW < 640) {
        card.style.left = '';
        card.style.right = '';
        card.style.top = '';
        card.style.bottom = '';
        card.style.width = '';
        card.style.transform = '';
        return;
      }

      if (!target) {
        card.style.width = `${cardW}px`;
        card.style.left = '50%';
        card.style.right = 'auto';
        card.style.top = `${Math.max(margin, Math.round(viewportH * 0.18))}px`;
        card.style.bottom = 'auto';
        card.style.transform = 'translateX(-50%)';
        return;
      }

      const rect = target.getBoundingClientRect();
      const preferRight = rect.left + rect.width + cardW + margin < viewportW;
      const preferLeft = rect.left - cardW - margin > 0;
      const measuredHeight = Math.min(card.getBoundingClientRect().height || 260, availableHeight);
      const maxTop = Math.max(margin, viewportH - measuredHeight - margin);
      const top = Math.min(Math.max(rect.top, margin), maxTop);

      card.style.width = `${cardW}px`;
      card.style.top = `${top}px`;
      card.style.bottom = 'auto';
      card.style.transform = 'none';

      if (preferRight) {
        card.style.left = `${rect.right + margin}px`;
        card.style.right = 'auto';
      } else if (preferLeft) {
        card.style.left = `${rect.left - cardW - margin}px`;
        card.style.right = 'auto';
      } else {
        card.style.left = '50%';
        card.style.right = 'auto';
        card.style.transform = 'translateX(-50%)';
        card.style.top = `${Math.min(Math.max(rect.bottom + margin, margin), maxTop)}px`;
      }
    };

    reposition = () => positionCard(activeTarget);
    window.addEventListener('resize', reposition);
    window.addEventListener('scroll', reposition, { passive: true });

    const render = () => {
      const step = TOUR_STEPS[index];
      if (getCurrentPath() !== new URL(step.path, window.location.origin).pathname) {
        goToTourStep(index);
        return;
      }

      cleanupTarget();
      const tone = TOUR_TONES[step.tone];
      activeTarget = getVisibleTarget(step.selector) ?? getVisibleTarget(step.navSelector ?? '');
      activeTarget?.style.setProperty('--tour-ring', tone.ring);
      activeTarget?.classList.add('dashboard-tour-highlight');
      activeTarget?.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });

      card.innerHTML = `
        <div class="mb-3 flex items-center justify-between gap-3">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.24em] ${tone.label}">Guide FideloPass (${index + 1}/${TOUR_STEPS.length})</p>
          <button type="button" id="tour-skip" class="rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
            Ne plus afficher
          </button>
        </div>
        <h3 class="text-lg font-display font-bold text-slate-900">${step.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">${step.body}</p>
        <div class="mt-3 rounded-xl border px-3 py-2 text-sm font-medium ${tone.box}">
          ${step.action}
        </div>
        <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full ${tone.bar} transition-all" style="width:${((index + 1) / TOUR_STEPS.length) * 100}%"></div>
        </div>
        <div class="mt-4 grid grid-cols-[auto_1fr_auto] items-center gap-2">
          <button type="button" id="tour-prev" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 ${index === 0 ? 'opacity-40 cursor-not-allowed' : ''}" ${index === 0 ? 'disabled' : ''}>
            Précédent
          </button>
          <a id="tour-open-page" href="${step.path}" class="text-center text-xs font-semibold text-sky-700 hover:text-sky-800">
            Explorer cette page
          </a>
          <button type="button" id="tour-next" class="rounded-xl px-3.5 py-2 text-xs font-semibold text-white ${tone.button}">
            ${index === TOUR_STEPS.length - 1 ? 'Terminer' : 'Suivant'}
          </button>
        </div>
      `;

      const nextBtn = card.querySelector<HTMLButtonElement>('#tour-next');
      const prevBtn = card.querySelector<HTMLButtonElement>('#tour-prev');
      const skipBtn = card.querySelector<HTMLButtonElement>('#tour-skip');
      window.requestAnimationFrame(() => {
        positionCard(activeTarget);
        window.setTimeout(() => positionCard(activeTarget), 180);
      });
      nextBtn?.addEventListener('click', async () => {
        if (index >= TOUR_STEPS.length - 1) {
          await finish();
          return;
        }
        index += 1;
        goToTourStep(index);
        render();
      });
      prevBtn?.addEventListener('click', () => {
        if (index <= 0) return;
        index -= 1;
        goToTourStep(index);
        render();
      });
      skipBtn?.addEventListener('click', dismiss);
    };

    goToTourStep(index);
    render();
  }

  async function maybeShowTour(session: SessionLike, onboardingCompleted = true) {
    try {
      const res = await fetch(`${API}/api/dashboard/tour-status`, {
        headers: {
          Authorization: `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
        },
      });
      if (!res.ok) return;
      const payload = await res.json().catch(() => null);
      if (window.sessionStorage.getItem(TOUR_POSTPONED_KEY) === '1' && !isTourForced()) return;
      if (payload?.data?.seen && !isTourForced()) return;
      startDashboardTour(session.access_token, isTourForced() ? getStepFromUrl() : 0, onboardingCompleted);
    } catch {
      // ignore
    }
  }

  async function initDashboardGuard() {
    let overlay = shouldShowSessionRefreshOverlay()
      ? showSessionOverlay('Reconnexion en cours...', 'Votre session est rafraîchie après une période d’inactivité.')
      : undefined;
    const session = await requireFreshSession(supabase, { overlay });
    if (!session) {
      return;
    }

    const billing = await fetch(`${API}/api/billing/status`, {
      headers: {
        Authorization: `Bearer ${session.access_token}`,
        'Content-Type': 'application/json',
      },
    }).then(async (r) => ({ ok: r.ok, status: r.status, payload: await r.json().catch(() => ({})) })).catch(() => null);

    if (!billing) {
      overlay = overlay ?? showSessionOverlay('Connexion instable', 'Impossible de vérifier votre accès pour le moment.');
      overlay.setText('Connexion instable', 'Impossible de vérifier votre accès pour le moment.');
      window.setTimeout(() => window.location.reload(), 1200);
      return;
    }

    if (billing.status === 401) {
      const refreshed = await requireFreshSession(supabase, { overlay });
      if (!refreshed) return;
      window.location.reload();
      return;
    }

    if (!billing.payload?.data?.has_access) {
      const reseller = await fetch(`${API}/api/reseller/me`, {
        headers: {
          Authorization: `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
        },
      }).then(async (r) => (r.ok ? await r.json().catch(() => null) : null)).catch(() => null);
      if (reseller?.data) {
        window.location.replace('/reseller');
        return;
      }
      window.location.replace('/abonnement/choix');
      return;
    }
    overlay?.remove();
    maybeShowTour(session as SessionLike, Boolean(billing.payload?.data?.onboarding_completed));
  }

  initDashboardGuard();
</script>

<script>
  type ToastType = 'success' | 'error' | 'info';
  window.showToast = function(message: string, type: ToastType = 'success') {
    const colors: Record<ToastType, string> = {
      success: 'bg-emerald-600 text-white',
      error: 'bg-red-600 text-white',
      info: 'bg-sky-600 text-white',
    };
    const container = document.getElementById('toast-container');
    if (!container) return;
    const t = document.createElement('div');
    t.className = `pointer-events-auto flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-semibold shadow-lg ${colors[type] ?? colors.success} translate-y-2 opacity-0 transition-all duration-300`;
    t.textContent = message;
    container.appendChild(t);
    requestAnimationFrame(() => { t.classList.remove('translate-y-2', 'opacity-0'); });
    setTimeout(() => {
      t.classList.add('translate-y-2', 'opacity-0');
      setTimeout(() => t.remove(), 300);
    }, 3500);
  };
</script>
