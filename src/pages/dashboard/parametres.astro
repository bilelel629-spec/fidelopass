---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Mon compte commerçant — Fidelopass" activeNav="parametres">
  <div class="account-page space-y-6">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <p class="text-[0.7rem] font-extrabold uppercase tracking-[0.32em] text-blue-600">Compte commerçant</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-[-0.04em] text-slate-950 sm:text-5xl lg:text-6xl">Mon compte</h1>
      <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">Gérez vos informations, votre abonnement et l’organisation de vos points de vente.</p>
    </div>
    <div class="inline-flex w-fit items-center gap-3 rounded-full border border-blue-100 bg-blue-50 px-4 py-3 shadow-[0_18px_40px_-32px_rgba(37,99,235,0.55)]">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-blue-600 shadow-sm">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 3 3 6 6 .9-4.5 4.4 1.1 6.2L12 17.6 6.4 20.5l1.1-6.2L3 9.9 9 9l3-6Z"></path>
        </svg>
      </span>
      <div>
        <p class="text-sm font-extrabold text-slate-950">Plan actif</p>
        <p id="account-plan-badge" class="text-xs font-medium text-slate-500">Chargement…</p>
      </div>
    </div>
  </div>

  <div class="rounded-[1.5rem] border border-slate-200 bg-white p-2 shadow-[0_18px_45px_-34px_rgba(15,23,42,0.35)]" data-tour="account-tabs">
    <div class="grid gap-2 sm:grid-cols-4">
      <button type="button" data-tab="profil" class="account-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Profil</button>
      <button type="button" data-tab="abonnement" class="account-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Abonnement</button>
      <button type="button" data-tab="organisation" class="account-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Organisation</button>
      <button type="button" data-tab="widget" class="account-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Espace fidélité</button>
    </div>
  </div>

  <section id="tab-profil" class="account-panel rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)] sm:p-7">
    <div class="mb-6">
      <h2 class="font-display text-2xl font-extrabold tracking-[-0.03em] text-slate-950">Profil du commerce</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">Informations principales visibles dans votre espace commerçant.</p>
    </div>
    <form id="settings-form" class="flex flex-col gap-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="nom">Nom du commerce</label>
          <input id="nom" type="text" class="input" placeholder="Ma Boutique" required />
        </div>
        <div>
          <label class="label" for="telephone">Téléphone</label>
          <input id="telephone" type="tel" class="input" placeholder="06 12 34 56 78" />
        </div>
      </div>
      <div>
        <label class="label" for="email-commerce">Email contact</label>
        <input id="email-commerce" type="email" class="input" placeholder="contact@moncommerce.fr" />
      </div>
      <div class="rounded-2xl border border-sky-100 bg-sky-50 px-4 py-3 text-sm text-slate-700">
        Adresse, géolocalisation et message de proximité se règlent dans
        <a href="/dashboard/carte" class="font-semibold text-sky-700 underline underline-offset-2">Ma carte</a>.
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3">
        <p class="text-sm font-semibold text-slate-900">Besoin de revoir la visite guidée ?</p>
        <p class="mt-1 text-xs text-slate-500">Relancez le tutoriel automatique pour parcourir les zones principales de l’espace commerçant.</p>
        <button id="restart-tour-btn" type="button" class="btn-secondary mt-3 px-4 py-2.5 text-sm">Relancer le tutoriel</button>
      </div>
      <div id="error-msg" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
      <div id="success-msg" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"></div>
      <button type="submit" class="w-fit rounded-[1rem] bg-slate-950 px-6 py-3 text-sm font-extrabold text-white shadow-[0_18px_36px_-24px_rgba(15,23,42,0.8)] transition hover:-translate-y-0.5 hover:bg-slate-800">Enregistrer</button>
    </form>
  </section>

  <section id="tab-abonnement" class="account-panel hidden" data-tour="account-billing">
    <div class="grid gap-5 xl:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.7fr)]">
      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)] sm:p-7">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.26em] text-blue-600/75">Plan actuel</p>
            <p class="mt-3 font-display text-4xl font-extrabold tracking-[-0.05em] text-slate-950"><span id="plans-current-plan">Chargement…</span></p>
            <p class="mt-2 text-sm text-slate-600">Statut: <span id="plans-current-status" class="font-semibold text-slate-900">Chargement…</span></p>
            <p id="plans-period-info" class="mt-2 text-sm text-slate-600"></p>
          </div>
          <span id="plans-status-pill" class="inline-flex w-fit rounded-full bg-[linear-gradient(135deg,#2563EB_0%,#7C3AED_100%)] px-4 py-2 text-xs font-extrabold uppercase tracking-[0.18em] text-white shadow-[0_16px_36px_-22px_rgba(37,99,235,0.95)]">Actif</span>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <button id="plans-manage-btn" type="button" class="account-action-btn account-action-primary">Factures et paiements</button>
          <button id="plans-payment-btn" type="button" class="account-action-btn">Moyen de paiement</button>
          <button id="plans-upgrade-btn" type="button" class="account-action-btn">Changer de plan</button>
          <button id="plans-cancel-btn" type="button" class="account-action-btn account-action-danger">Annuler l’abonnement</button>
          <button id="plans-reactivate-btn" type="button" class="account-action-btn account-action-success">Réactiver</button>
        </div>

        <p id="plans-action-feedback" class="hidden mt-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700"></p>
        <div class="mt-5 flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
          <span>✓ Sans engagement</span>
          <span>✓ Résiliation en un clic</span>
          <span>✓ Facturation sécurisée par Stripe</span>
        </div>
      </div>

      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-52px_rgba(15,23,42,0.45)] sm:p-7">
        <h2 class="font-display text-2xl font-extrabold tracking-[-0.03em] text-slate-950">Capacité incluse</h2>
        <div class="mt-5 space-y-3">
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <p class="font-bold text-slate-950">Starter</p>
            <p class="mt-1 text-sm text-slate-500">1 point de vente</p>
          </div>
          <div class="rounded-2xl border border-blue-200 bg-blue-50 p-4">
            <p class="font-bold text-blue-950">Pro</p>
            <p class="mt-1 text-sm text-blue-700">Jusqu’à 3 points de vente</p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <p class="font-bold text-slate-950">Sur mesure</p>
            <p class="mt-1 text-sm text-slate-500">Capacité personnalisée</p>
          </div>
        </div>
        <p class="mt-4 rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">Scanners illimités sur tous les plans.</p>
        <a href="/pricing" class="mt-4 inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-extrabold text-slate-700 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700">Voir les tarifs détaillés</a>
      </div>
    </div>
  </section>

  <section id="tab-organisation" class="account-panel hidden rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)] sm:p-7">
    <div class="mb-6">
      <h2 class="font-display text-2xl font-extrabold tracking-[-0.03em] text-slate-950">Organisation</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">Points de vente, scanner équipe et accès opérationnels.</p>
    </div>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-semibold text-slate-900">Point de vente actif</p>
        <p id="organisation-adresse" class="mt-2 text-sm text-slate-600">Adresse en cours de chargement…</p>
        <p id="organisation-rayon" class="mt-2 text-xs text-slate-500">Rayon de géolocalisation: —</p>
        <a href="/dashboard/points-vente" class="btn-secondary mt-4 inline-flex px-4 py-2.5 text-sm">Gérer les points de vente</a>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-semibold text-slate-900">Scanner équipe</p>
        <p class="mt-2 text-sm text-slate-600">Installez le scanner en caisse et partagez le QR client rapidement.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/app/install" class="btn-secondary px-4 py-2.5 text-sm">Installer un scanner</a>
          <a href="/dashboard/carte" class="btn-secondary px-4 py-2.5 text-sm">Afficher le QR client</a>
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 lg:col-span-2">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-sm font-semibold text-slate-900">Accès équipe</p>
            <p class="mt-2 text-sm text-slate-600">Ajoutez un email secondaire pour permettre à une autre personne de se connecter au même commerce.</p>
          </div>
          <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700">Propriétaire</span>
        </div>
        <form id="team-access-form" class="mt-4 grid gap-3 lg:grid-cols-[1fr_180px_auto]">
          <input id="team-access-email" type="email" class="input" placeholder="email@exemple.com" required />
          <select id="team-access-role" class="input">
            <option value="staff">Accès équipe</option>
            <option value="admin">Administrateur</option>
          </select>
          <button type="submit" class="rounded-[1rem] bg-slate-950 px-5 py-3 text-sm font-extrabold text-white">Ajouter</button>
        </form>
        <p class="mt-2 text-xs text-slate-500">Le compte secondaire doit exister dans Fidelopass avant d’être ajouté.</p>
        <p id="team-access-feedback" class="hidden mt-3 rounded-xl px-4 py-3 text-sm"></p>
        <div id="team-members-list" class="mt-4 space-y-2"></div>
      </div>
    </div>
  </section>

  <section id="tab-widget" class="account-panel hidden">
    <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)]">
      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)] sm:p-7">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.26em] text-blue-600/75">Widget pour votre site</p>
            <h2 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.04em] text-slate-950">Espace fidélité client</h2>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Vos clients se connectent par code SMS et consultent leurs points, tampons, récompenses et Wallet directement sur votre site.</p>
          </div>
          <label class="inline-flex w-fit cursor-pointer items-center gap-3 rounded-full border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-extrabold text-slate-700">
            <input id="widget-enabled" type="checkbox" class="h-4 w-4 accent-blue-600" />
            Activer
          </label>
        </div>

        <form id="widget-form" class="mt-7 space-y-5">
          <div>
            <label class="label" for="widget-origins">Domaines autorisés</label>
            <textarea id="widget-origins" class="input min-h-28 resize-y" placeholder="https://www.votre-site.fr&#10;https://votre-site.fr"></textarea>
            <p class="mt-2 text-xs leading-5 text-slate-500">Un domaine HTTPS par ligne. Seuls ces sites pourront charger les données du widget.</p>
          </div>
          <div>
            <label class="label" for="widget-portal-url">Page de l’espace fidélité</label>
            <input id="widget-portal-url" type="url" class="input" placeholder="https://www.votre-site.fr/fidelite" />
            <p class="mt-2 text-xs leading-5 text-slate-500">Cette adresse sera également ajoutée aux prochaines mises à jour des cartes Apple et Google Wallet.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for="widget-title">Titre du bouton</label>
              <input id="widget-title" type="text" maxlength="80" class="input" placeholder="Mon espace fidélité" />
            </div>
            <div>
              <label class="label" for="widget-color">Couleur principale</label>
              <div class="flex gap-3">
                <input id="widget-color-picker" type="color" value="#2563eb" class="h-12 w-14 cursor-pointer rounded-xl border border-slate-200 bg-white p-1" aria-label="Choisir la couleur" />
                <input id="widget-color" type="text" value="#2563eb" maxlength="7" class="input" pattern="#[0-9A-Fa-f]{6}" />
              </div>
            </div>
          </div>
          <div>
            <label class="label" for="widget-logo-url">Logo personnalisé (facultatif)</label>
            <input id="widget-logo-url" type="url" class="input" placeholder="https://www.votre-site.fr/logo.png" />
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700"><input id="widget-show-history" type="checkbox" checked class="h-4 w-4 accent-blue-600" />Afficher l’historique</label>
            <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700"><input id="widget-show-wallet" type="checkbox" checked class="h-4 w-4 accent-blue-600" />Afficher les boutons Wallet</label>
          </div>
          <p id="widget-feedback" class="hidden rounded-xl px-4 py-3 text-sm"></p>
          <button id="widget-save" type="submit" class="rounded-[1rem] bg-slate-950 px-6 py-3 text-sm font-extrabold text-white shadow-[0_18px_36px_-24px_rgba(15,23,42,0.8)] transition hover:-translate-y-0.5 hover:bg-slate-800">Enregistrer le widget</button>
        </form>

        <div class="mt-8 border-t border-slate-200 pt-7">
          <div class="flex items-center justify-between gap-3">
            <div><h3 class="font-display text-xl font-extrabold text-slate-950">Code d’intégration</h3><p class="mt-1 text-xs text-slate-500">À coller avant la balise de fermeture &lt;/body&gt; de votre site.</p></div>
            <button id="widget-copy" type="button" class="btn-secondary px-4 py-2.5 text-sm">Copier</button>
          </div>
          <textarea id="widget-snippet" readonly class="mt-4 min-h-32 w-full resize-none rounded-2xl border border-slate-800 bg-slate-950 p-4 font-mono text-xs leading-6 text-slate-100"></textarea>
        </div>
      </div>

      <div class="rounded-[1.75rem] border border-slate-200 bg-slate-950 p-5 shadow-[0_24px_70px_-44px_rgba(15,23,42,0.8)] sm:p-7">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-blue-300">Aperçu mobile</p>
        <div id="widget-preview" class="mt-5 overflow-hidden rounded-[1.5rem] border border-white/10 bg-white shadow-2xl"></div>
        <div class="mt-5 rounded-2xl border border-white/10 bg-white/5 p-4 text-xs leading-5 text-slate-300">
          Les récompenses restent présentées sous forme de cartes lisibles, même quand plusieurs paliers sont configurés. Le code SMS remplace le mot de passe.
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-[1.5rem] border border-red-100 bg-red-50/50 p-6">
    <h2 class="mb-1 font-display text-xl font-extrabold text-slate-950">Déconnexion</h2>
    <p class="mb-4 text-sm text-slate-600">Vous serez redirigé vers la page de connexion.</p>
    <button id="logout-btn" class="rounded-2xl border border-red-200 bg-white px-5 py-3 text-sm font-extrabold text-red-600 transition hover:bg-red-50">
      Se déconnecter
    </button>
  </section>
  </div>
</DashboardLayout>

<style>
  .account-page {
    animation: account-fade-up 0.58s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .account-action-btn {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240);
    background: rgb(255 255 255);
    padding: 0.95rem 1rem;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 800;
    color: rgb(51 65 85);
    box-shadow: 0 18px 38px -34px rgba(15, 23, 42, 0.45);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease, color 180ms ease;
  }

  .account-action-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: rgb(191 219 254);
    background: rgb(248 250 252);
    color: rgb(29 78 216);
    box-shadow: 0 22px 44px -30px rgba(37, 99, 235, 0.48);
  }

  .account-action-primary {
    border-color: rgba(37, 99, 235, 0.24);
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: white;
    box-shadow: 0 22px 46px -28px rgba(37, 99, 235, 0.78);
  }

  .account-action-primary:hover:not(:disabled) {
    color: white;
    background: linear-gradient(135deg, #1d4ed8 0%, #6d28d9 100%);
  }

  .account-action-danger {
    border-color: rgb(254 202 202);
    background: rgb(254 242 242);
    color: rgb(220 38 38);
  }

  .account-action-danger:hover:not(:disabled) {
    border-color: rgb(252 165 165);
    background: rgb(254 226 226);
    color: rgb(185 28 28);
  }

  .account-action-success {
    border-color: rgb(167 243 208);
    background: rgb(236 253 245);
    color: rgb(4 120 87);
  }

  .account-action-success:hover:not(:disabled) {
    border-color: rgb(110 231 183);
    background: rgb(209 250 229);
    color: rgb(6 95 70);
  }

  @keyframes account-fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .account-page,
    .account-action-btn {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { authFetch } from '../../lib/api';
  import { signOut } from '../../lib/auth';
  import { planLabel } from '../../lib/dashboard-config';

  function setAccountTab(tab: string) {
    document.querySelectorAll<HTMLElement>('.account-tab').forEach((button) => {
      const active = button.dataset.tab === tab;
      button.className = active
        ? 'account-tab rounded-[1.1rem] bg-[linear-gradient(135deg,#2563EB_0%,#7C3AED_100%)] px-4 py-4 text-sm font-extrabold text-white shadow-[0_16px_34px_-22px_rgba(37,99,235,0.95)] transition'
        : 'account-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold text-slate-600 transition hover:bg-slate-50';
    });
    document.querySelectorAll<HTMLElement>('.account-panel').forEach((panel) => panel.classList.add('hidden'));
    document.getElementById(`tab-${tab}`)?.classList.remove('hidden');
  }

  document.querySelectorAll<HTMLElement>('.account-tab').forEach((button) => {
    button.addEventListener('click', () => setAccountTab(button.dataset.tab ?? 'profil'));
  });

  const requestedTab = new URLSearchParams(window.location.search).get('tab');
  const normalizedTab = requestedTab === 'plans' ? 'abonnement' : requestedTab;
  if (normalizedTab && ['profil', 'abonnement', 'organisation', 'widget'].includes(normalizedTab)) {
    setAccountTab(normalizedTab);
  } else {
    setAccountTab('profil');
  }

  const form = document.getElementById('settings-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const plansCurrentPlan = document.getElementById('plans-current-plan') as HTMLSpanElement;
  const plansCurrentStatus = document.getElementById('plans-current-status') as HTMLSpanElement;
  const plansStatusPill = document.getElementById('plans-status-pill') as HTMLSpanElement;
  const plansPeriodInfo = document.getElementById('plans-period-info') as HTMLParagraphElement;
  const accountPlanBadge = document.getElementById('account-plan-badge') as HTMLParagraphElement;
  const plansUpgradeBtn = document.getElementById('plans-upgrade-btn') as HTMLButtonElement;
  const plansManageBtn = document.getElementById('plans-manage-btn') as HTMLButtonElement;
  const plansPaymentBtn = document.getElementById('plans-payment-btn') as HTMLButtonElement;
  const plansCancelBtn = document.getElementById('plans-cancel-btn') as HTMLButtonElement;
  const plansReactivateBtn = document.getElementById('plans-reactivate-btn') as HTMLButtonElement;
  const plansActionFeedback = document.getElementById('plans-action-feedback') as HTMLParagraphElement;
  const teamAccessForm = document.getElementById('team-access-form') as HTMLFormElement | null;
  const teamAccessEmail = document.getElementById('team-access-email') as HTMLInputElement | null;
  const teamAccessRole = document.getElementById('team-access-role') as HTMLSelectElement | null;
  const teamAccessFeedback = document.getElementById('team-access-feedback') as HTMLParagraphElement | null;
  const teamMembersList = document.getElementById('team-members-list') as HTMLDivElement | null;
  let billingPrices: Array<{ slot: string; available: boolean; plan: string; currency: string }> = [];
  let billingStatus: Record<string, any> | null = null;

  const widgetForm = document.getElementById('widget-form') as HTMLFormElement | null;
  const widgetEnabled = document.getElementById('widget-enabled') as HTMLInputElement | null;
  const widgetOrigins = document.getElementById('widget-origins') as HTMLTextAreaElement | null;
  const widgetPortalUrl = document.getElementById('widget-portal-url') as HTMLInputElement | null;
  const widgetTitle = document.getElementById('widget-title') as HTMLInputElement | null;
  const widgetColor = document.getElementById('widget-color') as HTMLInputElement | null;
  const widgetColorPicker = document.getElementById('widget-color-picker') as HTMLInputElement | null;
  const widgetLogoUrl = document.getElementById('widget-logo-url') as HTMLInputElement | null;
  const widgetShowHistory = document.getElementById('widget-show-history') as HTMLInputElement | null;
  const widgetShowWallet = document.getElementById('widget-show-wallet') as HTMLInputElement | null;
  const widgetSnippet = document.getElementById('widget-snippet') as HTMLTextAreaElement | null;
  const widgetFeedback = document.getElementById('widget-feedback') as HTMLParagraphElement | null;
  const widgetPreview = document.getElementById('widget-preview') as HTMLDivElement | null;

  function setWidgetFeedback(message = '', type: 'info' | 'success' | 'error' = 'info') {
    if (!widgetFeedback) return;
    if (!message) {
      widgetFeedback.classList.add('hidden');
      widgetFeedback.textContent = '';
      return;
    }
    widgetFeedback.textContent = message;
    widgetFeedback.className = [
      'rounded-xl px-4 py-3 text-sm',
      type === 'success' ? 'border border-emerald-200 bg-emerald-50 text-emerald-700' : '',
      type === 'error' ? 'border border-red-200 bg-red-50 text-red-700' : '',
      type === 'info' ? 'border border-sky-200 bg-sky-50 text-sky-700' : '',
    ].filter(Boolean).join(' ');
  }

  function setPlansFeedback(message = '') {
    if (!message) {
      plansActionFeedback.classList.add('hidden');
      plansActionFeedback.textContent = '';
      return;
    }
    plansActionFeedback.textContent = message;
    plansActionFeedback.classList.remove('hidden');
  }

  function formatDate(value?: string | null) {
    if (!value) return null;
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return null;
    return date.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
  }

  function setButtonState(button: HTMLButtonElement, enabled: boolean) {
    button.disabled = !enabled;
    button.classList.toggle('opacity-50', !enabled);
    button.classList.toggle('cursor-not-allowed', !enabled);
  }

  function setTeamFeedback(message = '', type: 'info' | 'success' | 'error' = 'info') {
    if (!teamAccessFeedback) return;
    if (!message) {
      teamAccessFeedback.classList.add('hidden');
      teamAccessFeedback.textContent = '';
      return;
    }

    teamAccessFeedback.textContent = message;
    teamAccessFeedback.className = [
      'mt-3 rounded-xl px-4 py-3 text-sm',
      type === 'success' ? 'border border-emerald-200 bg-emerald-50 text-emerald-700' : '',
      type === 'error' ? 'border border-red-200 bg-red-50 text-red-700' : '',
      type === 'info' ? 'border border-sky-200 bg-sky-50 text-sky-700' : '',
    ].filter(Boolean).join(' ');
  }

  function roleLabel(role: string) {
    if (role === 'owner') return 'Propriétaire';
    if (role === 'admin') return 'Administrateur';
    return 'Accès équipe';
  }

  function statusLabel(status: string) {
    return status === 'active' ? 'Actif' : 'Désactivé';
  }

  function escapeHtml(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char] ?? char));
  }

  function renderWidgetPreview() {
    if (!widgetPreview) return;
    const color = /^#[0-9a-f]{6}$/i.test(widgetColor?.value ?? '') ? widgetColor!.value : '#2563eb';
    const title = widgetTitle?.value.trim() || 'Mon espace fidélité';
    widgetPreview.innerHTML = `
      <div class="border-b border-slate-200 px-5 py-4" style="background:linear-gradient(135deg,${escapeHtml(color)}18,#fff)">
        <p class="text-sm font-extrabold text-slate-950">Votre commerce</p>
        <p class="mt-1 text-xs text-slate-500">${escapeHtml(title)}</p>
      </div>
      <div class="p-5">
        <p class="font-display text-2xl font-extrabold tracking-[-0.04em] text-slate-950">Bonjour Léa</p>
        <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200">
          <div class="bg-slate-50 p-4">
            <p class="text-sm font-extrabold text-slate-900">Ma carte fidélité</p>
            <div class="mt-3 flex items-end justify-between"><strong class="text-4xl tracking-tight text-slate-950">20</strong><span class="text-xs font-semibold text-slate-500">points</span></div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200"><span class="block h-full w-1/2 rounded-full" style="background:${escapeHtml(color)}"></span></div>
          </div>
          <div class="space-y-2 border-t border-slate-200 p-4">
            <p class="mb-2 text-xs font-extrabold text-slate-900">Récompenses</p>
            <div class="flex items-center gap-3 rounded-xl border p-3" style="border-color:${escapeHtml(color)}55;background:${escapeHtml(color)}0d"><span class="grid h-11 w-11 place-items-center rounded-xl text-[10px] font-black text-white" style="background:${escapeHtml(color)}">15 pts</span><div><strong class="block text-xs text-slate-900">Un café offert</strong><small class="mt-1 block text-[10px] text-slate-500">Disponible maintenant</small></div></div>
            <div class="flex items-center gap-3 rounded-xl border border-slate-200 p-3"><span class="grid h-11 w-11 place-items-center rounded-xl bg-slate-100 text-[10px] font-black text-slate-600">45 pts</span><div><strong class="block text-xs text-slate-900">Un plat offert</strong><small class="mt-1 block text-[10px] text-slate-500">Encore 25 points</small></div></div>
          </div>
        </div>
      </div>`;
  }

  async function loadWidgetConfig() {
    if (!widgetForm) return;
    try {
      const res = await authFetch('/api/widget/admin/config');
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible de charger le widget.');
      const data = payload?.data ?? {};
      if (widgetEnabled) widgetEnabled.checked = data.enabled === true;
      if (widgetOrigins) widgetOrigins.value = Array.isArray(data.allowed_origins) ? data.allowed_origins.join('\n') : '';
      if (widgetPortalUrl) widgetPortalUrl.value = data.portal_url ?? '';
      if (widgetTitle) widgetTitle.value = data.theme?.title ?? 'Mon espace fidélité';
      if (widgetColor) widgetColor.value = data.theme?.primary_color ?? '#2563eb';
      if (widgetColorPicker) widgetColorPicker.value = data.theme?.primary_color ?? '#2563eb';
      if (widgetLogoUrl) widgetLogoUrl.value = data.theme?.logo_url ?? '';
      if (widgetShowHistory) widgetShowHistory.checked = data.display_options?.show_history !== false;
      if (widgetShowWallet) widgetShowWallet.checked = data.display_options?.show_wallet_links !== false;
      if (widgetSnippet) widgetSnippet.value = data.snippet ?? '';
      if (!data.runtime_enabled) setWidgetFeedback('Le widget peut être configuré, mais son activation globale est encore en attente du déploiement.', 'info');
      else setWidgetFeedback('Configuration chargée.', 'success');
      renderWidgetPreview();
    } catch (error: unknown) {
      setWidgetFeedback(error instanceof Error ? error.message : 'Impossible de charger le widget.', 'error');
    }
  }

  widgetColorPicker?.addEventListener('input', () => {
    if (widgetColor) widgetColor.value = widgetColorPicker.value;
    renderWidgetPreview();
  });
  widgetColor?.addEventListener('input', () => {
    if (widgetColorPicker && /^#[0-9a-f]{6}$/i.test(widgetColor.value)) widgetColorPicker.value = widgetColor.value;
    renderWidgetPreview();
  });
  widgetTitle?.addEventListener('input', renderWidgetPreview);

  widgetForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = document.getElementById('widget-save') as HTMLButtonElement | null;
    if (button) { button.disabled = true; button.textContent = 'Enregistrement…'; }
    setWidgetFeedback('');
    try {
      const res = await authFetch('/api/widget/admin/config', {
        method: 'PUT',
        body: JSON.stringify({
          enabled: widgetEnabled?.checked === true,
          allowed_origins: (widgetOrigins?.value ?? '').split(/\r?\n/).map((value) => value.trim()).filter(Boolean),
          portal_url: widgetPortalUrl?.value.trim() || null,
          theme: {
            title: widgetTitle?.value.trim() || 'Mon espace fidélité',
            primary_color: widgetColor?.value.trim() || '#2563eb',
            logo_url: widgetLogoUrl?.value.trim() || null,
          },
          display_options: {
            show_history: widgetShowHistory?.checked !== false,
            show_wallet_links: widgetShowWallet?.checked !== false,
          },
        }),
      });
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible d’enregistrer le widget.');
      if (widgetSnippet) widgetSnippet.value = payload?.data?.snippet ?? '';
      setWidgetFeedback('Widget enregistré. Le code d’intégration est prêt à être copié.', 'success');
      renderWidgetPreview();
    } catch (error: unknown) {
      setWidgetFeedback(error instanceof Error ? error.message : 'Impossible d’enregistrer le widget.', 'error');
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Enregistrer le widget'; }
    }
  });

  document.getElementById('widget-copy')?.addEventListener('click', async () => {
    if (!widgetSnippet?.value) return;
    try {
      await navigator.clipboard.writeText(widgetSnippet.value);
      setWidgetFeedback('Code d’intégration copié.', 'success');
    } catch {
      widgetSnippet.select();
      setWidgetFeedback('Sélectionnez puis copiez le code affiché.', 'info');
    }
  });

  function renderTeamMembers(members: Array<Record<string, any>>) {
    if (!teamMembersList) return;

    if (!members.length) {
      teamMembersList.innerHTML = '<div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-500">Aucun accès secondaire pour le moment.</div>';
      return;
    }

    teamMembersList.innerHTML = members.map((member) => {
      const isOwner = member.role === 'owner';
      const isActive = member.status === 'active';
      const canEdit = !isOwner && !member.is_current_user;
      return `
        <div class="team-member-row flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between" data-member-id="${escapeHtml(member.id)}">
          <div>
            <p class="text-sm font-extrabold text-slate-950">${escapeHtml(member.email ?? 'Email inconnu')}</p>
            <p class="mt-1 text-xs font-semibold text-slate-500">${escapeHtml(roleLabel(String(member.role)))} · ${escapeHtml(statusLabel(String(member.status)))}</p>
          </div>
          ${canEdit ? `
            <div class="flex flex-wrap gap-2">
              <button type="button" data-team-action="toggle-status" data-next-status="${isActive ? 'disabled' : 'active'}" class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-700">${isActive ? 'Désactiver' : 'Réactiver'}</button>
              <button type="button" data-team-action="toggle-role" data-next-role="${member.role === 'admin' ? 'staff' : 'admin'}" class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-700">${member.role === 'admin' ? 'Passer équipe' : 'Passer admin'}</button>
              <button type="button" data-team-action="delete" class="rounded-full border border-red-200 bg-red-50 px-3 py-2 text-xs font-extrabold text-red-600">Retirer</button>
            </div>
          ` : '<span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-500">Accès principal</span>'}
        </div>
      `;
    }).join('');
  }

  async function loadTeamMembers() {
    if (!teamMembersList) return;
    teamMembersList.innerHTML = '<div class="rounded-2xl border border-slate-200 bg-white px-4 py-4 text-sm text-slate-500">Chargement des accès…</div>';

    try {
      const res = await authFetch('/api/commerces/members');
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible de charger les accès équipe.');
      renderTeamMembers(Array.isArray(payload?.data) ? payload.data : []);
      setTeamFeedback('');
    } catch (error: unknown) {
      renderTeamMembers([]);
      setTeamFeedback(error instanceof Error ? error.message : 'Impossible de charger les accès équipe.', 'error');
    }
  }

  teamAccessForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!teamAccessEmail || !teamAccessRole) return;

    const submitButton = teamAccessForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const previousLabel = submitButton?.textContent ?? 'Ajouter';
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Ajout...';
    }
    setTeamFeedback('');

    try {
      const res = await authFetch('/api/commerces/members', {
        method: 'POST',
        body: JSON.stringify({
          email: teamAccessEmail.value,
          role: teamAccessRole.value,
        }),
      });
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible d’ajouter cet accès.');

      teamAccessEmail.value = '';
      teamAccessRole.value = 'staff';
      await loadTeamMembers();
      setTeamFeedback('Accès équipe ajouté.', 'success');
    } catch (error: unknown) {
      setTeamFeedback(error instanceof Error ? error.message : 'Impossible d’ajouter cet accès.', 'error');
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = previousLabel;
      }
    }
  });

  teamMembersList?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-team-action]');
    if (!button) return;

    const row = button.closest<HTMLElement>('[data-member-id]');
    const memberId = row?.dataset.memberId;
    const action = button.dataset.teamAction;
    if (!memberId || !action) return;

    const previousLabel = button.textContent ?? 'Action';
    button.disabled = true;
    button.textContent = '...';
    setTeamFeedback('');

    try {
      if (action === 'delete') {
        const confirmed = window.confirm('Retirer cet accès secondaire ?');
        if (!confirmed) return;
        const res = await authFetch(`/api/commerces/members/${memberId}`, { method: 'DELETE' });
        const payload = await res.json().catch(() => null);
        if (!res.ok) throw new Error(payload?.error ?? 'Impossible de retirer cet accès.');
        setTeamFeedback('Accès retiré.', 'success');
      } else if (action === 'toggle-status') {
        const nextStatus = button.dataset.nextStatus;
        const res = await authFetch(`/api/commerces/members/${memberId}`, {
          method: 'PATCH',
          body: JSON.stringify({ status: nextStatus }),
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok) throw new Error(payload?.error ?? 'Impossible de modifier cet accès.');
        setTeamFeedback(nextStatus === 'active' ? 'Accès réactivé.' : 'Accès désactivé.', 'success');
      } else if (action === 'toggle-role') {
        const nextRole = button.dataset.nextRole;
        const res = await authFetch(`/api/commerces/members/${memberId}`, {
          method: 'PATCH',
          body: JSON.stringify({ role: nextRole }),
        });
        const payload = await res.json().catch(() => null);
        if (!res.ok) throw new Error(payload?.error ?? 'Impossible de modifier ce rôle.');
        setTeamFeedback('Rôle mis à jour.', 'success');
      }

      await loadTeamMembers();
    } catch (error: unknown) {
      setTeamFeedback(error instanceof Error ? error.message : 'Action impossible.', 'error');
    } finally {
      button.disabled = false;
      button.textContent = previousLabel;
    }
  });

  function pickTargetPlan(data: Record<string, any>) {
    const currentPlan = String(data.plan ?? '').toLowerCase();
    const interval = String(data.billing_interval ?? 'month');
    const commitment = String(data.billing_commitment ?? 'monthly-flex');
    const targetPlan = currentPlan === 'pro' ? 'starter' : 'pro';
    const targetSlot = (() => {
      if (interval === 'year' || interval === 'one_time' || commitment === 'annual-recurring' || commitment === 'annual-12m-once') return `${targetPlan}_annuel_once`;
      if (commitment === 'annual-12m-monthly') return `${targetPlan}_annuel_mensuel`;
      return `${targetPlan}_mensuel`;
    })();
    const exact = billingPrices.find((item) => item.slot === targetSlot && item.available);
    const fallback = billingPrices.find((item) => item.plan === targetPlan && item.slot.endsWith('_mensuel') && item.available);
    const selected = exact ?? fallback;
    if (!selected) return null;
    return {
      plan: targetPlan,
      interval: selected.slot.endsWith('_annuel_once') ? 'yearly' : 'monthly',
    };
  }

  async function openBillingPortal(flow: 'manage' | 'cancel' | 'payment_method' | 'change_plan') {
    setPlansFeedback('');
    const res = await authFetch('/api/billing/portal', {
      method: 'POST',
      body: JSON.stringify({ flow }),
    });
    const payload = await res.json().catch(() => null);
    if (!res.ok || !payload?.url) {
      const error = new Error(payload?.error ?? 'Impossible d’ouvrir la gestion de l’abonnement.');
      (error as any).code = payload?.code;
      throw error;
    }
    window.location.href = payload.url;
  }

  async function scheduleBillingCancel() {
    const confirmed = window.confirm("Programmer l'annulation à la fin de la période en cours ?");
    if (!confirmed) return;
    const res = await authFetch('/api/billing/cancel', { method: 'POST' });
    const payload = await res.json().catch(() => null);
    if (!res.ok) throw new Error(payload?.error ?? "Impossible de programmer l'annulation.");
    await loadPlansControls();
    setPlansFeedback("Annulation programmée. L'accès reste actif jusqu'à la fin de la période payée.");
  }

  async function reactivateBilling() {
    const confirmed = window.confirm("Réactiver l'abonnement et reprendre les renouvellements Stripe ?");
    if (!confirmed) return;
    const res = await authFetch('/api/billing/reactivate', { method: 'POST' });
    const payload = await res.json().catch(() => null);
    if (!res.ok) throw new Error(payload?.error ?? "Impossible de réactiver l'abonnement.");
    await loadPlansControls();
    setPlansFeedback("L'abonnement est réactivé.");
  }

  async function changeBillingPlan(target: { plan: string; interval: string }) {
    const confirmed = window.confirm("Confirmer le changement de plan ? Stripe appliquera les ajustements de facturation éventuels.");
    if (!confirmed) return;
    const res = await authFetch('/api/billing/change-plan', {
      method: 'POST',
      body: JSON.stringify(target),
    });
    const payload = await res.json().catch(() => null);
    if (!res.ok) throw new Error(payload?.error ?? 'Impossible de changer de plan.');
    await loadPlansControls();
    setPlansFeedback('Plan mis à jour. La facturation Stripe a été synchronisée.');
  }

  async function loadSettings() {
    try {
      const res = await authFetch('/api/commerces/me');
      if (!res.ok) return;
      const { data } = await res.json();
      if (!data) return;

      (document.getElementById('nom') as HTMLInputElement).value = data.nom ?? '';
      (document.getElementById('telephone') as HTMLInputElement).value = data.telephone ?? '';
      (document.getElementById('email-commerce') as HTMLInputElement).value = data.email ?? '';
      document.getElementById('organisation-adresse')!.textContent = data.adresse ?? 'Adresse non renseignée';
      document.getElementById('organisation-rayon')!.textContent = `Rayon de géolocalisation: ${(data.rayon_geo ?? 1000).toLocaleString('fr-FR')} m`;
    } catch {
      // best effort
    }
  }

  async function loadPlansControls() {
    try {
      const [statusRes, pricesRes] = await Promise.all([
        authFetch('/api/billing/status'),
        authFetch('/api/billing/prices'),
      ]);
      if (!statusRes.ok) throw new Error();
      const payload = await statusRes.json();
      const pricesPayload = pricesRes.ok ? await pricesRes.json().catch(() => null) : null;
      const data = payload?.data;
      if (!data) throw new Error();
      billingStatus = data;
      billingPrices = Array.isArray(pricesPayload?.data) ? pricesPayload.data : [];

      const rawPlan = data.plan ?? 'starter';
      const readablePlan = planLabel(rawPlan);
      const status = String(data.billing_status ?? 'unpaid');
      const hasSubscription = Boolean(data.stripe_subscription_id);
      const isOneTimeAccess = Boolean(data.is_one_time_access);
      const cancelScheduled = Boolean(data.billing_cancel_at_period_end);
      const renewalDate = formatDate(data.renewal_or_access_end_at);

      plansCurrentPlan.textContent = readablePlan;
      plansCurrentStatus.textContent = cancelScheduled ? `${status} · annulation programmée` : status;
      accountPlanBadge.textContent = `Plan ${readablePlan} actif`;
      plansStatusPill.textContent = cancelScheduled ? 'Annulation programmée' : (status === 'active' ? 'Actif' : status);
      plansPeriodInfo.textContent = renewalDate
        ? (isOneTimeAccess ? `Accès inclus jusqu’au ${renewalDate}.` : `Prochaine échéance: ${renewalDate}.`)
        : '';

      if (String(rawPlan).toLowerCase() === 'starter') {
        plansUpgradeBtn.textContent = 'Passer au Pro';
      } else if (String(rawPlan).toLowerCase() === 'pro') {
        plansUpgradeBtn.textContent = 'Rétrograder en Starter';
      } else {
        plansUpgradeBtn.textContent = 'Changer de plan';
      }

      setButtonState(plansUpgradeBtn, Boolean(data.can_change_plan) && Boolean(pickTargetPlan(data)));
      setButtonState(plansManageBtn, Boolean(data.can_open_portal));
      setButtonState(plansPaymentBtn, Boolean(data.can_open_portal));
      setButtonState(plansCancelBtn, Boolean(data.can_cancel) && !cancelScheduled);
      setButtonState(plansReactivateBtn, Boolean(data.can_reactivate));
      plansReactivateBtn.classList.toggle('hidden', !cancelScheduled);

      if (!hasSubscription) {
        setPlansFeedback(isOneTimeAccess
          ? 'Vous avez un accès annuel payé en une fois: il n’y a pas d’abonnement récurrent à annuler.'
          : 'Aucun abonnement Stripe actif détecté pour le moment.');
      } else if (cancelScheduled && renewalDate) {
        setPlansFeedback(`Votre abonnement restera actif jusqu’au ${renewalDate}.`);
      } else {
        setPlansFeedback('');
      }
    } catch {
      plansCurrentPlan.textContent = 'Indisponible';
      plansCurrentStatus.textContent = 'Indisponible';
      plansStatusPill.textContent = 'Indisponible';
      accountPlanBadge.textContent = 'Plan indisponible';
      plansPeriodInfo.textContent = '';
      setPlansFeedback('Impossible de charger le statut d’abonnement.');
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enregistrement...';

    try {
      const res = await authFetch('/api/commerces/me', {
        method: 'PATCH',
        body: JSON.stringify({
          nom: (document.getElementById('nom') as HTMLInputElement).value,
          telephone: (document.getElementById('telephone') as HTMLInputElement).value || null,
          email: (document.getElementById('email-commerce') as HTMLInputElement).value || null,
        }),
      });
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Erreur');
      successMsg.textContent = 'Profil commerçant enregistré.';
      successMsg.classList.remove('hidden');
      await loadSettings();
    } catch (error: unknown) {
      errorMsg.textContent = error instanceof Error ? error.message : 'Erreur lors de l’enregistrement.';
      errorMsg.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enregistrer';
    }
  });

  async function withBillingButton(button: HTMLButtonElement, label: string, action: () => Promise<void>) {
    const previousLabel = button.textContent;
    button.disabled = true;
    button.textContent = label;
    try {
      await action();
    } catch (error: unknown) {
      setPlansFeedback(error instanceof Error ? error.message : 'Impossible d’ouvrir la gestion de l’abonnement.');
      button.disabled = false;
      button.textContent = previousLabel ?? 'Réessayer';
    }
  }

  plansUpgradeBtn.addEventListener('click', async () => {
    const target = billingStatus ? pickTargetPlan(billingStatus) : null;
    if (!target) {
      setPlansFeedback('Aucun prix Stripe cible disponible pour ce changement de plan.');
      return;
    }
    await withBillingButton(plansUpgradeBtn, 'Mise à jour...', () => changeBillingPlan(target));
  });

  plansManageBtn.addEventListener('click', async () => {
    await withBillingButton(plansManageBtn, 'Ouverture...', () => openBillingPortal('manage'));
  });

  plansPaymentBtn.addEventListener('click', async () => {
    await withBillingButton(plansPaymentBtn, 'Ouverture...', () => openBillingPortal('payment_method'));
  });

  plansCancelBtn.addEventListener('click', async () => {
    await withBillingButton(plansCancelBtn, 'Annulation...', scheduleBillingCancel);
  });

  plansReactivateBtn.addEventListener('click', async () => {
    await withBillingButton(plansReactivateBtn, 'Réactivation...', reactivateBilling);
  });

  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/login';
  });

  document.getElementById('restart-tour-btn')?.addEventListener('click', async () => {
    window.sessionStorage.removeItem('fidelopass_tour_postponed');
    await authFetch('/api/dashboard/tour-status', {
      method: 'PATCH',
      body: JSON.stringify({ seen: false }),
    }).catch(() => null);
    window.location.href = '/dashboard?tour=1&step=0';
  });

  loadSettings();
  loadPlansControls();
  loadTeamMembers();
  loadWidgetConfig();
</script>
