---
import '../../styles/global.css';

const { slug } = Astro.params;
const apiBase = (
  import.meta.env.PUBLIC_API_URL
  ?? (import.meta.env.PROD ? 'https://api.fidelopass.com' : 'http://localhost:3001')
).replace(/\/$/, '');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Offre revendeur Fidelopass</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-950 antialiased">
    <main id="reseller-public-page" data-public-slug={slug ?? ''} data-api-base={apiBase} class="relative min-h-screen overflow-hidden px-4 py-8 sm:px-6 lg:px-8">
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute -top-36 right-[-8rem] h-[30rem] w-[30rem] rounded-full bg-cyan-200/50 blur-3xl"></div>
        <div class="absolute top-1/3 left-[-10rem] h-[26rem] w-[26rem] rounded-full bg-indigo-200/35 blur-3xl"></div>
      </div>

      <section class="relative mx-auto max-w-6xl space-y-8">
        <header class="flex flex-col gap-5 rounded-[2rem] border border-white/80 bg-white/88 p-6 shadow-[0_28px_80px_-58px_rgba(15,23,42,0.45)] backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white">
              <img id="brand-logo" src="/logo-premium.png" alt="Logo" class="h-full w-full object-contain p-2" />
            </div>
            <div>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-blue-700">Offre partenaire Fidelopass</p>
              <h1 id="brand-name" class="mt-1 font-display text-3xl font-bold tracking-tight text-slate-950">Chargement...</h1>
            </div>
          </div>
          <img src="/logo-premium.png" alt="Fidelopass" class="h-12 w-44 object-contain object-right" />
        </header>

        <div id="unavailable-card" class="hidden rounded-[2rem] border border-amber-200 bg-amber-50 p-8 text-amber-900">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em]">Offre indisponible</p>
          <h2 class="mt-2 font-display text-3xl font-bold">Cette offre n’est plus disponible.</h2>
          <p class="mt-3 text-base">Contactez votre revendeur pour obtenir un nouveau lien ou une offre à jour.</p>
        </div>

        <div id="public-content" class="hidden space-y-8">
          <section class="rounded-[2.2rem] border border-sky-100 bg-white/92 p-8 shadow-[0_30px_90px_-62px_rgba(37,99,235,0.55)]">
            <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
              <div>
                <p class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-sky-700">Carte fidélité digitale</p>
                <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
                  Lancez votre fidélité Wallet avec <span id="hero-reseller-name">votre partenaire</span>.
                </h2>
                <p id="partner-line" class="mt-4 rounded-2xl border border-sky-100 bg-sky-50 px-4 py-3 text-sm font-bold text-sky-900">
                  Fidelopass vous est proposé par votre revendeur.
                </p>
                <p class="mt-5 text-lg leading-8 text-slate-600">
                  Choisissez une offre, créez votre compte commerçant, profitez de 14 jours d’essai gratuit, puis configurez votre carte Fidelopass.
                </p>
              </div>
              <div class="rounded-[1.6rem] bg-gradient-to-br from-slate-950 via-blue-950 to-sky-700 p-6 text-white">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-white/60">Inclus</p>
                <ul class="mt-4 space-y-3 text-sm font-medium text-white/86">
                  <li>Carte Apple Wallet, Google Wallet et carte web</li>
                  <li>Dashboard commerçant et scanner mobile</li>
                  <li>Notifications et suivi des clients</li>
                  <li>14 jours d’essai gratuit sur votre abonnement</li>
                </ul>
              </div>
            </div>
          </section>

          <section>
            <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-blue-700">Offres disponibles</p>
                <h2 class="mt-2 font-display text-3xl font-bold text-slate-950">Choisissez votre plan</h2>
              </div>
              <p class="text-sm text-slate-500">Prix configurés par votre revendeur.</p>
            </div>
            <div id="plans-grid" class="mt-5 grid gap-4 lg:grid-cols-3"></div>
          </section>

          <section class="grid gap-5 lg:grid-cols-[1fr_0.85fr]">
            <form id="signup-form" class="rounded-[2rem] border border-sky-100 bg-white/92 p-6 shadow-[0_28px_80px_-58px_rgba(37,99,235,0.45)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-blue-700">Inscription commerçant</p>
              <h2 class="mt-2 font-display text-3xl font-bold text-slate-950">Créer votre compte</h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <label class="space-y-2 sm:col-span-2">
                  <span class="text-sm font-semibold text-slate-700">Nom du commerce</span>
                  <input name="commerce_name" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none transition focus:border-blue-300 focus:bg-white focus:ring-4 focus:ring-blue-100" placeholder="Votre commerce" />
                </label>
                <label class="space-y-2">
                  <span class="text-sm font-semibold text-slate-700">Email</span>
                  <input name="email" type="email" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none transition focus:border-blue-300 focus:bg-white focus:ring-4 focus:ring-blue-100" placeholder="vous@email.com" />
                </label>
                <label class="space-y-2">
                  <span class="text-sm font-semibold text-slate-700">Téléphone</span>
                  <input name="phone" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none transition focus:border-blue-300 focus:bg-white focus:ring-4 focus:ring-blue-100" placeholder="+33..." />
                </label>
                <label class="space-y-2 sm:col-span-2">
                  <span class="text-sm font-semibold text-slate-700">Pays</span>
                  <input name="country" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none transition focus:border-blue-300 focus:bg-white focus:ring-4 focus:ring-blue-100" placeholder="France" />
                </label>
              </div>
              <button id="signup-button" class="mt-6 w-full rounded-2xl bg-gradient-to-r from-blue-600 to-violet-500 px-5 py-4 text-sm font-bold text-white shadow-[0_20px_36px_-24px_rgba(37,99,235,0.8)] transition hover:-translate-y-0.5">
                Créer mon compte et démarrer l’essai
              </button>
              <p id="signup-feedback" class="mt-4 text-sm text-slate-500"></p>
            </form>

            <aside class="rounded-[2rem] border border-indigo-100 bg-white/92 p-6 shadow-[0_28px_80px_-58px_rgba(79,70,229,0.45)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-indigo-700">Votre sélection</p>
              <h2 id="selected-plan-title" class="mt-2 font-display text-3xl font-bold text-slate-950">Sélectionnez un plan</h2>
              <p id="selected-plan-price" class="mt-4 text-4xl font-bold text-slate-950">-</p>
              <p id="selected-plan-help" class="mt-4 text-sm leading-6 text-slate-500">
                Le commerçant final voit uniquement le prix de son abonnement.
              </p>
            </aside>
          </section>
        </div>
      </section>
    </main>

    <script is:inline type="module">
      const root = document.getElementById('reseller-public-page');
      const slug = root?.dataset.publicSlug || '';
      const API = (root?.dataset.apiBase || 'https://api.fidelopass.com').replace(/\/$/, '');
      let publicData = null;
      let selectedPlan = null;

      const formatMoney = (cents, currency = 'eur') => new Intl.NumberFormat('fr-FR', {
        style: 'currency',
        currency: String(currency || 'eur').toUpperCase(),
        maximumFractionDigits: 0,
      }).format(Number(cents || 0) / 100);

      function setUnavailable(message) {
        document.getElementById('public-content')?.classList.add('hidden');
        const card = document.getElementById('unavailable-card');
        card?.classList.remove('hidden');
        const text = card?.querySelector('p:last-child');
        if (text) text.textContent = message || 'Contactez votre revendeur pour obtenir un nouveau lien ou une offre à jour.';
      }

      async function trackPlanClick(plan) {
        fetch(`${API}/api/public/reseller/${encodeURIComponent(slug)}/track`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ event_type: 'plan_click', plan }),
        }).catch(() => null);
      }

      function selectPlan(plan) {
        selectedPlan = plan;
        const offer = publicData.plans.find((item) => item.plan === plan);
        document.querySelectorAll('[data-plan-card]').forEach((card) => {
          card.classList.toggle('ring-4', card.getAttribute('data-plan-card') === plan);
          card.classList.toggle('ring-blue-100', card.getAttribute('data-plan-card') === plan);
          card.classList.toggle('border-blue-300', card.getAttribute('data-plan-card') === plan);
        });
        document.getElementById('selected-plan-title').textContent = offer?.label ?? 'Plan';
        document.getElementById('selected-plan-price').textContent = `${formatMoney(offer?.public_price_cents, offer?.currency)}/mois`;
        if (offer?.is_valid === false) {
          document.getElementById('selected-plan-help').textContent = offer.validation_message || 'Cette offre doit être vérifiée par le revendeur.';
        } else if (publicData.checkout_available === false) {
          document.getElementById('selected-plan-help').textContent = publicData.checkout_message || 'Le paiement en ligne de cette offre n’est pas encore disponible.';
        } else {
          document.getElementById('selected-plan-help').textContent = 'Après inscription, Stripe sécurise votre moyen de paiement. Votre abonnement démarre par 14 jours d’essai gratuit.';
        }
        updateSignupState();
        trackPlanClick(plan);
      }

      function canSubmitSelectedPlan() {
        const offer = publicData?.plans?.find((item) => item.plan === selectedPlan);
        if (!offer || offer.is_valid === false) return false;
        if (publicData.checkout_available === false) return false;
        return publicData.signup_enabled !== false;
      }

      function updateSignupState() {
        const button = document.getElementById('signup-button');
        const feedback = document.getElementById('signup-feedback');
        if (!button || !feedback) return;
        const offer = publicData?.plans?.find((item) => item.plan === selectedPlan);
        const canSubmit = canSubmitSelectedPlan();
        button.disabled = !canSubmit;
        button.classList.toggle('opacity-50', !canSubmit);
        button.classList.toggle('cursor-not-allowed', !canSubmit);
        if (offer?.is_valid === false) {
          feedback.textContent = offer.validation_message || 'Cette offre doit être vérifiée par le revendeur.';
        } else if (publicData?.checkout_available === false) {
          feedback.textContent = publicData.checkout_message || 'Le paiement en ligne de cette offre n’est pas encore disponible.';
        } else if (publicData?.signup_enabled === false) {
          feedback.textContent = 'Les inscriptions publiques sont temporairement désactivées.';
        } else {
          feedback.textContent = '';
        }
      }

      function render(data) {
        publicData = data;
        document.documentElement.style.setProperty('--reseller-primary', data.primary_color || '#2563eb');
        document.getElementById('brand-name').textContent = data.brand_name || 'Revendeur Fidelopass';
        document.getElementById('hero-reseller-name').textContent = data.brand_name || 'votre partenaire Fidelopass';
        document.getElementById('partner-line').textContent = `Fidelopass vous est proposé par ${data.brand_name || 'votre partenaire'}.`;
        const logo = document.getElementById('brand-logo');
        if (data.brand_logo_url) logo.src = data.brand_logo_url;
        const grid = document.getElementById('plans-grid');
        grid.innerHTML = data.plans.map((plan) => `
          <button type="button" data-plan-card="${plan.plan}" ${plan.is_valid === false ? 'disabled aria-disabled="true"' : ''} class="text-left rounded-[1.6rem] border ${plan.is_valid === false ? 'border-amber-200 bg-amber-50/70 opacity-70' : 'border-slate-200 bg-white hover:-translate-y-1 hover:border-blue-200'} p-6 shadow-[0_18px_42px_-36px_rgba(15,23,42,0.35)] transition">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-blue-700">${plan.label}</p>
            <p class="mt-3 text-4xl font-bold text-slate-950">${formatMoney(plan.public_price_cents, plan.currency)}</p>
            <p class="mt-1 text-sm font-semibold text-slate-500">par mois</p>
            <p class="mt-4 inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-extrabold uppercase tracking-[0.14em] text-emerald-700">14 jours gratuits</p>
            <p class="mt-5 text-sm leading-6 text-slate-600">Carte fidélité digitale, Wallet, carte web, dashboard et scanner inclus.</p>
            ${plan.is_valid === false ? `<p class="mt-4 rounded-2xl border border-amber-200 bg-white/70 px-3 py-2 text-xs font-semibold text-amber-800">${plan.validation_message || 'Offre à vérifier.'}</p>` : ''}
          </button>
        `).join('');
        document.querySelectorAll('[data-plan-card]').forEach((button) => {
          if (button.disabled) return;
          button.addEventListener('click', () => selectPlan(button.getAttribute('data-plan-card')));
        });
        const firstAvailablePlan = data.plans.find((plan) => plan.is_valid !== false);
        if (firstAvailablePlan) {
          selectPlan(firstAvailablePlan.plan);
        } else {
          document.getElementById('selected-plan-title').textContent = 'Offres à vérifier';
          document.getElementById('selected-plan-price').textContent = '-';
          document.getElementById('selected-plan-help').textContent = 'Le revendeur doit corriger ses prix avant de proposer cette offre.';
          updateSignupState();
        }
        document.getElementById('public-content')?.classList.remove('hidden');
      }

      async function loadPublicOffer() {
        const res = await fetch(`${API}/api/public/reseller/${encodeURIComponent(slug)}`);
        const payload = await res.json().catch(() => null);
        if (!res.ok || !payload?.available) {
          setUnavailable(payload?.message);
          return;
        }
        render(payload.data);
      }

      document.getElementById('signup-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!selectedPlan || !canSubmitSelectedPlan()) {
          updateSignupState();
          return;
        }
        const form = event.currentTarget;
        const button = document.getElementById('signup-button');
        const feedback = document.getElementById('signup-feedback');
        const data = new FormData(form);
        const payload = {
          commerce_name: String(data.get('commerce_name') || ''),
          email: String(data.get('email') || ''),
          phone: String(data.get('phone') || ''),
          country: String(data.get('country') || ''),
          plan: selectedPlan,
        };
        button.disabled = true;
        feedback.textContent = 'Préparation de votre inscription...';
        const endpoint = publicData.checkout_available === false ? 'manual-request' : 'checkout';
        const res = await fetch(`${API}/api/public/reseller/${encodeURIComponent(slug)}/${endpoint}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json().catch(() => null);
        if (!res.ok) {
          feedback.textContent = result?.error || 'Inscription impossible pour le moment.';
          button.disabled = false;
          return;
        }
        if (result?.url) {
          window.location.href = result.url;
          return;
        }
        feedback.textContent = 'Demande envoyée. Votre revendeur vous contactera pour finaliser.';
        button.disabled = false;
      });

      loadPublicOffer();
    </script>
  </body>
</html>
