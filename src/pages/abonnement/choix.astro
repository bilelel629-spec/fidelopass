---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  theme="light"
  title="Choisir un abonnement — Fidelopass"
  description="Choisissez votre plan Fidelopass pour activer votre espace commerçant."
>
  <section class="min-h-screen bg-[linear-gradient(180deg,#ffffff_0%,#f5f9ff_62%,#ffffff_100%)] px-4 py-10 sm:py-14 relative overflow-hidden">
    <div class="pointer-events-none absolute -top-20 right-[-10rem] h-[28rem] w-[28rem] rounded-full bg-cyan-200/35 blur-3xl"></div>
    <div class="pointer-events-none absolute bottom-[-8rem] left-[-8rem] h-[24rem] w-[24rem] rounded-full bg-blue-100/80 blur-3xl"></div>

    <div class="max-w-5xl mx-auto">
      <a href="/" class="inline-flex items-center mb-6">
        <img src="/logo-premium-cropped.png" alt="Fidelopass" class="h-14 w-auto object-contain" />
      </a>

      <div class="max-w-2xl">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.26em] text-sky-700/75">Activation abonnement</p>
        <h1 id="choix-title" class="font-display text-4xl sm:text-5xl font-bold text-slate-900 leading-tight mt-3">
          Choisissez votre plan pour activer l’accès à l’outil.
        </h1>
        <p class="text-slate-500 text-base mt-4 leading-relaxed">
          Vous pourrez ajouter l’option <strong>Accompagnement Setup (90€)</strong> à l’étape suivante avant Stripe.
        </p>
      </div>

      <div id="trial-info-banner" class="mt-8 rounded-xl border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-600">
        <p><strong>Essai gratuit :</strong> 14 jours avec carte bancaire, aucun prélèvement aujourd’hui, résiliable pendant l’essai.</p>
        <p class="mt-1"><strong>Mensuel :</strong> après l’essai, résiliable à tout moment.</p>
        <p class="mt-1"><strong>Annuel :</strong> après l’essai, renouvellement automatique chaque année.</p>
      </div>

      <div id="choice-error" class="hidden mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600"></div>
      <div id="choice-warning" class="hidden mt-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700"></div>

      <div class="mt-8 flex justify-center">
        <div class="inline-flex items-center gap-1 rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm">
          <button id="toggle-monthly" type="button" aria-pressed="true" class="px-5 py-2 rounded-xl text-sm font-semibold transition-all bg-white text-slate-900 shadow-sm ring-2 ring-indigo-200">
            Mensuel
          </button>
          <button id="toggle-annual" type="button" aria-pressed="false" class="px-5 py-2 rounded-xl text-sm font-medium transition-all text-slate-500">
            Annuel
            <span class="ml-1.5 rounded-full bg-emerald-100 text-emerald-700 text-xs px-2 py-0.5 font-semibold">-15%</span>
          </button>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-6 mt-6">
        <article data-plan-card="starter" class="rounded-[2rem] border border-slate-200 bg-white shadow-[0_20px_50px_rgba(15,23,42,0.08)] p-8">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Starter</p>
          <div class="flex items-end gap-1 mt-3">
            <span
              class="font-display font-bold leading-none text-slate-900 text-4xl plan-price"
              data-monthly="29"
              data-annual-monthly="295"
              data-annual-once="295"
            >29€</span>
            <span
              class="text-sm mb-1 text-slate-400 plan-price-suffix"
              data-monthly="/mois"
              data-annual-monthly="/an"
              data-annual-once="/an"
            >/mois</span>
          </div>
          <p
            class="text-xs text-slate-400 mt-2 plan-price-label"
            data-monthly="29€/mois sans engagement"
            data-annual-monthly="295€/an · économisez 15%"
            data-annual-once="295€/an · économisez 15%"
          >
            29€/mois sans engagement
          </p>
          <ul class="space-y-2.5 mt-6 text-sm text-slate-600">
            <li>• Jusqu’à 500 cartes actives</li>
            <li>• 1 lieu / commerce</li>
            <li>• Notifications push incluses</li>
            <li>• Carte points, tampons et paliers</li>
            <li>• Géolocalisation Wallet</li>
          </ul>
          <button
            type="button"
            class="plan-select-btn mt-7 w-full rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-900 transition-colors"
            data-plan="starter"
            data-price-monthly=""
            data-price-annual-subscription=""
            data-price-annual-once=""
          >
            Continuer avec Starter
          </button>
        </article>

        <article data-plan-card="pro" class="rounded-[2rem] border border-indigo-400 bg-[linear-gradient(155deg,#1e1b4b_0%,#312e81_62%,#0284c7_100%)] shadow-[0_30px_80px_rgba(49,46,129,0.24)] p-8 text-white">
          <div class="inline-flex rounded-full bg-amber-400 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-amber-900">
            Le plus choisi
          </div>
          <p class="text-xs font-bold uppercase tracking-widest text-indigo-200 mt-4">Pro</p>
          <div class="flex items-end gap-1 mt-3">
            <span
              class="font-display font-bold leading-none text-4xl plan-price"
              data-monthly="69"
              data-annual-monthly="699"
              data-annual-once="699"
            >69€</span>
            <span
              class="text-sm mb-1 text-indigo-200 plan-price-suffix"
              data-monthly="/mois"
              data-annual-monthly="/an"
              data-annual-once="/an"
            >/mois</span>
          </div>
          <p
            class="text-xs text-indigo-200 mt-2 plan-price-label"
            data-monthly="69€/mois sans engagement"
            data-annual-monthly="699€/an · économisez 15%"
            data-annual-once="699€/an · économisez 15%"
          >
            69€/mois sans engagement
          </p>
          <ul class="space-y-2.5 mt-6 text-sm text-indigo-100">
            <li>• Jusqu’à 2000 cartes actives</li>
            <li>• 3 lieux / commerces</li>
            <li>• Push auto avis Google (+1h)</li>
            <li>• Analytics avancés</li>
            <li>• Support prioritaire</li>
          </ul>
          <button
            type="button"
            class="plan-select-btn mt-7 w-full rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 hover:bg-indigo-50 transition-colors"
            data-plan="pro"
            data-price-monthly=""
            data-price-annual-subscription=""
            data-price-annual-once=""
          >
            Continuer avec Pro
          </button>
        </article>

        <article data-plan-card="business" class="rounded-[2rem] border border-slate-200 bg-white shadow-[0_20px_50px_rgba(15,23,42,0.08)] p-8">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Business</p>
          <div class="flex items-end gap-1 mt-3">
            <span
              class="font-display font-bold leading-none text-slate-900 text-4xl plan-price"
              data-monthly="199"
              data-annual-monthly="1990"
              data-annual-once="1990"
            >199€</span>
            <span
              class="text-sm mb-1 text-slate-400 plan-price-suffix"
              data-monthly="/mois"
              data-annual-monthly="/an"
              data-annual-once="/an"
            >/mois</span>
          </div>
          <p
            class="text-xs text-slate-400 mt-2 plan-price-label"
            data-monthly="199€/mois sans engagement"
            data-annual-monthly="1990€/an · économisez 16%"
            data-annual-once="1990€/an · économisez 16%"
          >
            199€/mois sans engagement
          </p>
          <ul class="space-y-2.5 mt-6 text-sm text-slate-600">
            <li>• Cartes actives illimitées</li>
            <li>• Scanners illimités</li>
            <li>• Accompagnement setup compris</li>
            <li>• Automatisations incluses</li>
            <li>• Support prioritaire</li>
          </ul>
          <button
            type="button"
            class="plan-select-btn mt-7 w-full rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-900 transition-colors"
            data-plan="business"
            data-price-monthly=""
            data-price-annual-subscription=""
            data-price-annual-once=""
          >
            Continuer avec Business
          </button>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { withTimeout } from '../../lib/utils/with-timeout';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const API = (import.meta.env.PUBLIC_API_URL || 'https://api.fidelopass.com').replace(/\/$/, '');
  const STORAGE_KEY = 'fidelopass.checkout.selection';
  const SESSION_PROBE_TIMEOUT_MS = Number(import.meta.env.PUBLIC_AUTH_SESSION_PROBE_TIMEOUT_MS ?? 900);
  const BILLING_CHECK_TIMEOUT_MS = Number(import.meta.env.PUBLIC_BILLING_CHECK_TIMEOUT_MS ?? 2200);
  const queryParams = new URLSearchParams(window.location.search);
  const requestedPlanParam = queryParams.get('plan');
  const preselectedPlan = requestedPlanParam === 'starter' || requestedPlanParam === 'pro' || requestedPlanParam === 'business' ? requestedPlanParam : null;
  const requestedBillingParam = queryParams.get('billing');
  const setupRequested = ['1', 'true', 'yes'].includes((queryParams.get('setup') ?? '').toLowerCase());
  const monthlyBtn = document.getElementById('toggle-monthly') as HTMLButtonElement;
  const annualBtn = document.getElementById('toggle-annual') as HTMLButtonElement;
  const errorEl = document.getElementById('choice-error') as HTMLDivElement;
  const warningEl = document.getElementById('choice-warning') as HTMLDivElement;

  type SessionLike = { access_token: string };
  type PriceSlot =
    | 'starter_mensuel'
    | 'starter_annuel_once'
    | 'pro_mensuel'
    | 'pro_annuel_once'
    | 'business_mensuel'
    | 'business_annuel_once';
  let activeSession: SessionLike | null = null;
  let currentMode: 'monthly' | 'annual' = 'monthly';
  let pricingLoaded = false;
  let pricingDegraded = false;
  let hasUsedTrial = false; // l'essai 14j n'est offert qu'une fois

  function toggleWarning(message: string | null) {
    if (!message) {
      warningEl.classList.add('hidden');
      warningEl.textContent = '';
      return;
    }
    warningEl.textContent = message;
    warningEl.classList.remove('hidden');
  }

  function resolveButtonPriceAvailability(button: HTMLButtonElement) {
    if (currentMode === 'monthly') {
      return button.dataset.availabilityMonthly === '1';
    }
    return button.dataset.availabilityAnnualOnce === '1';
  }

  function planBaseLabel(plan?: string) {
    const normalizedPlan = plan === 'pro' || plan === 'business' ? plan : 'starter';
    const verb = hasUsedTrial ? 'Reprendre avec' : 'Continuer avec';
    const baseLabel = normalizedPlan === 'business'
      ? `${verb} Business`
      : normalizedPlan === 'pro'
        ? `${verb} Pro`
        : `${verb} Starter`;
    return setupRequested && (!preselectedPlan || preselectedPlan === normalizedPlan)
      ? `${baseLabel} + Setup`
      : baseLabel;
  }

  function applyPreselection() {
    if (!preselectedPlan) return;
    document
      .querySelector<HTMLElement>(`[data-plan-card="${preselectedPlan}"]`)
      ?.classList.add('ring-2', 'ring-indigo-300', 'ring-offset-2', 'ring-offset-white');
  }

  function refreshPlanButtonsState() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.plan-select-btn'));
    const unavailableCount = buttons.reduce((acc, button) => (
      acc + (resolveButtonPriceAvailability(button) ? 0 : 1)
    ), 0);

    buttons.forEach((button) => {
      const baseLabel = planBaseLabel(button.dataset.plan);
      const available = pricingLoaded && resolveButtonPriceAvailability(button);
      button.disabled = !available;
      button.classList.toggle('opacity-50', !available);
      button.classList.toggle('cursor-not-allowed', !available);
      button.textContent = available ? baseLabel : 'Tarif indisponible';
    });

    if (!pricingLoaded) {
      toggleWarning('Chargement des tarifs en cours...');
      return;
    }

    if (unavailableCount > 0 && !pricingDegraded) {
      toggleWarning('Certains tarifs sont temporairement indisponibles. Réessayez dans quelques instants.');
      return;
    }

    if (pricingDegraded) {
      toggleWarning('Mode dégradé: validation Stripe indisponible pour le moment.');
      return;
    }

    toggleWarning(null);
  }

  function setMode(mode: 'monthly' | 'annual') {
    currentMode = mode;
    const isAnnual = mode === 'annual';
    monthlyBtn.className = isAnnual
      ? 'px-5 py-2 rounded-xl text-sm font-medium transition-all text-slate-500'
      : 'px-5 py-2 rounded-xl text-sm font-semibold transition-all bg-white text-slate-900 shadow-sm ring-2 ring-indigo-200';
    annualBtn.className = isAnnual
      ? 'px-5 py-2 rounded-xl text-sm font-semibold transition-all bg-white text-slate-900 shadow-sm ring-2 ring-indigo-200'
      : 'px-5 py-2 rounded-xl text-sm font-medium transition-all text-slate-500';
    monthlyBtn.setAttribute('aria-pressed', String(!isAnnual));
    annualBtn.setAttribute('aria-pressed', String(isAnnual));

    const suffixKey = !isAnnual
      ? 'monthly'
      : 'annualOnce';

    document.querySelectorAll<HTMLElement>('.plan-price').forEach((el) => {
      const value = suffixKey === 'monthly'
        ? el.dataset.monthly
        : el.dataset.annualOnce;
      el.textContent = `${value ?? '0'}€`;
    });

    document.querySelectorAll<HTMLElement>('.plan-price-suffix').forEach((el) => {
      const value = suffixKey === 'monthly'
        ? el.dataset.monthly
        : el.dataset.annualOnce;
      el.textContent = value ?? '';
    });

    document.querySelectorAll<HTMLElement>('.plan-price-label').forEach((el) => {
      const value = suffixKey === 'monthly'
        ? el.dataset.monthly
        : el.dataset.annualOnce;
      el.textContent = value ?? '';
    });
    refreshPlanButtonsState();
  }

  function resolvePriceSlot(plan: string): PriceSlot {
    const normalizedPlan = plan === 'pro' || plan === 'business' ? plan : 'starter';
    if (currentMode === 'monthly') return `${normalizedPlan}_mensuel` as PriceSlot;
    return `${normalizedPlan}_annuel_once` as PriceSlot;
  }

  async function hydratePricingConfig(accessToken: string) {
    pricingLoaded = false;
    refreshPlanButtonsState();
    try {
      const res = await fetch(`${API}/api/checkout/pricing-config`, {
        headers: {
          Authorization: `Bearer ${accessToken}`,
          'Content-Type': 'application/json',
        },
      });
      if (!res.ok) return;
      const payload = await res.json().catch(() => null);
      pricingDegraded = Boolean(payload?.degraded);
      const starter = payload?.data?.starter;
      const pro = payload?.data?.pro;
      const business = payload?.data?.business;
      const starterBtn = document.querySelector<HTMLButtonElement>('.plan-select-btn[data-plan="starter"]');
      const proBtn = document.querySelector<HTMLButtonElement>('.plan-select-btn[data-plan="pro"]');
      const businessBtn = document.querySelector<HTMLButtonElement>('.plan-select-btn[data-plan="business"]');
      if (starterBtn && starter) {
        if (starter.monthly?.priceId) starterBtn.dataset.priceMonthly = String(starter.monthly.priceId);
        const annual = starter.annual ?? starter.annual_once;
        if (annual?.priceId) starterBtn.dataset.priceAnnualOnce = String(annual.priceId);
        starterBtn.dataset.availabilityMonthly = starter.monthly?.available ? '1' : '0';
        starterBtn.dataset.availabilityAnnualOnce = annual?.available ? '1' : '0';
      }
      if (proBtn && pro) {
        if (pro.monthly?.priceId) proBtn.dataset.priceMonthly = String(pro.monthly.priceId);
        const annual = pro.annual ?? pro.annual_once;
        if (annual?.priceId) proBtn.dataset.priceAnnualOnce = String(annual.priceId);
        proBtn.dataset.availabilityMonthly = pro.monthly?.available ? '1' : '0';
        proBtn.dataset.availabilityAnnualOnce = annual?.available ? '1' : '0';
      }
      if (businessBtn && business) {
        if (business.monthly?.priceId) businessBtn.dataset.priceMonthly = String(business.monthly.priceId);
        const annual = business.annual ?? business.annual_once;
        if (annual?.priceId) businessBtn.dataset.priceAnnualOnce = String(annual.priceId);
        businessBtn.dataset.availabilityMonthly = business.monthly?.available ? '1' : '0';
        businessBtn.dataset.availabilityAnnualOnce = annual?.available ? '1' : '0';
      }
    } catch {
      pricingDegraded = true;
    } finally {
      pricingLoaded = true;
      refreshPlanButtonsState();
    }
  }

  async function requireSessionAndBilling() {
    const sessionResult = await withTimeout(supabase.auth.getSession(), SESSION_PROBE_TIMEOUT_MS).catch(() => null);
    const session = sessionResult?.data?.session ?? null;
    if (!session) {
      window.location.replace('/register');
      return null;
    }

    const billing = await withTimeout(fetch(`${API}/api/billing/status`, {
      headers: {
        Authorization: `Bearer ${session.access_token}`,
        'Content-Type': 'application/json',
      },
    }).then((r) => r.json()).catch(() => ({})), BILLING_CHECK_TIMEOUT_MS).catch(() => ({}));

    if (billing?.data?.has_access) {
      window.location.replace(billing?.data?.onboarding_completed ? '/dashboard/carte' : '/dashboard?tour=1');
      return null;
    }

    // L'essai gratuit a déjà été consommé → on propose de reprendre l'abonnement, sans essai
    hasUsedTrial = Boolean(billing?.data?.has_used_trial);
    if (hasUsedTrial) applyTrialUsedMessaging();

    activeSession = session;
    await hydratePricingConfig(session.access_token);
    return session;
  }

  function applyTrialUsedMessaging() {
    const title = document.getElementById('choix-title');
    if (title) title.textContent = 'Reprenez votre abonnement pour réactiver votre accès.';
    const banner = document.getElementById('trial-info-banner');
    if (banner) {
      banner.innerHTML = `
        <p><strong>Essai gratuit déjà utilisé.</strong> Vous avez profité de vos 14 jours offerts : l'abonnement démarre dès la validation du paiement.</p>
        <p class="mt-1"><strong>Mensuel :</strong> résiliable à tout moment.</p>
        <p class="mt-1"><strong>Annuel :</strong> renouvellement automatique chaque année.</p>`;
    }
  }

  async function choosePlan(btn: HTMLButtonElement) {
    errorEl.classList.add('hidden');
    const session = activeSession;
    if (!session) {
      window.location.replace('/register');
      return;
    }

    const isAnnual = currentMode === 'annual';
    const priceId = !isAnnual ? btn.dataset.priceMonthly : btn.dataset.priceAnnualOnce;
    if (!priceId || !resolveButtonPriceAvailability(btn)) {
      errorEl.textContent = "Ce tarif n'est pas disponible pour le moment. Réessayez dans quelques instants.";
      errorEl.classList.remove('hidden');
      return;
    }

    const checkoutMode: 'subscription' = 'subscription';
    const priceSlot = resolvePriceSlot(btn.dataset.plan ?? 'starter');

    const selection = {
      plan: btn.dataset.plan,
      mode: currentMode,
      checkoutMode,
      priceSlot,
      priceId,
      setupRequested: setupRequested && (!preselectedPlan || preselectedPlan === btn.dataset.plan),
      selectedAt: Date.now(),
    };
    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(selection));
    window.location.href = '/abonnement/setup';
  }

  monthlyBtn.addEventListener('click', () => setMode('monthly'));
  annualBtn.addEventListener('click', () => setMode('annual'));

  setMode(requestedBillingParam === 'annual' ? 'annual' : 'monthly');

  const cancelled = queryParams.get('cancelled');
  const guard = queryParams.get('guard');
  const priceUnavailable = queryParams.get('price_unavailable');
  if (cancelled === '1') {
    errorEl.textContent = 'Paiement annulé. Vous pouvez reprendre votre sélection.';
    errorEl.classList.remove('hidden');
  } else if (guard === '1') {
    errorEl.textContent = 'Votre session nécessite un abonnement actif pour accéder à l’espace commerçant.';
    errorEl.classList.remove('hidden');
  } else if (priceUnavailable === '1') {
    errorEl.textContent = 'Le tarif sélectionné n’est plus disponible. Veuillez choisir un autre mode de facturation.';
    errorEl.classList.remove('hidden');
  }

  document.querySelectorAll<HTMLButtonElement>('.plan-select-btn').forEach((btn) => {
    btn.dataset.availabilityMonthly = btn.dataset.priceMonthly ? '1' : '0';
    btn.dataset.availabilityAnnualOnce = btn.dataset.priceAnnualOnce ? '1' : '0';
    btn.addEventListener('click', () => choosePlan(btn));
  });

  applyPreselection();
  refreshPlanButtonsState();
  void requireSessionAndBilling();
</script>
