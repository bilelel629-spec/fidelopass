---
import { DASHBOARD_NAV_ITEMS } from '../../lib/dashboard-nav';

interface Props {
  activeNav?: string;
}
const { activeNav = '' } = Astro.props;
const navItems = DASHBOARD_NAV_ITEMS;
const mobilePrimaryItems = navItems.filter((item) => ['dashboard', 'carte', 'notifications', 'clients'].includes(item.id));
const mobileMoreItems = navItems.filter((item) => !mobilePrimaryItems.some((primary) => primary.id === item.id));
const isMobileMoreActive = mobileMoreItems.some((item) => item.id === activeNav);
const navToneClasses = {
  blue: {
    active: 'bg-gradient-to-r from-blue-600 via-sky-500 to-cyan-400 text-white shadow-[0_22px_42px_-24px_rgba(37,99,235,0.95)] ring-1 ring-white/20',
    inactive: 'text-slate-600 hover:bg-blue-50/85 hover:text-blue-900 hover:shadow-sm',
    icon: 'border-blue-100 bg-blue-50 text-blue-700 group-hover:border-blue-200 group-hover:bg-blue-100',
    mobileActive: 'bg-blue-100 text-blue-800 font-semibold',
  },
  amber: {
    active: 'bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-[0_18px_30px_-24px_rgba(217,119,6,0.9)]',
    inactive: 'text-slate-600 hover:bg-amber-50 hover:text-amber-900',
    icon: 'border-amber-100 bg-amber-50 text-amber-700 group-hover:border-amber-200 group-hover:bg-amber-100',
    mobileActive: 'bg-amber-100 text-amber-800 font-semibold',
  },
  emerald: {
    active: 'bg-gradient-to-r from-emerald-600 to-teal-500 text-white shadow-[0_18px_30px_-24px_rgba(5,150,105,0.9)]',
    inactive: 'text-slate-600 hover:bg-emerald-50 hover:text-emerald-900',
    icon: 'border-emerald-100 bg-emerald-50 text-emerald-700 group-hover:border-emerald-200 group-hover:bg-emerald-100',
    mobileActive: 'bg-emerald-100 text-emerald-800 font-semibold',
  },
  rose: {
    active: 'bg-gradient-to-r from-rose-600 to-pink-500 text-white shadow-[0_18px_30px_-24px_rgba(225,29,72,0.9)]',
    inactive: 'text-slate-600 hover:bg-rose-50 hover:text-rose-900',
    icon: 'border-rose-100 bg-rose-50 text-rose-700 group-hover:border-rose-200 group-hover:bg-rose-100',
    mobileActive: 'bg-rose-100 text-rose-800 font-semibold',
  },
  violet: {
    active: 'bg-gradient-to-r from-violet-600 to-fuchsia-500 text-white shadow-[0_18px_30px_-24px_rgba(124,58,237,0.9)]',
    inactive: 'text-slate-600 hover:bg-violet-50 hover:text-violet-900',
    icon: 'border-violet-100 bg-violet-50 text-violet-700 group-hover:border-violet-200 group-hover:bg-violet-100',
    mobileActive: 'bg-violet-100 text-violet-800 font-semibold',
  },
  cyan: {
    active: 'bg-gradient-to-r from-cyan-600 to-sky-500 text-white shadow-[0_18px_30px_-24px_rgba(8,145,178,0.9)]',
    inactive: 'text-slate-600 hover:bg-cyan-50 hover:text-cyan-900',
    icon: 'border-cyan-100 bg-cyan-50 text-cyan-700 group-hover:border-cyan-200 group-hover:bg-cyan-100',
    mobileActive: 'bg-cyan-100 text-cyan-800 font-semibold',
  },
  slate: {
    active: 'bg-gradient-to-r from-slate-700 to-slate-500 text-white shadow-[0_18px_30px_-24px_rgba(51,65,85,0.9)]',
    inactive: 'text-slate-600 hover:bg-slate-100 hover:text-slate-950',
    icon: 'border-slate-200 bg-slate-50 text-slate-700 group-hover:border-slate-300 group-hover:bg-slate-100',
    mobileActive: 'bg-slate-200 text-slate-900 font-semibold',
  },
  indigo: {
    active: 'bg-gradient-to-r from-indigo-600 to-blue-500 text-white shadow-[0_18px_30px_-24px_rgba(79,70,229,0.9)]',
    inactive: 'text-slate-600 hover:bg-indigo-50 hover:text-indigo-900',
    icon: 'border-indigo-100 bg-indigo-50 text-indigo-700 group-hover:border-indigo-200 group-hover:bg-indigo-100',
    mobileActive: 'bg-indigo-100 text-indigo-800 font-semibold',
  },
  teal: {
    active: 'bg-gradient-to-r from-teal-600 to-emerald-500 text-white shadow-[0_18px_30px_-24px_rgba(13,148,136,0.9)]',
    inactive: 'text-slate-600 hover:bg-teal-50 hover:text-teal-900',
    icon: 'border-teal-100 bg-teal-50 text-teal-700 group-hover:border-teal-200 group-hover:bg-teal-100',
    mobileActive: 'bg-teal-100 text-teal-800 font-semibold',
  },
};
---

<aside class="hidden lg:flex w-72 shrink-0 h-full min-h-0 flex-col border-r border-sky-100/90 bg-white/78 backdrop-blur-2xl shadow-[0_24px_70px_-42px_rgba(37,99,235,0.38)]">
  <div class="px-6 py-6 border-b border-sky-100/90">
    <a href="/dashboard" class="flex flex-col gap-2">
      <img src="/logo-premium.png" alt="Fidelopass" class="h-14 w-48 object-cover object-center" />
      <span class="flex items-center gap-2 text-xs font-medium tracking-[0.24em] uppercase text-sky-700/70">
        <span>Espace commerçant</span>
        <span
          id="dashboard-plan-badge"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[0.58rem] font-semibold tracking-wide text-slate-500"
        >
          ...
        </span>
      </span>
    </a>
  </div>

  <nav class="flex-1 min-h-0 overflow-y-auto px-4 py-5 flex flex-col gap-1.5">
    {navItems.map(({ href, id, label, paths, tone }) => (
      <a
        href={href}
        data-tour-nav={id}
        class={`group flex items-center gap-3 rounded-2xl px-4 py-3 text-sm transition-all duration-300 hover:-translate-y-0.5
          ${activeNav === id
            ? navToneClasses[tone].active
            : navToneClasses[tone].inactive
          }`}
      >
        <span class={`flex h-10 w-10 items-center justify-center rounded-2xl border transition-all
          ${activeNav === id
            ? 'border-white/20 bg-white/12'
            : navToneClasses[tone].icon
          }`}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            {paths.map((path) => <path d={path}></path>)}
          </svg>
        </span>
        <span class={activeNav === id ? 'font-semibold' : 'font-medium'}>{label}</span>
      </a>
    ))}

    <div class="mt-auto rounded-2xl border border-sky-100/90 bg-white px-3 py-2.5 shadow-[0_18px_42px_-34px_rgba(37,99,235,0.35)]">
      <p class="text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-slate-500">Point de vente</p>
      <select id="dashboard-point-vente-select" class="mt-1.5 w-full rounded-xl border border-sky-100 bg-white px-2.5 py-2 text-xs font-medium text-slate-700 focus:border-sky-300 focus:outline-none">
        <option>Chargement...</option>
      </select>
      <p id="dashboard-point-vente-usage" class="mt-1.5 text-[0.68rem] text-slate-500"></p>
    </div>
  </nav>

  <div class="px-4 pb-4 space-y-2 border-t border-sky-100/90 pt-4">
    <a href="/app/install" class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-600 transition hover:border-sky-200 hover:bg-sky-50 hover:text-sky-800">
      <span>Installer un téléphone</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M12 3v12"></path>
        <path d="m7 10 5 5 5-5"></path>
        <path d="M5 21h14"></path>
      </svg>
    </a>
    <button id="logout-btn" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-medium text-slate-600 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600">
      Se déconnecter
    </button>
  </div>
</aside>

<header class="lg:hidden fixed top-0 inset-x-0 z-40 border-b border-sky-100/90 bg-white/90 backdrop-blur-2xl px-4 py-3 flex items-center justify-between">
  <a href="/dashboard" class="flex items-center gap-3 min-w-0">
    <img src="/logo-premium.png" alt="Fidelopass" class="h-10 w-36 object-cover object-center" />
  </a>
  <div class="flex items-center gap-2">
    <span
      id="dashboard-plan-badge-mobile"
      class="inline-flex items-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[0.65rem] font-semibold tracking-wide text-slate-500"
    >
      ...
    </span>
    <a href="/app/scan" class="inline-flex items-center gap-1.5 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 px-3.5 py-2 text-xs font-extrabold text-white shadow-[0_14px_30px_-18px_rgba(37,99,235,0.9)] ring-1 ring-white/40 active:scale-[0.98]">
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V5a1 1 0 0 1 1-1h2"></path><path d="M17 4h2a1 1 0 0 1 1 1v2"></path><path d="M20 17v2a1 1 0 0 1-1 1h-2"></path><path d="M7 20H5a1 1 0 0 1-1-1v-2"></path><path d="M7 12h10"></path></svg>
      <span>Scanner</span>
    </a>
  </div>
</header>

<div id="scanner-open-overlay" class="fixed inset-0 z-[120] hidden items-center justify-center bg-white/92 px-6 text-center backdrop-blur-xl lg:hidden">
  <div class="w-full max-w-xs rounded-[1.6rem] border border-sky-100 bg-white p-6 shadow-[0_28px_70px_-42px_rgba(37,99,235,0.7)]">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
      <span class="h-7 w-7 animate-spin rounded-full border-2 border-blue-200 border-t-blue-600"></span>
    </div>
    <p class="mt-4 font-display text-xl font-extrabold text-slate-950">Ouverture du scanner</p>
    <p class="mt-2 text-sm leading-6 text-slate-500">Préparation de la caméra et de votre session...</p>
  </div>
</div>

<nav class="lg:hidden fixed bottom-0 inset-x-0 z-40 border-t border-sky-100/90 bg-white/92 backdrop-blur-2xl px-2 pt-2 pb-[calc(env(safe-area-inset-bottom)+0.55rem)]">
  <div class="grid grid-cols-5 gap-1">
    {mobilePrimaryItems.map(({ href, id, label, paths, tone }) => (
      <a
        href={href}
        data-tour-nav={id}
        class={`min-w-0 flex flex-col items-center justify-center gap-1 rounded-2xl px-2 py-2 text-[0.68rem] transition-all
          ${activeNav === id
            ? navToneClasses[tone].mobileActive
            : 'text-slate-500 hover:text-slate-800'
          }`}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 leading-none">
          {paths.map((path) => <path d={path}></path>)}
        </svg>
        <span class="truncate max-w-full">{label}</span>
      </a>
    ))}
    <button
      id="mobile-more-btn"
      type="button"
      class={`min-w-0 flex flex-col items-center justify-center gap-1 rounded-2xl px-2 py-2 text-[0.68rem] transition-all ${isMobileMoreActive ? 'bg-slate-200 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-800'}`}
      aria-expanded="false"
      aria-controls="mobile-more-sheet"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 leading-none">
        <path d="M5 12h14"></path>
        <path d="M5 6h14"></path>
        <path d="M5 18h14"></path>
      </svg>
      <span class="truncate max-w-full">Plus</span>
    </button>
  </div>
</nav>

<div id="mobile-more-sheet" class="fixed inset-0 z-[80] hidden lg:hidden">
  <button id="mobile-more-backdrop" type="button" class="absolute inset-0 bg-slate-950/45 backdrop-blur-[2px]" aria-label="Fermer le menu"></button>
  <div class="absolute inset-x-0 bottom-0 max-h-[82dvh] overflow-y-auto rounded-t-[1.8rem] border border-sky-100 bg-white px-4 pb-[calc(env(safe-area-inset-bottom)+5.2rem)] pt-4 shadow-[0_-30px_70px_-42px_rgba(15,23,42,0.7)]">
    <div class="mx-auto mb-3 h-1 w-12 rounded-full bg-slate-200"></div>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <p class="text-[0.64rem] font-semibold uppercase tracking-[0.22em] text-sky-700/70">Menu</p>
        <p class="mt-1 text-base font-bold text-slate-950">Espace commerçant</p>
      </div>
      <button id="mobile-more-close" type="button" class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600">Fermer</button>
    </div>

    <div class="rounded-2xl border border-sky-100 bg-sky-50/70 p-3">
      <p class="text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-slate-500">Point de vente actif</p>
      <select id="dashboard-point-vente-select-mobile" class="mt-2 w-full rounded-xl border border-sky-100 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 focus:border-sky-300 focus:outline-none">
        <option>Chargement...</option>
      </select>
      <p id="dashboard-point-vente-usage-mobile" class="mt-2 text-[0.72rem] text-slate-500"></p>
    </div>

    <div class="mt-4 grid gap-2">
      {mobileMoreItems.map(({ href, id, label, paths, tone }) => (
        <a
          href={href}
          data-tour-nav={id}
          class={`flex items-center gap-3 rounded-2xl border px-3 py-3 text-sm transition
            ${activeNav === id
              ? 'border-sky-200 bg-sky-50 text-sky-900 font-semibold'
              : 'border-slate-100 bg-white text-slate-600 hover:border-sky-100 hover:bg-sky-50/70 hover:text-sky-900'
            }`}
        >
          <span class={`flex h-9 w-9 items-center justify-center rounded-xl border ${navToneClasses[tone].icon}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              {paths.map((path) => <path d={path}></path>)}
            </svg>
          </span>
          <span>{label}</span>
        </a>
      ))}
    </div>

    <div class="mt-4 grid gap-2 border-t border-slate-100 pt-4">
      <a href="/app/install" class="flex items-center justify-between rounded-2xl border border-sky-100 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-800">
        Installer un téléphone
        <span aria-hidden="true">→</span>
      </a>
      <button id="logout-btn-mobile" type="button" class="rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-left text-sm font-semibold text-red-700">
        Se déconnecter
      </button>
    </div>
  </div>
</div>

<script>
  import { ACTIVE_POINT_VENTE_STORAGE_KEY, authFetch } from '../../lib/api';
  import { planBadgeClass, planLabel } from '../../lib/dashboard-config';
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const desktopPlanBadge = document.getElementById('dashboard-plan-badge');
  const mobilePlanBadge = document.getElementById('dashboard-plan-badge-mobile');
  const pointVenteSelects = Array.from(document.querySelectorAll<HTMLSelectElement>('#dashboard-point-vente-select, #dashboard-point-vente-select-mobile'));
  const pointVenteUsages = Array.from(document.querySelectorAll<HTMLElement>('#dashboard-point-vente-usage, #dashboard-point-vente-usage-mobile'));
  const mobileMoreSheet = document.getElementById('mobile-more-sheet');
  const mobileMoreBtn = document.getElementById('mobile-more-btn');
  const scannerLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href="/app/scan"]'));
  const scannerOpenOverlay = document.getElementById('scanner-open-overlay');
  let scannerPrefetchStarted = false;
  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

  function isValidUuid(value: string | null | undefined) {
    return Boolean(value && UUID_RE.test(value));
  }

  function escapeHtml(value: unknown) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function prefetchScannerRoute() {
    if (scannerPrefetchStarted) return;
    scannerPrefetchStarted = true;

    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (connection?.saveData) return;

    const existingPrefetch = document.querySelector('link[rel="prefetch"][href="/app/scan"]');
    if (!existingPrefetch) {
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = '/app/scan';
      link.as = 'document';
      document.head.appendChild(link);
    }

    fetch('/app/scan', {
      method: 'GET',
      credentials: 'include',
      cache: 'force-cache',
      priority: 'low',
    } as RequestInit & { priority?: 'low' }).catch(() => {});
  }

  function scheduleScannerPrefetch() {
    if (!window.matchMedia('(max-width: 1023px)').matches) return;
    const idle = (window as Window & {
      requestIdleCallback?: (callback: () => void, options?: { timeout?: number }) => number;
    }).requestIdleCallback;
    if (idle) idle(prefetchScannerRoute, { timeout: 2200 });
    else window.setTimeout(prefetchScannerRoute, 900);
  }

  for (const scannerLink of scannerLinks) {
    scannerLink.addEventListener('pointerdown', prefetchScannerRoute, { passive: true });
    scannerLink.addEventListener('touchstart', prefetchScannerRoute, { passive: true });
    scannerLink.addEventListener('mouseenter', prefetchScannerRoute, { passive: true });
    scannerLink.addEventListener('click', () => {
      scannerOpenOverlay?.classList.remove('hidden');
      scannerOpenOverlay?.classList.add('flex');
      scannerLink.setAttribute('aria-busy', 'true');
      const labelNode = scannerLink.childElementCount === 0 ? scannerLink : null;
      if (labelNode) labelNode.textContent = 'Ouverture...';
      scannerLink.classList.add('opacity-80');
    });
  }

  function setPlanBadge(planRaw: unknown) {
    const label = planLabel(planRaw);
    const classes = planBadgeClass(planRaw);

    for (const element of [desktopPlanBadge, mobilePlanBadge]) {
      if (!element) continue;
      element.textContent = label;
      element.className = classes;
    }
  }

  function getStoredPointVenteId() {
    try {
      const stored = window.localStorage.getItem(ACTIVE_POINT_VENTE_STORAGE_KEY);
      if (!isValidUuid(stored)) {
        if (stored) window.localStorage.removeItem(ACTIVE_POINT_VENTE_STORAGE_KEY);
        return null;
      }
      return stored;
    } catch {
      return null;
    }
  }

  function setStoredPointVenteId(pointVenteId: string | null) {
    try {
      if (isValidUuid(pointVenteId)) window.localStorage.setItem(ACTIVE_POINT_VENTE_STORAGE_KEY, pointVenteId as string);
      else window.localStorage.removeItem(ACTIVE_POINT_VENTE_STORAGE_KEY);
    } catch {
      // localStorage best-effort
    }
  }

  async function loadPointVenteSelector() {
    if (!pointVenteSelects.length) return;

    let res = await authFetch('/api/commerces/points-vente');
    if (res.status === 403) {
      setStoredPointVenteId(null);
      res = await authFetch('/api/commerces/points-vente');
    }
    if (!res.ok) {
      for (const select of pointVenteSelects) select.innerHTML = '<option value="">Point indisponible</option>';
      return;
    }

    const payload = await res.json().catch(() => null);
    const points = Array.isArray(payload?.data) ? payload.data : [];
    const usage = payload?.usage;
    const selectedFromApi = payload?.selected_point_vente_id as string | null;
    const storedPointId = getStoredPointVenteId();
    const selectedId = points.some((point: { id: string }) => point.id === storedPointId)
      ? storedPointId
      : selectedFromApi;

    if (points.length === 0) {
      for (const select of pointVenteSelects) select.innerHTML = '<option value="">Ajoutez un point de vente</option>';
      for (const usageNode of pointVenteUsages) usageNode.textContent = '0 point de vente actif';
      setStoredPointVenteId(null);
      return;
    }

    const optionsHtml = points.map((point: { id: string; nom: string }) => (
      `<option value="${escapeHtml(point.id)}">${escapeHtml(point.nom)}</option>`
    )).join('');
    for (const select of pointVenteSelects) select.innerHTML = optionsHtml;

    if (selectedId && points.some((point: { id: string }) => point.id === selectedId)) {
      for (const select of pointVenteSelects) select.value = selectedId;
      setStoredPointVenteId(selectedId);
    }

    if (usage) {
      for (const usageNode of pointVenteUsages) usageNode.textContent = `${usage.current}/${usage.max} points de vente utilisés`;
    }
  }

  async function loadPlanBadge() {
    try {
      const res = await authFetch('/api/dashboard/plan');
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Plan indisponible');
      setPlanBadge(payload?.data?.plan);
    } catch (error) {
      console.error('[dashboard plan badge]', error);
      setPlanBadge('starter');
    }
  }

  for (const pointVenteSelect of pointVenteSelects) {
    pointVenteSelect.addEventListener('change', (event) => {
      const nextPointVenteId = (event.target as HTMLSelectElement).value || null;
      setStoredPointVenteId(nextPointVenteId);
      window.location.reload();
    });
  }

  function setMobileMoreOpen(open: boolean) {
    if (!mobileMoreSheet || !mobileMoreBtn) return;
    mobileMoreSheet.classList.toggle('hidden', !open);
    mobileMoreBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  mobileMoreBtn?.addEventListener('click', () => setMobileMoreOpen(mobileMoreSheet?.classList.contains('hidden') ?? true));
  document.getElementById('mobile-more-close')?.addEventListener('click', () => setMobileMoreOpen(false));
  document.getElementById('mobile-more-backdrop')?.addEventListener('click', () => setMobileMoreOpen(false));
  mobileMoreSheet?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobileMoreOpen(false)));
  scheduleScannerPrefetch();

  await loadPointVenteSelector();
  await loadPlanBadge();

  async function logout() {
    await supabase.auth.signOut();
    window.location.href = '/login';
  }

  document.getElementById('logout-btn')?.addEventListener('click', logout);
  document.getElementById('logout-btn-mobile')?.addEventListener('click', logout);
</script>
