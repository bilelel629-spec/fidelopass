---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Dashboard — Fidelopass" activeNav="dashboard">
  <div class="mb-5 flex items-start justify-between gap-3 sm:mb-6">
    <div class="min-w-0">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-sky-700/70">Pilotage</p>
      <h1 class="mt-2 font-display text-2xl font-extrabold tracking-[-0.04em] text-slate-950 sm:text-3xl">Tableau de bord</h1>
      <p class="mt-2 text-sm text-slate-600">Tout ce qui compte aujourd’hui: scanner, partager la carte, suivre l’activité.</p>
    </div>
    <button id="refresh-btn" type="button" class="premium-button rounded-2xl border border-slate-200 bg-white/90 px-3 py-2.5 text-sm font-semibold text-slate-600 transition flex items-center gap-1.5">
      <svg id="refresh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
        <path d="M21 3v5h-5"></path>
        <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
        <path d="M8 16H3v5"></path>
      </svg>
      <span class="hidden sm:inline">Rafraîchir</span>
    </button>
  </div>

  <div class="card dashboard-action-card mb-5 p-4 sm:mb-6 sm:p-5" data-tour="dashboard-actions">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="text-[0.64rem] font-semibold uppercase tracking-[0.24em] text-sky-700/70">Actions du jour</p>
        <p class="mt-1 text-sm text-slate-600">
          Point actif:
          <span id="active-point-name" class="font-semibold text-slate-900">Chargement...</span>
        </p>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
        <a href="/app/scan" class="rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 px-4 py-3 text-center text-sm font-semibold text-white shadow-[0_16px_34px_-22px_rgba(37,99,235,0.9)] transition hover:-translate-y-0.5 hover:shadow-[0_20px_42px_-24px_rgba(37,99,235,0.95)] sm:py-2.5 lg:hidden">Scanner mobile</a>
        <a href="/app/install" class="hidden rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 px-4 py-3 text-center text-sm font-semibold text-white shadow-[0_16px_34px_-22px_rgba(37,99,235,0.9)] transition hover:-translate-y-0.5 hover:shadow-[0_20px_42px_-24px_rgba(37,99,235,0.95)] sm:py-2.5 lg:inline-flex lg:items-center lg:justify-center">Scanner mobile</a>
        <a id="dashboard-client-qr-btn" href="/dashboard/carte" class="premium-button rounded-2xl border border-sky-200 bg-white px-4 py-3 text-center text-sm font-semibold text-sky-700 transition sm:py-2.5">QR client</a>
        <a href="/dashboard/scan" class="rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-500 px-4 py-3 text-center text-sm font-semibold text-white shadow-[0_16px_34px_-22px_rgba(16,185,129,0.9)] transition hover:-translate-y-0.5 hover:shadow-[0_20px_42px_-24px_rgba(16,185,129,0.95)] sm:py-2.5">Mode scannette</a>
        <a href="/dashboard/notifications" class="premium-button rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 transition sm:py-2.5">Notification</a>
      </div>
    </div>
  </div>

  <div class="mb-5 grid grid-cols-2 gap-3 sm:mb-6 sm:gap-4 lg:grid-cols-4" data-tour="dashboard-stats">
    <div class="stat-card">
      <span class="text-[0.65rem] sm:text-xs text-slate-500 uppercase tracking-wide">Clients totaux</span>
      <span id="stat-clients" class="font-mono text-2xl sm:text-3xl font-bold text-slate-900"><span class="inline-block h-8 w-16 animate-pulse rounded-lg bg-slate-200"></span></span>
      <span class="hidden sm:block text-slate-500 text-xs">Base active</span>
    </div>
    <div class="stat-card">
      <span class="text-[0.65rem] sm:text-xs text-slate-500 uppercase tracking-wide">Scans aujourd’hui</span>
      <span id="stat-scans" class="font-mono text-2xl sm:text-3xl font-bold text-slate-900"><span class="inline-block h-8 w-12 animate-pulse rounded-lg bg-slate-200"></span></span>
      <span class="hidden sm:block text-slate-500 text-xs">Transactions</span>
    </div>
    <div class="stat-card">
      <span class="text-[0.65rem] sm:text-xs text-slate-500 uppercase tracking-wide">Récompenses offertes</span>
      <span id="stat-recompenses" class="font-mono text-2xl sm:text-3xl font-bold text-slate-900"><span class="inline-block h-8 w-12 animate-pulse rounded-lg bg-slate-200"></span></span>
      <span class="hidden sm:block text-slate-500 text-xs">Total</span>
    </div>
    <div class="stat-card">
      <span class="text-[0.65rem] sm:text-xs text-slate-500 uppercase tracking-wide">Notifications envoyées</span>
      <span id="stat-push" class="font-mono text-2xl sm:text-3xl font-bold text-slate-900"><span class="inline-block h-8 w-12 animate-pulse rounded-lg bg-slate-200"></span></span>
      <span class="hidden sm:block text-slate-500 text-xs">Campagnes push</span>
    </div>
  </div>

  <div class="mb-6 grid gap-6 xl:grid-cols-[1.4fr_0.6fr]">
    <div class="card dashboard-chart-card overflow-hidden p-4 sm:p-6">
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="font-display text-xl font-bold text-slate-900">Visites par jour</h2>
          <p class="mt-1 text-sm text-slate-500">Scans clients sur les 14 derniers jours</p>
        </div>
        <div class="rounded-2xl border border-blue-100 bg-[linear-gradient(180deg,#eff6ff_0%,#f8fbff_100%)] px-4 py-3 text-right shadow-inner">
          <p class="text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-blue-600/75">Total période</p>
          <p id="visits-total" class="font-mono text-2xl font-bold text-slate-950">—</p>
        </div>
      </div>
      <div id="chart-container" class="chart-surface relative h-[17rem] rounded-[1.35rem] bg-white sm:h-[22rem]" data-tour="dashboard-activity">
        <p class="m-auto text-sm text-slate-400">Chargement...</p>
      </div>
      <div id="dashboard-wallet-qr-card" class="wallet-qr-strip mt-5 rounded-[1.35rem] border border-sky-100 bg-white/82 p-4" data-tour="dashboard-wallet-qr">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="max-w-xl">
            <p class="text-[0.64rem] font-semibold uppercase tracking-[0.24em] text-sky-700/70">Ajout carte Wallet</p>
            <h2 class="mt-1 font-display text-lg font-extrabold tracking-[-0.03em] text-slate-950">QR code client</h2>
            <p class="mt-1.5 text-sm leading-6 text-slate-600">
              À afficher au comptoir pour que vos clients ajoutent leur carte dans Apple Wallet ou Google Wallet.
            </p>
            <p class="mt-2 text-xs font-semibold text-slate-500">
              Carte web ouverte
              <span id="stat-web-card-opened" class="font-mono font-extrabold text-slate-900">0</span>
              fois sur 30 jours.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a id="dashboard-wallet-qr-link" href="/dashboard/carte" class="premium-button rounded-2xl border border-sky-200 bg-white px-4 py-2.5 text-sm font-semibold text-sky-700 transition">
                Ouvrir la carte client
              </a>
              <a id="dashboard-wallet-poster-link" href="/dashboard/carte" class="premium-button rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition">
                Affiche comptoir
              </a>
              <button id="dashboard-wallet-copy-link" type="button" class="premium-button rounded-2xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-sm font-semibold text-indigo-800 transition">
                Copier le lien
              </button>
            </div>
            <p id="dashboard-wallet-share-url" class="mt-3 hidden break-all rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600"></p>
          </div>
          <div class="flex items-center gap-4 rounded-[1.25rem] border border-sky-100 bg-white p-2.5 shadow-[0_20px_50px_-38px_rgba(37,99,235,0.42)]">
            <img id="dashboard-wallet-qr-img" src="" alt="QR code pour ajouter la carte FideloPass au Wallet" class="h-24 w-24 rounded-2xl border border-slate-100 bg-white object-contain" />
            <div class="hidden max-w-[8rem] text-xs leading-5 text-slate-500 sm:block">
              <span id="dashboard-wallet-qr-status">Chargement du QR...</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card dashboard-side-card p-6">
      <div class="retention-panel mb-5 rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
        <p class="text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-slate-500">Rétention clients</p>
        <div class="mt-2 flex items-end justify-between gap-2">
          <p class="text-sm text-slate-600">Clients revenus au moins 2 fois sur 30 jours</p>
          <p id="retention-rate" class="font-mono text-2xl font-bold text-slate-900">—</p>
        </div>
        <div id="retention-chart" class="retention-chart mt-3 flex h-20 items-end gap-1.5">
          <p class="m-auto text-xs text-slate-400">Chargement...</p>
        </div>
      </div>

      <p class="text-[0.64rem] font-semibold uppercase tracking-[0.24em] text-sky-700/70">Parcours rapide</p>
      <div class="mt-3 space-y-3" data-tour="dashboard-quick-path">
        <a href="/dashboard/carte" class="quick-path-card quick-path-card--active block rounded-2xl border border-sky-100 bg-sky-50/70 px-4 py-3 transition">
          <p class="text-sm font-semibold text-slate-900">1. Personnaliser la carte</p>
          <p class="mt-1 text-xs text-slate-600">Template, visuels, programme et géolocalisation.</p>
        </a>
        <a href="/app/install" class="quick-path-card block rounded-2xl border border-slate-200 bg-white px-4 py-3 transition">
          <p class="text-sm font-semibold text-slate-900">2. Installer le scanner équipe</p>
          <p class="mt-1 text-xs text-slate-600">QRCode d’installation pour la caisse.</p>
        </a>
        <a href="/dashboard/points-vente" class="quick-path-card block rounded-2xl border border-slate-200 bg-white px-4 py-3 transition">
          <p class="text-sm font-semibold text-slate-900">3. Gérer vos points de vente</p>
          <p id="points-vente-usage" class="mt-1 text-xs text-slate-600">Chargement du quota...</p>
        </a>
      </div>
      <div id="admin-shortcut" class="hidden mt-4 rounded-2xl border border-sky-100 bg-sky-50/80 p-4 shadow-sm">
        <p class="text-xs uppercase tracking-[0.24em] text-sky-600/75">Accès fondateur</p>
        <p class="mt-1 text-sm text-slate-700">Administration globale plateforme.</p>
        <a href="/admin" class="btn-secondary mt-3 inline-flex px-4 py-2.5 text-sm">Ouvrir l’admin</a>
      </div>
    </div>
  </div>

  <div class="card dashboard-activity-card p-6">
    <h2 class="mb-4 font-display font-bold text-slate-900">Activité récente</h2>
    <div id="recent-transactions" class="flex flex-col gap-3">
      <p class="text-sm text-slate-500">Chargement...</p>
    </div>
  </div>
</DashboardLayout>

<style>
  .dashboard-action-card,
  .dashboard-chart-card,
  .dashboard-side-card,
  .dashboard-activity-card,
  .stat-card {
    border-color: rgba(226, 232, 240, 0.82);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 251, 255, 0.9));
    box-shadow:
      0 28px 70px -54px rgba(15, 23, 42, 0.48),
      0 1px 0 rgba(255, 255, 255, 0.9) inset;
    backdrop-filter: blur(18px);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .dashboard-action-card:hover,
  .dashboard-chart-card:hover,
  .dashboard-side-card:hover,
  .dashboard-activity-card:hover,
  .stat-card:hover {
    border-color: rgba(147, 197, 253, 0.62);
    box-shadow: 0 34px 86px -58px rgba(37, 99, 235, 0.42);
  }

  .stat-card {
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 82% 12%, rgba(56, 189, 248, 0.14), transparent 32%);
  }

  .stat-card span {
    position: relative;
  }

  .premium-button {
    box-shadow: 0 16px 34px -28px rgba(15, 23, 42, 0.45);
  }

  .premium-button:hover {
    transform: translateY(-2px);
    border-color: rgba(125, 211, 252, 0.9);
    background: rgba(248, 252, 255, 0.98);
    box-shadow: 0 22px 44px -30px rgba(37, 99, 235, 0.55);
  }

  .wallet-qr-strip {
    background:
      radial-gradient(circle at 88% 20%, rgba(56, 189, 248, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(248, 251, 255, 0.86));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 22px 58px -48px rgba(37, 99, 235, 0.42);
  }

  @media (max-width: 640px) {
    .stat-card {
      padding: 0.85rem;
      gap: 0.18rem;
      border-radius: 1rem;
    }

    .stat-card span:first-child {
      font-size: 0.63rem;
      letter-spacing: 0.04em;
      line-height: 1.25;
    }

    .stat-card span:nth-child(2) {
      font-size: 1.45rem;
      line-height: 1.05;
    }

    .stat-card span:last-child {
      font-size: 0.66rem;
    }

    .wallet-qr-strip {
      padding: 0.85rem;
    }
  }

  #chart-container {
    isolation: isolate;
  }

  .chart-surface {
    overflow: hidden;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      inset 0 -46px 80px rgba(37, 99, 235, 0.035);
  }

  .chart-surface::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 72% 30%, rgba(56, 189, 248, 0.12), transparent 30%),
      linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px);
    background-size: auto, 100% 25%;
  }

  :global(.chart-grid-line) {
    stroke: rgba(148, 163, 184, 0.16);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  :global(.chart-axis-label) {
    fill: #64748b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
  }

  @media (max-width: 640px) {
    :global(.chart-axis-label) {
      font-size: 11px;
      font-weight: 750;
    }
  }

  :global(.chart-peak-dot) {
    fill: #ffffff;
    stroke: #2563eb;
    stroke-width: 3;
    filter: drop-shadow(0 8px 16px rgba(37, 99, 235, 0.22));
    vector-effect: non-scaling-stroke;
  }

  :global(.chart-active-dot) {
    fill: #38bdf8;
    stroke: #ffffff;
    stroke-width: 4;
    filter: drop-shadow(0 8px 18px rgba(37, 99, 235, 0.26));
    vector-effect: non-scaling-stroke;
  }

  :global(.chart-volume-bar) {
    animation: chart-bars-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    filter: drop-shadow(0 12px 18px rgba(37, 99, 235, 0.08));
    transform-origin: center bottom;
  }

  :global(.chart-volume-bar--empty) {
    opacity: 0.34;
    filter: none;
  }

  :global(.chart-active-line) {
    stroke: rgba(37, 99, 235, 0.18);
    stroke-width: 1;
    stroke-dasharray: 4 6;
    vector-effect: non-scaling-stroke;
  }

  :global(.chart-hit-area) {
    cursor: crosshair;
  }

  :global(.chart-line) {
    animation: chart-draw 1200ms cubic-bezier(0.22, 1, 0.36, 1) both;
    filter: drop-shadow(0 10px 18px rgba(37, 99, 235, 0.22));
  }

  :global(.chart-area) {
    animation: chart-fade 900ms ease-out both;
  }

  .retention-panel {
    background:
      radial-gradient(circle at 84% 14%, rgba(56, 189, 248, 0.13), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 251, 255, 0.88));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.88), 0 20px 50px -42px rgba(15, 23, 42, 0.4);
  }

  .quick-path-card {
    box-shadow: 0 18px 46px -40px rgba(15, 23, 42, 0.38);
  }

  .quick-path-card:hover {
    transform: translateY(-2px);
    border-color: rgba(147, 197, 253, 0.85);
    background: rgba(248, 252, 255, 0.98);
    box-shadow: 0 26px 58px -44px rgba(37, 99, 235, 0.48);
  }

  .quick-path-card--active {
    background: linear-gradient(180deg, rgba(239, 246, 255, 0.94), rgba(240, 249, 255, 0.86));
    box-shadow: 0 22px 54px -44px rgba(37, 99, 235, 0.56);
  }

  :global(.retention-bar-track) {
    position: relative;
    height: 4rem;
    overflow: hidden;
    border-radius: 0.8rem;
    background: rgba(226, 232, 240, 0.82);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  :global(.retention-bar-fill) {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    border-radius: 0.8rem;
    background: linear-gradient(180deg, #67e8f9 0%, #0284c7 100%);
    box-shadow: 0 10px 22px -12px rgba(14, 165, 233, 0.72);
    transition: height 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes chart-draw {
    from {
      stroke-dasharray: 1400;
      stroke-dashoffset: 1400;
      opacity: 0.35;
    }
    to {
      stroke-dasharray: 1400;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes chart-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes chart-bars-rise {
    from {
      opacity: 0;
      transform: scaleY(0.45);
    }
    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.chart-line),
    :global(.chart-area),
    :global(.chart-volume-bar) {
      animation: none;
    }

    .premium-button,
    .quick-path-card,
    .dashboard-action-card,
    .dashboard-chart-card,
    .dashboard-side-card,
    .dashboard-activity-card,
    .stat-card {
      transition: none;
    }
  }
</style>

<script>
  import { authFetch } from '../../lib/api';
  import { supabase } from '../../lib/supabase';
  import { isProPlan, planLabel } from '../../lib/dashboard-config';
  import { toDataURL } from 'qrcode';

  function escapeHtml(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char] ?? char));
  }

  function formatChartDate(value: string, options: Intl.DateTimeFormatOptions = { day: '2-digit', month: '2-digit' }) {
    return new Date(`${value}T12:00:00`).toLocaleDateString('fr-FR', options);
  }

  function buildSmoothPath(points: Array<{ x: number; y: number }>) {
    if (points.length === 0) return '';
    if (points.length === 1) return `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;
    if (points.length === 2) {
      return `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)} L ${points[1].x.toFixed(1)} ${points[1].y.toFixed(1)}`;
    }

    const commands = [`M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`];
    for (let i = 0; i < points.length - 1; i++) {
      const p0 = points[Math.max(0, i - 1)];
      const p1 = points[i];
      const p2 = points[i + 1];
      const p3 = points[Math.min(points.length - 1, i + 2)];
      const smoothing = 0.18;
      const cp1x = p1.x + (p2.x - p0.x) * smoothing;
      const cp1y = p1.y + (p2.y - p0.y) * smoothing;
      const cp2x = p2.x - (p3.x - p1.x) * smoothing;
      const cp2y = p2.y - (p3.y - p1.y) * smoothing;
      commands.push(`C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)} ${cp2x.toFixed(1)} ${cp2y.toFixed(1)} ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`);
    }
    return commands.join(' ');
  }

  function qrImageUrl(url: string, size = 320) {
    return toDataURL(url, {
      width: size,
      margin: 1,
      errorCorrectionLevel: 'M',
      color: {
        dark: '#111827',
        light: '#ffffff',
      },
    });
  }

  async function loadStats() {
    try {
      const res = await authFetch('/api/dashboard/stats');
      if (!res.ok) return;
      const data = await res.json();
      document.getElementById('stat-clients')!.textContent = String(data.totalClients ?? 0);
      document.getElementById('stat-scans')!.textContent = String(data.scansAujourdhui ?? 0);
      document.getElementById('stat-recompenses')!.textContent = String(data.totalRecompenses ?? 0);
      document.getElementById('stat-push')!.textContent = String(data.notificationsEnvoyees ?? 0);
      document.getElementById('stat-web-card-opened')!.textContent = String(data.webCardOpens30d ?? 0);
    } catch {
      // best effort
    }
  }

  async function loadChart() {
    const container = document.getElementById('chart-container')!;
    const totalNode = document.getElementById('visits-total');
    try {
      const res = await authFetch('/api/dashboard/weekly-scans');
      if (!res.ok) throw new Error();
      const { data } = await res.json();

      if (!data?.length) {
        container.innerHTML = '<p class="text-slate-400 text-sm m-auto">Aucune activité cette semaine.</p>';
        if (totalNode) totalNode.textContent = '0';
        return;
      }

      const rows = data.map((d: { date: string; scans: number; recompenses: number }) => ({
        date: d.date,
        visits: Number(d.scans ?? 0) + Number(d.recompenses ?? 0),
      }));
      const total = rows.reduce((sum: number, item: { visits: number }) => sum + item.visits, 0);
      if (totalNode) totalNode.textContent = String(total);

      const width = 1000;
      const height = 340;
      const paddingLeft = 40;
      const paddingRight = 32;
      const paddingTop = 52;
      const paddingBottom = 62;
      const chartHeight = height - paddingTop - paddingBottom;
      const baseline = height - paddingBottom;
      const maxRaw = Math.max(...rows.map((d: { visits: number }) => d.visits), 0);
      const zeroLift = maxRaw > 0 ? Math.max(maxRaw * 0.14, 0.22) : 0;
      const visualValues = rows.map((d: { visits: number }, index: number) => {
        if (total === 0) return 0.16;
        return d.visits > 0 ? d.visits : zeroLift;
      });
      const minVisual = Math.min(...visualValues);
      const maxVisual = Math.max(...visualValues);
      const visualRange = Math.max(maxVisual - minVisual, 1);
      const scaleMin = Math.max(0, minVisual - visualRange * 0.55);
      const scaleMax = maxVisual + visualRange * 0.38;
      const step = rows.length > 1 ? (width - paddingLeft - paddingRight) / (rows.length - 1) : 0;
      const points = rows.map((d: { visits: number }, index: number) => {
        const x = rows.length > 1 ? paddingLeft + index * step : width / 2;
        const visualValue = visualValues[index];
        const ratio = (visualValue - scaleMin) / Math.max(scaleMax - scaleMin, 1);
        const y = paddingTop + chartHeight - Math.min(Math.max(ratio, 0.08), 0.92) * chartHeight;
        return { ...d, x, y };
      });
      const linePath = buildSmoothPath(points);
      const areaPath = `${linePath} L ${points[points.length - 1].x.toFixed(1)} ${baseline.toFixed(1)} L ${points[0].x.toFixed(1)} ${baseline.toFixed(1)} Z`;
      const isMobileChart = window.matchMedia('(max-width: 640px)').matches;
      const labelIndexes = new Set<number>([0, rows.length - 1]);
      if (rows.length > 2) labelIndexes.add(Math.floor((rows.length - 1) / 2));
      if (!isMobileChart) {
        rows.forEach((_: unknown, index: number) => {
          if (rows.length <= 7 || index % 3 === 0) labelIndexes.add(index);
        });
      }
      const labelY = baseline + (isMobileChart ? 38 : 36);
      const labels = points.map((point: { date: string; x: number }, index: number) => {
        if (!labelIndexes.has(index)) return '';
        const label = formatChartDate(point.date);
        const anchor = isMobileChart && index === 0
          ? 'start'
          : isMobileChart && index === rows.length - 1
            ? 'end'
            : 'middle';
        return `<text x="${point.x.toFixed(1)}" y="${labelY.toFixed(1)}" text-anchor="${anchor}" class="chart-axis-label">${escapeHtml(label)}</text>`;
      }).join('');
      const gridLines = [0.25, 0.5, 0.75].map((ratio) => {
        const y = paddingTop + chartHeight * ratio;
        return `<line x1="${paddingLeft}" y1="${y.toFixed(1)}" x2="${width - paddingRight}" y2="${y.toFixed(1)}" class="chart-grid-line"></line>`;
      }).join('');
      const barSlot = rows.length > 1 ? step : 92;
      const barWidth = Math.min(34, Math.max(14, barSlot * 0.34));
      const maxBarHeight = Math.max(64, chartHeight * 0.42);
      const minBarHeight = total > 0 ? 12 : 16;
      const bars = points.map((point: { visits: number; x: number }, index: number) => {
        const ratio = maxRaw > 0 ? point.visits / maxRaw : 0;
        const barHeight = total > 0
          ? point.visits > 0
            ? Math.max(minBarHeight, ratio * maxBarHeight)
            : 6
          : 8;
        const x = point.x - barWidth / 2;
        const y = baseline - barHeight;
        const radius = Math.min(barWidth / 2, 10);
        const className = point.visits > 0 ? 'chart-volume-bar' : 'chart-volume-bar chart-volume-bar--empty';
        const fill = point.visits > 0 ? 'url(#visitsBarGradient)' : 'url(#visitsEmptyBarGradient)';
        return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barWidth.toFixed(1)}" height="${barHeight.toFixed(1)}" rx="${radius.toFixed(1)}" fill="${fill}" class="${className}" style="animation-delay:${(index * 38).toFixed(0)}ms"></rect>`;
      }).join('');
      const peakDots = points.map((point: { visits: number; x: number; y: number }, index: number) => {
        const previous = rows[index - 1]?.visits ?? 0;
        const next = rows[index + 1]?.visits ?? 0;
        const isPeak = point.visits > 0 && (point.visits === maxRaw || (point.visits >= previous && point.visits >= next && point.visits >= Math.max(1, maxRaw * 0.55)));
        return isPeak ? `<circle cx="${point.x.toFixed(1)}" cy="${point.y.toFixed(1)}" r="4.5" class="chart-peak-dot"></circle>` : '';
      }).join('');
      const hitAreas = points.map((point: { date: string; visits: number; x: number; y: number }, index: number) => {
        const hitWidth = Math.max(34, step || 80);
        const left = index === 0 ? paddingLeft - hitWidth / 2 : point.x - hitWidth / 2;
        return `
          <rect class="chart-hit-area" x="${left.toFixed(1)}" y="${paddingTop}" width="${hitWidth.toFixed(1)}" height="${chartHeight}" fill="transparent"
            data-index="${index}"
            data-date="${escapeHtml(formatChartDate(point.date, { weekday: 'short', day: '2-digit', month: 'short' }))}"
            data-visits="${point.visits}"
            data-x="${point.x.toFixed(1)}"
            data-y="${point.y.toFixed(1)}"></rect>
        `;
      }).join('');
      const lastPoint = points[points.length - 1];
      const firstHalf = rows.slice(0, Math.ceil(rows.length / 2)).reduce((sum: number, item: { visits: number }) => sum + item.visits, 0);
      const secondHalf = rows.slice(Math.ceil(rows.length / 2)).reduce((sum: number, item: { visits: number }) => sum + item.visits, 0);
      const trend = firstHalf > 0 ? Math.round(((secondHalf - firstHalf) / firstHalf) * 100) : (secondHalf > 0 ? 100 : 0);
      const reliableTrend = total >= 3 && rows.filter((item: { visits: number }) => item.visits > 0).length >= 2;
      const trendText = !reliableTrend
        ? 'Tendance en cours'
        : trend === 0
        ? 'Activité stable'
        : trend > 0
          ? `+${trend}% vs semaine précédente`
          : `${trend}% vs semaine précédente`;
      const trendClass = !reliableTrend
        ? 'text-sky-700 bg-sky-50 border-sky-100'
        : trend >= 0
          ? 'text-emerald-700 bg-emerald-50 border-emerald-100'
          : 'text-amber-700 bg-amber-50 border-amber-100';
      const helper = total <= 2
        ? '<p class="absolute left-5 bottom-5 max-w-[19rem] rounded-2xl border border-slate-200 bg-white/90 px-4 py-3 text-xs leading-5 text-slate-500 shadow-sm backdrop-blur">Pas encore assez de données pour afficher une tendance fiable.</p>'
        : '';

      container.innerHTML = `
        <div class="absolute left-5 top-5 z-10 rounded-full border ${trendClass} px-3 py-1.5 text-xs font-semibold shadow-sm">
          ${escapeHtml(trendText)}
        </div>
        ${helper}
        <div id="visits-tooltip" class="pointer-events-none absolute z-20 hidden rounded-2xl border border-slate-800 bg-slate-950/95 px-4 py-3 text-xs text-white shadow-[0_20px_48px_rgba(15,23,42,0.28)] backdrop-blur">
          <p id="visits-tooltip-date" class="font-semibold text-white"></p>
          <p class="mt-1 text-slate-300"><span id="visits-tooltip-value" class="font-mono font-bold text-cyan-300"></span> visite(s)</p>
        </div>
        <svg viewBox="0 0 ${width} ${height}" class="h-full w-full" preserveAspectRatio="none" role="img" aria-label="Visites par jour">
          <defs>
            <linearGradient id="visitsAreaGradient" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#2563eb" stop-opacity="0.18"></stop>
              <stop offset="60%" stop-color="#38bdf8" stop-opacity="0.06"></stop>
              <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"></stop>
            </linearGradient>
            <linearGradient id="visitsLineGradient" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0%" stop-color="#2563eb"></stop>
              <stop offset="55%" stop-color="#3b82f6"></stop>
              <stop offset="100%" stop-color="#06b6d4"></stop>
            </linearGradient>
            <linearGradient id="visitsBarGradient" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.34"></stop>
              <stop offset="100%" stop-color="#2563eb" stop-opacity="0.08"></stop>
            </linearGradient>
            <linearGradient id="visitsEmptyBarGradient" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#cbd5e1" stop-opacity="0.45"></stop>
              <stop offset="100%" stop-color="#e2e8f0" stop-opacity="0.12"></stop>
            </linearGradient>
          </defs>
          ${gridLines}
          ${bars}
          <path d="${areaPath}" fill="url(#visitsAreaGradient)" class="chart-area"></path>
          <path d="${linePath}" fill="none" stroke="url(#visitsLineGradient)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" class="chart-line"></path>
          ${peakDots}
          <circle id="chart-active-dot" cx="${lastPoint.x.toFixed(1)}" cy="${lastPoint.y.toFixed(1)}" r="6" class="chart-active-dot hidden"></circle>
          <line id="chart-active-line" x1="${lastPoint.x.toFixed(1)}" y1="${paddingTop}" x2="${lastPoint.x.toFixed(1)}" y2="${baseline}" class="chart-active-line hidden"></line>
          ${labels}
          ${hitAreas}
        </svg>
      `;

      const tooltip = container.querySelector('#visits-tooltip') as HTMLDivElement | null;
      const tooltipDate = container.querySelector('#visits-tooltip-date');
      const tooltipValue = container.querySelector('#visits-tooltip-value');
      const activeDot = container.querySelector('#chart-active-dot') as SVGCircleElement | null;
      const activeLine = container.querySelector('#chart-active-line') as SVGLineElement | null;
      container.querySelectorAll<SVGRectElement>('.chart-hit-area').forEach((area) => {
        area.addEventListener('pointerenter', () => {
          tooltip?.classList.remove('hidden');
          activeDot?.classList.remove('hidden');
          activeLine?.classList.remove('hidden');
        });
        area.addEventListener('pointermove', (event) => {
          const x = Number(area.dataset.x ?? 0);
          const y = Number(area.dataset.y ?? 0);
          if (tooltipDate) tooltipDate.textContent = area.dataset.date ?? '';
          if (tooltipValue) tooltipValue.textContent = area.dataset.visits ?? '0';
          activeDot?.setAttribute('cx', String(x));
          activeDot?.setAttribute('cy', String(y));
          activeLine?.setAttribute('x1', String(x));
          activeLine?.setAttribute('x2', String(x));
          if (tooltip) {
            const bounds = container.getBoundingClientRect();
            const tooltipWidth = tooltip.offsetWidth || 150;
            const left = Math.min(Math.max(event.clientX - bounds.left + 14, 12), bounds.width - tooltipWidth - 12);
            const top = Math.max(event.clientY - bounds.top - 54, 12);
            tooltip.style.left = `${left}px`;
            tooltip.style.top = `${top}px`;
          }
        });
        area.addEventListener('pointerleave', () => {
          tooltip?.classList.add('hidden');
          activeDot?.classList.add('hidden');
          activeLine?.classList.add('hidden');
        });
      });
    } catch {
      container.innerHTML = '<p class="text-slate-400 text-sm m-auto">Impossible de charger le graphique.</p>';
      if (totalNode) totalNode.textContent = '—';
    }
  }

  async function loadRecentTransactions() {
    try {
      const res = await authFetch('/api/transactions?limit=5');
      if (!res.ok) return;
      const { data } = await res.json();
      const container = document.getElementById('recent-transactions')!;

      if (!data?.length) {
        container.innerHTML = '<p class="text-slate-500 text-sm">Aucune transaction pour le moment.</p>';
        return;
      }

      container.innerHTML = data.map((t: { type: string; valeur: number; created_at: string }) => `
        <div class="flex items-center justify-between border-b border-slate-200 py-3 last:border-0">
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full ${t.type === 'ajout_tampon' ? 'bg-indigo-400' : t.type === 'ajout_points' ? 'bg-cyan-400' : 'bg-emerald-400'}"></span>
            <span class="text-slate-700 text-sm capitalize">${escapeHtml(t.type.replace('_', ' '))}</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-mono text-sm text-slate-900">+${t.valeur}</span>
            <span class="text-slate-500 text-xs">${new Date(t.created_at).toLocaleDateString('fr-FR')}</span>
          </div>
        </div>
      `).join('');
    } catch {
      // best effort
    }
  }

  async function loadRetention() {
    const rate = document.getElementById('retention-rate');
    const chart = document.getElementById('retention-chart');
    if (!rate || !chart) return;

    try {
      const res = await authFetch('/api/dashboard/retention');
      if (!res.ok) throw new Error();
      const payload = await res.json().catch(() => null);
      const summary = payload?.summary ?? {};
      const weekly = Array.isArray(payload?.data) ? payload.data : [];

      rate.textContent = `${summary?.rate_30d ?? 0}%`;

      if (!weekly.length) {
        chart.innerHTML = '<p class="m-auto text-xs text-slate-400">Pas assez de données.</p>';
        return;
      }

      const maxRate = Math.max(...weekly.map((item: { retention_rate?: number }) => Number(item.retention_rate ?? 0)), 1);
      chart.innerHTML = weekly.map((item: { week_start: string; retention_rate: number }) => {
        const rawRate = Number(item.retention_rate ?? 0);
        const ratio = Math.max(rawRate > 0 ? 12 : 0, Math.round((rawRate / maxRate) * 100));
        const label = new Date(`${item.week_start}T12:00:00`).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
        return `
          <div class="min-w-0 flex-1">
            <div class="group retention-bar-track">
              <div class="retention-bar-fill" style="height:${ratio}%"></div>
              <span class="pointer-events-none absolute -top-6 left-1/2 hidden -translate-x-1/2 rounded-md bg-slate-900 px-2 py-1 text-[10px] text-white shadow-lg group-hover:block">${rawRate}%</span>
            </div>
            <p class="mt-1 truncate text-center text-[0.62rem] text-slate-500">${escapeHtml(label)}</p>
          </div>
        `;
      }).join('');
    } catch {
      rate.textContent = '—';
      chart.innerHTML = '<p class="m-auto text-xs text-slate-400">Impossible de charger.</p>';
    }
  }

  async function loadCardShortcuts() {
    try {
      const res = await authFetch('/api/cartes');
      if (!res.ok) return;
      const { data } = await res.json();
      const qrStatus = document.getElementById('dashboard-wallet-qr-status');
      if (!data?.id) {
        if (qrStatus) qrStatus.textContent = 'Créez votre carte pour obtenir le QR.';
        return;
      }
      const qrBtn = document.getElementById('dashboard-client-qr-btn') as HTMLAnchorElement | null;
      const cardUrl = `${window.location.origin}/carte/${data.id}`;
      const posterUrl = `/poster/${data.id}?template=signature`;
      if (qrBtn) qrBtn.href = posterUrl;

      const qrImg = document.getElementById('dashboard-wallet-qr-img') as HTMLImageElement | null;
      const qrLink = document.getElementById('dashboard-wallet-qr-link') as HTMLAnchorElement | null;
      const posterLink = document.getElementById('dashboard-wallet-poster-link') as HTMLAnchorElement | null;
      const shareUrl = document.getElementById('dashboard-wallet-share-url');
      const copyLinkButton = document.getElementById('dashboard-wallet-copy-link');
      if (qrImg) qrImg.src = await qrImageUrl(cardUrl);
      if (qrLink) qrLink.href = cardUrl;
      if (posterLink) posterLink.href = posterUrl;
      if (shareUrl) {
        shareUrl.textContent = cardUrl;
        shareUrl.classList.remove('hidden');
      }
      if (copyLinkButton) copyLinkButton.onclick = async () => {
        await navigator.clipboard?.writeText(cardUrl);
        copyLinkButton.textContent = 'Lien copié';
        setTimeout(() => { copyLinkButton.textContent = 'Copier le lien'; }, 1400);
      };
      if (qrStatus) qrStatus.textContent = 'Prêt à être scanné par vos clients.';
    } catch {
      const qrStatus = document.getElementById('dashboard-wallet-qr-status');
      if (qrStatus) qrStatus.textContent = 'QR indisponible pour le moment.';
    }
  }

  async function loadPointVenteContext() {
    const activeName = document.getElementById('active-point-name');
    const usage = document.getElementById('points-vente-usage');
    if (!activeName || !usage) return;

    try {
      const res = await authFetch('/api/commerces/points-vente');
      if (!res.ok) throw new Error();
      const payload = await res.json().catch(() => null);
      const points = Array.isArray(payload?.data) ? payload.data : [];
      const selectedId = payload?.selected_point_vente_id;
      const selected = points.find((point: { id: string; nom?: string }) => point.id === selectedId);
      const stats = payload?.usage;
      const plan = planLabel(payload?.plan);
      const pro = isProPlan(payload?.plan);

      activeName.textContent = selected?.nom ?? '—';
      usage.textContent = `Plan ${plan}: ${stats?.current ?? 0}/${stats?.max ?? 1} point(s) de vente utilisés (${pro ? 'multi-sites activé' : '1 point inclus'}).`;
    } catch {
      activeName.textContent = '—';
      usage.textContent = 'Impossible de charger votre contexte point de vente.';
    }
  }

  async function loadAdminShortcut() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.access_token) return;
      const res = await authFetch('/api/admin/stats');
      const isAdmin = res.ok;
      document.getElementById('admin-shortcut')!.classList.toggle('hidden', !isAdmin);
    } catch {
      // best effort
    }
  }

  async function refreshAll() {
    const icon = document.getElementById('refresh-icon')!;
    const btn = document.getElementById('refresh-btn') as HTMLButtonElement;
    btn.disabled = true;
    icon.style.animation = 'spin 0.8s linear infinite';
    await Promise.all([
      loadStats(),
      loadChart(),
      loadRecentTransactions(),
      loadRetention(),
      loadCardShortcuts(),
      loadPointVenteContext(),
    ]);
    icon.style.animation = '';
    btn.disabled = false;
  }

  document.getElementById('refresh-btn')!.addEventListener('click', refreshAll);

  const style = document.createElement('style');
  style.textContent = '@keyframes spin { to { transform: rotate(360deg); } }';
  document.head.appendChild(style);

  loadStats();
  loadChart();
  loadRecentTransactions();
  loadRetention();
  loadCardShortcuts();
  loadPointVenteContext();
  loadAdminShortcut();
</script>
