    .editor-card {
      margin-top: 0.8rem;
      border-radius: 1.1rem;
      padding: 0.85rem;
    }

    .preview-toolbar {
      width: 100%;
      min-width: 0;
      border-radius: 1.1rem;
    }

    .preview-area {
      min-height: auto;
      padding: 1rem;
    }

    .poster-preview-shell {
      min-height: auto;
      padding-bottom: 10rem;
    }
  }
</style>

<script>
  // @ts-nocheck
  import QRCode from 'qrcode';
  import { jsPDF } from 'jspdf';

  const creatorRoot = document.querySelector('[data-poster-creator]');
  const API = creatorRoot?.dataset.apiBase || '';
  const carteId = creatorRoot?.dataset.carteId || '';
  const defaultFont = "Inter, Arial, ui-sans-serif, system-ui, sans-serif";
  const templatePresets = {
    affiche: { primary: '#fff0e5', secondary: '#df652a', text: '#1f2937', titleColor: '#df652a', image: '/banner-templates/nail-art.png', title: 'SCANNEZ & PROFITEZ' },
    qr: { primary: '#ffffff', secondary: '#2563eb', text: '#0f172a', titleColor: '#0f172a', image: '', title: 'SCANNEZ ICI' },
  };
  const templateAliases = {
    essential: 'affiche', signature: 'affiche', impact: 'affiche', premium: 'affiche',
    modern: 'affiche', elegant: 'affiche', elegante: 'affiche', restaurant: 'affiche',
    cafe: 'affiche', beaute: 'affiche', beauty: 'affiche', minimal: 'qr',
    moderne: 'affiche', affiche: 'affiche', qr: 'qr',
  };
  const exportSizes = {
    a4: { jsPdfFormat: 'a4', pdfWidth: 210, pdfHeight: 297, pixelWidth: 1240, pixelHeight: 1754 },
    a5: { jsPdfFormat: 'a5', pdfWidth: 148, pdfHeight: 210, pixelWidth: 1240, pixelHeight: 1754 },
  };

  const initialTemplate = normalizeTemplate(new URLSearchParams(window.location.search).get('template'));
  const initialPreset = templatePresets[initialTemplate] || templatePresets.affiche;
  const state = {
    template: initialTemplate,
    format: 'a4',
    logo: '',
    logoData: '',
    commerce: 'Votre commerce',
    title: initialPreset.title,
    subtitle: 'Ajoutez notre carte fidélité à votre téléphone',
    reward: '1 CAFÉ OFFERT',
    phone: '',
    instagram: '',
    address: '',
    primary: initialPreset.primary,
    secondary: initialPreset.secondary,
    text: initialPreset.text,
    titleColor: initialPreset.titleColor,
    fontFamily: defaultFont,
    titleFontFamily: defaultFont,
    image: initialPreset.image,
    imageData: '',
    qrData: '',
  };
  let isExportingPdf = false;
  let assetHydrationToken = 0;

  const $ = (id) => document.getElementById(id);

  function normalizeTemplate(value) {
    const key = String(value || '').trim().toLowerCase();
    return templateAliases[key] || 'affiche';
  }

  function apiUrl(path) {
    return `${API}${path}`;
  }

  function escapeXml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function hexToRgb(hex) {
    const value = String(hex || '').replace('#', '').trim();
    if (!/^[0-9a-f]{6}$/i.test(value)) return { red: 255, green: 255, blue: 255 };
    const intValue = parseInt(value, 16);
    return { red: (intValue >> 16) & 255, green: (intValue >> 8) & 255, blue: intValue & 255 };
  }

  function hexToRgba(hex, alpha = 1) {
    const { red, green, blue } = hexToRgb(hex);
    return `rgba(${red},${green},${blue},${alpha})`;
  }

  function mixHex(hex, target = '#ffffff', amount = 0.5) {
    const start = hexToRgb(hex);
    const end = hexToRgb(target);
    const channel = (from, to) => Math.round(from + (to - from) * amount).toString(16).padStart(2, '0');
    return `#${channel(start.red, end.red)}${channel(start.green, end.green)}${channel(start.blue, end.blue)}`;
  }

  function readableFont(font) {
    return String(font || defaultFont).split(',')[0].replace(/["']/g, '').trim() || 'Inter';
  }

  function wrapText(text, maxChars, maxLines = 3) {
    const words = String(text || '').replace(/\s+/g, ' ').trim().split(' ').filter(Boolean);
    const lines = [];
    let current = '';
    words.forEach((word) => {
      const next = current ? `${current} ${word}` : word;
      if (next.length > maxChars && current) {
        lines.push(current);
        current = word;
      } else {
        current = next;
      }
    });
    if (current) lines.push(current);
    if (!lines.length) lines.push('');
    if (lines.length > maxLines) {
      const clipped = lines.slice(0, maxLines);
      clipped[maxLines - 1] = `${clipped[maxLines - 1].replace(/[.,;:!?]$/, '')}…`;
      return clipped;
    }
    return lines;
  }

  function svgTextLines(lines, x, y, options = {}) {
    const {
      size = 48,
      lineHeight = 1.08,
      weight = 800,
      fill = '#0f172a',
      anchor = 'start',
      family = state.fontFamily,
      letterSpacing = 0,
    } = options;
    return `<text x="${x}" y="${y}" fill="${fill}" text-anchor="${anchor}" font-family="${escapeXml(readableFont(family))}" font-size="${size}" font-weight="${weight}" letter-spacing="${letterSpacing}">${lines.map((line, index) => `<tspan x="${x}" dy="${index ? size * lineHeight : 0}">${escapeXml(line)}</tspan>`).join('')}</text>`;
  }

  async function fetchWithTimeout(url, timeoutMs = 3500) {
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), timeoutMs);
    try {
      return await fetch(url, { signal: controller.signal, cache: 'no-store' });
    } finally {
      window.clearTimeout(timeout);
    }
  }

  function fileReaderDataUrl(blob) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  }

  async function imageToDataUrl(source) {
    if (!source || source.startsWith('data:')) return source || '';
    try {
      const response = await fetch(source, { mode: 'cors', cache: 'force-cache' });
      if (!response.ok) throw new Error('Image unavailable');
      return await fileReaderDataUrl(await response.blob());
    } catch {
      return '';
    }
  }

  async function hydratePosterAssets() {
    const token = ++assetHydrationToken;
    const [logoData, imageData] = await Promise.all([
      imageToDataUrl(state.logo),
      imageToDataUrl(state.image),
    ]);
    if (token !== assetHydrationToken) return;
    state.logoData = logoData;
    state.imageData = imageData;
    renderPosterPreview();
  }

  async function renderQrCode(cardId) {
    try {
      state.qrData = await QRCode.toDataURL(`${window.location.origin}/carte/${cardId}`, {
        width: 900,
        margin: 1,
        color: { dark: '#111827', light: '#ffffff' },
        errorCorrectionLevel: 'M',
      });
    } catch {
      state.qrData = '';
    }
  }

  function rewardSummary(data) {
    const tiers = data.carte.rewards_multi_enabled === true && Array.isArray(data.carte.rewards_config)
      ? data.carte.rewards_config
      : [];
    if (tiers.length) {
      return tiers.map((item) => `${item.seuil} ${data.carte.type === 'points' ? 'pts' : 'tampons'} = ${item.recompense}`).join(' · ');
    }
    return data.carte.recompense_description || 'Récompense fidélité';
  }

  function setField(id, value) {
    const field = $(id);
    if (field) field.value = value ?? '';
  }

  function syncFieldsFromState() {
    setField('field-commerce', state.commerce);
    setField('field-title', state.title);
    setField('field-subtitle', state.subtitle);
    setField('field-reward', state.reward);
    setField('field-phone', state.phone);
    setField('field-instagram', state.instagram);
    setField('field-address', state.address);
    setField('field-primary', state.primary);
    setField('field-secondary', state.secondary);
    setField('field-text', state.text);
    setField('field-title-color', state.titleColor);
    setField('field-font', state.fontFamily);
    setField('field-title-font', state.titleFontFamily);
  }

  function readFields() {
    state.commerce = $('field-commerce')?.value?.trim() || 'Votre commerce';
    state.title = $('field-title')?.value?.trim() || 'SCANNEZ & PROFITEZ';
    state.subtitle = $('field-subtitle')?.value?.trim() || 'Ajoutez notre carte fidélité à votre téléphone';
    state.reward = $('field-reward')?.value?.trim() || 'Récompense fidélité';
    state.phone = $('field-phone')?.value?.trim() || '';
    state.instagram = $('field-instagram')?.value?.trim() || '';
    state.address = $('field-address')?.value?.trim() || '';
    state.primary = $('field-primary')?.value || state.primary;
    state.secondary = $('field-secondary')?.value || state.secondary;
    state.text = $('field-text')?.value || state.text;
    state.titleColor = $('field-title-color')?.value || state.titleColor;
    state.fontFamily = $('field-font')?.value || state.fontFamily;
    state.titleFontFamily = $('field-title-font')?.value || state.titleFontFamily;
  }

  function setText(id, value) {
    const node = $(id);
    if (node) node.textContent = value;
  }

  function renderQrOnlySvg() {
    const qr = state.qrData || '';
    return `
      <rect width="1240" height="1754" fill="${state.primary}"/>
      <circle cx="190" cy="190" r="260" fill="${hexToRgba(state.secondary, 0.10)}"/>
      <circle cx="1060" cy="1550" r="320" fill="${hexToRgba(state.secondary, 0.12)}"/>
      <text x="620" y="265" text-anchor="middle" fill="${state.titleColor}" font-family="${escapeXml(readableFont(state.titleFontFamily))}" font-size="92" font-weight="950" letter-spacing="-3">${escapeXml(state.title || 'SCANNEZ ICI')}</text>
      <text x="620" y="350" text-anchor="middle" fill="${hexToRgba(state.text, 0.72)}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="34" font-weight="700">${escapeXml(state.commerce)}</text>
      <rect x="245" y="455" width="750" height="750" rx="54" fill="#ffffff"/>
      ${qr ? `<image href="${qr}" x="315" y="525" width="610" height="610"/>` : ''}
      <text x="620" y="1285" text-anchor="middle" fill="${state.text}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="34" font-weight="850">Ouvrez l'appareil photo</text>
      <text x="620" y="1465" text-anchor="middle" fill="${hexToRgba(state.text, 0.48)}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="26" font-weight="750">Powered by Fidelopass</text>
    `;
  }

  function renderAfficheSvg() {
    const muted = hexToRgba(state.text, 0.72);
    const soft = mixHex(state.primary, '#ffffff', 0.18);
    const accentSoft = hexToRgba(state.secondary, 0.26);
    const titleLines = wrapText(state.title.toUpperCase(), 12, 3);
    const subtitleLines = wrapText(state.subtitle, 35, 2);
    const commerceLines = wrapText(state.commerce, 18, 1);
    const rewardLines = wrapText(state.reward.toUpperCase(), 18, 2);
    const logo = state.logoData;
    const image = state.imageData;
    const qr = state.qrData || '';
    const contactLines = [state.phone, state.instagram, state.address].filter(Boolean).slice(0, 3);

    return `
      <defs>
        <linearGradient id="posterBg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="${mixHex(state.primary, '#ffffff', 0.18)}"/>
          <stop offset="58%" stop-color="${state.primary}"/>
          <stop offset="100%" stop-color="${mixHex(state.secondary, state.primary, 0.35)}"/>
        </linearGradient>
        <linearGradient id="accentGlow" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="${hexToRgba(state.secondary, 0.34)}"/>
          <stop offset="100%" stop-color="${hexToRgba(state.secondary, 0)}"/>
        </linearGradient>
        <clipPath id="logoClip"><rect x="80" y="86" width="118" height="118" rx="28"/></clipPath>
      </defs>
      <rect width="1240" height="1754" fill="url(#posterBg)"/>
      ${image ? `<image href="${image}" x="0" y="0" width="1240" height="1754" preserveAspectRatio="xMidYMid slice" opacity="0.16"/>` : ''}
      <circle cx="1010" cy="330" r="255" fill="url(#accentGlow)" opacity="0.85"/>
      <circle cx="120" cy="1260" r="235" fill="${hexToRgba(state.secondary, 0.13)}"/>
      <rect x="0" y="0" width="1240" height="250" fill="${soft}" opacity="0.38"/>
      <rect x="80" y="86" width="118" height="118" rx="28" fill="${hexToRgba(state.text, 0.11)}" stroke="${hexToRgba(state.text, 0.24)}"/>
      ${logo ? `<image href="${logo}" x="80" y="86" width="118" height="118" preserveAspectRatio="xMidYMid slice" clip-path="url(#logoClip)"/>` : `<text x="139" y="164" text-anchor="middle" fill="${state.text}" font-family="${escapeXml(readableFont(state.titleFontFamily))}" font-size="54" font-weight="900">${escapeXml((state.commerce || 'F').charAt(0).toUpperCase())}</text>`}
      <text x="230" y="118" fill="${muted}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="23" font-weight="900" letter-spacing="8">CARTE FIDÉLITÉ WALLET</text>
      ${svgTextLines(commerceLines, 230, 177, { size: 50, weight: 950, fill: state.titleColor, family: state.titleFontFamily })}
      <rect x="910" y="92" width="246" height="92" rx="46" fill="${hexToRgba(state.text, 0.12)}" stroke="${hexToRgba(state.text, 0.22)}"/>
      <text x="1033" y="149" text-anchor="middle" fill="${state.text}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="24" font-weight="850">Sans application</text>
      <rect x="82" y="448" width="590" height="${rewardLines.length > 1 ? 116 : 86}" rx="43" fill="${accentSoft}" stroke="${hexToRgba(state.secondary, 0.58)}" stroke-width="3"/>
      <text x="130" y="504" fill="${muted}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="21" font-weight="950" letter-spacing="5">RÉCOMPENSE</text>
      ${svgTextLines(rewardLines, 392, 505, { size: 29, lineHeight: 1.1, weight: 950, fill: state.titleColor, family: state.titleFontFamily })}
      ${svgTextLines(titleLines, 82, 720, { size: titleLines.length > 2 ? 98 : 112, lineHeight: 0.94, weight: 950, fill: state.titleColor, family: state.titleFontFamily, letterSpacing: -3 })}
      ${svgTextLines(subtitleLines, 85, 940, { size: 32, lineHeight: 1.18, weight: 750, fill: muted, family: state.fontFamily })}
      <rect x="86" y="1115" width="455" height="455" rx="40" fill="#ffffff"/>
      <text x="314" y="1180" text-anchor="middle" fill="#64748b" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="19" font-weight="950" letter-spacing="9">SCANNEZ ICI</text>
      ${qr ? `<image href="${qr}" x="155" y="1218" width="318" height="318"/>` : ''}
      <text x="314" y="1610" text-anchor="middle" fill="#111827" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="22" font-weight="850">Ouvrez l'appareil photo</text>
      ${[0, 1, 2].map((index) => {
        const labels = ['Scannez le QR code', 'Ajoutez la carte à votre Wallet', 'Cumulez vos avantages'];
        const y = 1126 + index * 128;
        return `<rect x="610" y="${y}" width="500" height="88" rx="30" fill="${hexToRgba(state.text, 0.10)}" stroke="${hexToRgba(state.text, 0.16)}"/>
          <circle cx="660" cy="${y + 44}" r="24" fill="${hexToRgba(state.text, 0.18)}"/>
          <text x="660" y="${y + 54}" text-anchor="middle" fill="${state.text}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="28" font-weight="950">${index + 1}</text>
          <text x="715" y="${y + 54}" fill="${state.text}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="25" font-weight="850">${escapeXml(labels[index])}</text>`;
      }).join('')}
      <rect x="86" y="1652" width="178" height="50" rx="25" fill="${hexToRgba(state.text, 0.10)}" stroke="${hexToRgba(state.text, 0.22)}"/>
      <text x="175" y="1685" text-anchor="middle" fill="${state.text}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="20" font-weight="850">Apple Wallet</text>
      <rect x="288" y="1652" width="190" height="50" rx="25" fill="${hexToRgba(state.text, 0.10)}" stroke="${hexToRgba(state.text, 0.22)}"/>
      <text x="383" y="1685" text-anchor="middle" fill="${state.text}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="20" font-weight="850">Google Wallet</text>
      <text x="86" y="1730" fill="${hexToRgba(state.text, 0.48)}" font-family="${escapeXml(readableFont(state.fontFamily))}" font-size="23" font-weight="800">Powered by Fidelopass</text>
      ${contactLines.length ? svgTextLines(contactLines, 1154, 1659, { size: 20, lineHeight: 1.25, weight: 750, fill: muted, anchor: 'end', family: state.fontFamily }) : ''}
    `;
  }

  function renderPosterSvgMarkup() {
    const body = state.template === 'qr' ? renderQrOnlySvg() : renderAfficheSvg();
    return `<svg id="poster-svg" class="poster-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1240 1754" role="img" aria-label="Aperçu affiche Fidelopass">${body}</svg>`;
  }

  function renderPosterPreview() {
    const sheet = $('poster-sheet');
    if (!sheet) return;
    sheet.innerHTML = renderPosterSvgMarkup();
  }

  function applyFormat() {
    const sheet = $('poster-sheet');
    const format = state.format === 'a5' ? 'a5' : 'a4';
    if (sheet) sheet.dataset.format = format;
    document.querySelectorAll('.format-btn').forEach((button) => {
      button.classList.toggle('is-active', button.dataset.format === format);
    });
    setText('poster-preview-title', `Affiche ${format.toUpperCase()}`);
  }

  function applyCreator() {
    readFields();
    applyFormat();
    const uploadLogo = $('upload-logo-img');
    const uploadIcon = $('upload-logo-icon');
    if (state.logo && uploadLogo && uploadIcon) {
      uploadLogo.src = state.logo;
      uploadLogo.classList.remove('hidden');
      uploadIcon.classList.add('hidden');
    } else if (uploadLogo && uploadIcon) {
      uploadLogo.classList.add('hidden');
      uploadIcon.classList.remove('hidden');
    }
    renderPosterPreview();
  }

  function updateTemplateSelection() {
    document.querySelectorAll('.template-card').forEach((button) => {
      button.classList.toggle('is-selected', button.dataset.template === state.template);
    });
    document.querySelectorAll('.palette-btn').forEach((button) => {
      button.classList.toggle(
        'is-selected',
        button.dataset.primary === state.primary
          && button.dataset.secondary === state.secondary
          && button.dataset.text === state.text
          && (button.dataset.title || button.dataset.text) === state.titleColor,
      );
    });
  }

  function selectTemplate(name, keepText = true) {
    const normalizedName = normalizeTemplate(name);
    const preset = templatePresets[normalizedName] || templatePresets.affiche;
    state.template = normalizedName;
    state.primary = preset.primary;
    state.secondary = preset.secondary;
    state.text = preset.text;
    state.titleColor = preset.titleColor;
    state.image = preset.image;
    state.imageData = '';
    if (!keepText) state.title = preset.title;
    setField('field-primary', state.primary);
    setField('field-secondary', state.secondary);
    setField('field-text', state.text);
    setField('field-title-color', state.titleColor);
    if (!keepText) setField('field-title', state.title);
    updateTemplateSelection();
    applyCreator();
    hydratePosterAssets();
  }

  function posterFilename(format) {
    const commerce = (state.commerce || 'fidelopass')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/gi, '-')
      .replace(/^-+|-+$/g, '')
      .toLowerCase();
    return `affiche-${commerce || 'fidelopass'}-${format}.pdf`;
  }

  function setExportButtonsBusy(isBusy) {
    const buttons = [$('download-pdf-top'), ...Array.from(document.querySelectorAll('[data-download-format]'))].filter(Boolean);
    buttons.forEach((button) => {
      if (!button.dataset.label) button.dataset.label = button.textContent.trim();
      button.disabled = isBusy;
      button.classList.toggle('is-exporting', isBusy);
      if (button.id === 'download-pdf-top') button.textContent = isBusy ? 'Préparation PDF...' : button.dataset.label;
    });
  }

  function svgToPngDataUrl(svgMarkup, width, height, pixelRatio = 2) {
    return new Promise((resolve, reject) => {
      const image = new Image();
      const blob = new Blob([svgMarkup], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      image.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(width * pixelRatio);
          canvas.height = Math.round(height * pixelRatio);
          const context = canvas.getContext('2d');
          context.fillStyle = state.primary || '#ffffff';
          context.fillRect(0, 0, canvas.width, canvas.height);
          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          URL.revokeObjectURL(url);
          resolve(canvas.toDataURL('image/png', 1));
        } catch (error) {
          URL.revokeObjectURL(url);
          reject(error);
        }
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('Impossible de rendre le SVG de l’affiche.'));
      };
      image.src = url;
    });
  }

  async function downloadPdf(format = state.format) {
    if (isExportingPdf) return;
    isExportingPdf = true;
    setExportButtonsBusy(true);
    state.format = format === 'a5' ? 'a5' : 'a4';
    applyCreator();
    try {
      await hydratePosterAssets();
      const size = exportSizes[state.format] || exportSizes.a4;
      const svgMarkup = renderPosterSvgMarkup();
      const pngData = await svgToPngDataUrl(svgMarkup, size.pixelWidth, size.pixelHeight, 2);
      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: size.jsPdfFormat, compress: true });
      pdf.addImage(pngData, 'PNG', 0, 0, size.pdfWidth, size.pdfHeight, undefined, 'FAST');
      pdf.save(posterFilename(state.format));
    } catch (error) {
      console.error('Poster PDF export failed', error);
      window.alert("Impossible de générer le PDF pour le moment. Vérifiez le logo puis réessayez.");
    } finally {
      isExportingPdf = false;
      setExportButtonsBusy(false);
    }
  }

  async function loadPoster() {
    try {
      const response = await fetchWithTimeout(apiUrl(`/api/cartes/${carteId}/public`));
      if (!response.ok) throw new Error();
      const { data } = await response.json();
      state.logo = data.carte.logo_url || data.commerce.logo_url || '';
      state.commerce = data.commerce.nom || 'Votre commerce';
      state.subtitle = data.carte.welcome_message || 'Ajoutez notre carte fidélité à votre téléphone';
      state.reward = rewardSummary(data);
      state.primary = data.carte.couleur_fond || state.primary;
      state.secondary = data.carte.couleur_accent || state.secondary;
      state.text = data.carte.couleur_texte || state.text;
      state.titleColor = data.carte.couleur_texte || state.titleColor;
      state.phone = data.commerce.telephone || '';
      state.instagram = data.commerce.instagram || '';
      state.address = data.commerce.adresse || '';
      state.title = templatePresets[state.template]?.title || state.title;
      const cardPaletteButton = $('card-palette-btn');
      if (cardPaletteButton) {
        cardPaletteButton.dataset.primary = state.primary;
        cardPaletteButton.dataset.secondary = state.secondary;
        cardPaletteButton.dataset.text = state.text;
        cardPaletteButton.dataset.title = state.titleColor;
        cardPaletteButton.querySelectorAll('span')[0].style.background = state.primary;
        cardPaletteButton.querySelectorAll('span')[1].style.background = state.secondary;
        cardPaletteButton.querySelectorAll('span')[2].style.background = state.text;
        cardPaletteButton.classList.remove('hidden');
      }
    } catch {
      // L'éditeur reste utilisable avec des valeurs par défaut si l'API publique est indisponible.
    } finally {
      syncFieldsFromState();
      await renderQrCode(carteId);
      $('poster-loading')?.classList.add('hidden');
      $('poster-stage')?.classList.remove('hidden');
      updateTemplateSelection();
      applyCreator();
      hydratePosterAssets();
    }
  }

  document.querySelectorAll('.template-card').forEach((button) => {
    button.addEventListener('click', () => selectTemplate(button.dataset.template || 'affiche', false));
  });
  document.querySelectorAll('.format-btn').forEach((button) => {
    button.addEventListener('click', () => {
      state.format = button.dataset.format === 'a5' ? 'a5' : 'a4';
      applyCreator();
    });
  });
  document.querySelectorAll('.palette-btn').forEach((button) => {
    button.addEventListener('click', () => {
      setField('field-primary', button.dataset.primary);
      setField('field-secondary', button.dataset.secondary);
      setField('field-text', button.dataset.text || state.text);
      setField('field-title-color', button.dataset.title || button.dataset.text || state.titleColor);
      document.querySelectorAll('.palette-btn').forEach((item) => item.classList.remove('is-selected'));
      button.classList.add('is-selected');
      applyCreator();
    });
  });
  ['field-commerce', 'field-title', 'field-subtitle', 'field-reward', 'field-phone', 'field-instagram', 'field-address', 'field-primary', 'field-secondary', 'field-text', 'field-title-color', 'field-font', 'field-title-font'].forEach((id) => {
    $(id)?.addEventListener('input', applyCreator);
    $(id)?.addEventListener('change', applyCreator);
  });
  $('poster-logo-upload')?.addEventListener('change', (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      state.logo = String(reader.result || '');
      state.logoData = state.logo;
      applyCreator();
    };
    reader.readAsDataURL(file);
  });
  document.querySelectorAll('[data-download-format]').forEach((button) => {
    button.addEventListener('click', () => downloadPdf(button.dataset.downloadFormat));
  });
  $('download-pdf-top')?.addEventListener('click', () => downloadPdf(state.format));
  $('mobile-editor-jump')?.addEventListener('click', () => $('poster-editor-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  $('mobile-preview-jump')?.addEventListener('click', () => $('poster-preview-area')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));

  loadPoster();
</script>
