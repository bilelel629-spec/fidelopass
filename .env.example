# =============================================
# FidéliPass — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Apple Wallet
APPLE_PASS_TYPE_ID=pass.com.votre-societe.fidelopass
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_P12_PASSWORD=ton_mot_de_passe
APPLE_WWDR_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_SIGNER_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_SIGNER_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Wallet
GOOGLE_SERVICE_ACCOUNT_PATH=./certs/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_ISSUER_ID=3388000000012345678

# Web Push natif (carte web / PWA)
# Générer avec: npx web-push generate-vapid-keys
PUBLIC_WEB_PUSH_VAPID_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contact@fidelopass.com

# App
APP_URL=http://localhost:4321
API_URL=http://localhost:3001
APPLE_WEB_SERVICE_URL=http://localhost:3001/api/wallet/apple
NODE_ENV=development
REGISTER_ACCESS_KEY=change_me_register_access_key
CORS_ALLOWED_ORIGINS=https://fidelopass.com,https://www.fidelopass.com,http://localhost:4321
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW_MS=300000

# Emails transactionnels (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@duo-agency.com
BREVO_SENDER_NAME=Fidelopass
BREVO_REPLY_TO_EMAIL=contact@duo-agency.com
# Fallback legacy Supabase Auth email, à garder désactivé en production pour éviter les templates blancs et l'adresse brevosend.
PUBLIC_ALLOW_SUPABASE_AUTH_FALLBACK=false

# Stripe
# Important: les Price IDs live et test sont différents.
# En production Railway, utiliser uniquement une clé sk_live_... et le webhook live.
# En live, l'app lit stripe-price-ids.json. En test local, elle lit stripe-price-ids.test.json.
# Génération live: STRIPE_SECRET_KEY=sk_live_... node scripts/setup-stripe.js --mode=live
# Génération test local: STRIPE_SECRET_KEY=sk_test_... node scripts/setup-stripe.js --mode=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Géolocalisation / autocomplétion d'adresse
# Optionnel mais recommandé. Sans clé, fallback OpenStreetMap/Nominatim.
GEOAPIFY_API_KEY=

# Super admin (emails séparés par virgule)
ADMIN_EMAILS=contact@duo-agency.com,admin@votre-domaine.com
