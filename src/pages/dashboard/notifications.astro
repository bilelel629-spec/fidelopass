---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Notifications push — Fidelopass" activeNav="notifications">
  <div class="notif-page space-y-6">
    <header class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="text-[0.7rem] font-extrabold uppercase tracking-[0.32em] text-blue-600">Communication client</p>
        <h1 class="mt-3 font-display text-4xl font-extrabold tracking-[-0.04em] text-slate-950 sm:text-5xl lg:text-6xl">Notifications push</h1>
        <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">Envoyez des offres ciblées directement dans Apple Wallet et Google Wallet.</p>
      </div>
      <div class="inline-flex w-fit items-center gap-3 rounded-full border border-slate-200 bg-white px-4 py-3 shadow-[0_18px_40px_-30px_rgba(15,23,42,0.45)]">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-50 text-blue-600">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        </span>
        <div>
          <p id="summary-wallet-badge" class="text-sm font-extrabold text-slate-950">— clients abonnés</p>
          <p class="text-xs font-medium text-slate-500">Wallet/push actifs</p>
        </div>
      </div>
    </header>

    <div class="notif-kpi-grid grid gap-3 sm:grid-cols-2" data-tour="notifications-summary">
      <article class="notif-kpi-card">
        <span class="notif-kpi-icon bg-blue-50 text-blue-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Clients abonnés</p>
          <div class="mt-1 flex items-end justify-between gap-3">
            <p id="summary-wallet" class="font-display text-3xl font-extrabold tracking-[-0.05em] text-slate-950">—</p>
            <p class="pb-1 text-xs font-medium text-slate-500">Wallet actifs</p>
          </div>
        </div>
      </article>
      <article class="notif-kpi-card">
        <span class="notif-kpi-icon bg-indigo-50 text-indigo-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3Z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path></svg></span>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Campagnes envoyées</p>
          <div class="mt-1 flex items-end justify-between gap-3">
            <p id="summary-history" class="font-display text-3xl font-extrabold tracking-[-0.05em] text-slate-950">—</p>
            <p class="pb-1 text-xs font-medium text-slate-500">Historique</p>
          </div>
        </div>
      </article>
    </div>

    <div class="rounded-[1.5rem] border border-slate-200 bg-white p-2 shadow-[0_18px_45px_-34px_rgba(15,23,42,0.35)]">
      <div class="grid gap-2 sm:grid-cols-3">
        <button type="button" data-tab="manual" class="notif-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Envoi manuel</button>
        <button type="button" data-tab="automation" class="notif-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Automatisations</button>
        <button type="button" data-tab="history" class="notif-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold transition">Historique</button>
      </div>
    </div>

    <section id="tab-manual" class="notif-panel space-y-6" data-tour="notifications-compose">
      <div class="grid gap-6 xl:grid-cols-[minmax(0,1.45fr)_minmax(22rem,0.65fr)]">
        <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)] sm:p-7">
          <div class="mb-6">
            <h2 class="font-display text-2xl font-extrabold tracking-[-0.03em] text-slate-950">Nouveau message client</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">Créez une notification visible directement sur l’écran verrouillé.</p>
          </div>
          <form id="notif-form" class="flex flex-col gap-5">
            <div>
              <label class="label" for="titre">Titre</label>
              <input id="titre" type="text" class="input" placeholder="Offre du week-end" maxlength="50" required />
            </div>
            <div>
              <label class="label" for="message">Message</label>
              <textarea id="message" class="input h-28 resize-none" placeholder="-20% ce samedi pour les membres fidélité." maxlength="150" required></textarea>
              <div class="mt-2 flex items-center justify-between gap-3 text-xs text-slate-500">
                <span id="message-validity" class="font-semibold text-emerald-600">Prêt à rédiger</span>
                <span><span id="char-count">0</span>/150</span>
              </div>
            </div>
            <div id="error-msg" class="hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
            <div id="success-msg" class="hidden rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"></div>
            <button type="submit" class="rounded-[1.1rem] bg-[linear-gradient(135deg,#2563EB_0%,#7C3AED_100%)] px-5 py-4 text-base font-extrabold text-white shadow-[0_20px_42px_-24px_rgba(37,99,235,0.95)] transition hover:-translate-y-0.5 hover:shadow-[0_28px_58px_-28px_rgba(124,58,237,0.95)]">Envoyer la notification</button>
            <p id="send-helper" class="text-center text-xs font-medium text-slate-500">Envoi instantané aux clients abonnés.</p>
          </form>
        </div>

        <aside class="space-y-5">
          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)]">
            <h2 class="font-display text-xl font-extrabold text-slate-950">Aperçu</h2>
            <div class="mx-auto mt-5 max-w-[18rem] rounded-[2.2rem] bg-slate-950 p-3 shadow-[0_28px_60px_-34px_rgba(15,23,42,0.75)]">
              <div class="overflow-hidden rounded-[1.75rem] bg-[linear-gradient(160deg,#dbeafe_0%,#ffffff_46%,#c7d2fe_100%)] p-4">
                <div class="flex items-center justify-between text-xs font-extrabold text-slate-950"><span>9:41</span><span>5G</span></div>
                <div class="mt-14 rounded-[1.35rem] bg-white/88 p-3 shadow-[0_16px_38px_-26px_rgba(15,23,42,0.7)] backdrop-blur">
                  <div class="flex gap-3">
                    <div id="push-icon-preview-manual" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/70 shadow-inner"><span class="text-sm font-extrabold text-white">F</span></div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between gap-2"><p class="truncate text-xs font-extrabold text-slate-950">FideloPass</p><span class="text-[0.66rem] text-slate-400">maintenant</span></div>
                      <p id="preview-title" class="mt-1 text-sm font-extrabold text-slate-950">Offre du week-end</p>
                      <p id="preview-message" class="mt-0.5 text-xs leading-5 text-slate-600">-20% ce samedi pour les membres fidélité.</p>
                    </div>
                  </div>
                </div>
                <div class="mt-24 h-1.5 w-24 rounded-full bg-slate-950/70 mx-auto"></div>
              </div>
            </div>
          </div>
          <div class="rounded-[1.5rem] border border-blue-100 bg-blue-50/55 p-5">
            <div class="mb-3 flex items-start justify-between gap-3">
              <div>
                <h3 class="font-extrabold text-slate-950">Fond du logo</h3>
                <p class="mt-1 text-xs leading-5 text-slate-500">Utilisé par Wallet à l'installation de la carte. iOS peut garder l'ancienne icône en cache.</p>
              </div>
            </div>
            <div id="push-icon-error-manual" class="mb-2 hidden rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700"></div>
            <div id="push-icon-success-manual" class="mb-2 hidden rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700"></div>
            <div class="mb-3 grid grid-cols-2 gap-2 rounded-2xl border border-blue-100 bg-white/75 p-1">
              <button type="button" class="push-icon-mode-btn rounded-xl px-3 py-2 text-xs font-extrabold transition" data-push-icon-mode="auto">Automatique</button>
              <button type="button" class="push-icon-mode-btn rounded-xl px-3 py-2 text-xs font-extrabold transition" data-push-icon-mode="custom">Personnalisée</button>
            </div>
            <label class="label" for="push-icon-bg-color-manual">Couleur du fond</label>
            <input id="push-icon-bg-color-manual" type="color" value="#6366f1" class="h-11 w-full cursor-pointer rounded-xl border border-slate-200 bg-white" />
            <p id="push-icon-status-manual" class="mt-2 text-xs text-slate-500">Chargement du réglage...</p>
            <p class="mt-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-800">Sur iPhone, ce fond peut ne changer qu'après redémarrage pour les cartes déjà installées. Les nouvelles cartes utiliseront la bonne couleur.</p>
          </div>
        </aside>
      </div>

      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-48px_rgba(15,23,42,0.45)] sm:p-6">
        <h2 class="font-display text-2xl font-extrabold text-slate-950">Idées rapides</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          <button type="button" class="quick-idea" data-title="Offre du week-end" data-message="-20% ce samedi pour les membres fidélité."><span>Offre du week-end</span><small>Promotion simple et immédiate.</small></button>
          <button type="button" class="quick-idea" data-title="Nouveau produit" data-message="Une nouveauté vous attend en boutique cette semaine."><span>Nouveau produit</span><small>Annonce courte et claire.</small></button>
          <button type="button" class="quick-idea" data-title="Récompense débloquée" data-message="Votre récompense fidélité est disponible sur votre carte."><span>Récompense débloquée</span><small>Incite au retour en caisse.</small></button>
          <button type="button" class="quick-idea" data-title="Joyeux anniversaire" data-message="Votre bonus anniversaire est disponible aujourd’hui."><span>Joyeux anniversaire</span><small>Message personnel.</small></button>
          <button type="button" class="quick-idea" data-title="Votre avis compte" data-message="Vous avez aimé votre visite ? Laissez-nous un avis Google, cela nous aide énormément."><span>Avis Google</span><small>Demander un avis après une bonne expérience.</small></button>
          <button type="button" class="quick-idea" data-title="Dernière chance" data-message="Dernier jour pour profiter de votre avantage fidélité."><span>Dernière chance</span><small>Créer une urgence mesurée.</small></button>
          <button type="button" class="quick-idea" data-title="On vous attend" data-message="Votre carte fidélité vous attend, passez nous voir cette semaine."><span>Client inactif</span><small>Relance douce.</small></button>
        </div>
      </div>
    </section>

    <section id="tab-automation" class="notif-panel hidden space-y-5">
      <div class="grid gap-5 xl:grid-cols-2">
        <div class="automation-card border-sky-100 bg-sky-50/50">
          <div class="flex items-start justify-between gap-3"><div><h2 class="font-display text-xl font-extrabold text-slate-950">Avis Google automatique</h2><p class="mt-1 text-sm leading-6 text-slate-500">Push envoyé 60 minutes après l’installation de la carte.</p></div><span class="pro-pill">Pro</span></div>
          <div class="mt-4 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">Plan actuel: <span id="review-auto-plan-value" class="font-semibold text-slate-900">Chargement...</span></div>
          <div id="review-auto-locked" class="mt-4 hidden rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">Cette fonctionnalité est réservée au plan Pro.</div>
          <div id="review-auto-error" class="mt-3 hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
          <div id="review-auto-success" class="mt-3 hidden rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"></div>
          <div class="mt-4 flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3"><div><p class="text-sm font-bold text-slate-900">Activer l’automatisation</p><p class="mt-0.5 text-xs text-slate-500">Utilise le lien Google Maps du point de vente actif.</p></div><button id="review-auto-toggle" type="button" class="relative h-7 w-14 flex-shrink-0 rounded-full transition-colors" style="background:#334155" aria-pressed="false"><span id="review-auto-knob" class="absolute top-1 h-5 w-5 rounded-full bg-white shadow transition-all" style="left:2px"></span></button></div>
          <p id="review-auto-status" class="mt-3 text-center text-xs text-slate-500">Chargement du statut...</p>
        </div>

        <div class="automation-card border-pink-100 bg-pink-50/50">
          <div class="flex items-start justify-between gap-3"><div><h2 class="font-display text-xl font-extrabold text-slate-950">Joyeux anniversaire</h2><p class="mt-1 text-sm leading-6 text-slate-500">Push anniversaire + bonus automatique sur la carte client.</p></div><span class="pro-pill">Pro</span></div>
          <div class="mt-4 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">Plan actuel: <span id="birthday-plan-value" class="font-semibold text-slate-900">Chargement...</span></div>
          <div id="birthday-locked" class="mt-4 hidden rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">Cette fonctionnalité est réservée au plan Pro.</div>
          <div id="birthday-error" class="mt-3 hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
          <div id="birthday-success" class="mt-3 hidden rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"></div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2"><div><label class="label" for="birthday-reward-value">Bonus anniversaire</label><input id="birthday-reward-value" type="number" min="1" max="50" value="1" class="input" /></div><div><label class="label" for="birthday-title">Titre du push</label><input id="birthday-title" type="text" maxlength="80" class="input" placeholder="Joyeux anniversaire" /></div></div>
          <div class="mt-3"><label class="label" for="birthday-message">Message du push</label><textarea id="birthday-message" maxlength="180" class="input h-24 resize-none" placeholder="Votre bonus anniversaire est disponible sur votre carte Fidelopass."></textarea></div>
          <div class="mt-4 flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3"><div><p class="text-sm font-bold text-slate-900">Activer l’automatisation anniversaire</p><p class="mt-0.5 text-xs text-slate-500">Exécution Europe/Paris à 10h.</p></div><button id="birthday-toggle" type="button" class="relative h-7 w-14 flex-shrink-0 rounded-full transition-colors" style="background:#334155" aria-pressed="false"><span id="birthday-knob" class="absolute top-1 h-5 w-5 rounded-full bg-white shadow transition-all" style="left:2px"></span></button></div>
          <button id="birthday-save-btn" type="button" class="mt-4 w-full rounded-2xl border border-pink-200 bg-white px-4 py-3 text-sm font-extrabold text-pink-700 transition hover:-translate-y-0.5 hover:bg-pink-50">Enregistrer le réglage anniversaire</button>
          <p id="birthday-status" class="mt-3 text-center text-xs text-slate-500">Chargement du statut...</p>
        </div>
      </div>

      <div class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-[0_20px_60px_-48px_rgba(15,23,42,0.45)]">
        <div class="mb-4 flex items-start justify-between gap-3"><div><h2 class="font-display text-xl font-extrabold text-slate-950">Fond du logo Wallet</h2><p class="mt-1 text-sm leading-6 text-slate-500">Couleur utilisée derrière le logo dans l'icône Wallet. Les cartes déjà installées peuvent garder l'ancienne icône en cache iOS.</p></div><div id="push-icon-preview" class="h-12 w-12 rounded-xl border border-slate-200 shadow-inner"></div></div>
        <div id="push-icon-error" class="mb-3 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
        <div id="push-icon-success" class="mb-3 hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"></div>
        <div class="mb-4 grid grid-cols-2 gap-2 rounded-2xl border border-blue-100 bg-blue-50/60 p-1">
          <button type="button" class="push-icon-mode-btn rounded-xl px-3 py-2 text-sm font-extrabold transition" data-push-icon-mode="auto">Automatique</button>
          <button type="button" class="push-icon-mode-btn rounded-xl px-3 py-2 text-sm font-extrabold transition" data-push-icon-mode="custom">Personnalisée</button>
        </div>
        <label class="label" for="push-icon-bg-color">Couleur du fond</label>
        <input id="push-icon-bg-color" type="color" value="#6366f1" class="h-11 w-full cursor-pointer rounded-xl border border-slate-200 bg-white" />
        <p id="push-icon-status" class="mt-2 text-xs text-slate-500">Chargement du réglage...</p>
        <p class="mt-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-800">En automatique, les nouvelles cartes suivent la couleur de fond. Sur iPhone, Apple Wallet peut conserver l'ancienne icône des cartes déjà installées jusqu'au redémarrage du téléphone.</p>
      </div>
    </section>

    <section id="tab-history" class="notif-panel hidden rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_24px_70px_-48px_rgba(15,23,42,0.5)] sm:p-7">
      <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"><div><h2 class="font-display text-2xl font-extrabold text-slate-950">Historique</h2><p class="mt-1 text-sm text-slate-500">Campagnes envoyées sur le point de vente actif.</p></div></div>
      <div id="notif-history" class="overflow-hidden rounded-2xl border border-slate-200"><p class="p-4 text-sm text-slate-500">Chargement...</p></div>
    </section>
  </div>
</DashboardLayout>

<style>
  .notif-page {
    animation: notif-fade-up 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .notif-kpi-card {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    border: 1px solid rgb(226 232 240);
    border-radius: 1.25rem;
    background: #fff;
    padding: 1rem;
    box-shadow: 0 24px 70px -52px rgba(15, 23, 42, 0.55);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .notif-kpi-card:hover,
  .automation-card:hover,
  .quick-idea:hover {
    transform: translateY(-2px);
    box-shadow: 0 30px 75px -52px rgba(37, 99, 235, 0.52);
    border-color: rgb(191 219 254);
  }

  .notif-kpi-icon {
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
  }

  .notif-kpi-icon svg {
    height: 1.25rem;
    width: 1.25rem;
  }

  .quick-idea {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid rgb(226 232 240);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #fff 0%, #f8fbff 100%);
    padding: 1rem;
    text-align: left;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .quick-idea span {
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
  }

  .quick-idea small {
    font-size: 0.75rem;
    line-height: 1.45;
    color: #64748b;
  }

  .automation-card {
    border-width: 1px;
    border-style: solid;
    border-radius: 1.6rem;
    padding: 1.5rem;
    box-shadow: 0 22px 64px -52px rgba(15, 23, 42, 0.5);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .pro-pill {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid rgb(253 230 138);
    background: rgb(254 243 199);
    padding: 0.35rem 0.65rem;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(180 83 9);
  }

  @keyframes notif-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .notif-page {
      gap: 1rem;
    }

    .notif-page header h1 {
      margin-top: 0.55rem;
      font-size: 2.15rem;
      line-height: 1;
    }

    .notif-page header p:last-child {
      margin-top: 0.75rem;
      font-size: 0.94rem;
      line-height: 1.65;
    }

    .notif-kpi-card {
      display: grid;
      grid-template-columns: 2.6rem 1fr auto;
      align-items: center;
      gap: 0.75rem;
      padding: 0.95rem;
      border-radius: 1.15rem;
    }

    .notif-kpi-card .notif-kpi-icon {
      height: 2.6rem;
      width: 2.6rem;
    }

    .notif-kpi-card p {
      margin: 0;
    }

    .notif-kpi-card p:nth-of-type(2) {
      grid-column: 3;
      grid-row: 1 / span 2;
      font-size: 1.8rem;
    }

    .notif-tab {
      padding-block: 0.8rem !important;
      font-size: 0.78rem !important;
    }

    #tab-manual > div:first-child > aside {
      display: grid;
      gap: 1rem;
    }

    #tab-manual > div:first-child > aside > div:first-child {
      order: 2;
    }

    #tab-manual > div:first-child > aside > div:first-child .mx-auto {
      max-width: 14.5rem;
    }

    .quick-idea {
      min-width: 13rem;
    }

    .quick-idea span {
      font-size: 0.86rem;
    }

    #tab-manual .mt-5.grid:has(.quick-idea) {
      display: flex;
      overflow-x: auto;
      padding-bottom: 0.35rem;
      scroll-snap-type: x proximity;
    }

    #tab-manual .mt-5.grid:has(.quick-idea) .quick-idea {
      scroll-snap-align: start;
    }

    .automation-card {
      padding: 1rem;
      border-radius: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notif-page,
    .notif-kpi-card,
    .automation-card,
    .quick-idea {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { ACTIVE_POINT_VENTE_STORAGE_KEY, authFetch } from '../../lib/api';
  import { isProPlan, normalizePlan } from '../../lib/dashboard-config';

  function escapeHtml(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char] ?? char));
  }

  function setNotifTab(tab: 'manual' | 'automation' | 'history') {
    document.querySelectorAll<HTMLElement>('.notif-panel').forEach((panel) => panel.classList.add('hidden'));
    document.getElementById(`tab-${tab}`)?.classList.remove('hidden');

    document.querySelectorAll<HTMLElement>('.notif-tab').forEach((btn) => {
      const active = btn.dataset.tab === tab;
      btn.className = active
        ? 'notif-tab rounded-[1.1rem] bg-[linear-gradient(135deg,#2563EB_0%,#7C3AED_100%)] px-4 py-4 text-sm font-extrabold text-white shadow-[0_16px_34px_-22px_rgba(37,99,235,0.95)] transition'
        : 'notif-tab rounded-[1.1rem] px-4 py-4 text-sm font-extrabold text-slate-600 transition hover:bg-slate-50';
    });
  }

  document.querySelectorAll<HTMLElement>('.notif-tab').forEach((btn) => {
    btn.addEventListener('click', () => setNotifTab((btn.dataset.tab as 'manual' | 'automation' | 'history') ?? 'manual'));
  });

  const messageInput = document.getElementById('message') as HTMLTextAreaElement;
  const titleInput = document.getElementById('titre') as HTMLInputElement;
  const charCount = document.getElementById('char-count') as HTMLSpanElement;
  const messageValidity = document.getElementById('message-validity') as HTMLSpanElement | null;
  const previewTitle = document.getElementById('preview-title');
  const previewMessage = document.getElementById('preview-message');
  const sendHelper = document.getElementById('send-helper');
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const form = document.getElementById('notif-form') as HTMLFormElement;

  function syncMessagePreview() {
    charCount.textContent = String(messageInput.value.length);
    if (previewTitle) previewTitle.textContent = titleInput.value.trim() || 'Offre du week-end';
    if (previewMessage) previewMessage.textContent = messageInput.value.trim() || '-20% ce samedi pour les membres fidélité.';
    if (messageValidity) {
      const hasContent = titleInput.value.trim().length > 0 && messageInput.value.trim().length > 0;
      messageValidity.textContent = hasContent ? 'Message prêt' : 'Prêt à rédiger';
      messageValidity.className = hasContent ? 'font-semibold text-emerald-600' : 'font-semibold text-slate-400';
    }
  }

  messageInput.addEventListener('input', syncMessagePreview);
  titleInput.addEventListener('input', syncMessagePreview);

  document.querySelectorAll<HTMLButtonElement>('.quick-idea').forEach((button) => {
    button.addEventListener('click', () => {
      titleInput.value = button.dataset.title ?? '';
      messageInput.value = button.dataset.message ?? '';
      syncMessagePreview();
      titleInput.focus();
    });
  });

  let summaryWallet = 0;
  let summaryHistory = 0;
  let reviewAutoEnabled = false;
  let reviewAutoIsPro = false;
  let birthdayEnabled = false;
  let birthdayIsPro = false;

  const reviewAutoToggle = document.getElementById('review-auto-toggle') as HTMLButtonElement;
  const reviewAutoKnob = document.getElementById('review-auto-knob') as HTMLSpanElement;
  const reviewAutoStatus = document.getElementById('review-auto-status') as HTMLParagraphElement;
  const reviewAutoPlanValue = document.getElementById('review-auto-plan-value') as HTMLSpanElement;
  const reviewAutoLocked = document.getElementById('review-auto-locked') as HTMLDivElement;
  const reviewAutoError = document.getElementById('review-auto-error') as HTMLDivElement;
  const reviewAutoSuccess = document.getElementById('review-auto-success') as HTMLDivElement;

  const birthdayToggle = document.getElementById('birthday-toggle') as HTMLButtonElement;
  const birthdayKnob = document.getElementById('birthday-knob') as HTMLSpanElement;
  const birthdayStatus = document.getElementById('birthday-status') as HTMLParagraphElement;
  const birthdayPlanValue = document.getElementById('birthday-plan-value') as HTMLSpanElement;
  const birthdayLocked = document.getElementById('birthday-locked') as HTMLDivElement;
  const birthdayError = document.getElementById('birthday-error') as HTMLDivElement;
  const birthdaySuccess = document.getElementById('birthday-success') as HTMLDivElement;
  const birthdayRewardValue = document.getElementById('birthday-reward-value') as HTMLInputElement;
  const birthdayTitle = document.getElementById('birthday-title') as HTMLInputElement;
  const birthdayMessage = document.getElementById('birthday-message') as HTMLTextAreaElement;
  const birthdaySaveBtn = document.getElementById('birthday-save-btn') as HTMLButtonElement;
  const pushIconColorInput = document.getElementById('push-icon-bg-color') as HTMLInputElement;
  const pushIconColorInputManual = document.getElementById('push-icon-bg-color-manual') as HTMLInputElement | null;
  const pushIconPreview = document.getElementById('push-icon-preview') as HTMLDivElement;
  const pushIconPreviewManual = document.getElementById('push-icon-preview-manual') as HTMLDivElement | null;
  const pushIconStatus = document.getElementById('push-icon-status') as HTMLParagraphElement;
  const pushIconStatusManual = document.getElementById('push-icon-status-manual') as HTMLParagraphElement | null;
  const pushIconError = document.getElementById('push-icon-error') as HTMLDivElement;
  const pushIconErrorManual = document.getElementById('push-icon-error-manual') as HTMLDivElement | null;
  const pushIconSuccess = document.getElementById('push-icon-success') as HTMLDivElement;
  const pushIconSuccessManual = document.getElementById('push-icon-success-manual') as HTMLDivElement | null;
  const pushIconInputs = [pushIconColorInput, pushIconColorInputManual].filter(Boolean) as HTMLInputElement[];
  const pushIconPreviews = [pushIconPreview, pushIconPreviewManual].filter(Boolean) as HTMLDivElement[];
  const pushIconStatuses = [pushIconStatus, pushIconStatusManual].filter(Boolean) as HTMLParagraphElement[];
  const pushIconErrors = [pushIconError, pushIconErrorManual].filter(Boolean) as HTMLDivElement[];
  const pushIconSuccesses = [pushIconSuccess, pushIconSuccessManual].filter(Boolean) as HTMLDivElement[];
  const pushIconModeButtons = Array.from(document.querySelectorAll('.push-icon-mode-btn')) as HTMLButtonElement[];
  let cachedPlan: string = 'starter';
  let pushIconSaveTimer: ReturnType<typeof setTimeout> | null = null;
  let pushIconLastSavedColor: string | null = null;
  let pushIconMode: 'auto' | 'custom' = 'auto';
  let pushIconCardColor = '#6366f1';
  let pushIconPendingColor: string | null | undefined;
  let pushIconSavePromise: Promise<void> | null = null;
  let pushIconLastSaveError: Error | null = null;

  function withPointVente(path: string): string {
    if (typeof window === 'undefined') return path;
    try {
      const pointVenteId = window.localStorage.getItem(ACTIVE_POINT_VENTE_STORAGE_KEY)?.trim() ?? '';
      if (!pointVenteId) return path;
      const separator = path.includes('?') ? '&' : '?';
      return `${path}${separator}point_vente_id=${encodeURIComponent(pointVenteId)}`;
    } catch {
      return path;
    }
  }

  function setReviewPlanLabel(planRaw: unknown) {
    const normalized = normalizePlan(planRaw);
    if (normalized.includes('sur-mesure') || normalized.includes('surmesure') || normalized.includes('custom') || normalized.includes('enterprise')) {
      reviewAutoPlanValue.textContent = 'Sur mesure';
      return;
    }
    reviewAutoPlanValue.textContent = isProPlan(normalized) ? 'Pro' : 'Starter';
  }

  function setReviewToggle(enabled: boolean) {
    reviewAutoEnabled = enabled;
    reviewAutoToggle.style.background = enabled ? '#4f46e5' : '#334155';
    reviewAutoKnob.style.left = enabled ? '26px' : '2px';
    reviewAutoToggle.setAttribute('aria-pressed', String(enabled));
    reviewAutoStatus.textContent = enabled ? 'Automatisation active.' : 'Automatisation inactive.';
  }

  function setBirthdayPlanLabel(planRaw: unknown) {
    const normalized = normalizePlan(planRaw);
    if (normalized.includes('sur-mesure') || normalized.includes('surmesure') || normalized.includes('custom') || normalized.includes('enterprise')) {
      birthdayPlanValue.textContent = 'Sur mesure';
      return;
    }
    birthdayPlanValue.textContent = isProPlan(normalized) ? 'Pro' : 'Starter';
  }

  function setBirthdayToggle(enabled: boolean) {
    birthdayEnabled = enabled;
    birthdayToggle.style.background = enabled ? '#4f46e5' : '#334155';
    birthdayKnob.style.left = enabled ? '26px' : '2px';
    birthdayToggle.setAttribute('aria-pressed', String(enabled));
    birthdayStatus.textContent = enabled ? 'Automatisation active.' : 'Automatisation inactive.';
  }

  function setBirthdayFormDisabled(disabled: boolean) {
    birthdayToggle.disabled = disabled;
    birthdayRewardValue.disabled = disabled;
    birthdayTitle.disabled = disabled;
    birthdayMessage.disabled = disabled;
    birthdaySaveBtn.disabled = disabled;
    birthdayToggle.classList.toggle('opacity-40', disabled);
    birthdayToggle.classList.toggle('cursor-not-allowed', disabled);
    birthdaySaveBtn.classList.toggle('opacity-40', disabled);
    birthdaySaveBtn.classList.toggle('cursor-not-allowed', disabled);
  }

  function syncPushIconInputs(color: string, source?: HTMLInputElement) {
    pushIconInputs.forEach((input) => {
      if (source && input === source) return;
      input.value = color;
    });
  }

  function updatePushIconPreview(color: string) {
    pushIconPreviews.forEach((preview) => {
      preview.style.background = color;
    });
  }

  function setPushIconMode(mode: 'auto' | 'custom', color?: string) {
    pushIconMode = mode;
    const effectiveColor = color ?? (mode === 'auto' ? pushIconCardColor : (pushIconInputs[0]?.value ?? pushIconCardColor));
    syncPushIconInputs(effectiveColor);
    updatePushIconPreview(effectiveColor);
    pushIconInputs.forEach((input) => {
      input.disabled = mode === 'auto';
      input.classList.toggle('opacity-60', mode === 'auto');
      input.classList.toggle('cursor-not-allowed', mode === 'auto');
    });
    pushIconModeButtons.forEach((button) => {
      const active = button.dataset.pushIconMode === mode;
      button.classList.toggle('bg-white', active);
      button.classList.toggle('text-blue-700', active);
      button.classList.toggle('shadow-sm', active);
      button.classList.toggle('text-slate-500', !active);
    });
  }

  function setPushIconStatusText(text: string) {
    pushIconStatuses.forEach((status) => { status.textContent = text; });
  }

  function setPushIconInputsDisabled(disabled: boolean) {
    pushIconInputs.forEach((input) => { input.disabled = disabled || pushIconMode === 'auto'; });
    pushIconModeButtons.forEach((button) => { button.disabled = disabled; });
  }

  function hidePushIconAlerts() {
    pushIconErrors.forEach((el) => el.classList.add('hidden'));
    pushIconSuccesses.forEach((el) => el.classList.add('hidden'));
  }

  function showPushIconError(text: string) {
    pushIconErrors.forEach((el) => {
      el.textContent = text;
      el.classList.remove('hidden');
    });
  }

  function showPushIconSuccess(text: string) {
    pushIconSuccesses.forEach((el) => {
      el.textContent = text;
      el.classList.remove('hidden');
    });
  }

  async function loadPlanFallback() {
    try {
      const res = await authFetch(withPointVente('/api/dashboard/plan'));
      const payload = await res.json().catch(() => null);
      if (!res.ok) return;
      cachedPlan = String(payload?.data?.plan ?? payload?.data?.raw_plan ?? 'starter');
    } catch {
      cachedPlan = 'starter';
    }
  }

  async function loadSummary() {
    try {
      const [summaryRes, historyRes] = await Promise.all([
        authFetch(withPointVente('/api/notifications/summary')),
        authFetch(withPointVente('/api/notifications?limit=50')),
      ]);
      const summaryPayload = await summaryRes.json().catch(() => null);
      const historyPayload = await historyRes.json().catch(() => null);

      summaryWallet = summaryPayload?.data?.wallet_ready ?? 0;
      summaryHistory = Array.isArray(historyPayload?.data) ? historyPayload.data.length : 0;

      document.getElementById('summary-wallet')!.textContent = String(summaryWallet);
      document.getElementById('summary-history')!.textContent = String(summaryHistory);
      document.getElementById('summary-wallet-badge')!.textContent = `${summaryWallet} client${summaryWallet > 1 ? 's' : ''} abonné${summaryWallet > 1 ? 's' : ''}`;
      if (sendHelper) {
        sendHelper.textContent = `Envoi instantané à ${summaryWallet} client${summaryWallet > 1 ? 's' : ''} abonné${summaryWallet > 1 ? 's' : ''}.`;
      }
    } catch {
      document.getElementById('summary-wallet')!.textContent = '—';
      document.getElementById('summary-history')!.textContent = '—';
      document.getElementById('summary-wallet-badge')!.textContent = '— clients abonnés';
    }
  }

  async function loadHistory() {
    const container = document.getElementById('notif-history')!;
    try {
      const res = await authFetch(withPointVente('/api/notifications?limit=20'));
      if (!res.ok) throw new Error();
      const { data } = await res.json();

      if (!data?.length) {
        container.innerHTML = '<p class="p-4 text-sm text-slate-500">Aucune notification envoyée.</p>';
        return;
      }

      container.innerHTML = `
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-4 py-3 text-xs font-extrabold uppercase tracking-[0.18em] text-slate-500">Date</th>
                <th class="px-4 py-3 text-xs font-extrabold uppercase tracking-[0.18em] text-slate-500">Titre</th>
                <th class="px-4 py-3 text-xs font-extrabold uppercase tracking-[0.18em] text-slate-500">Audience</th>
                <th class="px-4 py-3 text-xs font-extrabold uppercase tracking-[0.18em] text-slate-500">Statut</th>
                <th class="px-4 py-3 text-xs font-extrabold uppercase tracking-[0.18em] text-slate-500">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              ${data.map((n: { titre: string; message: string; nb_destinataires: number; nb_delivrees: number | null; created_at: string }) => `
                <tr class="transition hover:bg-slate-50/70">
                  <td class="whitespace-nowrap px-4 py-4 text-xs font-medium text-slate-500">${new Date(n.created_at).toLocaleDateString('fr-FR')}</td>
                  <td class="px-4 py-4">
                    <p class="font-bold text-slate-950">${escapeHtml(n.titre)}</p>
                    <p class="mt-1 max-w-md truncate text-xs text-slate-500">${escapeHtml(n.message)}</p>
                  </td>
                  <td class="whitespace-nowrap px-4 py-4 text-slate-600">${n.nb_destinataires} client(s)</td>
                  <td class="whitespace-nowrap px-4 py-4">
                    <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Envoyée</span>
                  </td>
                  <td class="whitespace-nowrap px-4 py-4">
                    <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">${n.nb_delivrees ?? 0}/${n.nb_destinataires}</span>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
    } catch {
      container.innerHTML = '<p class="p-4 text-sm text-red-600">Erreur lors du chargement.</p>';
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi en cours...';

    try {
      if (pushIconSaveTimer) {
        clearTimeout(pushIconSaveTimer);
        pushIconSaveTimer = null;
      }
      if (pushIconMode === 'custom') {
        await savePushIconColorNow(pushIconInputs[0]?.value ?? '#6366f1', { throwOnError: true });
      } else if (pushIconSavePromise) {
        await pushIconSavePromise;
        if (pushIconLastSaveError) throw pushIconLastSaveError;
      }

      const titre = (document.getElementById('titre') as HTMLInputElement).value.trim();
      const message = messageInput.value.trim();
      const pushIconColorPayload = pushIconMode === 'custom'
        ? (pushIconInputs[0]?.value ?? '#6366f1')
        : null;
      const res = await authFetch(withPointVente('/api/notifications'), {
        method: 'POST',
        body: JSON.stringify({ titre, message, push_icon_bg_color: pushIconColorPayload }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error ?? 'Erreur lors de l’envoi.');

      successMsg.textContent = data?.nb_destinataires === 0
        ? 'Aucun client joignable pour le moment.'
        : `Message envoyé à ${data?.nb_delivrees ?? 0}/${data?.nb_destinataires ?? 0} client(s).`;
      successMsg.classList.remove('hidden');
      form.reset();
      syncMessagePreview();
      await Promise.all([loadSummary(), loadHistory()]);
    } catch (error: unknown) {
      errorMsg.textContent = error instanceof Error ? error.message : 'Erreur réseau.';
      errorMsg.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Envoyer la notification';
    }
  });

  async function loadReviewAutoSettings() {
    try {
      const res = await authFetch(withPointVente('/api/notifications/review-reminder-settings'));
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible de charger le réglage.');

      reviewAutoIsPro = Boolean(payload?.data?.is_pro) || isProPlan(payload?.data?.plan ?? payload?.data?.raw_plan);
      setReviewPlanLabel(payload?.data?.plan);
      setReviewToggle(Boolean(payload?.data?.enabled));

      if (!reviewAutoIsPro) {
        reviewAutoLocked.classList.remove('hidden');
        reviewAutoToggle.disabled = true;
        reviewAutoToggle.classList.add('opacity-40', 'cursor-not-allowed');
      } else {
        reviewAutoLocked.classList.add('hidden');
        reviewAutoToggle.disabled = false;
        reviewAutoToggle.classList.remove('opacity-40', 'cursor-not-allowed');
      }
    } catch {
      setReviewPlanLabel('starter');
      setReviewToggle(false);
      reviewAutoToggle.disabled = true;
      reviewAutoLocked.classList.remove('hidden');
      reviewAutoStatus.textContent = 'Impossible de charger le statut pour le moment.';
    }
  }

  reviewAutoToggle.addEventListener('click', async () => {
    if (!reviewAutoIsPro) return;
    reviewAutoError.classList.add('hidden');
    reviewAutoSuccess.classList.add('hidden');
    reviewAutoToggle.disabled = true;

    try {
      const nextValue = !reviewAutoEnabled;
      const res = await authFetch(withPointVente('/api/notifications/review-reminder-settings'), {
        method: 'PATCH',
        body: JSON.stringify({ enabled: nextValue }),
      });
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible de mettre à jour le réglage.');
      setReviewToggle(nextValue);
      reviewAutoSuccess.textContent = nextValue ? 'Automatisation activée.' : 'Automatisation désactivée.';
      reviewAutoSuccess.classList.remove('hidden');
    } catch (error: unknown) {
      reviewAutoError.textContent = error instanceof Error ? error.message : 'Erreur réseau.';
      reviewAutoError.classList.remove('hidden');
    } finally {
      reviewAutoToggle.disabled = false;
    }
  });

  async function loadBirthdaySettings() {
    try {
      const res = await authFetch(withPointVente('/api/notifications/birthday-settings'));
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible de charger le réglage anniversaire.');

      birthdayIsPro = Boolean(payload?.data?.is_pro) || isProPlan(payload?.data?.plan ?? payload?.data?.raw_plan);
      setBirthdayPlanLabel(payload?.data?.plan);
      setBirthdayToggle(Boolean(payload?.data?.enabled));
      birthdayRewardValue.value = String(payload?.data?.reward_value ?? 1);
      birthdayTitle.value = String(payload?.data?.push_title ?? '');
      birthdayMessage.value = String(payload?.data?.push_message ?? '');

      if (!payload?.data?.has_active_card) {
        setBirthdayFormDisabled(true);
        birthdayStatus.textContent = 'Aucune carte active sur ce point de vente.';
        return;
      }

      if (!birthdayIsPro) {
        birthdayLocked.classList.remove('hidden');
        setBirthdayFormDisabled(true);
      } else {
        birthdayLocked.classList.add('hidden');
        setBirthdayFormDisabled(false);
      }
    } catch {
      setBirthdayPlanLabel(cachedPlan);
      setBirthdayToggle(false);
      birthdayLocked.classList.remove('hidden');
      setBirthdayFormDisabled(true);
      birthdayStatus.textContent = 'Impossible de charger le statut pour le moment.';
    }
  }

  async function loadPushIconSettings() {
    hidePushIconAlerts();
    try {
      const res = await authFetch(withPointVente('/api/notifications/push-icon-settings'));
      const payload = await res.json().catch(() => null);
      if (!res.ok) throw new Error(payload?.error ?? 'Impossible de charger le réglage.');
      const color = String(payload?.data?.push_icon_bg_color ?? payload?.data?.couleur_fond ?? '#6366f1');
      pushIconCardColor = String(payload?.data?.couleur_fond ?? color);
      const mode = payload?.data?.mode === 'custom' ? 'custom' : 'auto';
      pushIconLastSavedColor = mode === 'custom'
        ? String(payload?.data?.stored_push_icon_bg_color ?? color)
        : null;
      setPushIconMode(mode, color);
      setPushIconStatusText(payload?.data?.has_active_card
        ? (mode === 'auto'
          ? 'Mode automatique: les nouvelles cartes suivent le fond de votre carte.'
          : 'Couleur personnalisée enregistrée. Les cartes déjà installées peuvent garder l’ancienne icône en cache iOS.')
        : 'Aucune carte active sur ce point de vente.');
      setPushIconInputsDisabled(!payload?.data?.has_active_card);
    } catch (error: unknown) {
      setPushIconStatusText('Impossible de charger le réglage.');
      setPushIconInputsDisabled(true);
      showPushIconError(error instanceof Error ? error.message : 'Erreur réseau.');
    }
  }

  async function persistPushIconColorRequest(color: string | null) {
    if (color === pushIconLastSavedColor) return null;
    const res = await authFetch(withPointVente('/api/notifications/push-icon-settings'), {
      method: 'PATCH',
      body: JSON.stringify({ push_icon_bg_color: color }),
    });
    const payload = await res.json().catch(() => null);
    if (!res.ok) {
      throw new Error(payload?.error ?? 'Impossible de mettre à jour la couleur.');
    }
    pushIconLastSavedColor = color;
    return payload;
  }

  async function savePushIconColorNow(color: string | null, options: { throwOnError?: boolean } = {}) {
    if (pushIconModeButtons.every((button) => button.disabled)) return;
    pushIconPendingColor = color;
    if (pushIconSavePromise) {
      setPushIconStatusText('Enregistrement du réglage...');
      await pushIconSavePromise;
      if (options.throwOnError && pushIconLastSaveError) throw pushIconLastSaveError;
      return;
    }
    hidePushIconAlerts();
    pushIconSavePromise = (async () => {
      let latestPayload: any = null;
      let latestColor: string | null = color;
      try {
        while (pushIconPendingColor !== undefined) {
          const colorToSave = pushIconPendingColor;
          pushIconPendingColor = undefined;
          latestColor = colorToSave;
          const result = await persistPushIconColorRequest(colorToSave);
          if (result) latestPayload = result;
        }
        pushIconLastSaveError = null;
        if (!latestPayload) return;
        const refreshed = Number(latestPayload?.data?.apple_refresh_sent ?? 0);
        showPushIconSuccess(refreshed > 0
          ? `Réglage enregistré. ${refreshed} carte(s) Apple Wallet notifiée(s), mais iOS peut garder l'ancienne icône en cache jusqu'au redémarrage.`
          : (latestColor === null ? 'Mode automatique enregistré pour les prochaines cartes.' : 'Couleur enregistrée pour les prochaines cartes.'));
        setPushIconStatusText(latestColor === null
          ? 'Mode automatique: les nouvelles cartes suivent le fond de votre carte.'
          : 'Couleur personnalisée enregistrée. Les cartes déjà installées peuvent garder l’ancienne icône en cache iOS.');
      } catch (error: unknown) {
        pushIconLastSaveError = error instanceof Error ? error : new Error('Erreur réseau.');
        showPushIconError(pushIconLastSaveError.message);
      } finally {
        pushIconSavePromise = null;
      }
    })();
    await pushIconSavePromise;
    if (options.throwOnError && pushIconLastSaveError) throw pushIconLastSaveError;
  }

  async function persistBirthdaySettings(nextEnabled: boolean) {
    const rewardValue = Number.parseInt(birthdayRewardValue.value, 10);
    if (!Number.isFinite(rewardValue) || rewardValue < 1 || rewardValue > 50) {
      throw new Error('Le bonus anniversaire doit être compris entre 1 et 50.');
    }
    const res = await authFetch(withPointVente('/api/notifications/birthday-settings'), {
      method: 'PATCH',
      body: JSON.stringify({
        enabled: nextEnabled,
        reward_value: rewardValue,
        push_title: birthdayTitle.value.trim() || null,
        push_message: birthdayMessage.value.trim() || null,
      }),
    });
    const payload = await res.json().catch(() => null);
    if (!res.ok) throw new Error(payload?.error ?? 'Impossible de mettre à jour le réglage anniversaire.');
    return payload;
  }

  birthdayToggle.addEventListener('click', async () => {
    if (!birthdayIsPro) return;
    birthdayError.classList.add('hidden');
    birthdaySuccess.classList.add('hidden');
    setBirthdayFormDisabled(true);

    try {
      const nextEnabled = !birthdayEnabled;
      const payload = await persistBirthdaySettings(nextEnabled);
      setBirthdayToggle(Boolean(payload?.data?.enabled));
      birthdaySuccess.textContent = nextEnabled ? 'Programmation anniversaire activée.' : 'Programmation anniversaire désactivée.';
      birthdaySuccess.classList.remove('hidden');
    } catch (error: unknown) {
      birthdayError.textContent = error instanceof Error ? error.message : 'Erreur réseau.';
      birthdayError.classList.remove('hidden');
    } finally {
      setBirthdayFormDisabled(!birthdayIsPro);
    }
  });

  birthdaySaveBtn.addEventListener('click', async () => {
    if (!birthdayIsPro) return;
    birthdayError.classList.add('hidden');
    birthdaySuccess.classList.add('hidden');
    birthdaySaveBtn.disabled = true;
    const previousLabel = birthdaySaveBtn.textContent;
    birthdaySaveBtn.textContent = 'Enregistrement...';
    try {
      const payload = await persistBirthdaySettings(birthdayEnabled);
      setBirthdayToggle(Boolean(payload?.data?.enabled));
      birthdaySuccess.textContent = 'Réglage anniversaire enregistré.';
      birthdaySuccess.classList.remove('hidden');
    } catch (error: unknown) {
      birthdayError.textContent = error instanceof Error ? error.message : 'Erreur réseau.';
      birthdayError.classList.remove('hidden');
    } finally {
      birthdaySaveBtn.disabled = !birthdayIsPro;
      birthdaySaveBtn.textContent = previousLabel ?? 'Enregistrer le réglage anniversaire';
    }
  });

  [birthdayRewardValue, birthdayTitle, birthdayMessage].forEach((field) => {
    field.addEventListener('input', () => {
      if (!birthdayIsPro) return;
      birthdaySuccess.classList.add('hidden');
      birthdayStatus.textContent = birthdayEnabled
        ? 'Réglage modifié. Enregistrez pour appliquer à la prochaine programmation.'
        : 'Réglage modifié. Enregistrez avant d’activer l’automatisation.';
    });
  });

  function bindPushIconInput(input: HTMLInputElement) {
    input.addEventListener('input', () => {
      const color = input.value;
      if (pushIconMode !== 'custom') setPushIconMode('custom', color);
      syncPushIconInputs(color, input);
      updatePushIconPreview(color);
      if (pushIconSaveTimer) clearTimeout(pushIconSaveTimer);
      pushIconSaveTimer = setTimeout(() => {
        void savePushIconColorNow(color);
      }, 220);
    });

    input.addEventListener('change', async () => {
      if (pushIconSaveTimer) clearTimeout(pushIconSaveTimer);
      if (pushIconMode !== 'custom') setPushIconMode('custom', input.value);
      syncPushIconInputs(input.value, input);
      updatePushIconPreview(input.value);
      await savePushIconColorNow(input.value);
    });
  }

  pushIconInputs.forEach(bindPushIconInput);

  pushIconModeButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const mode = button.dataset.pushIconMode === 'custom' ? 'custom' : 'auto';
      hidePushIconAlerts();
      if (pushIconSaveTimer) {
        clearTimeout(pushIconSaveTimer);
        pushIconSaveTimer = null;
      }
      if (mode === 'auto') {
        setPushIconMode('auto', pushIconCardColor);
        await savePushIconColorNow(null);
        return;
      }
      const color = pushIconLastSavedColor ?? pushIconCardColor;
      setPushIconMode('custom', color);
      await savePushIconColorNow(color);
    });
  });

  setNotifTab('manual');
  syncMessagePreview();
  loadSummary();
  loadHistory();
  loadPlanFallback().then(() => Promise.all([
    loadReviewAutoSettings(),
    loadBirthdaySettings(),
    loadPushIconSettings(),
  ]));
</script>
