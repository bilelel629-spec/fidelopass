    .preview-area {
      border-radius: 1.35rem;
    }
  }

  @media (max-width: 720px) {
    .poster-creator {
      --poster-preview-width: min(100%, 330px);
      --poster-preview-width-a5: min(100%, 300px);
      padding-bottom: 11rem;
    }

    .creator-header nav,
    .primary-export-btn {
      display: none;
    }

    .form-grid,
    .color-grid,
    .template-grid {
      grid-template-columns: 1fr;
    }

    .export-bar {
      position: fixed;
      inset-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
      bottom: max(1rem, env(safe-area-inset-bottom));
      z-index: 50;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr;
    }

    .poster-sheet {
      width: var(--poster-preview-width);
      border-radius: 1.2rem;
    }

    .poster-sheet[data-format="a5"] {
