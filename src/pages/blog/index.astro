---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicNav from '../../components/marketing/PublicNav.astro';
import PublicFooter from '../../components/marketing/PublicFooter.astro';

export const prerender = true;

const posts = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const featured = posts[0];
const rest: CollectionEntry<'blog'>[] = posts.slice(1);

const dateFmt = (d: Date) => d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
const readingTime = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));

// Couleur de badge par catégorie (cohérent, premium)
const categoryStyle = (cat: string): string => {
  const map: Record<string, string> = {
    Guide: 'border-indigo-200 bg-indigo-50 text-indigo-700',
    Produit: 'border-sky-200 bg-sky-50 text-sky-700',
    Comparatif: 'border-violet-200 bg-violet-50 text-violet-700',
    'Stratégie': 'border-emerald-200 bg-emerald-50 text-emerald-700',
  };
  return map[cat] ?? 'border-slate-200 bg-slate-50 text-slate-600';
};
---

<BaseLayout
  theme="light"
  title="Blog Fidelopass — Fidélité client & cartes dématérialisées"
  description="Guides, comparatifs et stratégies premium pour fidéliser vos clients avec une carte de fidélité dématérialisée dans Apple Wallet et Google Wallet. La référence pour les commerces exigeants."
>
  <PublicNav currentPath="/blog" />

  <!-- Hero premium -->
  <section class="relative overflow-hidden bg-[linear-gradient(180deg,#ffffff_0%,#f3f7ff_60%,#ffffff_100%)] pt-12 pb-8 sm:pt-20 sm:pb-12">
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-72 w-[42rem] rounded-full bg-[radial-gradient(closest-side,rgba(79,70,229,0.10),transparent)]"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-indigo-200/80 bg-white px-4 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-indigo-700 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span> Le blog Fidelopass
      </span>
      <h1 class="font-display text-3xl sm:text-[3.25rem] font-bold text-slate-900 leading-[1.05] tracking-[-0.02em]">
        La fidélité client, <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">faite avec exigence.</span>
      </h1>
      <p class="text-slate-500 text-base sm:text-lg mt-5 max-w-2xl mx-auto leading-relaxed">
        Guides, comparatifs et stratégies concrètes pour transformer vos clients en habitués —
        la méthode des commerces qui ne laissent rien au hasard.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-semibold text-slate-400">
        <span class="inline-flex items-center gap-1.5"><span class="text-indigo-500">✦</span> +2 000 commerces</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-indigo-500">✦</span> Apple Wallet &amp; Google Wallet</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-indigo-500">✦</span> Sans application</span>
      </div>
    </div>
  </section>

  <section class="bg-slate-50/70 py-10 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      {posts.length === 0 ? (
        <p class="text-center text-slate-500">Les premiers articles arrivent très bientôt.</p>
      ) : (
        <>
          <!-- Article à la une -->
          <a
            href={`/blog/${featured.id}`}
            class="group mb-8 grid overflow-hidden rounded-[1.9rem] border border-slate-200 bg-white shadow-[0_24px_60px_-40px_rgba(15,23,42,0.45)] transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-[0_30px_70px_-35px_rgba(79,70,229,0.35)] sm:grid-cols-[1.05fr_0.95fr]"
          >
            <div class="relative hidden sm:block bg-[linear-gradient(135deg,#0f172a_0%,#312e81_55%,#0284c7_100%)]">
              <div class="absolute inset-0 flex flex-col justify-between p-8 text-white">
                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-white backdrop-blur">
                  ★ À la une
                </span>
                <div>
                  <p class="font-display text-2xl font-bold leading-snug">{featured.data.title}</p>
                  <p class="mt-3 text-sm text-indigo-100/90">Le guide le plus lu du moment.</p>
                </div>
              </div>
            </div>
            <div class="flex flex-col p-7 sm:p-9">
              <span class={`inline-flex w-fit rounded-full border px-3 py-1 text-[0.66rem] font-bold uppercase tracking-[0.14em] ${categoryStyle(featured.data.category)}`}>{featured.data.category}</span>
              <h2 class="mt-4 font-display text-2xl sm:text-[1.85rem] font-bold text-slate-950 leading-tight group-hover:text-indigo-700">{featured.data.title}</h2>
              <p class="mt-3 flex-1 text-[0.97rem] leading-7 text-slate-500">{featured.data.description}</p>
              <div class="mt-6 flex items-center gap-3 text-xs font-semibold text-slate-400">
                <span>{dateFmt(featured.data.pubDate)}</span>
                <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                <span>{readingTime(featured.body)} min de lecture</span>
                <span class="ml-auto inline-flex items-center gap-1 text-indigo-600 group-hover:gap-2 transition-all">Lire <span aria-hidden="true">→</span></span>
              </div>
            </div>
          </a>

          <!-- Grille des autres articles -->
          <div class="grid gap-6 sm:grid-cols-2">
            {rest.map((post) => (
              <a href={`/blog/${post.id}`} class="group flex flex-col rounded-[1.6rem] border border-slate-200 bg-white p-6 shadow-[0_18px_46px_-36px_rgba(15,23,42,0.4)] transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-[0_24px_60px_-30px_rgba(79,70,229,0.3)]">
                <span class={`inline-flex w-fit rounded-full border px-3 py-1 text-[0.66rem] font-bold uppercase tracking-[0.14em] ${categoryStyle(post.data.category)}`}>{post.data.category}</span>
                <h2 class="mt-4 font-display text-xl font-bold text-slate-950 leading-tight group-hover:text-indigo-700">{post.data.title}</h2>
                <p class="mt-3 flex-1 text-sm leading-6 text-slate-500">{post.data.description}</p>
                <div class="mt-5 flex items-center gap-2.5 text-xs font-semibold text-slate-400">
                  <span>{dateFmt(post.data.pubDate)}</span>
                  <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                  <span>{readingTime(post.body)} min</span>
                  <span class="ml-auto text-indigo-500 opacity-0 group-hover:opacity-100 transition" aria-hidden="true">→</span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <PublicFooter />
</BaseLayout>
